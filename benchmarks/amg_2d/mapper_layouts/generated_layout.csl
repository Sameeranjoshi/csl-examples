////
// AUTOGENERATED DO NOT EDIT
////

param kernel_x_dim: i16 = 2;
param kernel_y_dim: i16 = 2;
param M: i16 = 4;
param N: i16 = 4;

// Colors
const ax_color_1: color = @get_color(0);
const ax_color_2: color = @get_color(1);
const x_color: color = @get_color(2);

const memcpy = @import_module("<memcpy/get_params>", .{
  .width = kernel_x_dim,
  .height = kernel_y_dim
});

layout {
  @set_rectangle(kernel_x_dim, kernel_y_dim);

  @comptime_assert(M % kernel_y_dim == 0);
  @comptime_assert(N % kernel_x_dim == 0);

  const common_params = .{
    .M_per_PE = M / kernel_y_dim,
    .N_per_PE = N / kernel_x_dim,
    .kernel_x_dim = kernel_x_dim,
    .kernel_y_dim = kernel_y_dim,
    .x_color = x_color
  };

  const even_params = @concat_structs(common_params, .{
    .send_east_color = ax_color_1, .recv_west_color = ax_color_2
  });

  const odd_params = @concat_structs(common_params, .{
    .send_east_color = ax_color_2, .recv_west_color = ax_color_1
  });

  @set_tile_code(0, 0, "pe_program.csl", @concat_structs(
    .{ .memcpy_params = memcpy.get_params(0) }, even_params));
  @set_tile_code(0, 1, "pe_program.csl", @concat_structs(
    .{ .memcpy_params = memcpy.get_params(0) }, even_params));
  @set_tile_code(1, 0, "pe_program.csl", @concat_structs(
    .{ .memcpy_params = memcpy.get_params(1) }, odd_params));
  @set_tile_code(1, 1, "pe_program.csl", @concat_structs(
    .{ .memcpy_params = memcpy.get_params(1) }, odd_params));

  // Define routes
  const RX_R_TX_RS = .{ .rx = .{RAMP},  .tx = .{RAMP, SOUTH} };
  const RX_N_TX_RS = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} };
  const RX_N_TX_R  = .{ .rx = .{NORTH}, .tx = .{RAMP} };
  const RX_W_TX_R  = .{ .rx = .{WEST},  .tx = .{RAMP} };
  const RX_R_TX_E  = .{ .rx = .{RAMP},  .tx = .{EAST} };

  @set_color_config(0, 0, x_color, .{ .routes = RX_R_TX_RS });
  @set_color_config(0, 0, ax_color_1, .{ .routes = RX_R_TX_E });
  @set_color_config(0, 0, ax_color_2, .{ .routes = RX_W_TX_R });
  @set_color_config(0, 1, x_color, .{ .routes = RX_N_TX_R });
  @set_color_config(0, 1, ax_color_1, .{ .routes = RX_R_TX_E });
  @set_color_config(0, 1, ax_color_2, .{ .routes = RX_W_TX_R });
  @set_color_config(1, 0, x_color, .{ .routes = RX_R_TX_RS });
  @set_color_config(1, 0, ax_color_1, .{ .routes = RX_W_TX_R });
  @set_color_config(1, 0, ax_color_2, .{ .routes = RX_R_TX_E });
  @set_color_config(1, 1, x_color, .{ .routes = RX_N_TX_R });
  @set_color_config(1, 1, ax_color_1, .{ .routes = RX_W_TX_R });
  @set_color_config(1, 1, ax_color_2, .{ .routes = RX_R_TX_E });

  // export symbol names
  @export_name("A", [*]f32, true);
  @export_name("x", [*]f32, true);
  @export_name("y", [*]f32, true);
  @export_name("compute", fn()void);
}
