// color/ task ID map
//
//  ID var             ID var              ID var               ID var
//   0 C0                       9 STARTUP                 18          27 reserved (memcpy)
//   1                        10 SYNC_Y                 19        28 reserved (memcpy)
//   2                        11 SYNC_BCAST             20          29 reserved
//   3                        12 EXIT_SYNC              21 reserved (memcpy)      30 reserved (memcpy)
//   4                        13 C2D_X_ENTRYPOINT_0     22 reserved (memcpy)      31 reserved
//   5 collective_x_color_right 14 C2D_X_ENTRYPOINT_1     23 reserved (memcpy)      32
//   6 collective_x_color_left  15 C2D_Y_ENTRYPOINT_0     24     33
//   7 collective_y_color_down  16 C2D_Y_ENTRYPOINT_1     25            34
//   8 collective_y_color_up    17 STATE_MACHINE          26      35


// fixed parameters
param total_pe_cols: i16 ; // width of the core rectangle // 1
param total_pe_rows: i16 ; // height of the core rectangle    //1 initially
param total_levels: i16; // number of levels in the AMG hierarchy


// LAYER 0(Other way - This can be @import_comptime_value)
param layer_M_0: i16;       // A shape parameters here
param layer_N_0: i16;   
param layer_R_M_0: i16;     // R shape parameters here
param layer_R_N_0: i16; 
param layer_start_x_0: i16; // start x of the layer
param layer_start_y_0: i16; // start y of the layer
param layer_pe_cols_0: i16; // number of PEs in x direction
param layer_pe_rows_0: i16; // number of PEs in y direction
param layer_index_0: i16; // index of the layer

// LAYER 1
param layer_M_1: i16;       // A shape parameters here
param layer_N_1: i16;
param layer_R_M_1: i16;     // R shape parameters here
param layer_R_N_1: i16;
param layer_start_x_1: i16; // start x of the layer
param layer_start_y_1: i16; // start y of the layer
param layer_pe_cols_1: i16; // number of PEs in x direction
param layer_pe_rows_1: i16; // number of PEs in y direction
param layer_index_1: i16; // index of the layer

// LAYER 2
// ... continue for total_levels
// same for others based on levels/total_levels.
// param M_1: i16;       // A shape parameters here
// param N_1: i16;
// ... list continues for all levels

const first = [9]i16 { layer_M_0, layer_N_0, layer_R_M_0, layer_R_N_0, layer_start_x_0, layer_start_y_0, layer_pe_cols_0, layer_pe_rows_0, layer_index_0 };
const second = [9]i16 { layer_M_1, layer_N_1, layer_R_M_1, layer_R_N_1, layer_start_x_1, layer_start_y_1, layer_pe_cols_1, layer_pe_rows_1, layer_index_1 };
// continue for all levels


// SYNC MODULE
const C0 : color = @get_color(0);
const fast_bcast_c1 : color = @get_color(1);
const fast_bcast_c2 : color = @get_color(2);
const fast_bcast_c3 : color = @get_color(3);
const fast_bcast_c4 : color = @get_color(4);
const fast_bcast_c5 : color = @get_color(18);
const fast_bcast_c6 : color = @get_color(19);
const fast_bcast_c7 : color = @get_color(20);

// collective module colors
const collective_x_color_right : color = @get_color(5);
const collective_x_color_left : color = @get_color(6);
const collective_y_color_down : color = @get_color(7);
const collective_y_color_up : color = @get_color(8);

// entrypoints of sync module

// entrypoints of allreduce
const EN_REDUCE_1: local_task_id = @get_local_task_id(9);
const EN_REDUCE_2: local_task_id = @get_local_task_id(10);
const EN_REDUCE_3: local_task_id = @get_local_task_id(11);
const EN_REDUCE_4: local_task_id = @get_local_task_id(12);

// collective module tasks
const C2D_X_ENTRYPOINT_0: local_task_id = @get_local_task_id(13);
const C2D_X_ENTRYPOINT_1: local_task_id = @get_local_task_id(14);
const C2D_Y_ENTRYPOINT_0: local_task_id = @get_local_task_id(15);
const C2D_Y_ENTRYPOINT_1: local_task_id = @get_local_task_id(16);
// layer task ID
// Task IDs
const STATE_MACHINE: local_task_id = @get_local_task_id(17);
// used for sync across all the layers for timings.
const reduce_module = @import_module( "../../csl-libs/allreduce/layout.csl", .{
    .colors = [1]color{C0},
    .entrypoints = [4]local_task_id{EN_REDUCE_1, EN_REDUCE_2, EN_REDUCE_3, EN_REDUCE_4},
    .width = total_pe_cols,
    .height = total_pe_rows
    });

const memcpy = @import_module( "<memcpy/get_params>", .{
    .width = total_pe_cols,
    .height = total_pe_rows
    });
const c2d = @import_module("<collectives_2d/params>");
const c2d_struct = .{
    .x_colors = .{collective_x_color_left, collective_x_color_right},
    .y_colors = .{collective_y_color_down, collective_y_color_up},
    .x_entrypoints = .{C2D_X_ENTRYPOINT_0, C2D_X_ENTRYPOINT_1},
    .y_entrypoints = .{C2D_Y_ENTRYPOINT_0, C2D_Y_ENTRYPOINT_1},
};

layout {
    // step 1: configure the rectangle which does not include halo
    @set_rectangle( total_pe_cols, total_pe_rows );
    var pe_has_code = @zeros([total_pe_rows*total_pe_cols]i16);

    var idx: i16 = 0;
    while(idx < total_levels) : (idx += 1) {
        var currentlayer:[9]i16 = switch(idx) { // This can be @import_comptime_value
            0 => first,
            1 => second,
            else => @comptime_assert("Invalid layer data or no layer found while layout generation")
        };
        // perform some precomputations

        // Local matrix dimensions
        var layer_rows_A = currentlayer[0]; // Height of matrix
        var layer_cols_A = currentlayer[1]; // Width of matrix
        var layer_rows_R = currentlayer[2]; // Height of matrix R
        var layer_cols_R = currentlayer[3]; // Width of matrix R
        var layer_start_x = currentlayer[4]; // start x of the layer
        var layer_start_y = currentlayer[5]; // start y of the layer
        var layer_kernel_rows = currentlayer[6]; // Height of kernel
        var layer_kernel_cols = currentlayer[7]; // Width of kernel
        var layer_index = currentlayer[8]; // index of the layer

        // Local matrix dimensions
        const LOCAL_rows_A: i16 = layer_rows_A / layer_kernel_rows; // Number of rows per PE
        const LOCAL_cols_A: i16 = layer_cols_A / layer_kernel_cols; // Number of columns per PE
        const LOCAL_rows_R: i16 = layer_rows_R / layer_kernel_rows; // Number of rows per PE
        const LOCAL_cols_R: i16 = layer_cols_R / layer_kernel_cols; // Number of columns per PE
        const layer_end_x: i16 = layer_start_x + layer_kernel_cols; // end x of the layer
        const layer_end_y: i16 = layer_start_y + layer_kernel_rows; // end y of the layer

        const current_layer_params = .{
            .M = layer_rows_A,
            .N = layer_cols_A,
            .M_local = LOCAL_rows_A,
            .N_local = LOCAL_cols_A,
            .R_M_local = LOCAL_rows_R,
            .R_N_local = LOCAL_cols_R,
            .layer_start_x = layer_start_x,
            .layer_start_y = layer_start_y,
            .layer_end_x = layer_end_x,
            .layer_end_y = layer_end_y,
            .layer_kernel_rows = layer_kernel_rows,
            .layer_kernel_cols = layer_kernel_cols,
            .layer_index = layer_index,
            .layer_task_id = [1]local_task_id{STATE_MACHINE},
        };


        ////// Layout plotting //////
        var px: i16 = layer_start_x;
        while (px < layer_end_x) : (px += 1) {
            var py: i16 = layer_start_y;  // Reset py for each new px
            const memcpy_params = memcpy.get_params(px);
            while (py < layer_end_y) : (py += 1) {
                const reduce_params = reduce_module.get_params(px, py);
                const c2d_params = c2d.get_params(px, py, c2d_struct);
                const layer_params = current_layer_params;

                var params: comptime_struct = .{
                    .memcpy_params = memcpy_params,
                    .c2d_params = c2d_params,
                    .layer_params = layer_params,
                    .reduce_params = reduce_params,
                    .fast_bcast_colors = [7]color{fast_bcast_c1, fast_bcast_c2, fast_bcast_c3, fast_bcast_c4, fast_bcast_c5, fast_bcast_c6, fast_bcast_c7},
                    .pe_id_x = px,
                    .pe_id_y = py,
                };
                @set_tile_code(px, py, "./libraries/single_layer/single_layer_pe.csl", params);

                // empty tiles indexing.
                var oned_index:i16 = py + px * total_pe_rows;
                pe_has_code[oned_index] = 1;
            }
        }
    }
    // OK now layers are mapped, fill unoccupied PEs with empty.csl
    var px: i16 = 0;
    while (px < total_pe_cols) : (px += 1) {
        var py: i16 = 0;
        while (py < total_pe_rows) : (py += 1) {
            // var oned_index:i16 = py + px * total_pe_cols;
            var oned_index:i16 = py + px * total_pe_rows;
            if (pe_has_code[oned_index] == 0) {
                const memcpy_params = memcpy.get_params(px);
                @set_tile_code(px, py, "empty.csl", .{ .memcpy_params = memcpy_params });
            }
        }
    }
    
    // export symbol names
    @export_name("A", [*]f32, true);
    @export_name("R", [*]f32, true);
    @export_name("P", [*]f32, true);
    @export_name("x", [*]f32, true);
    @export_name("x_coarse", [*]f32, true);
    @export_name("b", [*]f32, true);
    @export_name("v_cycle_down", fn()void);
    @export_name("v_cycle_up", fn()void);
    @export_name("b_next", [*]f32, true);
    @export_name("omega", [*]f32, true);
    @export_name("iterations", [*]i32, true);
    @export_name("layout_print", fn()void);

    // timing
    @export_name("time_memcpy", [*]f32, true);
    @export_name("time_ref", [*]f32, true);
    @export_name("communication_time", [*]f32, true);
    @export_name("f_enable_timer", fn()void);
    @export_name("f_tic", fn()void);
    @export_name("f_toc", fn()void);
    @export_name("f_memcpy_timestamps", fn()void);
    @export_name("f_sync", fn()void);
    @export_name("f_reference_timestamps", fn()void);    

} // end of layout