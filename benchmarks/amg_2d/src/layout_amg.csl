// fixed parameters
param total_pe_cols: i16 ; // width of the core rectangle // 1
param total_pe_rows: i16 ; // height of the core rectangle    //1 initially
param total_levels: i16; // number of levels in the AMG hierarchy


// list dynamic/array?
param layer_M_0: i16;       // A shape parameters here
param layer_N_0: i16;   
param layer_R_M_0: i16;     // R shape parameters here
param layer_R_N_0: i16; 
param layer_start_x_0: i16; // start x of the layer
param layer_start_y_0: i16; // start y of the layer
param layer_pe_cols_0: i16; // number of PEs in x direction
param layer_pe_rows_0: i16; // number of PEs in y direction
param layer_index_0: i16; // index of the layer

// same for others based on levels/total_levels.
// param M_1: i16;       // A shape parameters here
// param N_1: i16;
// ... list continues for all levels

const memcpy = @import_module( "<memcpy/get_params>", .{
    .width = total_pe_cols,
    .height = total_pe_rows
    });

layout {
    // step 1: configure the rectangle which does not include halo
    @set_rectangle( total_pe_cols, total_pe_rows );

    // step 2: compile csl code for a set of PEx.y and generate out_x_y.elf
    //   format: @set_tile_code(x, y, code.csl, param_binding);

    // Map each layer
    for (@range(i16, layer_start_y_0, layer_pe_rows_0,1)) |py| {
        for (@range(i16, layer_start_x_0, layer_pe_cols_0,1)) |px| {

            const memcpyParams = memcpy.get_params(px);
            var params: comptime_struct = .{
                .memcpy_params = memcpyParams,
                .M = layer_M_0,
                .N = layer_N_0,
                .R_M = layer_R_M_0,
                .R_N = layer_R_N_0
                // .layer_index = layer_index_0,    // Maybe?
            };

            @set_tile_code(px, py, "kernel_amg.csl", params);
        }
    }

    // input (true = mutability from host?)
    @export_name("b", [*]f32, true);
    @export_name("x", [*]f32, true);
    @export_name("A", [*]f32, true);
    @export_name("R", [*]f32, true);

    // kernels
    @export_name("compute", fn(f32, i16)void);

    // outputs
    @export_name("residual", [*]f32, false);    // host can't modify residual.
    @export_name("b_coarse", [*]f32, false);    // host can't modify b_coarse.
} // end of layout