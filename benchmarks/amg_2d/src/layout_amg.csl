// color map: memcpy + allreduce + stencil
//
// color  var   color  var        color  var              color  var
//   0   C0       9                18    EN_REDUCE_2       27   reserved (memcpy)
//   1   C1      10                19    EN_REDUCE_3       28   reserved (memcpy)
//   2   C2      11                20    EN_REDUCE_4       29   reserved (memcpy)
//   3   C3      12                21    reserved (memcpy) 30   reserved (memcpy)
//   4   C4      13                22    reserved (memcpy) 31   reserved
//   5   C5      14  EN_STENCIL_1  23    reserved (memcpy) 32
//   6   C6      15  EN_STENCIL_2  24                      33
//   7   C7      16  EN_STENCIL_3  25                      34
//   8   C8      17  EN_REDUCE_1   26                      35
//



param pe_cols: i16 ; // width of the core rectangle // 1
param pe_rows: i16 ; // height of the core rectangle    //1 initially
param M: i16;       // A shape parameters here
param N: i16;   
param R_M: i16;     // R shape parameters here
param R_N: i16; 
comptime {
    @comptime_assert(M == N, "M and N must be equal at compiletime");
}
// comptime {
//   // Number of matrix rows must be multiple of kernel rectangle height
//   @comptime_assert(matrix_rows % pe_rows == 0);
//   // Number of matrix cols must be multiple of kernel rectangle width
//   @comptime_assert(matrix_cols % pe_cols == 0);
// }
// Local matrix dimensions
// const local_rows: i16 = matrix_rows / pe_rows; // Number of rows per PE
// const local_cols: i16 = matrix_cols / pe_cols; // Number of columns per PE
// const local_rows: i16 = matrix_rows;
// const local_cols: i16 = matrix_cols;    // TODO: change me back to division

const memcpy = @import_module( "<memcpy/get_params>", .{
    .width = pe_cols,
    .height = pe_rows
    });

layout {
    // step 1: configure the rectangle which does not include halo
    @set_rectangle( pe_cols, pe_rows );

    // step 2: compile csl code for a set of PEx.y and generate out_x_y.elf
    //   format: @set_tile_code(x, y, code.csl, param_binding);

    var py: i16 = 0;
    while(py < pe_rows) : (py +=1) {
        var px: i16 = 0;
        while(px < pe_cols) : (px +=1) {

            const memcpyParams = memcpy.get_params(px);
            var params: comptime_struct = .{
                .memcpy_params = memcpyParams,
                .M = M,
                .N = N,
                .R_M = R_M,
                .R_N = R_N
            };

            @set_tile_code(px, py, "kernel_amg.csl", params);
        }
    }

    // input (true = mutability from host?)
    @export_name("b", [*]f32, true);
    @export_name("x", [*]f32, true);
    @export_name("A", [*]f32, true);
    @export_name("R", [*]f32, true);

    // kernels
    @export_name("compute", fn()void);
    @export_name("jacobi", fn()void);

    // outputs
    @export_name("x_smooth", [*]f32, false);    // host can't modify x_smooth.
    @export_name("residual", [*]f32, false);    // host can't modify residual.
    @export_name("b_coarse", [*]f32, false);    // host can't modify b_coarse.
} // end of layout