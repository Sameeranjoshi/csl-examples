// Internal utils and constants for the math library

// ----------------------------------------------------------------
// generic floating point constants
// ----------------------------------------------------------------

fn bit_size(comptime T: type) comptime_int {
  if (@is_same_type(T, f16)) {
    return 16;
  } else if (@is_same_type(T, f32)) {
    return 32;
  }
  @comptime_assert(false);
}

fn bits_type(comptime T: type) type {
  if (@is_same_type(T, f16)) {
    return u16;
  } else if (@is_same_type(T, f32)) {
    return u32;
  }
  @comptime_assert(false);
}

fn exp_len(comptime T: type) comptime_int {
  if (@is_same_type(T, f16)) {
    return 5;
  } else if (@is_same_type(T, f32)) {
    return 8;
  }
  @comptime_assert(false);
}

fn mantissa_len(comptime T: type) comptime_int {
  return bit_size(T) - 1 - exp_len(T);
}

fn mantissa_mask(comptime T: type) comptime_int {
  return comptime (1 << mantissa_len(T)) - 1;
}

// This mask is for an exponent shifted to bit 0.
fn exp_mask(comptime T: type) comptime_int {
  return (1 << exp_len(T)) - 1;
}

fn default_bias(comptime T: type) comptime_int {
  return exp_mask(T) >> 1;
}

fn sign_bit(comptime T: type) comptime_int {
  return comptime 1 << (bit_size(T) - 1);
}

fn POSITIVE_INF(comptime T: type) T {
  return @bitcast(T, @as(bits_type(T), comptime exp_mask(T) << mantissa_len(T)));
}

fn NEGATIVE_INF(comptime T: type) T {
  return @bitcast(T, @as(bits_type(T), comptime (exp_mask(T) << mantissa_len(T)) | sign_bit(T)));
}

// indicates signalling NaN
fn HIGH_MANT_BIT(comptime T: type) comptime_int {
  return comptime 1 << (mantissa_len(T)) - 1;
}

fn NaN(comptime T: type) T {
  return @bitcast(T, @as(bits_type(T), comptime (exp_mask(T) << mantissa_len(T)) | HIGH_MANT_BIT(T)));
}

// ----------------------------------------------------------------
// f16 constants
// ----------------------------------------------------------------

const exp_len_f16 = exp_len(f16);
const mantissa_len_f16 = mantissa_len(f16);
const mantissa_mask_f16 = mantissa_mask(f16);

// This mask is for an exponent shifted to bit 0.
const exp_mask_f16 = exp_mask(f16);

const default_bias_f16 = default_bias(f16);

const POSITIVE_INF_f16 = POSITIVE_INF(f16);
const NEGATIVE_INF_f16 = NEGATIVE_INF(f16);
const NaN_f16 = NaN(f16);

const LOW_EXP_BIT_f16 = @as(u16, 0x0400);
const HIGH_MANT_BIT_f16 = HIGH_MANT_BIT(f16); // indicates signalling NaN

const EXP_MAX_LN_f16 = @bitcast(f16, @as(u16, 0x498c)); // exp=0b10010, man=0b0110001100
const EXP_MIN_LN_f16 = @bitcast(f16, @as(u16, 0xcc55)); // exp=0b10011, man=0b0001010101

// ----------------------------------------------------------------
// f32 constants
// ----------------------------------------------------------------

const exp_len_f32 = exp_len(f32);
const mantissa_len_f32 = mantissa_len(f32);
const mantissa_mask_f32 = mantissa_mask(f32);

// This mask is for an exponent shifted to bit 0.
const exp_mask_f32 = exp_mask(f32);

const default_bias_f32 = default_bias(f32);

const one_f32 = @bitcast(u32, @as(f32, 1.0));

const POSITIVE_INF_f32 = POSITIVE_INF(f32);
const NEGATIVE_INF_f32 = NEGATIVE_INF(f32);
const NaN_f32 = NaN(f32);

const HIGH_MANT_BIT_f32 = HIGH_MANT_BIT(f32); // indicates signalling NaN

// ----------------------------------------------------------------
// cerebras specific functions (used only in this library)
// ----------------------------------------------------------------

fn fnorm_f16(f : f16) f16 {
  var res : f16 = 0.0;
  @fnormh(&res, f);
  return res;
}

fn fnorm_f32(f : f32) f32 {
  var res : f32 = 0.0;
  @fnorms(&res, f);
  return res;
}

fn fmac_f32(x : f32, y : f32, z : f32) f32 {
  return x + y * z;
}

fn fmac_f16(x : f16, y : f16, z : f16) f16 {
  return x + y * z;
}

fn fs2xp16(x : f32) i16 {
  var res : i16 = 0;
  @fs2xp16(&res, x);
  return res;
}

// Implements pow2i_f32(x) = powf(2,x)
fn pow2i_f32(x: i16) f32 {
  const default_bias = @as(i16,default_bias_f32);
  const max_exp = default_bias;
  const min_exp = -(default_bias - 1);
  if (x < min_exp - mantissa_len_f32) {
    return @bitcast(f32, @as(u32,0));
  }
  if (x < min_exp) {
    return @bitcast(f32, @as(u32,1) << @as(u16, mantissa_len_f32 + x - min_exp));
  }
  if (x > max_exp) {
    return POSITIVE_INF_f32;
  }
  return @bitcast(f32, @as(u32,x + default_bias) << mantissa_len_f32);
}
