fn rotate_clockwise(d : direction) direction {
  if (d == NORTH) {
    return EAST;
  } else if (d == EAST) {
    return SOUTH;
  } else if (d == SOUTH) {
    return WEST;
  } else if (d == WEST) {
    return NORTH;
  }
  return RAMP; // d == RAMP
}

fn rotate_counterclockwise(d : direction) direction {
  if (d == NORTH) {
    return WEST;
  } else if (d == EAST) {
    return NORTH;
  } else if (d == SOUTH) {
    return EAST;
  } else if (d == WEST) {
    return SOUTH;
  }
  return RAMP; // d == RAMP
}

fn flip_vertical(d : direction) direction {
  if (d == NORTH) {
    return SOUTH;
  } else if (d == SOUTH) {
    return NORTH;
  }
  return d; // d == EAST, WEST, or RAMP. all unchanged
}

fn flip_horizontal(d : direction) direction {
  if (d == EAST) {
    return WEST;
  } else if (d == WEST) {
    return EAST;
  }
  return d; // d == NORTH, SOUTH, or RAMP. all unchanged
}

fn flip(d : direction) direction {
  return flip_vertical(flip_horizontal(d));
}
