param target : imported_module;

const addresses = target.addresses;
const reg_type = target.reg_type;
const word_size = target.word_size;

// Returns the word address of an input queue configuration that
// corresponds to input queue `qid`.
fn get_output_queue_config_addr(qid: u16) reg_type {
  const base_addr_output_queue_config = @get_int(addresses.OUTPUT_QUEUE_CONFIG) / word_size;
  return base_addr_output_queue_config + target.REGS_PER_OUTPUT_QUEUE * @get_int(qid);
}

// Output queue configuration registers
// 0x7b80 - 0x7b87
// one word per queue
// bit 15:14  Reserved
// bit 13     Enable color change control wavelets
// bit 12:10  Half-wavelet delay
// bit 9      Dense mode
// bit 8:4    Color
// bit 3:0    Rate limit
//
// Only encode color field.
// Other fields are kept as-is.
fn encode_output_queue( qid: u16, c: i16) void {
  if (!@is_arch("wse3")) {
    @comptime_print("output queue not supported on this target");
    @comptime_assert(false);
  }

  const addr = get_output_queue_config_addr(qid);
  var val: u16 = @get_config(addr);

  // set bit 8:4 to zero
  val = val & 0xfe0f;
  // assign color to bit 8:4
  val = val + @as(u16, c) << 4;

  @set_config(addr, val);
}
