param target : imported_module;
const addresses = target.addresses;
const reg_type = target.reg_type;
const word_size = target.word_size;

const  PERF_CNT_0_OVERFLOW = ~@as(reg_type, (1 << 2));
const  PERF_CNT_1_OVERFLOW = ~@as(reg_type, (1 << 3));
const  SW_EXCEPTION = ~@as(reg_type, (1 << 4));
const  FP_UNDERFLOW = ~@as(reg_type, (1 << 11));
const  FP_OVERFLOW = ~@as(reg_type, (1 << 12));
const  FP_INEXACT = ~@as(reg_type, (1 << 13));
const  FP_INVALID = ~@as(reg_type, (1 << 14));
const  FP_DIV_BY_0 = ~@as(reg_type, (1 << 15));

fn set_exception_mask(exception_mask: reg_type) void {
  const exception_mask_addr = @as(reg_type, addresses.EXCEPTION_MASK_ADDR) / word_size;
  @set_config(exception_mask_addr, exception_mask);
}
