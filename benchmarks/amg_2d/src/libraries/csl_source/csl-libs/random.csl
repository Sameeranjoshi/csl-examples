const math = @import_module("<math>");
const config = @import_module("<tile_config>");

/// Number of PRNGs provided by the hardware.
const prng_count: u16 = config.target.prng_count;
const prng_size = config.target.prng_size;

/// Sets the global state of the PRNGs to `seed`.
fn set_global_prng_seed(seed: u32) void {
  /// Even though only the 0th PRNG is used, we set the state of all of them, as
  /// we need enough side-effect producing operations to ensure a long enough
  /// cycle delay.
  for (@range(u16, prng_count)) |prng_id| {
    set_global_seed_for_prng_id(seed, prng_id);
  }
}

/// Sets the global state of the PRNG number `prng_id` to `seed`.
fn set_global_seed_for_prng_id(seed: u32, prng_id: u16) void {
  @assert(prng_id < prng_count);
  if (prng_id >= prng_count) {
    return;
  }

  // Base address is architecture-dependent.
  const base = @as(u16, config.addresses.PRNG_STATE);
  const addr = (base + prng_size * prng_id) / config.word_size;

  var low_word : u16 = @as(u16, seed);
  var high_word : u16 = @as(u16, seed >> 16);
  @set_config(addr, low_word);
  @set_config(addr + 1, high_word);
}

fn random_f16(lower: f16, upper: f16) f16 {
  @comptime_assert(math.internal.mantissa_len_f16 <= 16);

  // pull 16 random bits from the LFSR, selecting
  // only what we need to cover the mantissa
  const mantissa : u16 = @random16() & math.internal.mantissa_mask_f16;

  // construct a random floating-point value in the range [1.0, 2.0)
  const one_f16 = @bitcast(u16, @as(f16, 1.0));
  const f : f16 = @bitcast(f16, @as(u16, one_f16) | mantissa);

  // scale this to a random floating-point value in the range requested
  return (f - 1.0) * (upper - lower) + lower;
}

fn random_f32(lower: f32, upper: f32) f32 {
  // pull 2 × 16 bits from the LFSR for mantissa input
  const t0 : u32 = @as(u32, @random16()) | @as(u32, @random16()) << 16;

  // select only as many bits as we need for the mantissa
  const FLT_MANT_DIG = 24;
  const mantissa : u32 = t0 >> (32 - FLT_MANT_DIG + 1);

  // construct a random floating-point value in the range [1.0, 2.0)
  const one_f32 = @bitcast(u32, @as(f32, 1.0));
  const f : f32 = @bitcast(f32, one_f32 | mantissa);

  // scale this to a random floating-point value in the range requested
  return (f - @as(f32, 1.0)) * (upper - lower) + lower;
}

// generate a random number in the range [0, 2ᵇᵒᵘⁿᵈ)
fn random_pow_u32(pow : u16) u32 {
  // pow > 0 && pow <= 32
  var v : u32 = @as(u32, @random16());
  if (pow > 16) {
    v = v | @as(u32, @random16()) << 16;
  }
  if (pow == 32) {
    return v;
  }

  return v & ((@as(u32, 1) << pow) - 1);
}

fn random_normal_f32() f32 {
  // We use the Box–Muller transform
  const u1 = 1.0 - random_f32(0.0, 1.0);
  const u2 = random_f32(0.0, 1.0);
  const r2 = -2.0 * math.log_f32(u1);
  const theta = 2.0 * math.PI * u2;
  return math.sqrt_f32(r2) * math.cos_f32(theta);
}
