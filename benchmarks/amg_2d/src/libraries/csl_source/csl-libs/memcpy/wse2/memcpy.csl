
// memcpy to support up to 4 inputs and 4 outputs:

//
// memcpy.csl is a wrapper of sys.csl, memcpyh2d.csl and memcpyd2h.csl
//
// It provides a unique entrypoint of task 29 for teardown process.
// The user cannot define task 29, the compiler must emit an error if
// task 29 is defined.
//

//
// The behavior of memcpyH2D
// step 1: RXCOMMAND(=C22) broadcasts memcpyH2D to a row PEs
// step 2: entrypoint memcpyH2D decodes (px, py, w, h, addr)
//         and sets up a counter filter at runtime
// step 3: receive data via color C21
//
// The behavior of memcpyD2H
// step 1: RXCOMMAND(=C22) broadcasts memcpyD2H to a row PEs
// step 2: entrypoint memcpyD2H decodes (px, py, w, h, addr)
//         and sets up a switch at runtime
// step 3: entrypoint memcpyD2H sends data and ctrl to the router in
//         round-robin sense
//

// WARNING: The design consideration of H2D
// The H2D receives data from cmd fan if there exists at least one active
// PE (a PE is in region of interest) in a row.
// The whole row must involve "this" H2D operation: each PE sets up the
// filter according to the ROI.
// If any PE in this row does not follow the protocol, for example, some
// PE is not in the ROI of 1st H2D, but in ROI of 2nd H2D, and it sets the
// filter according to 2nd H2D, the pattern of 1st H2D may be broken.
// Therefore we can only unblock the cmd stream (C22) when TD arrives
// because TD indicates all data of this H2D has been sent by cmd fan.
// Even a PE is not active, it cannot process next command as long as it
// does not receive the TD.

// data channel, one for H2D and the other for D2H
// CSL reports invalid color 31, so we use 32 as default value
//

param MEMCPYH2D_1 = {};  // 1-th H2D specified at runtime
param MEMCPYH2D_2 = {};  // 2-th H2D specified at runtime
param MEMCPYH2D_3 = {};  // 3-th H2D specified at runtime
param MEMCPYH2D_4 = {};  // 4-th H2D specified at runtime

param MEMCPYD2H_1 = {};  // 1-th D2H specified at runtime
param MEMCPYD2H_2 = {};  // 2-th D2H specified at runtime
param MEMCPYD2H_3 = {};  // 3-th D2H specified at runtime
param MEMCPYD2H_4 = {};  // 4-th D2H specified at runtime

param LAUNCH = {}; // RPC via memcpy streaming
                                      // LAUNCH must be a routable color, similar to H2D
                                      // because the user must define WTT for LAUNCH

// (first_pe, last_pe) is used in H2D and D2H to set up counter filter and switch
param first_pe: bool; // (0 == px);
param last_pe: bool;  // ((width-1) == px);

// When D2H finishes, sys.exit() is called which unblocks C22 and
// calls f_callback() which is the user's callback.
// if not specified, NOP (sys_nop)
param f_callback : fn ()void = sys_nop;

// Explicit DSR allocation
// The default value is 0
// The user can overwrite the default value
//
// NOTE: commands in C22 are serialized, including H2D, D2H and launch,
// so all commands can reuse the same microthreads and the same DSRs.
param dest_dsr_ids = [1]u16{0};
param src1_dsr_ids = [1]u16{0};

// width is also a parameter in memcpyh2d.csl and memcpyd2h.csl
// to decide the boundary of the routing
const rectangle = @get_rectangle();
const width : i16 = rectangle.width;


//
// system reserved colors, entrypoints, input/output queue in core rectangle
//
// routable colors:
//   - RXCOMMAND: command sequence from CMD fan
//   - MEMCPYH2D_DATA: forward all wavelets from demux to core
//   - MEMCPYD2H_DATA: aggregate all D2H data, to mux
//
// entrypoints:
//   - SYS_SEND_CTRL: sending task for D2H
//   - SYS_EXIT: unblock RXCOMMAND, receive next command
//   - SYS_UBLK_C22: unblock RXCOMMAND only when H2D finishes
//
// control wavelet triggered task:
//   - SYS_CMD_PUSH: receive parameters of host-callable API
//   - SYS_CMD_MEMCPYH2D: H2D command
//   - SYS_CMD_MEMCPYD2H: D2H command
//
// input queue: only used in H2D, memcpy, not streaming
// output queue: only used in D2H, both memcpy and streaming
// chunk: only support/test chunk = 1
//

const sys_params = @import_module( "<memcpy/sys_params>" );
const STACK_POS_MEMCPY = sys_params.STACK_POS_MEMCPY;

const MEMCPYH2D_DATA: color = sys_params.MEMCPYH2D_DATA;
const RXCOMMAND : color     = sys_params.RXCOMMAND;
const MEMCPYD2H_DATA: color = sys_params.MEMCPYD2H_DATA;

const SYS_SEND_CTRL: local_task_id  = sys_params.SYS_SEND_CTRL;
const SYS_EXIT: local_task_id       = sys_params.SYS_EXIT;
const SYS_UBLK_C22: local_task_id   = sys_params.SYS_UBLK_C22;

const SYS_CMD_PUSH: control_task_id = sys_params.SYS_CMD_PUSH;
const SYS_CMD_MEMCPYH2D: control_task_id = sys_params.SYS_CMD_MEMCPYH2D;
const SYS_CMD_MEMCPYD2H: control_task_id = sys_params.SYS_CMD_MEMCPYD2H;
const SYS_RPC: control_task_id = sys_params.SYS_RPC;
const SYS_CHECK_AND_IGNORE : control_task_id = sys_params.SYS_CHECK_AND_IGNORE;

// input queue only used in H2D
// output queue only used in both H2D and D2H
// H2D and D2H are serialized, so we can use the same ID for input queue and output queue
//
const input_queue_id: i16  = sys_params.input_queue_id;
const output_queue_id: i16 = sys_params.output_queue_id;

const chunk : i16 = sys_params.chunk;

// the parameters of H2D
// (1) c: streaming color
// (2) px
// (3) py
// (4) w
// (5) h
// (6) addr (device pointer)
// (7) pe_length
// (8) is_half (mov16)
// (9) memcpy_optype { MEMCPY_OP_DENSE = 0, MEMCPY_OP_ROW_BCAST = 1, MEMCPY_OP_COL_BCAST = 2, MEMCPY_OP_STRIDE = 3 }
// (10) row_stride
// (11) col_stride
// (12, 13) one_over_row_stride (f32)
// (14, 15) one_over_col_stride (f32)
const params_h2d = 15;

// the parameters of D2H
// only first 8 u16 of H2D
const params_d2h = 8;

////////////////////////////////////////////////////////////////////////////////
// Main memory (48KB)
////////////////////////////////////////////////////////////////////////////////

var memcpyH2D_c  : i16 = 0;
var memcpyH2D_px : i16 = 0;
var memcpyH2D_py : i16 = 0;
var memcpyH2D_w  : i16 = 0;
var memcpyH2D_h  : i16 = 0;
var memcpyH2D_addr : u16 = 0;
var memcpyH2D_pe_length : u16 = 0;
var memcpyH2D_is_half : u16 = 0;

var memcpyD2H_c  : i16 = 0;
var memcpyD2H_px : i16 = 0;
var memcpyD2H_py : i16 = 0;
var memcpyD2H_w  : i16 = 0;
var memcpyD2H_h  : i16 = 0;
var memcpyD2H_addr : u16 = 0;
var memcpyD2H_pe_length : u16 = 0;
var memcpyD2H_is_half : u16 = 0;
var memcpyH2D_memcpy_optype : i16 = 0;
var memcpyH2D_row_stride : i16 = 0;
var memcpyH2D_col_stride : i16 = 0;
var memcpyH2D_one_over_row_stride : f32 = @as(f32, 0);
var memcpyH2D_one_over_col_stride : f32 = @as(f32, 0);

const dest_dsr = @get_dsr(dsr_dest, dest_dsr_ids[0]);
const src1_dsr = @get_dsr(dsr_src1, src1_dsr_ids[0]);

////////////////////////////////////////////////////////////////////////////////
// DSDs
// data-structure descriptors (DSDs), loaded into data-structure registers (DSRs) to configure DSR
// The DSDs are typically put in their own data segment that is placed right above lo-mem.?
//
// Queues 0,1: input depth 6 wavelets
// Queues 2,3: input depth 4 wavelets
// Queues 4-7: input depth 2 wavelets
//
// queues 0,1: output depth 2 wavelets
// queues 2,3: output depth 6 wavelets
// queues 4,5: output depth 2 wavelets
//
// Length of an operand:
// The length of all other types of DSRs is specified by the length field of its DSD. When
// the bits encoding the length are 0x7fff, the length is infinite.
//
// Length of the vector instruction is then determined in the following order:
// 1. If src0 has a non-zero length, that length is used
// 2. If src1 has a non-zero length, that length is used
// 3. If dst has a non-zero length, that length is used
// 4. if no operands have length (all operands are GPR), length = 1
////////////////////////////////////////////////////////////////////////////////



////////////////////////////////////////////////////////////////////////////////
// Tasks
// syntax
//     task_begin(name, entrypoint, color)
////////////////////////////////////////////////////////////////////////////////

const sys_mod = @import_module( "<memcpy/wse2/sys>" , .{
  .RXACT_CMD=RXCOMMAND,
  .COLOR_PUSH=SYS_CMD_PUSH,
  .COLOR_SYS_EXIT=SYS_EXIT,
  .COLOR_SYS_CHECK_AND_IGNORE = SYS_CHECK_AND_IGNORE,
  //.first_pe=first_pe,
  .last_pe=last_pe,
  .width=width,
  .f_callback=f_callback } );

fn sys_nop() void {
    // do nothing
}


const memcpyh2d_mod_1 = @import_module( "<memcpy/wse2/memcpyh2d>" , .{
  .MEMCPYH2D_DATA=MEMCPYH2D_DATA,
  .USER_MEMCPYH2D_DATA_1=MEMCPYH2D_1,
  .USER_MEMCPYH2D_DATA_2=MEMCPYH2D_2,
  .USER_MEMCPYH2D_DATA_3=MEMCPYH2D_3,
  .USER_MEMCPYH2D_DATA_4=MEMCPYH2D_4,
  .input_queue_id=input_queue_id,
  .output_queue_id=output_queue_id,
  .dest_dsr_ids = dest_dsr_ids,
  .src1_dsr_ids = src1_dsr_ids,
  .first_pe=first_pe,
  .last_pe=last_pe,
  .width=width,
  .RXACT_CMD=RXCOMMAND,
  .SYS_UBLK_C22=SYS_UBLK_C22} );


const memcpyd2h_mod = @import_module( "<memcpy/wse2/memcpyd2h>" , .{
  .MEMCPYD2H_DATA=MEMCPYD2H_DATA,
  .USER_MEMCPYD2H_DATA_1=MEMCPYD2H_1,
  .USER_MEMCPYD2H_DATA_2=MEMCPYD2H_2,
  .USER_MEMCPYD2H_DATA_3=MEMCPYD2H_3,
  .USER_MEMCPYD2H_DATA_4=MEMCPYD2H_4,
  .SEND_CTRL=SYS_SEND_CTRL,
  .output_queue_id=output_queue_id,
  .dest_dsr_ids = dest_dsr_ids,
  .src1_dsr_ids = src1_dsr_ids,
  .chunk=1,
  .first_pe=first_pe,
  .last_pe=last_pe,
  .width=width,
  .callback=SYS_EXIT });


//------------  wrapper for sys.csl
//
// All commands are sequential, the current command retrieves the stack
// by dereferencing stack directly and clears the stack by resetting
// stack_last, so we don't need stack_top, stack_push and stack_pop.

fn block_cmd_stream() void {
    sys_mod.block_cmd_stream();
}

fn unblock_cmd_stream() void {
    sys_mod.unblock_cmd_stream();
}
//---------------------



const tile_config = @import_module("<tile_config>");

// H2D:
//  - cmd fan only sends TD to active rows.
//  - if PE is in inactive rows, the core has to unblock C22 explicitly
//    when H2D command is received.
fn teardown_h2d() void{
    // the H2D data is done, receive TD from the cmd fan
    // turn C21 back to teardown mode and proceed next command
    @activate(SYS_UBLK_C22);
}

// - the core receives H2D command
//   unblock SYS_UBLK_C22
// - the core finishes H2D and unblocks SYS_UBLK_C22 by
//   @mov32(fab_trans_wdsd_3, fab_recv_wdsd, .{.async=true, .unblock=SYS_UBLK_C22} );
//
// SYS_UBLK_C22 runs only if H2D finishes
task f_ublk_c22() void {
    unblock_cmd_stream();
}

// D2H:
//  - 1st PE of ROI sends TD to PEs in [px, end)
//  - if PE is in inactive rows, the core has to call sys.exit() explicitly
//    when D2H command is received.
//
fn teardown_d2h() void {
    // the D2H data is done, receive TD from the 1st PE of ROI
    // turn C23 back to teardown mode and proceed next command
    @activate(SYS_EXIT); // sys_exit() does
                         // - unblock C22
                         // - call user's callback (defined by f_callback)
}


// ---------------- the following is independent of number of inputs/outputs

// interface to trigger MEMCPYH2D when a command arrives
//
// memcpyH2D(color:int, px:int, py:int, w:int, h:int, h_A:np.ndarray, d_A:devicePtr, pe_length:int)
//    PUSH color
//    PUSH px
//    PUSH py
//    PUSH w
//    PUSH h
//    PUSH d_A
//    PUSH pe_length
//    MEMCPYH2D, 0    // ctrl MEMCPYD2H triggers f_memcpyH2D
//
task f_memcpyh2d() void {

    @assert(sys_mod.stack_last == params_h2d); // receive "params_h2d" uint16
    const stack = @ptrcast([*]u16, &sys_mod.stack_u32);

    var c : i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.C)]);
    var px : i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.PX)]);
    var py : i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.PY)]);
    var w : i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.W)]);
    var h : i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.H)]);
    var d_A : u16 = @bitcast(u16, stack[@get_int(STACK_POS_MEMCPY.ADDR)]);
    var pe_length : u16 = @bitcast(u16, stack[@get_int(STACK_POS_MEMCPY.PE_LENGTH)]);
    var is_half : u16 = @bitcast(u16, stack[@get_int(STACK_POS_MEMCPY.IS_HALF)]);
    var memcpy_optype: i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.MEMCPY_OPTYPE)]);
    var row_stride: i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.ROW_STRIDE)]);
    var col_stride: i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.COL_STRIDE)]);
    var one_over_row_stride: f32 = @bitcast(f32, @as(u32, stack[@get_int(STACK_POS_MEMCPY.INV_ROW_STRIDE_HI)]) << 16 + @as(u32, stack[@get_int(STACK_POS_MEMCPY.INV_ROW_STRIDE_LO)]));
    var one_over_col_stride: f32 = @bitcast(f32, @as(u32, stack[@get_int(STACK_POS_MEMCPY.INV_COL_STRIDE_HI)]) << 16 + @as(u32, stack[@get_int(STACK_POS_MEMCPY.INV_COL_STRIDE_LO)]));

    sys_mod.stack_last = 0; // clear stack, stack is empty

    memcpyH2D_c   = c;
    memcpyH2D_px  = px;
    memcpyH2D_py  = py;
    memcpyH2D_w  = w;
    memcpyH2D_h  = h;
    memcpyH2D_addr = d_A;
    memcpyH2D_pe_length = pe_length;
    memcpyH2D_is_half = is_half;
    memcpyH2D_memcpy_optype = memcpy_optype;
    memcpyH2D_row_stride = row_stride;
    memcpyH2D_col_stride = col_stride;
    memcpyH2D_one_over_row_stride = one_over_row_stride;
    memcpyH2D_one_over_col_stride = one_over_col_stride;

    sys_mod.block_cmd_stream(); // block C22

    // WARNING: H2D blocks SYS_UBLK_C22 in the beginning and only
    // unblocks SYS_UBLK_C22 when H2D finishes.
    // (if a PE is not in the ROI, it unblocks SYS_UBLK_C22)
    @block(SYS_UBLK_C22);

    // case 1: inactive row
    //   - keep C21 in teardown mode
    //   - unblock C22 explicitly
    // case 2: active row, inactive PE
    //   - clear TIP in order to forward the broadcast data
    //   - DO NOT unblock C22 (TD will unblock C22)
    // case 3: active row, active PE
    //   - reconfigure the filter
    //   - clear TIP
    //   - DO NOT unblock C22 (TD will unblock C22)
    memcpyh2d_mod_1.h2d_configure(
            c,
            px,
            py,
            w,
            h,
            d_A,
            pe_length,
            is_half,
            memcpyH2D_memcpy_optype,
            memcpyH2D_row_stride,
            memcpyH2D_col_stride,
            memcpyH2D_one_over_row_stride,
            memcpyH2D_one_over_col_stride);
}


// memcpyD2H(color:int, px:int, py:int, w:int, h:int, d_A:devicePtr, h_A:np.ndarray, pe_length:int)
//    PUSH color
//    PUSH px
//    PUSH py
//    PUSH w
//    PUSH h
//    PUSH d_A
//    PUSH pe_length
//    MEMCPYD2H, 0    // MEMCPYD2H triggers f_memcpyD2H
//
// Then we only have the following colors for memcpy
// color 0~23: routable
// 21: RXCOMMAND
// 22: MEMCPYH2D_DATA
// 23: MEMCPYD2H_DATA
//
// color 24~30: entrypoints
// 29: teardown (reserved)
// 30: SYS_EXIT
// 31: no color (reserved)
//
task f_memcpyd2h() void {

    @assert(sys_mod.stack_last == params_d2h); // receive "params_d2h" uint16
    const stack = @ptrcast([*]u16, &sys_mod.stack_u32);

    var c : i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.C)]);
    var px : i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.PX)]);
    var py : i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.PY)]);
    var w : i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.W)]);
    var h : i16 = @bitcast(i16, stack[@get_int(STACK_POS_MEMCPY.H)]);
    var d_A : u16 = @bitcast(u16, stack[@get_int(STACK_POS_MEMCPY.ADDR)]);
    var pe_length : u16 = @bitcast(u16, stack[@get_int(STACK_POS_MEMCPY.PE_LENGTH)]);
    var is_half : u16 = @bitcast(u16, stack[@get_int(STACK_POS_MEMCPY.IS_HALF)]);

    sys_mod.stack_last = 0; // clear stack, stack is empty

    memcpyD2H_c   = c;
    memcpyD2H_px  = px;
    memcpyD2H_py  = py;
    memcpyD2H_w  = w;
    memcpyD2H_h  = h;
    memcpyD2H_addr = d_A;
    memcpyD2H_pe_length = pe_length;
    memcpyD2H_is_half = is_half;

    sys_mod.block_cmd_stream(); // block C22

    // definition of "routing PEs":
    // the PEs that are to the EAST of the ROI would still need to
    // forward the data to mux which is to the EAST of the core PEs.
    // Therefore we define the set of "routing PEs" as the PEs
    // included in a rectangle that is the extension of the ROI rectangle
    // to the EAST.

    // case 1: PE in "routing PEs", p.x >= px,  py <= p.y < py + h
    //   - reconfigure the switch
    //   - clear TIP
    //   - send data/ctrl pair, only unblock C22 when D2H is done.
    // case 2: PE not in "routing PEs", p.x < px or p.y is not in [py, py+h)
    //   - DO NOT clear TIP, C23 still in teardown mode
    //   - call sys.exit() to unblock C22 and calls user's callback
    memcpyd2h_mod.d2h_configure(c, px, py, w, h, d_A, pe_length, is_half);
}


var fab_trans_wdsd = @get_dsd(fabout_dsd, .{
    .extent = 1,
    .fabric_color = LAUNCH,
    .output_queue = @get_output_queue(output_queue_id)
});

const dummy = @zeros([1]f32);
var mem_stack_buf_dsd  = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> dummy[i] });

extern fn rpc_server([*]const u32) void;

// protocol of RPC
//   +---------------------+
//   | # of wvlts          | 1st wavelet
//   +---------------------+
//   | param 1             | 2nd wavelet
//   +---------------------+
//   | param 2             | 3rd wavelet
//   +---------------------+
//   | param 3             | 4th wavelet
//   +---------------------+
//   | ...                 |
//   +---------------------+
//   | ID of the function  | last wavelet
//   +---------------------+
//
// The RPC at least have 2 uint32
//   - # of wvlts
//   - ID of the function
//
// The command wavelet is index=RPC, data=color
// color must be LAUNCH
//
// We may also use
// index = RPC, data = {color, num_wvlts}
//
// TODO: if we change the behavior of stack_last
//   we must update f_rpc
//
// TODO: the user has to define WTT on color "LAUNCH"
//
task f_rpc( wtt_c: i16) void {
    // stack_last is valid from 0 to _STACK_SIZE-1
    // stack_last = 0 implies stack is empty
    // stack[stack_last-1] is the last element
    // stack_last is number of uint16

    sys_mod.block_cmd_stream();

    // WARNING: RPC only sends uint32, so stack_last must be even
    // WARNING: RPC have at least two uint32, so stack_last >= 4
    // WARNING: stack_last is number of uint16
    //          (stack_last/2) is the number of uint32 sent by RPC
    @assert(sys_mod.stack_last >= 4);

    // wtt_c is don't care because the LAUNCH color is no longer
    // required.
    rpc_server(&(sys_mod.stack_u32));

    sys_mod.stack_last = 0; // stack is empty
}

comptime {
    @__internal_rpc(rpc_server);
}

comptime {

    // keep C29 unblocked, memcpy does not block/unblock C29
    @unblock(tile_config.teardown.get_task_id());

    @bind_control_task( f_memcpyh2d, SYS_CMD_MEMCPYH2D);
    @bind_control_task( f_memcpyd2h, SYS_CMD_MEMCPYD2H);
    @bind_control_task( f_rpc, SYS_RPC);
    @bind_local_task( f_ublk_c22, SYS_UBLK_C22);
}

// bind H2D/D2H teardown handler to T29
comptime {
    @set_teardown_handler(teardown_h2d, MEMCPYH2D_DATA);
    @set_teardown_handler(teardown_d2h, MEMCPYD2H_DATA);
}

comptime {
    if (!@is_same_type(@type_of(LAUNCH), void)){
        @set_local_color_config(LAUNCH, .{ .routes = .{ .rx = .{RAMP}, .tx = .{RAMP} } } );
    }
}

fn get_h2d_task_id() data_task_id {
    @comptime_print("WSE2 does not support get_h2d_task_id(), please use --arch=wse3");
    @comptime_assert(false);
}

fn get_lock_h2d_task_id() local_task_id {
    @comptime_print("WSE2 does not support get_lock_h2d_task_id(), please use --arch=wse3");
    @comptime_assert(false);
}
