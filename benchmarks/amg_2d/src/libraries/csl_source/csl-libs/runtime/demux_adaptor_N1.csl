
//
// special version of demux adaptor when N = 1 (height = 1 )
//
// The runtime only issues the H2D command when the H2D is not empty, so
// there is no need for filter
//
//
//  FABRIC_H2D_DATA  +----------+  GC_RXACT_DEMUX        +--------+  GC_TXACT_DEMUX    +---------+
// ------------->    | demux    | ---------------------> | demux  | -----------------> | CMD fan |
//                   | adaptor  |                        |        |                    |         |
//                   +----------+                        +--------+                    +---------+
//


// demux adaptor
//
//     +---------------+     +--------+     +-------------+
//     | demux adaptor | --> | demux  | --> | CMD fan     |
//     +---------------+     +--------+     +-------------+
//
// The demux adaptor reads data into a buffer first, and then writes it out
// The purpose of this addition buffer is to remove the backpressure from halo,
// i.e. backpressure of halo only affects the timing of demux
//
//
//
// Adapter for demux kernel sends teardowns and configuration sentinels to the
// demux kernel before each received tensor. The adapter receives a header from
// the driver on each channel with this format:
//  struct {
//      u16 enable_receiver[N];
//      u16 pes_per_receiver;
//      u16 pe_length;
//  };
// Each demux receives from one LVDS channel and sends to N columns of PEs in
// the core kernel. enable_receiver[i] is a boolean value indicating whether
// the ith receiver gets any data for the next tensor. The pes_per_receiver
// field represents the number of PEs receiving data in each column of the
// core kernel. pe_length is the number of wavelets received by each individual
// PE in the core for the next tensor.
//
// This adapter performs the following steps upon receiving a header for the
// next tensor:
// 1. Sends a teardown with NOCE bit to the demux kernel.
// 2. Sends config parameters, including
//   - enable_receiver[i]
//   - pes_per_receiver
//   - pe_length
//   - number of receivers
// 3. Sends another teardown with the NOCE bit to the demux kernel.
// 4. Begins streaming data for the next tensor with total length equal to
//    sum(enable_receiver) * pes_per_receiver * pe_length.
//


// control flow
//  f_startup: read config parameters
//  --> f_config: compute offset of each active receiver
//  --> f_txtd0_done: send config_buf[N+3]
//  --> f_txtd1_done: prepare the loop to send out the data
//  --> f_rxdone: send out data
//

// local colors
param RXACT: color; // receive data from LVDS
                    // interleave data cmd and data
param TXACT: color; // send data to demux

// local tasks
param STARTUP: local_task_id; // receive config parameter of next tensor
param CONFIG: local_task_id;  // recompute enable_tensor[N]
param TXTD0_DONE: local_task_id;
param TXCFG3_DONE: local_task_id; // unused
param TXTD1_DONE: local_task_id;
param RXDONE: local_task_id;

// parameters
param N: i16; // number of receivers in demux

// bind RXACT to input queue 0
const iq_rxact = @get_input_queue(0);

const oq_txact = @get_output_queue(2);

const task_id_rxact = if (@is_arch("wse3")) @get_data_task_id(iq_rxact) else @get_data_task_id(RXACT);

//
// The host sends N+7 i16, including
// - enable_receiver[0:N-1]
// - N: pes_per_receiver,
// - N+1: pe_length
// - N+2: dsd_length
// - N+3: num_iters (num_send)
// - N+4: r (dsd_length_r)
// - N+5: is_add(=0)
// - N+6: memcpy_optype
//
// N+7 i16 are packed into i32 wavelet, so the host may do zero extension if
// N+7 is not even.
// Here we compute Np7_even>=N+7 is an even number
//
// example 1: N=3
//   Np7 = 9, Np7_div_2=5, Np7_even=10
// example 2: N=4
//   Np7 = 10, Np7_div_2=5, Np7_even=10
const Np7 = N+7;
const Np7_div_2 = (Np7+1)/2;
const Np7_even = 2*Np7_div_2;


////////////////////////////////////////////////////////////////////////////////
// Main memory (48KB)
////////////////////////////////////////////////////////////////////////////////

// The demux adaptor receives the following N+7 u16 from the host
//   u16 enable_receiver[0:N-1] = config_buf[0:N-1]
//   u16 pes_per_receiver = config_buf[N]
//   u16 pe_length = config_buf[N+1]
//   u16 dsd_length = config_buf[N+2]
//   u16 num_send = config_buf[N+3]
//   u16 dsd_length_r = config_buf[N+4]
//   u16 is_odd = config_buf[N+5]
//   u16 memcpy_optype = config_buf[N+6]
// then computes prefix_sum(enable_receiver[0:N-1]) and resets
//   config_buf[N+2] = num_receivers[0]
//   config_buf[N+3] = memcpy_optype
//
// It sends the following N+4 u16 parameters to demux
//   enable_receiver[N] = config_buf[0:N-1]
//   pes_per_receiver = config_buf[N]
//   pe_length = config_buf[N+1]
//   num_receivers = config_buf[N+2]
//   memcpy_optype = config_buf[N+3]
//
var config_buf_i32 = @zeros([Np7_even+1]i32);

var num_receivers = @zeros([1]i16);

var pes_per_receiver : i16 = 0;
var pe_length : i16 = 0;

// (dsd_length, num_send, dsd_length_r) is used to send the data
//   number of wavelets = dsd_length * num_send + dsd_length_r
//
//   for j in range(num_send):
//      send dsd_length wavelets via microthread
//   end
//   send dsd_length_r wavelets via microthread

//--- EXTRA PARAMS
var idx_send : u16 = 0;

var dsd_length: u16 = 0;
var num_send : u16 = 0;
var dsd_length_r: u16 = 0;

var is_odd: u16 = 0;
var memcpy_optype: u16 = 0;

// state = 0: process dsd_length_r
// state = 1: read config params of next tensor
var state : i16 = 0;
//--- END

////////////////////////////////////////////////////////////////////////////////
// DSDs
// data-structure descriptors (DSDs), loaded into data-structure registers (DSRs)
//
// Queues 0,1: input depth 6 wavelets
// Queues 2,3: input depth 4 wavelets
// Queues 4-7: input depth 2 wavelets
//
// queues 0,1: output depth 2 wavelets
// queues 2,3: output depth 6 wavelets
// queues 4,5: output depth 2 wavelets
////////////////////////////////////////////////////////////////////////////////



// The input data is uint32, and we copy to uint16 config_buf
// This only works if config_buf aligns to int32 boundary (2 words)
//
// WARNING: if the alignment does not work, we need extra buffer,
//   config_buf_uint32[Np7_div_2]
// then copy config_buf_uint32 to config_buf
//
const gdsr_rxcfg_s1 =  @get_dsd(fabin_dsd, .{
   .extent = Np7_div_2,
   .fabric_color = RXACT,
   .input_queue = iq_rxact
});


// DSR for receiving data
var gdsr_rxact_s1 =  @get_dsd(fabin_dsd, .{
   .extent = 1,
   .fabric_color = RXACT,
   .input_queue = iq_rxact
});

// DSR for transmitting data
var gdsr_txact_dst = @get_dsd(fabout_dsd, .{
    .extent = 1,
    .fabric_color = TXACT,
    .output_queue = oq_txact
});


// the length Np7_div_2 is independent of data type of config_buf_i32
// it depends on the instruction mov16 or mov32
// we use mov32 for mem_buf_config_dsd, so it needs Np7_div_2 wavelets
const mem_buf_config_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Np7_div_2} -> config_buf_i32[i] });

// However we use mov16 for mem_buf_config_np4_dsd, so it trasmits N+4 i16
const mem_buf_config_np4_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N+4} -> config_buf_i32[i] });

// we use mov16 for fab_tx_config_dst, so it trasmits N+4 i16
const fab_tx_config_dst = @get_dsd(fabout_dsd, .{
    .extent = N+4,
    .fabric_color = TXACT,
    .output_queue = oq_txact
});

////////////////////////////////////////////////////////////////////////////////
// Tasks
// syntax
//     task_begin(name, entrypoint, color)
////////////////////////////////////////////////////////////////////////////////


task f_startup() void {
    // Begin receiving config header for next tensor
    // The data cmd is packed N+2 i16 into 32-bit wavelets
    //    - receivers[N]
    //    - pes_per_receiver
    //    - pe_length
    //    - dsd_length
    //    - num_send
    //    - dsd_length_r
    //    - is_odd
    //    - memcpy_optype
    // runtime has to do zero extension such that Np7_div_2 wavelets holds N+7 i16
    @mov32(mem_buf_config_dsd, gdsr_rxcfg_s1, .{.async=true, .activate=f_config} );
}


// preliminary: receive the config parameters from fabric
// - enable_receiver[N] = config_buf[0:N-1]
// - pes_per_receiver = config_buf[N]
// - pe_length = config_buf[N+1]
// - dsd_length = config_buf[N+2]
// - num_send = config_buf[N+3]
// - dsd_length_r = config_buf[N+4]
// - is_odd = config_buf[N+5]
// - memcpy_optype = config_buf[N+6]
//
// computation:
// - prefix_sum(enable_receiver[N])
// - pes_per_receiver is not modified
// - pe_length is not modified
// - num_receivers = sum{enable_receiver[N]}
// - send 1st teardown to the demux
//
// Example 1: enable_receivers[4] = {1,1,1,1}
//   prefix_sum(enable_receiver[N]) = {0,1,2,3}
//   num_receivers = 4
// Example 2: enable_receivers[4] = {0,1,1,1}
//   prefix_sum(enable_receiver[N]) = {-1,0,1,2}
//   num_receivers = 3
// Example 3: enable_receivers[4] = {0,1,1,0}
//   prefix_sum(enable_receiver[N]) = {-1,0,1,-1}
//   num_receivers = 2
//
task f_config() void {
    // Compute prefix sum of enable bits to represent the receiver order
    // PEs which don't receive get a value of 0xffff (-1)
    // Use the final value as the number of receivers for tracking DSR

    var config_buf : [*]i16 = @ptrcast([*]i16, &config_buf_i32);

    dsd_length = @bitcast(u16, config_buf[N+2]);
    num_send = @bitcast(u16, config_buf[N+3]);
    dsd_length_r = @bitcast(u16, config_buf[N+4]);
    is_odd = @bitcast(u16, config_buf[N+5]);
    memcpy_optype = @bitcast(u16, config_buf[N+6]);

    // (1) update enable_receiver[N]
    // enable_receiver[0:N-1] = config_buf[0:N-1]
    // prefix_sum(enable_receiver[N])
    var row : i16 = 0;
    var r_length: i16 = 0;
    while(row < N) : (row +=1) {
        var r_enable : i16 = config_buf[row];
        var r_order : i16 = r_length;
        if ( 0 == r_enable ){
            r_order = -1; // "row" receiver is off
        }
        config_buf[row] = r_order;
        r_length = r_length + r_enable;
    }

    // (2) num_receivers = sum{ enable_receivers[N] }
    // receiver_loop_done:
    // mov16 [num_receivers] = r_length
    num_receivers[0] = r_length;

    // record pes_per_receiver, pe_length to increase readability
    // WARNING: pes_per_receiver = config_buf[N] is not changed
    // WARNING: pe_length = config_buf[N+1] is not changed
    pes_per_receiver = config_buf[N];
    pe_length = config_buf[N+1];

    // (3) append num_receivers back to config_buf
    config_buf[N+2] = num_receivers[0];

    // (4) append memcpy_optype back to config_buf
    config_buf[N+3] = @bitcast(i16, memcpy_optype);

    // (5) Send config parameters to demux
    @activate(TXTD0_DONE);
}


// send config parameters
//    {enable_receiver[N], pes_per_receiver, pe_length, num_receivers}
// with callback TXCFG3_DONE
//
task f_txtd0_done() void {

    @mov16(fab_tx_config_dst, mem_buf_config_np4_dsd, .{.async=true, .activate=f_txtd1_done} );
}

task f_txtd1_done() void {

    if (0 == num_receivers[0]){
// no active receivers, continue next tensor
// skip_forwarding:
        // recv config header for next tensor
        @mov32(mem_buf_config_dsd, gdsr_rxcfg_s1, .{.async=true, .activate=f_config} );
    }else{
        gdsr_rxact_s1  = @set_dsd_length(gdsr_rxact_s1,  dsd_length);
        gdsr_txact_dst = @set_dsd_length(gdsr_txact_dst, dsd_length);
        // num_send is received from config header
        idx_send = 0;
        @activate(RXDONE);
    }
}


// pseudocode
// for i in range(num_receivers):
//    for j in range(pes_per_receiver):
//       send pe_length wavelets via microthread
//
task f_rxdone() void {
    if ( idx_send >= num_send ){
        if (0 == state){
            // process dsd_length_r
            if ( 0 == dsd_length_r ){
                @activate(RXDONE);
            }else{
                gdsr_rxact_s1  = @set_dsd_length(gdsr_rxact_s1,  dsd_length_r);
                gdsr_txact_dst = @set_dsd_length(gdsr_txact_dst, dsd_length_r);
                @mov32(gdsr_txact_dst, gdsr_rxact_s1, .{.async=true, .activate=f_rxdone} );
            }
            state = 1;
        }else{
            // recv config header for next tensor
            @mov32(mem_buf_config_dsd, gdsr_rxcfg_s1, .{.async=true, .activate=f_config} );
            state = 0;
        }
    }else{
        // idx_send = 0:(num_send-1)
        // send pe_length wavelets by a microthread
        @mov32(gdsr_txact_dst, gdsr_rxact_s1, .{.async=true, .activate=f_rxdone} );
        idx_send = idx_send + 1;
    }
}


comptime {

    @comptime_assert( 1 == N );

    @activate(STARTUP);
    @block(task_id_rxact); // use microthread

    @bind_local_task( f_startup, STARTUP);
    @bind_local_task( f_config, CONFIG);
    @bind_local_task( f_txtd0_done, TXTD0_DONE);
    @bind_local_task( f_txtd1_done, TXTD1_DONE);
    @bind_local_task( f_rxdone, RXDONE);

    if (@is_arch("wse3"))
      @initialize_queue(oq_txact, .{.color = TXACT});
}

//         +---------------+
//  c0 --> | demux adaptor | --> c1
//         +---------------+
// where
//    c0 = RXACT (data cmd and data)
//    c1 = TXACT
//
comptime {
    @set_local_color_config(RXACT, .{ .routes = .{ .rx = .{WEST}, .tx = .{RAMP} } } );
    @set_local_color_config(TXACT, .{ .routes = .{ .rx = .{RAMP}, .tx = .{EAST} } } );
}

// WTT must bind to an input queue
comptime {
    @initialize_queue(iq_rxact, .{.color = RXACT} );
}
