// Ref: monolith/src/ucode/kernels/lib/routing_funcs.casm
//
// index[6:8] has the following configuration
// 000 = NOP + CE
// 001 = Switch advance + CE
// 010 = Switch reset + CE
// 011 = Teardown  + CE
// 100 = NOP + NOCE
// 101 = Switch advance + NOCE
// 110 = Switch reset + NOCE
// 111 = Teardown + NOCE


// These are switch commands that tell the receiving router to either do nothing
// or advance the switch position.
const sw_nop = 0;
const sw_adv = 1;
const sw_reset = 2;
const sw_td  = 3;


// This function computes the payload field of the control wavelet.  The `cmds`
// argument contains the switch commands for seven downstream PEs.
//
// 32-bit control wavelet, sepatately into index field and data field, 16-bit each.
// It contains 8 commands in data field and index[13:6]
//
// When control wavelet pops one command, the outgoing control wavelet is modified
// as follows:
//     index = {index[15:14], data[2:0], index[13:9], index[5:0]}
//     data = {3'b100, data[15:3]}
//
// 3'b100 means "NOP + NOCE", it does not affect the router and does not enter the RAMP.
// index[15:14] is never changed
// index[15] = 1 for control wavelet (should be set by fanout_dsd with ".control = true")
// index[14] = local flip, which is 0 in this case
//
fn ctrl(cmds: [8]u16) u32 {
  // Tell the router to not forward control wavelets to the PE.
  // so called NOCE control wavelet
  const ceFilter = true;

  // Color 31 is special.  It is the hardware's way of saying null color.
  // index[0:5] = 6'b011111
  const colorToActivate = 31;

  var result: u32 = 0;
  result |= (colorToActivate & 0x1f) << 16;

  result |= @as(u32, cmds[0] & 0b11) << 22;
  result |= @as(u32, ceFilter) << 24;

  result |= @as(u32, cmds[1] & 0b11) << 25;
  result |= @as(u32, ceFilter) << 27;

  result |= @as(u32, cmds[2] & 0b11) << 28;
  result |= @as(u32, ceFilter) << 0;

  result |= @as(u32, cmds[3] & 0b11) << 1;
  result |= @as(u32, ceFilter) << 3;

  result |= @as(u32, cmds[4] & 0b11) << 4;
  result |= @as(u32, ceFilter) << 6;

  result |= @as(u32, cmds[5] & 0b11) << 7;
  result |= @as(u32, ceFilter) << 9;

  result |= @as(u32, cmds[6] & 0b11) << 10;
  result |= @as(u32, ceFilter) << 12;

  result |= @as(u32, cmds[7] & 0b11) << 13;
  result |= @as(u32, ceFilter) << 15;

  return result;
}


// 1st PE (PE starts transmission) does not change its switch, only change switch of next PE
fn switch_cmd_01() [8]u16 {

  var cmds = @constants([8]u16, sw_nop);
  //cmds[0] = sw_adv; // does not change switch of current PE
  cmds[1] = sw_adv;

  return cmds;
}


// This computes the (first) control wavelet, which advances the switch position
// at (1) the current PE's router, (2) the next PE's router
fn switch_cmd_11() [8]u16 {

  var cmds = @constants([8]u16, sw_nop);
  cmds[0] = sw_adv;
  cmds[1] = sw_adv;

  return cmds;
}


// Last PE only change the switch of itself
fn switch_cmd_1() [8]u16 {

  var cmds = @constants([8]u16, sw_nop);
  cmds[0] = sw_adv;

  return cmds;
}


// cmd1 = teardown + NOCE
// cmdj = NOP + NOCE
fn teardown_cmd_1() [8]u16 {

  var cmds = @constants([8]u16, sw_nop);
  cmds[0] = sw_td;

  return cmds;
}


// cmd1 = reset + NOCE
// cmdj = NOP + NOCE
fn reset_cmd_1() [8]u16 {

  var cmds = @constants([8]u16, sw_nop);
  cmds[0] = sw_reset;

  return cmds;
}
