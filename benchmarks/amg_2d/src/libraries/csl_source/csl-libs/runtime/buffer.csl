
// store the input data into fifo
//
//
//     RXACT  +--------+
//     -->    |        | --> TXACT
//            +--------+
//

param RXACT: color ; // data from west
param TXACT: color ; // data to east

param STARTUP: local_task_id; // entrypoint, color >= 24

const max_fifo_len = 256*46; // maximum length of the fifo, the unit is u32

const iq_rxact = @get_input_queue(0);
const task_id_rxact = if (@is_arch("wse3")) @get_data_task_id(iq_rxact) else @get_data_task_id(RXACT);

const oq_txact = @get_output_queue(1);

////////////////////////////////////////////////////////////////////////////////
// Main memory (48KB)
////////////////////////////////////////////////////////////////////////////////

var fifo_buffer = @zeros([max_fifo_len]u32);
const fifo = @allocate_fifo(fifo_buffer);

////////////////////////////////////////////////////////////////////////////////
// DSDs
// data-structure descriptors (DSDs), loaded into data-structure registers (DSRs) to configure DSR
//
// Queues 0,1: input depth 6 wavelets
// Queues 2,3: input depth 4 wavelets
// Queues 4-7: input depth 2 wavelets
//
// queues 0,1: output depth 2 wavelets
// queues 2,3: output depth 6 wavelets
// queues 4,5: output depth 2 wavelets
////////////////////////////////////////////////////////////////////////////////

// The length of all other types of DSRs is specified by the length field of its DSD.
// When the bits encoding the length are 0x7fff, the length is infinite.

// redirect data to fifo
// ctrl wavelets are excluded from core because they are NOCE
var fab_recv_wdsd = @get_dsd(fabin_dsd, .{
   .extent = 0x7fff,
   .fabric_color = RXACT,
   .input_queue = iq_rxact
});

// f_startup() sets length=inf
// redirect data out of fifo
var fab_trans_wdsd = @get_dsd(fabout_dsd, .{
    .extent = 0x7fff,
    .fabric_color = TXACT,
    .output_queue = oq_txact
});


////////////////////////////////////////////////////////////////////////////////
// Tasks
// syntax
//     task_begin(name, entrypoint, color)
////////////////////////////////////////////////////////////////////////////////

task f_startup() void {

    @mov32(fifo, fab_recv_wdsd, .{.async=true} );

    @mov32(fab_trans_wdsd, fifo, .{.async=true} );
}


comptime {

    @activate(STARTUP);

    // use UT0 to read data into fifo
    @block( task_id_rxact );

    @bind_local_task( f_startup, STARTUP);
}

comptime {
    @initialize_queue(iq_rxact, .{.color = RXACT} );
}

comptime {
    @set_local_color_config(RXACT, .{ .routes = .{ .rx = .{WEST}, .tx = .{RAMP} } } );
    @set_local_color_config(TXACT, .{ .routes = .{ .rx = .{RAMP}, .tx = .{EAST} } } );
}

comptime {
    if (@is_arch("wse3")){
        @initialize_queue(oq_txact, .{.color = TXACT});
    }
}
