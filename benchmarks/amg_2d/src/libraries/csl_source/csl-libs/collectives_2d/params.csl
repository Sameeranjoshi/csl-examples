// Compile-time component of the `collectives_2d` library

// This is a hack, but currently the only way to read from anonymous fields
const anon_fields = [4]comptime_string{ "0", "1", "2", "3" };

fn pack_ids(ids: comptime_struct, color_field: comptime_string, entrypt_field: comptime_string) comptime_struct {

    // If the user has not asked for `x_colors` + `x_entrypoints` or `y_colors` + `y_entrypoints`,
    // we simply return a struct with a `present = false` field: this particular dimension of the
    // library will not be usable
    if (!@has_field(ids, color_field)) {
        return .{ .present = false };
    } else if (!@has_field(ids, entrypt_field)) {
        return .{ .present = false };
    }

    const colors = @field(ids, color_field);
    const entrypts = @field(ids, entrypt_field);
    return .{ .DATA_COLOR_0 = @field(colors, anon_fields[0]), .DATA_COLOR_1 = @field(colors, anon_fields[1]), .ACTIVATE_FSM_TASK_ID = @field(entrypts, anon_fields[0]), .C_LOCK = @field(entrypts, anon_fields[1]), .present = true };
}

// This is a user-facing function that is called at compile-time to obtain
// the relevant parameter struct for a given PE without including the
// actual Px and Py values (and generating a lot of ELF files)
fn get_params(Px: u16, Py: u16, ids: comptime_struct, current_layer_params: comptime_struct) comptime_struct {
    const x_ids = pack_ids(ids, "x_colors", "x_entrypoints");
    const y_ids = pack_ids(ids, "y_colors", "y_entrypoints");

    const x_dirs = .{ .POS_DIR = EAST, .NEG_DIR = WEST };
    const y_dirs = .{ .POS_DIR = SOUTH, .NEG_DIR = NORTH };

    const layer_start_x = @as(u16, current_layer_params.layer_start_x);
    const layer_start_y = @as(u16, current_layer_params.layer_start_y);
    const layer_end_x = @as(u16, current_layer_params.layer_end_x);
    const layer_end_y = @as(u16, current_layer_params.layer_end_y);
    const layer_kernel_rows = @as(u16, current_layer_params.layer_kernel_rows);
    const layer_kernel_cols = @as(u16, current_layer_params.layer_kernel_cols);

    const width = layer_kernel_cols;
    const x_dim_info = .{
        .pe_min = (Px == layer_start_x),
        .pe_max = (Px == (layer_end_x - 1)),
        .NUM_PES = width,
        .DIM_ID = 0, // x-dimension has an ID of 0
    };

    const height = layer_kernel_rows;
    const y_dim_info = .{
        .pe_min = (Py == layer_start_y),
        .pe_max = (Py == (layer_end_y - 1)),
        .NUM_PES = height,
        .DIM_ID = 1, // y-dimension has an ID of 1
    };

    return .{
        .x = @concat_structs(x_ids, @concat_structs(x_dirs, x_dim_info)),
        .y = @concat_structs(y_ids, @concat_structs(y_dirs, y_dim_info)),
    };
}
