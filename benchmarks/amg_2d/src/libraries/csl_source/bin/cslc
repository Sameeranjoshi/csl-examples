#!/usr/bin/env python3
"""
Frontend for cslc-driver. Creates a directory and then calls
cslc-driver which will write its output files to the created directory.
Options that are not specifically recognized are forwarded to cslc-driver.
"""
import argparse
import logging
import os
import re
import subprocess
import sys
from collections import namedtuple
from pathlib import Path
from shlex import quote
from shutil import rmtree
from typing import Dict, List, Optional, Tuple
from math import ceil

from cerebras.elf.cself import ELFMemory

Rectangle = namedtuple('Rectangle', ['x', 'y', 'w', 'h'])

elf_dir_name = Path("bin")
out_file_name = "out"
num_colors = 21
max_memcpy_channels = 16

# config_wvlt array always ends with rect width, elt_per_pe, 3 DSD config
# wavelets, and (for D2H) an is-odd flag
base_config_wvlt_size = 6

def _get_fabric_and_kernel_dims(elf_list: List[str]) -> Tuple[Rectangle, str, Rectangle]:
  """
  Get the fabric and kernel dimensions from the user's generated binaries.
  """
  elfs = ELFMemory(*elf_list)

  fab_w, fab_h = elfs.get_fabric_dimensions()
  fabric = Rectangle(0, 0, fab_w, fab_h)

  # is there a target architecture implied by `$CS_TARGET`?
  target = os.environ.get("CS_TARGET")

  this_target = elfs.get_target().abbreviation
  if target is None:
    target = this_target
  elif target != this_target:
    raise RuntimeError(f"mismatched target architectures '{target}' and '{this_target}'")

  extent = elfs.get_extent()
  kernel = Rectangle(*extent[0], *extent[1])

  return fabric, target, kernel

def _generate_memcpy(driver_path: Path, params_list: Optional[str],
                     import_path: Optional[str], dirname: Path, n_channels: int,
                     width_west_buf: int, width_east_buf: int):
  """
  Get fabric and kernel dimensions from the kernel binaries that the user
  asked us to compile. Assign the memcpy routing colors from the set of
  available colors not used by in/out tensors. Issue the compile commands.
  """
  # Get the other bins we just compiled
  elf_list = dirname.glob("bin/*elf")

  fabric, target, kernel = _get_fabric_and_kernel_dims(elf_list)

  arch = "wse2"
  if target == "EIN":
    arch = "wse1"
  if target == "SDR":
    arch = "wse3"

  if not (kernel.x >= 4 + width_west_buf and kernel.y >= 1):
    raise RuntimeError("The core must have --fabric-offsets=4+width_west_buf,1")

  if not (fabric.w > 0 and fabric.h > 0 and kernel.w > 0 and kernel.h > 0):
    raise RuntimeError(
        "Fabric and ELF/Kernel Dimensions must all be > 0 - " \
        f"fabric w,h = {fabric.w},{fabric.h}; kernel w,h = {kernel.w},{kernel.h}." \
      )

  if n_channels > kernel.h:
    raise RuntimeError("Can not have more memcpy channels than kernel rows")

  if n_channels > max_memcpy_channels:
    raise RuntimeError(f"Channel count must be less than {max_memcpy_channels}")

  # fabric-dims must cover the core and infrastructure
  bound_x = kernel.x - 3 - width_west_buf + kernel.w + 5 + 1 + width_west_buf + width_east_buf
  bound_y = kernel.y + kernel.h + 1

  if bound_x > fabric.w or bound_y > fabric.h:
    raise RuntimeError(f"Fabric dimension must be at least {bound_x}-by-{bound_y}")

  # find the input/output colors from the user's compile command line
  c_h2d = []
  c_d2h = []
  pdict = _split_params_string(params_list)
  for key, value in pdict.items():
    match = re.search(r"MEMCPY(H2D|D2H)_DATA_\d+_ID", key)
    if match:
      if match.group(1) == "H2D":
        c_h2d.append(int(value))
      else:
        c_d2h.append(int(value))

  bin_dir_path_east, persist_dir_path_east = _make_output_dir(dirname / "east")
  bin_dir_path_west, persist_dir_path_west = _make_output_dir(dirname / "west")

  # Given our own location, find the lib dir
  cslc_bin_dir = driver_path.parent # path/to/install/bin/
  cslc_dir = cslc_bin_dir.parent # path/to/install/
  # this path is for memcpy kernel only
  if import_path is not None:
    libs_base = import_path
  else:
    libs_base = cslc_dir / "csl-libs" # path/to/install/csl-libs

  memcpy_file_east = libs_base / "runtime/layout_east_mux_multi.csl"
  memcpy_file_west = libs_base / "runtime/layout_west_demux_cmdfan_multi.csl"

  # assign the memcpy colors
  # new memcpy implementation h2d/d2h data channel colors must be distinct from
  # the named colors. no other restrictions.
  color_dict = {}
  color_dict["FABRIC_CMD_ID"] = 0
  color_dict["GC_RXACT_DEMUX_ID"] = 1
  color_dict["GC_TXACT_DEMUX_ID"] = 2
  color_dict["GC_RXACT_CMD"] = 3
  color_dict["GC_BUF_DEMUX"] = 4

  color_dict["FABRIC_D2H_DATA_CMD_ID"] = 0
  color_dict["GC_TXACT_MUX_ID"] = 1
  color_dict["GC_RXACT_MUX_TD_ID"] = 2
  color_dict["GC_RXACT_CONFIG_MUX_ID"] = 3
  color_dict["GC_BUF_MUX"] = 4

  west_fabric_colors = list(range(5, num_colors))
  east_fabric_colors = list(range(5, num_colors))

  # Calculate the channel heights:
  # If the number of channels does not evenly divide the kernel height,
  # then one channel needs to vary in size. Make the first channel the
  # varying one, since we enqueue it first. If it is larger it may start
  # work before the rest.
  # Try to make the not-first channel (the ones with the same size) as
  # large as possible.
  if n_channels == 1:
    normal_channel_height = first_channel_height = kernel.h
  elif ceil(kernel.h / n_channels) >= kernel.h / (n_channels - 1):
    # need to round down, otherwise last channel would be empty
    normal_channel_height = kernel.h // n_channels
  else:
    # round up
    normal_channel_height = ceil(kernel.h / n_channels)
  # first channel gets what's left
  first_channel_height = kernel.h - normal_channel_height * (n_channels - 1)
  max_channel_height = max(normal_channel_height, first_channel_height)

  # config wavelets are 16b values packed into 32b wavelets
  # Each channel needs (num_rows + 2) config values
  num_config_wvlt = (max_channel_height + base_config_wvlt_size + 1) // 2

  # west, core, and east layout:
  #   +---------+-------+---------+------+-----+--------+
  #   | demux   | demux | CMD fan | core | mux | mux    |
  #   | adaptor |       |         |      |     | adaptor|
  #   +---------+-------+---------+------+-----+--------+

  # Compile EAST side: mux, mux adaptor
  FABRIC_D2H_DATA_CMD = color_dict["FABRIC_D2H_DATA_CMD_ID"]
  GC_TXACT_MUX = color_dict["GC_TXACT_MUX_ID"]
  GC_RXACT_MUX_TD = color_dict["GC_RXACT_MUX_TD_ID"]
  GC_RXACT_CONFIG_MUX = color_dict["GC_RXACT_CONFIG_MUX_ID"]
  args_east = []
  args_east.append(driver_path)
  args_east.append(memcpy_file_east)
  args_east.append("-o")
  args_east.append(bin_dir_path_east / out_file_name)
  args_east.append("--persist")
  args_east.append(persist_dir_path_east)
  start_x = kernel.x + kernel.w
  start_y = kernel.y
  args_east.append(f"--fabric-offsets={start_x},{start_y}")
  args_east.append(f"--fabric-dims={fabric.w},{fabric.h}")
  args_east.append(f"--params=height:{kernel.h}")
  GC_BUF_MUX = color_dict["GC_BUF_MUX"]
  args_east.append(f"--params=num_mux:{n_channels if n_channels else 1}")
  args_east.append(f"--params=num_config_wvlt:{num_config_wvlt}")
  args_east.append(f"--params=width_east_buf:{width_east_buf}")
  args_east.append(f"--params=GC_BUF_MUX_ID:{GC_BUF_MUX}")

  args_east.append(f"--params=FABRIC_D2H_DATA_ID_0:{east_fabric_colors[0]}")
  args_east.append(f"--params=height_mux_0:{first_channel_height}")
  for j in range(1, n_channels):
    args_east.append(f"--params=FABRIC_D2H_DATA_ID_{j}:{east_fabric_colors[j]}")
    args_east.append(f"--params=height_mux_{j}:{normal_channel_height}")

  args_east.append(f"--params=FABRIC_D2H_DATA_CMD_ID:{FABRIC_D2H_DATA_CMD}")
  args_east.append(f"--params=GC_TXACT_MUX_ID:{GC_TXACT_MUX}")
  args_east.append(f"--params=GC_RXACT_MUX_TD_ID:{GC_RXACT_MUX_TD}")
  args_east.append(f"--params=GC_RXACT_CONFIG_MUX_ID:{GC_RXACT_CONFIG_MUX}")
  if arch is not None:
    args_east.append(f"--arch={arch}")
  # east/out.json
  json_filename = persist_dir_path_east / f"{out_file_name}.json"
  args_east.append(f"--output-json={json_filename}")
  if import_path is not None:
    args_east.append(f"--import-path={import_path}")
  subprocess.check_call(args_east)

  # Compile WEST side: demux adaptor, demux and cmd fan
  FABRIC_CMD = color_dict["FABRIC_CMD_ID"]
  GC_RXACT_DEMUX = color_dict["GC_RXACT_DEMUX_ID"]
  GC_TXACT_DEMUX = color_dict["GC_TXACT_DEMUX_ID"]
  args_west = []
  args_west.append(driver_path)
  args_west.append(memcpy_file_west)
  args_west.append("-o")
  args_west.append(bin_dir_path_west / out_file_name)
  args_west.append("--persist")
  args_west.append(persist_dir_path_west)
  # start_x must include the h2d buffer - the layout is:
  #demux adaptor | demux | buffer | cmd fan | core | buffer | mux | mux adaptor
  start_x = kernel.x - 3 - width_west_buf
  start_y = kernel.y
  args_west.append(f"--fabric-offsets={start_x},{start_y}")
  args_west.append(f"--fabric-dims={fabric.w},{fabric.h}")
  args_west.append(f"--params=height:{kernel.h}")
  args_west.append(f"--params=num_inputs:{len(c_h2d)}")
  args_west.append(f"--params=FABRIC_CMD_ID:{FABRIC_CMD}")
  GC_RXACT_CMD = color_dict["GC_RXACT_CMD"]
  GC_BUF_DEMUX = color_dict["GC_BUF_DEMUX"]
  args_west.append(f"--params=num_demux:{n_channels if n_channels else 1}")
  args_west.append(f"--params=FABRIC_H2D_DATA_ID_0:{west_fabric_colors[0]}")
  args_west.append(f"--params=height_demux_0:{first_channel_height}")
  args_west.append(f"--params=width_west_buf:{width_west_buf}")
  args_west.append(f"--params=GC_RXACT_CMD_ID:{GC_RXACT_CMD}")
  args_west.append(f"--params=GC_BUF_DEMUX_ID:{GC_BUF_DEMUX}")
  for j in range(1, n_channels):
    args_west.append(f"--params=FABRIC_H2D_DATA_ID_{j}:{west_fabric_colors[j]}")
    args_west.append(f"--params=height_demux_{j}:{normal_channel_height}")

  args_west.append(f"--params=GC_RXACT_DEMUX_ID:{GC_RXACT_DEMUX}")
  args_west.append(f"--params=GC_TXACT_DEMUX_ID:{GC_TXACT_DEMUX}")

  if arch is not None:
    args_west.append(f"--arch={arch}")
  # west/out.json
  json_filename = persist_dir_path_west / f"{out_file_name}.json"
  args_west.append(f"--output-json={json_filename}")
  if import_path is not None:
    args_west.append(f"--import-path={import_path}")
  subprocess.check_call(args_west)

def _split_params_string(params: Optional[str]) -> Dict:
  """
  Example: "INPUT_SIZE:16,HIST_WIDTH:8,HIST_HEIGHT:8"
  Returns:  {
              "INPUT_SIZE"  : "16",
              "HIST_WIDTH"  : "8",
              "HIST_HEIGHT" : "8"
            }
  """
  param_py_dict = {}
  if params is None:
    return param_py_dict

  param_list = params.split(",")
  for param in param_list:
    key, _, value = param.partition(":")
    param_py_dict[key] = value

  return param_py_dict

def _make_output_dir(user_output_name: Path) -> Tuple[Path, Path]:
  # Output name is either user specified or "out".
  output_name = _output_dir_name(user_output_name)

  # The compiler directory path is either 1) take user specified absolute path or
  # 2) constructed from output_name
  compile_dir_path = _get_compile_path(user_output_name, output_name)

  # Optionally, create a new directory.
  if not _make_compile_dir(compile_dir_path, False, logging.getLogger("cslc")):
    # Early exit if mkdir fails due to parent dir does not exist.
    sys.exit(-1)

  # Create a bin directory to place ELF files.
  bin_dir_path = compile_dir_path / elf_dir_name
  if not _make_compile_dir(bin_dir_path, True, logging.getLogger("cslc")):
    # Early exit when remove existing directory fails or mkdir fails due to parent dir
    # does not exist.
    sys.exit(-1)

  return bin_dir_path, compile_dir_path

def _make_compile_dir(dir_path: Path, clean_me: bool, logger: logging.Logger):
  """
  Create, if needed, a directory named dir_path.
  Optionally, remove the directory first.
  """
  # If parent does not exist, do not continue.
  if not dir_path.parent.exists():
    logger.error("%s does not exist.", dir_path.parent)
    return False

  # If exist, optionally remove and overwrite the existing one
  if dir_path.exists():

    if clean_me:
      try:
        rmtree(dir_path)
      except OSError as e:
        logger.error("%s - %s.", e.filename, e.strerror)
        return False
      dir_path.mkdir()
      logger.info("mkdir %s", dir_path)

  else:
    dir_path.mkdir()
    logger.info("mkdir %s", dir_path)

  return True


def _output_dir_name(user_specified_name: Path) -> Path:
  """
  Decide the output directory name. There are 2 cases:
  1. Path is absolute - use last part as output (no parent dir and extension)
  2. User provides a name - use the provided name
  """
  # Case 1. When output is absolute path, strip away the parent directory
  # Example: /tmp/my_try1/demo --> demo
  if user_specified_name.is_absolute():
    return Path(user_specified_name.stem)

  # Case 2: User has already provided a name.
  return user_specified_name


def _get_compile_path(user_specified_name: Path, output_name: Path) -> Path:
  """
  Returns the absolute path for compile directory.
  1) User specified absolute path
  2) Generate the absolute path from output_name
     Example: "foo" --> cwd()/foo
              "tmp/bar" --> cwd()/tmp/bar
  """
  output_path = Path(output_name)
  # 1. User specified an absolute path
  if user_specified_name.is_absolute():
    output_path = user_specified_name

  # Resolve to use absolute path
  return output_path.resolve()


def _parse_args():
  parser = argparse.ArgumentParser(
      prog="cslc",
      description=__doc__
  )
  parser.add_argument(
      "csl_filename",
      help="Input CSL file",
  )
  parser.add_argument(
      "-o",
      dest="output_name",
      default="out",
      help="Output directory name (default: %(default)s)"
  )
  parser.add_argument(
      "--params",
      action="append",
      help="Comma-separated list of param-to-value mappings where a mapping is a \
            `name:value` pair where name is a string and value is an unsigned integer. \
            The parameter list is passed on to cslc-driver as-is."
  )
  parser.add_argument(
      "--colors",
      action="append",
      help="Comma-separated list of color-to-value mappings where a mapping is a \
            `color:value` pair where color is a string and value is an unsigned integer. \
            The parameter list is passed on to cslc-driver as-is."
  )
  parser.add_argument(
      "--memcpy",
      action="store_true",
      help="Add memcpy support to this program"
  )
  parser.add_argument(
      "--channels",
      default=0, type=int,
      help="Number of memcpy I/O channels to use when memcpy support is compiled with this \
           program. If this argument is not present, or is 0, then the previous single-I/O \
           channel version is compiled."
  )
  parser.add_argument(
      "--import-path",
      action="append", default=[],
      help="Add the given directory to the list of directories searched for <...> paths in "
           "@import_module and @set_tile_code statements."
  )
  parser.add_argument(
      "--width-west-buf",
      default=0, type=int,
      help="width of west buffer (default is zero, i.e. no buffer to mitigate slow input)")
  parser.add_argument(
      "--width-east-buf",
      default=0, type=int,
      help="width of east buffer (default is zero, i.e. no buffer to mitigate slow output)")
  parser.add_argument(
      "--verbose",
      action="store_true",
      help="Verbose output"
  )
  return parser


def extract_memcpy_path(import_path_list: List[str]):
  """
  return a path which is specified by --import-path and contains memcpy or
         None if no such path exists

  emits a runtime error if more than one path
  """
  # find --import-path which contains [memcpy|runtime] folders
  import_path_memcpy_list = []
  for import_path in import_path_list:
    import_path = Path(import_path)
    runtime_path = import_path / "runtime"
    memcpy_path = import_path / "memcpy"
    if runtime_path.is_dir() and \
       memcpy_path.is_dir():
      import_path_memcpy_list.append(import_path)
  # import_path_memcpy_list is empty: use legacy path cslang/csl-libs
  # import_path_memcpy_list is non-empty: use user's path
  if len(import_path_memcpy_list) == 0:
    import_path_memcpy = None
  elif len(import_path_memcpy_list) == 1:
    import_path_memcpy = import_path_memcpy_list[0]
  else:
    raise RuntimeError(
        "there is more than one path with memcpy implementation inside\n"
        f"{import_path_memcpy_list}"
    )
  return import_path_memcpy


def main() -> int:
  parser = _parse_args()
  args, otherargs = parser.parse_known_args()

  csl_filename = args.csl_filename
  params_list = args.params
  colors_list = args.colors
  user_output_name = Path(args.output_name)
  memcpy = args.memcpy
  n_channels = args.channels
  width_west_buf = args.width_west_buf
  width_east_buf = args.width_east_buf
  verbose = args.verbose
  # import_path_memcpy is used to find the layout file of memcpy module
  import_path_memcpy = None
  if n_channels >= 0:
    import_path_memcpy = extract_memcpy_path(args.import_path)

  if n_channels == 0:
    raise RuntimeError(
        "n_channels=0 corresponds to the deprecated runtime CSELFRunner\n"
        "Please use n_channels>0 with SdkRuntime\n"
    )

  compile_dir_path = None
  bin_dir_path = None

  logging.basicConfig(stream=sys.stdout, level=logging.WARNING)
  logger = logging.getLogger("cslc")
  if verbose:
    logger.setLevel(logging.INFO)

  # Create a directory if a CSL file is in argument. Otherwise, this looks like
  # malformed command or help command, then the wrapper just pass the arguments through.
  if csl_filename is not None:
    bin_dir_path, compile_dir_path = _make_output_dir(user_output_name)

  # Formulate the compile command
  # The path that containing cslc-driver is the same
  driver_path = Path(__file__).parent / "cslc-driver"
  cmd = [driver_path]

  # Combine multiple --params options using comma
  params = None
  if params_list is not None:
    params = ",".join(params_list)
  if params is not None:
    cmd.append(f"--params={params}")

  for path in args.import_path:
    cmd.append(f"--import-path={path}")

  colors = None
  if colors_list is not None:
    colors = ",".join(colors_list)
  if colors is not None:
    cmd.append(f"--colors={colors}")
  cmd += otherargs

  if bin_dir_path is not None:
    # Always use "out" as prefix for binary files for consistency.
    cmd.append("-o")
    cmd.append(bin_dir_path / out_file_name)

  # Input CSL file
  if csl_filename is not None:
    cmd.append(csl_filename)

  if verbose:
    cmd.append("--verbose")

  # Ensure params json is generated for Python to import
  if compile_dir_path is not None:
    json_filename = compile_dir_path / f"{out_file_name}.json"
    cmd.append(f"--output-json={json_filename}")
    cmd.append("--persist")
    cmd.append(compile_dir_path)

  # Prints the compile executable command for debugging
  cmd_str = " ".join(quote(str(a)) for a in cmd)
  logger.info("Command: %s", cmd_str)

  # The user's kernel is compiled with --import-path which may
  # contain the memcpy module
  status = subprocess.call(cmd)

  if status != 0:
    return status

  # Add memcpy infrastructure
  if memcpy:
    _generate_memcpy(driver_path, params, import_path_memcpy,
                     user_output_name,
                     n_channels, width_west_buf, width_east_buf)

  return 0

if __name__ == "__main__":
  sys.exit(main())
