// params
param memcpy_params: comptime_struct;
param c2d_params: comptime_struct;
param layer_params: comptime_struct;
param sync_params: comptime_struct;


const M: i16 = layer_params.M; // Height of local matrix, or num rows per PE
const N: i16 = layer_params.N; // Width of local matrix, or num cols per PE
const M_local: i16 = layer_params.M_local; // Height of local matrix, or num rows per PE
const N_local: i16 = layer_params.N_local; // Width of local matrix, or num cols per PE
const R_M_local: i16 = layer_params.R_M_local; // Height of local matrix, or num rows per PE
const R_N_local: i16 = layer_params.R_N_local; // Width of local matrix, or num cols per PE
const layer_start_x: i16 = layer_params.layer_start_x;
const layer_start_y: i16 = layer_params.layer_start_y;
const layer_end_x: i16 = layer_params.layer_end_x;
const layer_end_y: i16 = layer_params.layer_end_y;
const layer_kernel_rows: i16 = layer_params.layer_kernel_rows;
const layer_kernel_cols: i16 = layer_params.layer_kernel_cols;
const layer_index: i16 = layer_params.layer_index;

// Task IDs
const EXIT:local_task_id = layer_params.layer_task_id[0];
const compute_jacobi_task_id:local_task_id = layer_params.layer_task_id[1];
const compute_residual_task_id:local_task_id = layer_params.layer_task_id[2];
const bcast_residual_task_id:local_task_id = layer_params.layer_task_id[3];
const compute_restriction_task_id:local_task_id = layer_params.layer_task_id[4];
const bcast_jacobi_task_id:local_task_id = layer_params.layer_task_id[5];


const math_lib = @import_module("<math>");
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
// The default values of queue IDs and DSR IDs of collectives_2d are applied implicitly.
// See mpi_x and mpi_y of gemm-collectives_2d/pe.csl for default values of queue and DSR IDs.
// const mpi_x = @import_module("<collectives_2d/pe>", .{ .dim_params = c2d_params.x });
// const mpi_y = @import_module("<collectives_2d/pe>", .{ .dim_params = c2d_params.y });
const mpi_x = @import_module("<collectives_2d/pe>", .{
    .dim_params = c2d_params.x,
    .queues = [2]u16{2,4},
    .dest_dsr_ids = [1]u16{1},
    .src0_dsr_ids = [1]u16{1},
    .src1_dsr_ids = [1]u16{1}
    });
const mpi_y = @import_module("<collectives_2d/pe>", .{
    .dim_params = c2d_params.y,
    .queues = [2]u16{3,5},
    .dest_dsr_ids = [1]u16{2},
    .src0_dsr_ids = [1]u16{2},
    .src1_dsr_ids = [1]u16{2}
    });
const simprint = @import_module("<simprint>", .{ .enable = true });
const timestamp = @import_module("<time>");
const sync_mod = @import_module( "../../../../row-col-broadcast/src/sync/pe.csl", @concat_structs(sync_params, .{
     .f_callback = sys_mod.unblock_cmd_stream,
     .input_queues=[3]u16{2, 3, 4},
     .output_queues=[3]u16{2, 3, 4},
     }));


//x, b, A, R will be partitioned using 2D Block decomposition.
// input
var A_tile = @zeros([M_local*N_local]f32);
var R_tile = @zeros([R_M_local*R_N_local]f32);
var x_tile = @zeros([N_local]f32);
var b_tile = @zeros([M_local]f32);
var omega = @zeros([1]f32);
var iterations = @constants([1]i32, 0); // default is 0 iteration.

// temporary variables on each PE.
// The product of Ax or Rx or any other matrix-vector product.
var Ax = @zeros([M_local]f32);  //Ax
var Rx = @zeros([R_M_local]f32);  // Rr
var residual_tile = @zeros([M_local]f32);
var term_2 = @zeros([M_local]f32);
var D_inv = @zeros([M_local]f32); // vector of diagonals of A_tile
var w_dinv_a_x = @zeros([M_local]f32);
var i_into_x = @zeros([M_local]f32);
var iter_count: i32 = 0;


// output
var b_next = @zeros([R_M_local]f32);  // rightmost Column


// Timing variables
// time_buf_f32[0:2] = {tscStartBuffer, tscEndBuffer}
var time_buf_f32 = @zeros([3]f32);
var time_ref_f32 = @zeros([3]f32);
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);


// DSDs
const dsd_A_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> A_tile[i*@as(i16, N_local)] }); // 1 row of A_tile
const dsd_A_diag = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> A_tile[i*N_local + i] });
const dsd_R_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> R_tile[i*@as(i16, R_N_local)] }); // 1 row of R_tile
const dsd_x_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N_local} -> x_tile[i]});
const dsd_b_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> b_tile[i]});
const dsd_Ax = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> Ax[i]});
const dsd_Rx = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> Rx[i]});
const dsd_residual_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> residual_tile[i]});
const dsd_D_inv = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> D_inv[i] });
const dsd_term_2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> term_2[i] });
var dsd_w_dinv_a_x = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> w_dinv_a_x[i] });
var dsd_i_into_x = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> i_into_x[i] });

// Pointers and advertised outside
var ptr_x : [*]f32 = &x_tile;
var ptr_b : [*]f32 = &b_tile;
var ptr_A : [*]f32 = &A_tile;
var ptr_R : [*]f32 = &R_tile;
var ptr_b_next : [*]f32 = &b_next;
var ptr_omega: [*]f32 = &omega;
var ptr_iter: [*]i32 = &iterations;
var ptr_time_memcpy: [*]f32 = &time_buf_f32;
var ptr_time_ref: [*]f32 = &time_ref_f32;

// temp variables
// Updated at runtime to store x and y IDs of PE reported by collectives library
var px: u16;
var py: u16;

// timing

fn f_enable_timer() void {
    timestamp.enable_tsc();
    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

fn f_tic() void {
    timestamp.get_timestamp(&tscStartBuffer);

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

fn f_toc() void {
    timestamp.get_timestamp(&tscEndBuffer);

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

fn f_memcpy_timestamps() void {
    // time_buf_f32[0] = {tscStartBuffer[1], tscStartBuffer[0]}
    // time_buf_f32[1] = {tscEndBuffer[0], tscStartBuffer[2]}
    // time_buf_f32[2] = {tscEndBuffer[2], tscEndBuffer[1]}
    var lo_ : u16 = 0;
    var hi_ : u16 = 0;
    var word : u32 = 0;

    lo_ = tscStartBuffer[0];
    hi_ = tscStartBuffer[1];
    time_buf_f32[0] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    lo_ = tscStartBuffer[2];
    hi_ = tscEndBuffer[0];
    time_buf_f32[1] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    lo_ = tscEndBuffer[1];
    hi_ = tscEndBuffer[2];
    time_buf_f32[2] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}


fn f_sync() void {
    // sync all PEs and record the reference clock
    sync_mod.f_sync();
}

fn f_reference_timestamps() void {
    // time_ref_f32[0] = {tscRefBuffer[1], tscRefBuffer[0]}
    // time_ref_f32[1] = {0, tscRefBuffer[2]}
    var lo_ : u16 = 0;
    var hi_ : u16 = 0;

    lo_ = sync_mod.tscRefBuffer[0];
    hi_ = sync_mod.tscRefBuffer[1];
    time_ref_f32[0] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    lo_ = sync_mod.tscRefBuffer[2];
    hi_ = 0;
    time_ref_f32[1] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

// AMG
fn compute_mv_per_tile(N_tile: i16, dsd_mv_tile: anytype, dsd_matrix_tile: anytype, vector_tile_data: [*]const f32) void {
  @fmovs(dsd_mv_tile, 0.0); // this can cause error if not initialized.
  for (@range(i16, N_tile)) |j| {
    const dsd_offset = @increment_dsd_offset(dsd_matrix_tile, j, f32);
    if (vector_tile_data[j] != 0.0) { // helps to speed up little bit.
      @fmacs(dsd_mv_tile, dsd_mv_tile, dsd_offset, vector_tile_data[j]);
    }
  }
}
// New formula implementation: Jacobi iteration logic (new formula)
// formula: x = (Identity-omega*D_inv*A_tile)*x_tile
// x_tile[i] = (1.0 - omega) * temp_tile[i] + omega * (b_tile[i] - rsum) / diag;
// The diagonal PEs add the term_1 so that we don't have to gather on diag PE.

fn jacobi_local() void {
    compute_mv_per_tile(N_local, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));  // Ax(vector) = Ax(matrix * vector)
    @fmuls(dsd_w_dinv_a_x, dsd_D_inv, dsd_Ax); // tmp = D_inv * Ax (vector * vector)
    @fmuls(dsd_w_dinv_a_x, omega[0], dsd_w_dinv_a_x); // tmp = w * D_inv * Ax (scalar * vector)

    if (px == py) { // good speedup.
      @fmovs(dsd_i_into_x, dsd_x_tile); // I*x = x
      // save some operatioons can be effective if PE grid large enough.
    } // otherwise, 0.0

    @fsubs(dsd_term_2, dsd_i_into_x, dsd_w_dinv_a_x); // tmp = I*x - omega * D_inv * Ax

    if (px == py) { // omega * D_inv * b
      @fmuls(dsd_w_dinv_a_x, dsd_D_inv, dsd_b_tile); // tmp = D_inv * b (vector * vector)
      @fmuls(dsd_w_dinv_a_x, omega[0], dsd_w_dinv_a_x); // tmp = omega * D_inv * b (scalar * vector)
      @fadds(dsd_term_2, dsd_w_dinv_a_x, dsd_term_2); // term_2 = omega * D_inv * b + term_2
    }
}

// Ax = A_local * x_local
fn residual_local() void {
  compute_mv_per_tile(N_local, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));  // Ax = A_tile * x_tile
}

fn printdsd(val: f32) void {
  simprint.fmt_with_coords("yourdsd_name[i] = {f}", .{ val });
}

fn inverse_callback(val: f32) f32 {
  return if (val != 0.0) math_lib.inv(val) else 0.0;
}

fn initialize() void {
  if (px == py) {  
    // now D_inv, is 1/A_tile for px==py and bcast to other PEs.
    @map(inverse_callback, dsd_A_diag, dsd_D_inv);
  }
  mpi_x.broadcast(py, @ptrcast([*]u32, &D_inv), M_local, compute_jacobi_task_id);
}

fn layout_print() void {
  simprint.print_string("PE (0,0) \n");
  // print A
  for (A_tile) |val, i| {
      simprint.fmt_with_coords("A_tile[{d}] = {f}", .{ i, val });
  }
  if (px==0 and py==0) {
    simprint.print_string("PE (0,0) \n");
    // print A
    for (A_tile) |val, i| {
        simprint.fmt_with_coords("A_tile[{d}] = {f}", .{ i, val });
    }
    // print shapes of A_tile, x_tile, b_tile, R_tile
    simprint.fmt_with_coords("A_tile shape: {d}x{d}", .{ @as(u32, M_local), @as(u32, N_local) });
    simprint.fmt_with_coords("x_tile shape: {d}", .{ @as(u32, N_local) });
    simprint.fmt_with_coords("b_tile shape: {d}", .{ @as(u32, M_local) });
    simprint.fmt_with_coords("R_tile shape: {d}x{d}", .{ @as(u32, R_M_local), @as(u32, R_N_local) });
    // print b_next shape
    simprint.fmt_with_coords("b_next shape: {d}", .{ @as(u32, R_M_local) });
    
  }
  if (px==0 and py==1) {
    simprint.print_string("PE (0,1) \n");
    // print A
    for (A_tile) |val, i| {
        simprint.fmt_with_coords("A_tile[{d}] = {f}", .{ i, val });
    }
    
  }
  if (px==1 and py==0) {
    simprint.print_string("PE (1,0) \n");
    // print A
    for (A_tile) |val, i| {
        simprint.fmt_with_coords("A_tile[{d}] = {f}", .{ i, val });
    }
    
  }
  if (px==1 and py==1) {
    simprint.print_string("PE (1,1) \n");
    // print A
    for (A_tile) |val, i| {
        simprint.fmt_with_coords("A_tile[{d}] = {f}", .{ i, val });
    }
    
  }
  sys_mod.unblock_cmd_stream();
  // @activate(EXIT);
  // print R
}

// Entrypoint into kernel
fn main() void {
  mpi_x.init();
  mpi_y.init();
  px = mpi_x.pe_id;
  py = mpi_y.pe_id;
  if ( iter_count < iterations[0]) {  // case when iterations is 0, so no jacobi.
    initialize();
  } else {
    @activate(compute_residual_task_id);  // don't calculate Jacobi straight to residual.
  }
}

task compute_jacobi() void {
  jacobi_local();  // updates term_2
  simprint.print_string("term_2\n");
  for (term_2) |val, i| {
    simprint.fmt_with_coords("term_2[{d}] = {f}", .{ i, val });
  }  
  // notice the py instead of 0.
  mpi_x.reduce_fadds(py, @ptrcast([*]f32, &term_2), @ptrcast([*]f32, &x_tile),
                     M_local, bcast_jacobi_task_id); // reduce across rows toward
}

// Gather the product into the diagonal PEs
task bcast_jacobi() void {  
  mpi_y.broadcast(px, @ptrcast([*]u32, &x_tile), N_local, compute_residual_task_id);
}

// r = b - Ax
// row_sum = sum(Ax)
task compute_residual() void {
  iter_count += 1;
  if (iter_count < iterations[0]) {
    simprint.fmt_with_coords("iter_count = {d}", .{@as(u32, iter_count)});
    @activate(compute_jacobi_task_id);
  } else {
    residual_local(); // has answers in dsd_Ax
    mpi_x.reduce_fadds(py, @ptrcast([*]f32, &Ax), @ptrcast([*]f32, &residual_tile),
                     M_local, bcast_residual_task_id); // reduce across rows towards left
  }
}

// bcast(residual_tile) to all PEs.
task bcast_residual() void {
  if (px == py) {
    @fsubs(dsd_residual_tile, dsd_b_tile, dsd_residual_tile);  // r = b - Ax
  }
  mpi_y.broadcast(px, @ptrcast([*]u32, &residual_tile), M_local, compute_restriction_task_id);
}

// Rx = R_tile*residual_tile
// b_next = sum(Rx)
task compute_restriction() void {
  compute_mv_per_tile(R_N_local, dsd_Rx, dsd_R_tile, @ptrcast([*]const f32, &residual_tile));
  mpi_x.reduce_fadds(layer_kernel_cols-1, @ptrcast([*]f32, &Rx), @ptrcast([*]f32, &b_next),
                     R_M_local, EXIT); // reduce across rows towards left
}

task f_exit() void {
  for (b_next) |val, i| {
    simprint.fmt_with_coords("b_next[{d}] = {f}", .{ i, val });
  }
  sys_mod.unblock_cmd_stream();
}

comptime {
  @bind_local_task(compute_jacobi, compute_jacobi_task_id);
  @bind_local_task(compute_residual, compute_residual_task_id);
  @bind_local_task(compute_restriction, compute_restriction_task_id);

  @bind_local_task(bcast_jacobi, bcast_jacobi_task_id);
  @bind_local_task(bcast_residual, bcast_residual_task_id);
  @bind_local_task(f_exit, EXIT);

  @export_symbol(ptr_A, "A");
  @export_symbol(ptr_x, "x");
  @export_symbol(ptr_b, "b");
  @export_symbol(ptr_R, "R");
  @export_symbol(ptr_b_next, "b_next");
  @export_symbol(ptr_omega, "omega");
  @export_symbol(ptr_iter, "iterations");
  @export_symbol(main);
  @export_symbol(layout_print); // prints layout of A

  // timing
  @export_symbol(ptr_time_memcpy, "time_memcpy");
  @export_symbol(ptr_time_ref, "time_ref");
  @export_symbol(f_enable_timer);
  @export_symbol(f_tic);
  @export_symbol(f_toc);
  @export_symbol(f_memcpy_timestamps);
  @export_symbol(f_sync);
  @export_symbol(f_reference_timestamps);
  
}