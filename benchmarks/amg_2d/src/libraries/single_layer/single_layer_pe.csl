// color/ task ID map
//
//  ID var             ID var              ID var               ID var
//   0 c2d_x_color_0    9 EXIT             18 scatter_residual  27 reserved (memcpy)
//   1 c2d_x_color_1   10 scatter_x        19 restrict_compute  28 reserved (memcpy)
//   2 c2d_y_color_0   11 broadcast_x_down 20 gather_b_next     29 reserved (memcpy)
//   3 c2d_y_color_1   12 compute          21 reserved (memcpy) 30 reserved (memcpy)
//   4                 13 gather_result    22 reserved (memcpy) 31 reserved
//   5                 14 c2d_x_entrypt_0  23 reserved (memcpy) 32
//   6                 15 c2d_x_entrypt_1  24 broadcast_residual  33
//   7                 16 c2d_y_entrypt_0  25                   34
//   8                 17 c2d_y_entrypt_1  26                   35

// params
param memcpy_params: comptime_struct;
param c2d_params: comptime_struct;
param layer_params: comptime_struct;


const M: i16 = layer_params.M; // Height of local matrix, or num rows per PE
const N: i16 = layer_params.N; // Width of local matrix, or num cols per PE
const M_local: i16 = layer_params.M_local; // Height of local matrix, or num rows per PE
const N_local: i16 = layer_params.N_local; // Width of local matrix, or num cols per PE
const R_M_local: i16 = layer_params.R_M_local; // Height of local matrix, or num rows per PE
const R_N_local: i16 = layer_params.R_N_local; // Width of local matrix, or num cols per PE
const layer_start_x: i16 = layer_params.layer_start_x;
const layer_start_y: i16 = layer_params.layer_start_y;
const layer_end_x: i16 = layer_params.layer_end_x;
const layer_end_y: i16 = layer_params.layer_end_y;
const layer_kernel_rows: i16 = layer_params.layer_kernel_rows;
const layer_kernel_cols: i16 = layer_params.layer_kernel_cols;
const layer_index: i16 = layer_params.layer_index;

// Task IDs
const EXIT:local_task_id = @get_local_task_id(9);
const compute_jacobi_task_id:local_task_id = @get_local_task_id(5);
const compute_residual_task_id:local_task_id = @get_local_task_id(12);
const bcast_residual_task_id:local_task_id = @get_local_task_id(13);
const compute_restriction_task_id:local_task_id = @get_local_task_id(18);
const bcast_jacobi_task_id:local_task_id = @get_local_task_id(25);



const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
// The default values of queue IDs and DSR IDs of collectives_2d are applied implicitly.
// See mpi_x and mpi_y of gemm-collectives_2d/pe.csl for default values of queue and DSR IDs.
// const mpi_x = @import_module("<collectives_2d/pe>", .{ .dim_params = c2d_params.x });
// const mpi_y = @import_module("<collectives_2d/pe>", .{ .dim_params = c2d_params.y });
const mpi_x = @import_module("<collectives_2d/pe>", .{
    .dim_params = c2d_params.x,
    .queues = [2]u16{2,4},
    .dest_dsr_ids = [1]u16{1},
    .src0_dsr_ids = [1]u16{1},
    .src1_dsr_ids = [1]u16{1}
    });
const mpi_y = @import_module("<collectives_2d/pe>", .{
    .dim_params = c2d_params.y,
    .queues = [2]u16{3,5},
    .dest_dsr_ids = [1]u16{2},
    .src0_dsr_ids = [1]u16{2},
    .src1_dsr_ids = [1]u16{2}
    });
const simprint = @import_module("<simprint>", .{ .enable = true });

//x, b, A, R will be partitioned using 2D Block decomposition.
// input
var A_tile = @zeros([M_local*N_local]f32);
var R_tile = @zeros([R_M_local*R_N_local]f32);
var x_tile = @zeros([N_local]f32);
var b_tile = @zeros([M_local]f32);
var omega = @zeros([1]f32);
var D_inv = @zeros([M_local*N_local]f32);


// temporary variables on each PE.
// The product of Ax or Rx or any other matrix-vector product.
var Ax = @zeros([M_local]f32);  //Ax
var Rx = @zeros([R_M_local]f32);  // Rr
var diag_tile = @zeros([M_local]f32);
var residual_tile = @zeros([M_local]f32);
var term_2 = @zeros([M_local]f32);
var term_2_sum = @zeros([M_local]f32);
var identity = @zeros([M_local*N_local]f32);

// output
var b_next = @zeros([R_M_local]f32);  // rightmost Column

// DSDs
const dsd_A_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> A_tile[i*@as(i16, N_local)] }); // 1 row of A_tile
const dsd_R_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> R_tile[i*@as(i16, R_N_local)] }); // 1 row of R_tile
const dsd_x_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N_local} -> x_tile[i]});
const dsd_b_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> b_tile[i]});
const dsd_Ax = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> Ax[i]});
const dsd_Rx = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> Rx[i]});
const dsd_diag_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> A_tile[i*@as(i16, N_local) + i]});
const dsd_residual_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> residual_tile[i]});

// Pointers and advertised outside
var ptr_x : [*]f32 = &x_tile;
var ptr_b : [*]f32 = &b_tile;
var ptr_A : [*]f32 = &A_tile;
var ptr_R : [*]f32 = &R_tile;
var ptr_b_next : [*]f32 = &b_next;
var ptr_omega: [*]f32 = &omega;
var ptr_D_inv: [*]f32 = &D_inv;
// temp variables
// Updated at runtime to store x and y IDs of PE reported by collectives library
var px: u16;
var py: u16;

fn compute_mv_per_tile(N_tile: i16, dsd_mv_tile: anytype, dsd_matrix_tile: anytype, vector_tile_data: [*]const f32) void {
  for (@range(i16, N_tile)) |j| {
    const dsd_offset = @increment_dsd_offset(dsd_matrix_tile, j, f32);
    @fmacs(dsd_mv_tile, dsd_mv_tile, dsd_offset, vector_tile_data[j]);
  }
}
// New formula implementation: Jacobi iteration logic (new formula)
// formula: x = (Identity-omega*D_inv*A_tile)*x_tile
// x_tile[i] = (1.0 - omega) * temp_tile[i] + omega * (b_tile[i] - rsum) / diag;
// The diagonal PEs add the term_1 so that we don't have to gather on diag PE.

fn jacobi_local(iterations: i16) void {
  for (@range(i16, iterations)) |iter| {
    for (@range(i16, M_local)) |i| {  // Given A is a SPD, it's M==N always.
        var a_into_x_rsum: f32 = 0.0;
        var d_inv: f32 = 0.0;
        var i_into_x_rsum: f32 = 0.0;

        d_inv = D_inv[i*N_local + i]; 
        // Apply formula: x = (I - omega*D_inv*A)*x
        if (d_inv != 0.0) {
          // Calculate matrix-vector product (A*x)
          for (@range(i16, N_local)) |j| {
              a_into_x_rsum += A_tile[i*N_local + j] * x_tile[j];  // vector
              i_into_x_rsum += identity[i*N_local + j] * x_tile[j]; // vector
          }
          term_2[i] = i_into_x_rsum - omega[0] * d_inv * a_into_x_rsum;
        } else {
          if (px == py) {
            term_2[i] = x_tile[i];
          } else {
            term_2[i] = 0.0;
          }
        }
    }
  }
}

fn initialize() void {
  if (px == py) {
    // Identity matrix
    for (@range(i16, M_local)) |i| {
      identity[i*N_local + i] = 1.0;
    }
    // // now D_inv, is 1/A_tile for px==py and bcast to other PEs.
    // for (@range(i16, M_local)) |i| {
    //   D_inv[i*N_local + i] = 1.0 / A_tile[i*N_local + i];
    // }
    // mpi_x.broadcast(py, @ptrcast([*]u32, &D_inv), M_local*N_local, compute_jacobi_task_id);
  }
}
// Entrypoint into kernel
fn main() void {
  mpi_x.init();
  mpi_y.init();
  px = mpi_x.pe_id;
  py = mpi_y.pe_id;

  initialize();
  @activate(compute_jacobi_task_id);
}

task compute_jacobi() void {
  var iterations: i16 = 1;
  jacobi_local(iterations);  // updates term_2

  // notice the py instead of 0.
  mpi_x.reduce_fadds(py, @ptrcast([*]f32, &term_2), @ptrcast([*]f32, &term_2_sum),
                     M_local, bcast_jacobi_task_id); // reduce across rows toward
}

// Gather the product into the top left PE
// complete the formula: term_2_sum = (Identity-omega*D_inv*A_tile)*x_tile
// # formula: x = omega*D_inv*b + term_2_sum
task bcast_jacobi() void {
  if (px == py) { // we are on diagonal for each row.
    // find term_1 first then add term_2_sum
    for (@range(i16, M_local)) |i| {
      var d_inv: f32 = 0.0;
      d_inv = D_inv[i*N_local + i];
      if (d_inv != 0.0) {
        var term_1: f32 = 0.0;
        term_1 = omega[0] * d_inv * b_tile[i];
        x_tile[i] = term_1 + term_2_sum[i];
      } else{
        x_tile[i] = term_2_sum[i];
      }
    }
  }
  mpi_y.broadcast(px, @ptrcast([*]u32, &x_tile), N_local, compute_residual_task_id);
}

// Ax = A*x
// r = b - Ax
// row_sum = sum(Ax)
task compute_residual() void {
  // (vector_size, ax, A, x)
  // ax = A*x
  compute_mv_per_tile(N_local, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));
  mpi_x.reduce_fadds(py, @ptrcast([*]f32, &Ax), @ptrcast([*]f32, &residual_tile),
                     M_local, bcast_residual_task_id); // reduce across rows towards left
}

// bcast(residual_tile) to all PEs.
task bcast_residual() void {
  if (px == py) {
    @fsubs(dsd_residual_tile, dsd_b_tile, dsd_residual_tile);  // r = b - Ax
  }
  mpi_y.broadcast(px, @ptrcast([*]u32, &residual_tile), M_local, compute_restriction_task_id);
}

// Rx = R_tile*residual_tile
// b_next = sum(Rx)
task compute_restriction() void {
  compute_mv_per_tile(R_N_local, dsd_Rx, dsd_R_tile, @ptrcast([*]const f32, &residual_tile));
  mpi_x.reduce_fadds(layer_kernel_cols-1, @ptrcast([*]f32, &Rx), @ptrcast([*]f32, &b_next),
                     R_M_local, EXIT); // reduce across rows towards left
}

task f_exit() void {
  sys_mod.unblock_cmd_stream();
}

comptime {
  @bind_local_task(compute_jacobi, compute_jacobi_task_id);
  @bind_local_task(compute_residual, compute_residual_task_id);
  @bind_local_task(compute_restriction, compute_restriction_task_id);

  @bind_local_task(bcast_jacobi, bcast_jacobi_task_id);
  @bind_local_task(bcast_residual, bcast_residual_task_id);
  @bind_local_task(f_exit, EXIT);

  @export_symbol(ptr_A, "A");
  @export_symbol(ptr_x, "x");
  @export_symbol(ptr_b, "b");
  @export_symbol(ptr_R, "R");
  @export_symbol(ptr_b_next, "b_next");
  @export_symbol(ptr_omega, "omega");
  @export_symbol(ptr_D_inv, "D_inv");
  @export_symbol(main);
}