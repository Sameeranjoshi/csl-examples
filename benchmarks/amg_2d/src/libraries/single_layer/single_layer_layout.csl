// This does y = Ax + b on a kernel_cols x kernel_rows rectangle of PEs.

// color/ task ID map
//
//  ID var             ID var              ID var               ID var
//   0 C0                       9 STARTUP                 18 COMPUTE_JACOBI       27 reserved (memcpy)
//   1 C1                       10 SYNC_Y                 19 COMPUTE_RESIDUAL     28 reserved (memcpy)
//   2 C2                       11 SYNC_BCAST             20 BCAST_RESIDUAL       29 reserved
//   3 C3                       12 EXIT_SYNC              21 reserved (memcpy)      30 reserved (memcpy)
//   4 C4                       13 C2D_X_ENTRYPOINT_0     22 reserved (memcpy)      31 reserved
//   5 collective_x_color_right 14 C2D_X_ENTRYPOINT_1     23 reserved (memcpy)    32
//   6 collective_x_color_left  15 C2D_Y_ENTRYPOINT_0     24     33
//   7 collective_y_color_down  16 C2D_Y_ENTRYPOINT_1     25     34
//   8 collective_y_color_up    17 EXIT                   26     35

param layer_rows_A : i16; // Height of matrix
param layer_cols_A : i16; // Width of matrix
param layer_rows_R : i16; // Height of matrix R
param layer_cols_R : i16; // Width of matrix R
param layer_start_x: i16; // start x of the layer
param layer_start_y: i16; // start y of the layer
param layer_kernel_rows : i16; // Height of kernel
param layer_kernel_cols : i16; // Width of kernel
param layer_index: i16; // index of the layer


// comptime {
//   // Number of matrix rows must be multiple of kernel rectangle height
//   @comptime_assert(layer_rows_A % layer_kernel_rows == 0);
//   // Number of matrix cols must be multiple of kernel rectangle width
//   @comptime_assert(layer_cols_A % layer_kernel_cols == 0);
//   // at least R_N should be same as A_M
//   @comptime_assert(layer_cols_R == layer_rows_A);
//   // If we do this this becomes a GMG with a very structured lowering, 
//   // keep for now.
//   @comptime_assert(layer_rows_R % layer_kernel_rows == 0);
//   @comptime_assert(layer_cols_R % layer_kernel_cols == 0);
// }

// Local matrix dimensions
const LOCAL_rows_A: i16 = layer_rows_A / layer_kernel_rows; // Number of rows per PE
const LOCAL_cols_A: i16 = layer_cols_A / layer_kernel_cols; // Number of columns per PE
const LOCAL_rows_R: i16 = layer_rows_R / layer_kernel_rows; // Number of rows per PE
const LOCAL_cols_R: i16 = layer_cols_R / layer_kernel_cols; // Number of columns per PE
const layer_end_x: i16 = layer_start_x + layer_kernel_cols; // end x of the layer
const layer_end_y: i16 = layer_start_y + layer_kernel_rows; // end y of the layer

// SYNC MODULE
const C0 : color = @get_color(0);
const C1 : color = @get_color(1);
const C2 : color = @get_color(2);
const C3 : color = @get_color(3);
const C4 : color = @get_color(4);
// collective module colors
const collective_x_color_right : color = @get_color(5);
const collective_x_color_left : color = @get_color(6);
const collective_y_color_down : color = @get_color(7);
const collective_y_color_up : color = @get_color(8);

// entrypoints of sync module
const STARTUP: local_task_id = @get_local_task_id(9);
const SYNC_Y: local_task_id = @get_local_task_id(10);
const SYNC_BCAST: local_task_id = @get_local_task_id(11);
const EXIT_SYNC: local_task_id = @get_local_task_id(12);
// collective module tasks
const C2D_X_ENTRYPOINT_0: local_task_id = @get_local_task_id(13);
const C2D_X_ENTRYPOINT_1: local_task_id = @get_local_task_id(14);
const C2D_Y_ENTRYPOINT_0: local_task_id = @get_local_task_id(15);
const C2D_Y_ENTRYPOINT_1: local_task_id = @get_local_task_id(16);
// layer task ID
// Task IDs
const EXIT: local_task_id = @get_local_task_id(17);
const COMPUTE_JACOBI: local_task_id = @get_local_task_id(18);
const COMPUTE_RESIDUAL: local_task_id = @get_local_task_id(19);
const BCAST_RESIDUAL: local_task_id = @get_local_task_id(20);
const COMPUTE_RESTRICTION: local_task_id = @get_local_task_id(24);
const BCAST_JACOBI: local_task_id = @get_local_task_id(25);

const c2d_struct = .{
    .x_colors = .{collective_x_color_left, collective_x_color_right},
    .y_colors = .{collective_y_color_down, collective_y_color_up},
    .x_entrypoints = .{C2D_X_ENTRYPOINT_0, C2D_X_ENTRYPOINT_1},
    .y_entrypoints = .{C2D_Y_ENTRYPOINT_0, C2D_Y_ENTRYPOINT_1},
};
const sync_module = @import_module( "../../../../row-col-broadcast/src/sync/layout.csl", .{
    .colors = [5]color{C0, C1, C2, C3, C4},
    .entrypoints = [4]local_task_id{STARTUP, SYNC_Y, SYNC_BCAST, EXIT_SYNC},
    .width = layer_kernel_cols,
    .height = layer_kernel_rows
    });

const c2d = @import_module("<collectives_2d/params>");
const memcpy = @import_module( "<memcpy/get_params>", .{
    .width = layer_kernel_cols,
    .height = layer_kernel_rows
});
const current_layer_params = .{
        .M = layer_rows_A,
        .N = layer_cols_A,
        .M_local = LOCAL_rows_A,
        .N_local = LOCAL_cols_A,
        .R_M_local = LOCAL_rows_R,
        .R_N_local = LOCAL_cols_R,
        .layer_start_x = layer_start_x,
        .layer_start_y = layer_start_y,
        .layer_end_x = layer_end_x,
        .layer_end_y = layer_end_y,
        .layer_kernel_rows = layer_kernel_rows,
        .layer_kernel_cols = layer_kernel_cols,
        .layer_index = layer_index,
        .layer_task_id = [6]local_task_id{EXIT, COMPUTE_JACOBI, COMPUTE_RESIDUAL, BCAST_RESIDUAL, COMPUTE_RESTRICTION, BCAST_JACOBI},
};

layout {
  @set_rectangle(layer_kernel_cols, layer_kernel_rows);

  var Px_end: u16 = layer_end_x;
  var Py_end: u16 = layer_end_y;

  var Px: u16 = layer_start_x;
  while (Px < Px_end) : (Px += 1) {
    var Py: u16 = layer_start_y;
    const memcpy_params = memcpy.get_params(Px);
    while (Py < Py_end) : (Py += 1) {
      const c2d_params = c2d.get_params(Px, Py, c2d_struct);
      // const syncParams = sync_module.get_params(Px, Py, layer_start_x, layer_start_y, layer_kernel_cols, layer_kernel_rows);
      const syncParams = sync_module.get_params(Px, Py);
      const layer_params: comptime_struct = current_layer_params;

      @set_tile_code(Px, Py, "single_layer_pe.csl", .{
        .memcpy_params = memcpy_params, // memcpy
        .c2d_params = c2d_params, // c2d
        .layer_params = layer_params, // problem information
        .sync_params = syncParams, // sync
      });
    }
  }

  // export symbol names
  @export_name("A", [*]f32, true);
  @export_name("R", [*]f32, true);
  @export_name("P", [*]f32, true);
  @export_name("x", [*]f32, true);
  @export_name("b", [*]f32, true);
  @export_name("main", fn()void);
  @export_name("b_next", [*]f32, true);
  @export_name("x_coarse", [*]f32, true);
  @export_name("omega", [*]f32, true);
  @export_name("iterations", [*]i32, true);
  @export_name("layout_print", fn()void);

  // timing
  @export_name("time_memcpy", [*]f32, true);
  @export_name("time_ref", [*]f32, true);
  @export_name("f_enable_timer", fn()void);
  @export_name("f_tic", fn()void);
  @export_name("f_toc", fn()void);
  @export_name("f_memcpy_timestamps", fn()void);
  @export_name("f_sync", fn()void);
  @export_name("f_reference_timestamps", fn()void);

}