////////////////////////////////////////
// params
////////////////////////////////////////
param memcpy_params: comptime_struct;
param M: i16;   // pe_rows
param N: i16;   // pe_cols
param R_M: i16; // R shape parameters here
param R_N: i16;
param layer_index: i16; // index of the layer
param px_start: i16; // start x of the layer
param py_start: i16; // start y of the layer
param layer_width: i16; // number of PEs in x direction
param layer_height: i16; // number of PEs in y direction
////////////////////////////////////////
// DATA(local + global)
////////////////////////////////////////
// Constants defining dimensions of our matrix(MxN)

const _MAX_SIZE_A = M*N;
const _MAX_SIZE_X = N*1;
const _MAX_SIZE_AX = M*1;
const _MAX_SIZE_R = R_M*R_N;
// R shape parameters here

//INPUT
// 48 kB of global memory contain A, x, b, R
// Accessible from host.
var A: [M*N]f32; // A is stored in row-major order
var R: [R_M*R_N]f32; // R is stored in row-major order
var x: [N*1]f32;    // var x: [N*1]f32;
var b: [M*1]f32;    // var b: [M*1]f32;
// var x_coarse: @zeros([N]f32);

// LOCAL TEMP
var AX = @zeros([M*1]f32);   // var AX: [M*1]f32;

// OUTPUT
var residual =  @constants([M*1]f32, 0.0);   // var residual: [M*1]f32;
var b_coarse = @zeros([R_M*1]f32);

////////////////////////////////////////
// Decide what is visible from outside world.
////////////////////////////////////////
const residual_ptr: [*]f32 = &residual; // Why const = as won't be changed by the host
const b_coarse_ptr: [*]f32 = &b_coarse;
var A_ptr: [*]f32 = &A;
var x_ptr: [*]f32 = &x;
var b_ptr: [*]f32 = &b;
var R_ptr: [*]f32 = &R;
////////////////////////////////////////
// DSD
////////////////////////////////////////

// General : memory_address=base_address+offset+stride×induction_variable
// base_address, offset, stride, extent
var mem_b_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M} -> b[i] });
var mem_x_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N} -> x[i] });
var mem_A_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M} -> A[i*N] });
var mem_R_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M} -> R[i*R_N] });
// base_address=&A, offset=0, stride=N, extent=M
var mem_residual_dsd = @get_dsd(mem1d_dsd, .{ .base_address=&residual, .offset=0, .stride=1, .extent=M });
var mem_b_coarse_dsd = @get_dsd(mem1d_dsd, .{ .base_address=&b_coarse, .offset=0, .stride=1, .extent=R_M });
var mem_AX_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M} -> AX[i] });


////////////////////////////////////////
// import modules
////////////////////////////////////////
const gemv_mod   = @import_module("../libraries/gemv.csl",   .{ .sizeA = _MAX_SIZE_A, .sizeX = _MAX_SIZE_X, .sizeY = _MAX_SIZE_AX });
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const simprint = @import_module("<simprint>", .{ .enable = true });
////////////////////////////////////////
// Functions
////////////////////////////////////////
// Initialize matrix and vectors
fn initialize() void {
    // for loop with range syntax
    // loops over 0, 1, ...., M*N-1
    // idx stores the loop index
    // for (@range(i16, M*N)) |idx| {
    //     // @as casts idx from i16 to f32
    //     A[idx] = @as(f32, idx);
    // }
    // print x and b

    simprint.fmt_with_coords("In layer = {d}", .{ @as(u32, layer_index) });
    simprint.fmt("M = {d}, N = {d}, R_M = {d}, R_N = {d}, px_start = {d}, py_start = {d}, layer_width = {d}, layer_height = {d}", 
                 .{ @as(u32, M), @as(u32, N), @as(u32, R_M), @as(u32, R_N), @as(u32, px_start), @as(u32, py_start), @as(u32, layer_width), @as(u32, layer_height) });
    simprint.print_string("\n");

}

//  General: Ax = aplha. (A * x) + beta.y
//  answer= 1.(A * x) + 0.y
// AX = A*x
fn gemv_using_library() void {

    var alpha: f32 = 1.0;
    var beta: f32 = 0.0;
    var is_layout_column_major: bool = false;
    gemv_mod.sgemv_inner(M, N, alpha, &A, M, &x, beta, &AX, is_layout_column_major);

}

// Compute gemv
// input: A, x
// output: AX
// AX = A*x
fn gemv() void {
  for (@range(i16, M)) |i| {
    var tmp: f32 = 0.0;
    for (@range(i16, N)) |j| {
      tmp += A[i*N + j] * x[j];
    }
    AX[i] = tmp;
    // y[i] = tmp + b[i];
  }
}

fn gemv_using_dsd() void{
    // TODO: BUG: This produces wrong results if called multiple times.
    for (@range(i16, M)) |i| {
        AX[i] = 0.0;
    }
    // @fsubs(mem_AX_dsd, mem_AX_dsd, mem_AX_dsd);
    for (@range(i16, N)) |i| {
        @fmacs(mem_AX_dsd, mem_AX_dsd, mem_A_dsd, x[i]);
        mem_A_dsd = @increment_dsd_offset(mem_A_dsd, 1, f32);
    }
}

fn residual_operator() void {
    @fsubs(mem_residual_dsd, mem_b_dsd, mem_AX_dsd);
}

fn restriction_operator() void {
    // TODO: Use DSD for speed.
  for (@range(i16, R_M)) |i| {
    var tmp: f32 = 0.0;
    for (@range(i16, R_N)) |j| {
      tmp += R[i*R_N + j] * residual[j];
    }
    b_coarse[i] = tmp;
    // y[i] = tmp + b[i];
  }
}

fn restriction_operator_using_dsd() void{
    // TODO: BUG: This produces wrong results if called multiple times.
    // for (@range(i16, R_M)) |i| {
    //     AX[i] = 0.0;
    // }
    // @fsubs(mem_AX_dsd, mem_AX_dsd, mem_AX_dsd);
    for (@range(i16, R_N)) |i| {
        @fmacs(mem_b_coarse_dsd, mem_b_coarse_dsd, mem_R_dsd, residual[i]);
        mem_R_dsd = @increment_dsd_offset(mem_R_dsd, 1, f32);
    }
}

// Weighted jacobi iteration
// formula: x = (1-omega)*x + omega*(b - A*x)/diag(A)
// Ax is for all values except the diagonal value.

fn jacobi(omega:f32, iterations: i16) void {

    // var omega: f32 = 1.0/3.0;
    // var iterations: i32 = 5;

    for (@range(i16, iterations)) |iter| {
        // make copy of x into temp.
        var tmp = @zeros([N*1]f32);
        for (@range(i32, N)) |i| {
            tmp[i] = x[i];
        }

        for (@range(i16, M)) |i| {
            var rsum: f32 = 0.0;
            var diag: f32 = A[i*N + i];
            for (@range(i16, N)) |j| {
                if (i != j) {
                    rsum += A[i*N + j] * tmp[j];
                }
            }
            if (diag != 0.0) {
                x[i] = (1.0 - omega) * tmp[i] + omega * (b[i] - rsum) / diag;
            }
        }
    }

    // sys_mod.unblock_cmd_stream();
}


// Call initialize and gemv functions
fn compute(omega:f32, iterations: i16) void {
    initialize();
    // gemv();
    jacobi(omega, iterations);  // presmoother
    // gemv_using_library();
    gemv();
    // // gemv_using_dsd();
    residual_operator();        // residual
    restriction_operator_using_dsd();   // restriction

    for (x) |val, i| {
            simprint.fmt_with_coords("x_smooth[{d}] = {f}", .{ i, val });
    }
    //ax
    for (AX) |val, i| {
            simprint.fmt_with_coords("AX[{d}] = {f}", .{ i, val });
    }
    for (residual) |val, i| {
            simprint.fmt_with_coords("residual[{d}] = {f}", .{ i, val });
    }
    for (b_coarse) |val, i| {
            simprint.fmt_with_coords("b_coarse[{d}] = {f}", .{ i, val });
    }
    simprint.print_string("\n");
    // unblock memcpy so that it can send data outside.
    sys_mod.unblock_cmd_stream();
}


////////////////////////////////////////
// Visibility to outside world
////////////////////////////////////////
comptime {
    @export_symbol(A_ptr, "A");
    @export_symbol(R_ptr, "R");
    @export_symbol(x_ptr, "x");
    @export_symbol(b_ptr, "b");
}
comptime {
    // Export function so it is host-callable by RPC mechanism
    @export_symbol(compute);
}
comptime {
    // Export symbol pointing to y so it is host-readable
    @export_symbol(residual_ptr, "residual");
    @export_symbol(b_coarse_ptr, "b_coarse");
}