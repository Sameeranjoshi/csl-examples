////////////////////////////////////////
// params
////////////////////////////////////////
param memcpy_params: comptime_struct;
param M: i16;   // Matrix rows
param N: i16;   // Matrix columns  
param R_M: i16; // Restriction matrix rows
param R_N: i16; // Restriction matrix columns
param layer_index: i16; // index of the layer
param px_start: i16; // start x of the layer
param py_start: i16; // start y of the layer
param layer_width: i16; // number of PEs in x direction
param layer_height: i16; // number of PEs in y direction
////////////////////////////////////////
// DATA(local + global)
////////////////////////////////////////

// // Constants
// const _MAX_SIZE_A = M*N;
// const _MAX_SIZE_X = N;
// const _MAX_SIZE_AX = M;
// const _MAX_SIZE_R = R_M*R_N;

//INPUT
// 48 kB of global memory contain A, x, b, R
// Copied from host.
var A: [M*N]f32; // A is stored in row-major order
var R: [R_M*R_N]f32; // R is stored in row-major order
var P: [R_N*R_M]f32; // P is stored in row-major order
var x: [N*1]f32;    // x is stored in row-major order
var b: [M*1]f32;    // b is stored in row-major order


// OUTPUT
var residual =  @constants([M*1]f32, 0.0);   // var residual: [M*1]f32;
var b_coarse = @zeros([R_M*1]f32);
var x_coarse = @zeros([R_M*1]f32);


////////////////////////////////////////
// Decide what is visible from outside world.
////////////////////////////////////////
const residual_ptr: [*]f32 = &residual; // Why const = as won't be changed by the host
const b_coarse_ptr: [*]f32 = &b_coarse;
const x_coarse_ptr: [*]f32 = &x_coarse;
var A_ptr: [*]f32 = &A;
var x_ptr: [*]f32 = &x;
var b_ptr: [*]f32 = &b;
var R_ptr: [*]f32 = &R;
var P_ptr: [*]f32 = &P;

////////////////////////////////////////
// import modules
////////////////////////////////////////
// const gemv_mod   = @import_module("../libraries/gemv.csl",   .{ .sizeA = _MAX_SIZE_A, .sizeX = _MAX_SIZE_X, .sizeY = _MAX_SIZE_AX });
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const simprint = @import_module("<simprint>", .{ .enable = false });

////////////////////////////////////////
// Functions
////////////////////////////////////////
// Use for debugging purposes.
fn initialize(current_level:i16) void {

    if (current_level == layer_index){
        simprint.fmt_with_coords("In layer = {d} INITIALIZE", .{ @as(u32, layer_index) });
        simprint.fmt("M = {d}, N = {d}, R_M = {d}, R_N = {d}, px_start = {d}, py_start = {d}, layer_width = {d}, layer_height = {d}", 
                    .{ @as(u32, M), @as(u32, N), @as(u32, R_M), @as(u32, R_N), @as(u32, px_start), @as(u32, py_start), @as(u32, layer_width), @as(u32, layer_height) });        
        // print the data on this tile
        for (x) |val, i| {
            simprint.fmt_with_coords("x[{d}] = {f}", .{ i, val });
        }
        for (b) |val, i| {
            simprint.fmt_with_coords("b[{d}] = {f}", .{ i, val });
        }
        // print A
        for (A) |val, i| {
            simprint.fmt_with_coords("A[{d}] = {f}", .{ i, val });
        }
        // print R
        for (R) |val, i| {
            simprint.fmt_with_coords("R[{d}] = {f}", .{ i, val });
        }
    }
    simprint.print_string("\n");

}

// Weighted jacobi iteration
// formula: x = (1-omega)*x + omega*(b - A*x)/diag(A)
// Ax is for all values except the diagonal value.
fn jacobi(omega:f32, iterations: i16) void {
    for (@range(i16, iterations)) |iter| {
        // make copy of x into temp.
        var tmp = @zeros([N*1]f32);
        for (@range(i32, N)) |i| {
            tmp[i] = x[i];
        }

        for (@range(i16, M)) |i| {
            var rsum: f32 = 0.0;
            var diag: f32 = A[i*N + i];
            for (@range(i16, N)) |j| {
                if (i != j) {
                    rsum += A[i*N + j] * tmp[j];
                }
            }
            if (diag != 0.0) {
                x[i] = (1.0 - omega) * tmp[i] + omega * (b[i] - rsum) / diag;
            }
        }
    }
}

// V-cycle upward phase implementation
fn v_cycle_up(omega: f32, post_smooth_iterations: i16, current_level: i16) void {
    if (current_level == layer_index) {
        simprint.fmt_with_coords("In layer = {d} V_CYCLE_UP", .{ @as(u32, layer_index) });
        
        // Step 1: Prolongation operator (P * x_coarse)
        for (@range(i16, R_N)) |i| {
            var Px: f32 = 0.0;
            for (@range(i16, R_M)) |j| {
                // P[i*R_M + j] accesses element (i,j) in P matrix
                Px += P[i*R_M + j] * x_coarse[j];
            }
            x[i] += Px;  // Add correction to existing solution
        }

        // Step 2: Post-smoothing
        jacobi(omega, post_smooth_iterations);        
    }
    // Unblock memcpy so that it can send data outside
    sys_mod.unblock_cmd_stream();        
}

// Call initialize and gemv functions
fn v_cycle_down(omega:f32, pre_smooth_iterations: i16, current_level:i16) void {
    if (current_level == layer_index) {
        // simprint.fmt_with_coords("In layer = {d} V_CYCLE_DOWN", .{ @as(u32, layer_index) });    
        // initialize(current_level);

        // 1. Presmoother
        jacobi(omega, pre_smooth_iterations);  
        
        // 2. Compute residual = b - AX
        // Compute AX = A*x
        for (@range(i16, M)) |i| {
            var Ax: f32 = 0.0;
            for (@range(i16, N)) |j| {
                Ax += A[i*N + j] * x[j];
            }
            residual[i] = b[i] - Ax;  // Merged both loops by computing residual here
        }
        
        // 3. Restriction operator  (b_coarse = R * residual)
        for (@range(i16, R_M)) |i| {
            var tmp: f32 = 0.0;
            for (@range(i16, R_N)) |j| {
                tmp += R[i*R_N + j] * residual[j];
            }
            b_coarse[i] = tmp;
        }
    }
    // unblock memcpy so that it can send data outside.
    sys_mod.unblock_cmd_stream();
}


////////////////////////////////////////
// Visibility to outside world
////////////////////////////////////////
comptime {
    @export_symbol(A_ptr, "A");
    @export_symbol(R_ptr, "R");
    @export_symbol(P_ptr, "P");
    @export_symbol(x_ptr, "x");
    @export_symbol(b_ptr, "b");

    // Export function so it is host-callable by RPC mechanism
    @export_symbol(v_cycle_down);
    @export_symbol(v_cycle_up);

    // Export symbol pointing to y so it is host-readable
    @export_symbol(residual_ptr, "residual");
    @export_symbol(b_coarse_ptr, "b_coarse");
    @export_symbol(x_coarse_ptr, "x_coarse");
}

