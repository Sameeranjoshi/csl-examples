param memcpy_params: comptime_struct;

// memcpy module provides infrastructure for copying data
// and launching functions from the host
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const simprint = @import_module("<simprint>", .{ .enable = true });
const layout_module = @import_module("<layout>");

// Return the 0-indexed x and y coord
// Only supported on WSE-2


// Constants definining dimensions of our matrix
const M: i16 = 2;
const N: i16 = 2;

// 48 kB of global memory contain A, x, b, y
var A: [M*N]f32; // A is stored row major
var x: [N]f32;
var b: [M]f32;
var y = @zeros([M]f32); // Initialize y to zero

// DSDs for accessing A, b, y
// A_dsd accesses column of A
var A_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M} -> A[i*N] });
var b_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &b, .extent = M });
var y_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &y, .extent = M });

// ptrs to A, x, b, y will be advertised as symbols to host
var A_ptr: [*]f32 = &A;
var x_ptr: [*]f32 = &x;
var b_ptr: [*]f32 = &b;
const y_ptr: [*]f32 = &y;

// Compute gemv
fn gemv() void {
  // reset A_dsd to the start of A
  A_dsd = @set_dsd_base_addr(A_dsd, &A);

  // Loop over all columns of A
  for (@range(i16, N)) |i| {
    // Calculate contribution to A*x from ith column of A, ith elem of x
    @fmacs(y_dsd, y_dsd, A_dsd, x[i]);
    // Move A_dsd to next column of A
    A_dsd = @increment_dsd_offset(A_dsd, 1, f32);
  }
  // Add b to A*x
  @fadds(y_dsd, y_dsd, b_dsd);
  // print x, y and A after gemv
  
}

fn print_init() void {
const x_coord = layout_module.get_x_coord();
const y_coord = layout_module.get_y_coord();  

    if(x_coord ==0 and y_coord == 0) {
      simprint.print_string("PRINTING BACK AGAIN! x_coord: 0, y_coord: 0\n");
    for (x) |val, i| {
      simprint.fmt_with_coords("x[{d}] = {f}", .{ i, val });
    }
    for (b) |val, i| {
      simprint.fmt_with_coords("b[{d}] = {f}", .{ i, val });
    }
    // y
    for (y) |val, i| {
      simprint.fmt_with_coords("y[{d}] = {f}", .{ i, val });
    }
    // a
    for (A) |val, i| {
      simprint.fmt_with_coords("A[{d}] = {f}", .{ i, val });
    }
    }

    if(x_coord ==1 and y_coord == 1) {
      simprint.print_string("PRINTING BACK AGAIN! x_coord: 1, y_coord: 1\n");
    for (x) |val, i| {
      simprint.fmt_with_coords("x[{d}] = {f}", .{ i, val });
    }
    for (b) |val, i| {
      simprint.fmt_with_coords("b[{d}] = {f}", .{ i, val });
    }
    // y
    for (y) |val, i| {
      simprint.fmt_with_coords("y[{d}] = {f}", .{ i, val });
    }
    // a
    for (A) |val, i| {
      simprint.fmt_with_coords("A[{d}] = {f}", .{ i, val });
    }
    }    

    // for (A) |val, i| {
    //   simprint.fmt_with_coords("A[{d}] = {f}", .{ i, val });
    // }
  sys_mod.unblock_cmd_stream();
}

fn flush() void {

  for (y) |val, i| {
    y[i] = 0.0;
  }
}
// Call initialize and gemv functions
fn init_and_compute() void {
  gemv();
  sys_mod.unblock_cmd_stream();
}

comptime {
  @export_symbol(A_ptr, "A");
  @export_symbol(x_ptr, "x");
  @export_symbol(b_ptr, "b");
  @export_symbol(y_ptr, "y");
  @export_symbol(init_and_compute);
  @export_symbol(print_init);
}
