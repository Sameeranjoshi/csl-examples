// layer_kernel.csl
// Each PE optionally does a tiny "compute": acc += value, repeated 'iters' times.
// Enabled via a boolean param. All layers run the *same* kernel logic.

param enabled: i32;   // set true for PEs that belong to a layer
param value:   i32;    // dumb value to add (same across layers)
param iters:   i32;    // loop count (same across layers)

export var acc: i32;   // readable from host (per-PE symbol)

const main_id = @get_local_task_id(8);


task main() void {
  if (enabled == 1) {
    var a: i32 = 0;
    var i: i32 = 0;
    while (i < iters) : (i += 1) {
      a += value;
    }
    acc = a;
  } else {
    acc = -1; // mark "not in any layer"
  }
  // print the acc
  
}

comptime {
  @bind_local_task(main, main_id);
  @activate(main_id);
}

