+def copy_last_layer_b_next_from_device(simple_memcpy, symbols, ml, total_pe_rows, total_pe_cols, b_level, symbol_name, deviceoperator):
+    """Copy only the last layer's b_next from device and update b_level[-1]"""
+    last_idx = len(ml.levels) - 2  # last layer with R (not the coarsest)
+    size = ml.levels[last_idx].R.shape[0]
+    data_blob = np.zeros(size, dtype=np.float32)
+    d2h_time = time.time()
+    # For b_level, read from last column
+    simple_memcpy.do_memcpy_d2h(data_blob, symbols[symbol_name], total_pe_cols-1, 0, 1, total_pe_rows, size//total_pe_rows)
+    d2h_time = time.time() - d2h_time
+    print(f"\tD2H transfer time (last layer): {d2h_time:.4f}s")
+    print(f"\tD2H data size (last layer): {data_blob.nbytes} bytes")
+    deviceoperator.set_d2h_time(d2h_time)
+    deviceoperator.set_d2h_data_size(data_blob.nbytes)
+    # Split by rows
+    size_per_pe = size // total_pe_rows
+    b_last = []
+    for i in range(total_pe_rows):
+        start_idx = i * size_per_pe
+        end_idx = start_idx + size_per_pe
+        b_last.extend(data_blob[start_idx:end_idx])
+    b_level[last_idx+1] = np.array(b_last)
+    return b_level
+
+def copy_last_layer_x_coarse_to_device(simple_memcpy, simulator, symbols, ml, layer_coordinates_map, x_level, b_level, setup_config, iteration, deviceoperator):
+    print("\n" + "\t" + "-"*40)
+    print("\t" + "│ COPYING LAST LAYER X_COARSE TO DEVICE (column bcast down)")
+    print("\t" + "-"*40)
+    coords = layer_coordinates_map[0]
+    px, py = coords['layer_start_x'], coords['layer_start_y']
+    w, h = coords['layer_pe_cols'], coords['layer_pe_rows']
+    last_idx = len(ml.levels) - 2  # last layer with R (not the coarsest)
+    R_M_last = ml.levels[last_idx].R.shape[0]
+    x_coarse_last = pad_1d(x_level[-1], R_M_last, variable_name=f"x_coarse_last")
+    x_coarse_last_chunks = np.split(x_coarse_last, w)
+    chunk_size = R_M_last // w
+    x_blob = np.concatenate(x_coarse_last_chunks)
+    start_time = time.time()
+    simple_memcpy.do_memcpy_h2d(symbols['x_coarse'], x_blob, px, py, w, 1, chunk_size)
+    h2d_time = time.time() - start_time
+    print(f"\tH2D transfer time (last layer): {h2d_time:.6f}s")
+    print(f"\tH2D data size (last layer): {x_blob.nbytes} bytes")
+    deviceoperator.set_h2d_time(h2d_time)
+    deviceoperator.set_h2d_data_size(x_blob.nbytes)
+
