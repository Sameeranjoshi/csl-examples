param color_1: color;
param pe_id: u32;
param root_id: u32; // *
param POS_DIR: direction;
param NEG_DIR: direction;
param start_index: u32; // *
param end_index: u32; // *

const layer_size: u32 = end_index - start_index + 1;

const simprint = @import_module("<simprint>", .{ .enable = true });
const math = @import_module("<math>");

const distance_from_root: i32 = @as(i32, pe_id) - @as(i32, root_id);
const abs_distance_from_root:u32 = math.abs(distance_from_root);

fn is_PE_diagonal() bool {
  return pe_id == root_id;
}

fn is_PE_right_of_root() bool {
  return distance_from_root > 0 and abs_distance_from_root < layer_size;
}

fn is_PE_left_of_root() bool {
  return distance_from_root < 0 and abs_distance_from_root > start_index;
}

fn is_PE_start_of_layer() bool {
  return pe_id == start_index;
}

fn is_PE_end_of_layer() bool {
  return pe_id == end_index;
}

// TODO: both same
const COLOR_0_OQ = @get_output_queue(5);
const COLOR_0_IQ = @get_input_queue(7);
var fabout = @get_dsd(fabout_dsd, .{ .extent = 1, .fabric_color = color_1, .output_queue=COLOR_0_OQ});
var fabin = @get_dsd(fabin_dsd, .{ .extent = 1, .fabric_color = color_1, .input_queue=COLOR_0_IQ});


fn configure_network() void {
  if (is_PE_diagonal()) {
    if (is_PE_start_of_layer()) {
      @set_local_color_config(color_1, .{.routes = .{.rx = .{RAMP}, .tx = .{POS_DIR}}});
    } else if (is_PE_end_of_layer()) {
      @set_local_color_config(color_1, .{.routes = .{.rx = .{RAMP}, .tx = .{NEG_DIR}}});
    } else {
      @set_local_color_config(color_1, .{.routes = .{.rx = .{RAMP}, .tx = .{NEG_DIR, POS_DIR}}});
    }
  } else {
    if (is_PE_start_of_layer()) {
      @set_local_color_config(color_1, .{.routes = .{.rx = .{POS_DIR}, .tx = .{RAMP}}});
    } else if (is_PE_end_of_layer()) { // this is last PE in layer
      @set_local_color_config(color_1, .{.routes = .{.rx = .{NEG_DIR}, .tx = .{RAMP}}});
    } else if (is_PE_left_of_root()) {
      @set_local_color_config(color_1, .{.routes = .{.rx = .{POS_DIR}, .tx = .{RAMP, NEG_DIR}}});
    } else {
      @set_local_color_config(color_1, .{.routes = .{.rx = .{NEG_DIR}, .tx = .{RAMP, POS_DIR}}});
    }
  }
}

fn transfer_data(mem: mem1d_dsd, count: u16, activate: local_task_id) void {
  // This is microthread-safe as there is only 1 operation on a PE at a time.
  if(is_PE_diagonal()) {
    fabout = @set_dsd_length(fabout, count);
    @fmovs(fabout, mem, .{ .async = true });  // send data to all PEs
  } else { 
    fabin = @set_dsd_length(fabin, count);
    @fmovs(mem, fabin, .{ .async = true });  // receive data from root PE
  }

  @activate(activate);
}