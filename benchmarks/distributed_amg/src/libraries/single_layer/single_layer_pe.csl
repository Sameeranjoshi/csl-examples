fn matvec(N_tile: u16, dsd_mv_tile: mem1d_dsd, dsd_matrix_tile: mem1d_dsd, vector_tile_data: [*]const f32) void {
  @fmovs(dsd_mv_tile, 0.0); // Initialize result to 0
  var matrix_dsd = dsd_matrix_tile; // Create a mutable copy of the DSD
  
  for (@range(u16, N_tile)) |j| {
    @fmacs(dsd_mv_tile, dsd_mv_tile, matrix_dsd, vector_tile_data[j]);
    matrix_dsd = @increment_dsd_offset(matrix_dsd, 1, f32);
  }
}

// New formula implementation: Jacobi iteration logic (new formula)
// formula: x = (Identity-omega*D_inv*A_tile)*x_tile
// x_tile[i] = (1.0 - omega) * temp_tile[i] + omega * (b_tile[i] - rsum) / diag;
// The diagonal PEs add the term_1 so that we don't have to gather on diag PE.

fn jacobi_local() void {
  dsd_A_tile = @set_dsd_base_addr(dsd_A_tile, &A_tile); // make sure you do this before
  // compute_mv_per_tile(N_local, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));  // Ax(vector) = Ax(matrix * vector)
  matvec(N_local_i, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));  // Ax(vector) = Ax(matrix * vector)
  @fmuls(dsd_w_dinv_a_x, dsd_D_inv, dsd_Ax); // tmp = D_inv * Ax (vector * vector)
  @fmuls(dsd_w_dinv_a_x, omega[0], dsd_w_dinv_a_x); // tmp = w * D_inv * Ax (scalar * vector)

  if (px == py) { // good speedup.
    @fmovs(dsd_i_into_x, dsd_x_tile); // I*x = x
    // save some operatioons can be effective if PE grid large enough.
  } // otherwise, 0.0

  @fsubs(dsd_term_2, dsd_i_into_x, dsd_w_dinv_a_x); // tmp = I*x - omega * D_inv * Ax

  if (px == py) { // omega * D_inv * b
    @fmuls(dsd_w_dinv_a_x, dsd_D_inv, dsd_b_tile); // tmp = D_inv * b (vector * vector)
    @fmuls(dsd_w_dinv_a_x, omega[0], dsd_w_dinv_a_x); // tmp = omega * D_inv * b (scalar * vector)
    @fadds(dsd_term_2, dsd_w_dinv_a_x, dsd_term_2); // term_2 = omega * D_inv * b + term_2
  }
}

// Ax = A_local * x_local
fn residual_local() void {
  dsd_A_tile = @set_dsd_base_addr(dsd_A_tile, &A_tile); // make sure you do this before
  // compute_mv_per_tile(N_local, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));  // Ax = A_tile * x_tile
  matvec(N_local_i, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));  // Ax = A_tile * x_tile
}


fn inverse_callback(val: f32) f32 {
  return if (val != 0.0) math_lib.inv(val) else 0.0;
}


// State machine trigger function
fn f_trigger_state_machine() void {
  cur_state = next_state; // go to next state
  @activate(STATE_MACHINE);   
}

// Compute Jacobi iteration
fn compute_jacobi() void {
  jacobi_local();  // updates term_2
  // notice the py instead of 0.
  cur_state = next_state;
  mpi_x.reduce_fadds(py, @ptrcast([*]f32, &term_2), @ptrcast([*]f32, &x_tile),
                     M_local_i, STATE_MACHINE); // reduce across rows towards left
}

fn bcast_jacobi() void {
  cur_state = next_state;
  mpi_y.broadcast(px, @ptrcast([*]u32, &x_tile), N_local_i, STATE_MACHINE);
}

// Compute residual
fn compute_residual() void {
  residual_local(); // has answers in dsd_Ax
  cur_state = next_state;
  mpi_x.reduce_fadds(py, @ptrcast([*]f32, &Ax), @ptrcast([*]f32, &residual_tile),
                     M_local_i, STATE_MACHINE); // reduce across rows towards left
}

// bcast(residual_tile) to all PEs.
fn bcast_residual() void {
  if (px == py) {
    @fsubs(dsd_residual_tile, dsd_b_tile, dsd_residual_tile);  // r = b - Ax
  }
  cur_state = next_state;
  mpi_y.broadcast(px, @ptrcast([*]u32, &residual_tile), M_local_i, STATE_MACHINE);
}

// Compute restriction
fn compute_restriction() void {
  dsd_R_tile = @set_dsd_base_addr(dsd_R_tile, &R_tile); // make sure you do this before
  // compute_mv_per_tile(R_N_local, dsd_Rx, dsd_R_tile, @ptrcast([*]const f32, &residual_tile));
  matvec(R_N_local_i, dsd_Rx, dsd_R_tile, @ptrcast([*]const f32, &residual_tile));
  cur_state = next_state;
  mpi_x.reduce_fadds(layer_kernel_cols-1, @ptrcast([*]f32, &Rx), @ptrcast([*]f32, &b_next),
                     R_M_local_i, STATE_MACHINE); // reduce across rows towards left
}

// Compute prolongation
fn compute_prolongation() void {
  dsd_P_tile = @set_dsd_base_addr(dsd_P_tile, &P_tile); // make sure you do this before
  // compute_mv_per_tile(R_M_local, dsd_Px, dsd_P_tile, @ptrcast([*]const f32, &x_coarse));
  matvec(R_M_local_i, dsd_Px, dsd_P_tile, @ptrcast([*]const f32, &x_coarse));
  cur_state = next_state;
  mpi_x.reduce_fadds(py, @ptrcast([*]f32, &Px), @ptrcast([*]f32, &px_sum_tile),
                     R_N_local_i, STATE_MACHINE); // reduce across rows towards left  
}

fn bcast_prolongation() void {
  if (px == py) {
    @fadds(dsd_x_tile, dsd_x_tile, dsd_px_sum_tile);  // x_tile = x_tile + Px
  }
  cur_state = next_state;
  mpi_y.broadcast(px, @ptrcast([*]u32, &x_tile), N_local_i, STATE_MACHINE);
}

fn no_op() void {
  // simprint.print_string("no_op\n");
}

// Helpers

fn is_first_layer() bool {
  return current_active_layer_index == 0;
}

fn is_last_layer() bool {
  return current_active_layer_index == total_levels_count - 1;
}

fn is_layer_last_column() bool {
  return pe_id_x == layer_end_x - 1;
}

fn is_layer_first_column() bool {
  return pe_id_x == layer_start_x;
}

fn is_rectangle_last_column() bool {
  return is_layer_last_column();
}

fn is_rectangle_first_column() bool {
  return is_layer_first_column();
}

//// blob and memcpy helper routines.
// create the layer size map and offset map.
fn layeridx_to_size_map(comptime data: comptime_string) [total_levels_count]u16 {
  var result = @zeros([total_levels_count]u16);
  for (layers_data) |layer_data, index| {
  // layer params
    const M_local: u16 = layer_data.M_local; 
    const N_local: u16 = layer_data.N_local; 
    const R_M_local: u16 = layer_data.R_M_local; 
    const R_N_local: u16 = layer_data.R_N_local; 
    if (data == "A") {
      result[index] = M_local * N_local;
    } else if (data == "R") {
      result[index] = R_M_local * R_N_local;
    } else if (data == "P") {
      result[index] = R_N_local * R_M_local;
    } else if (data == "x") {
      result[index] = N_local;
    } else if (data == "b") {
      result[index] = M_local;
    } else if (data == "x_coarse") {
      result[index] = R_M_local;
    } else {
      @compileError("Invalid string for layeridx_to_size_map");
    }
  }
  return result;
}
fn layeridx_to_offset_map(comptime data: comptime_string) [total_levels_count]u16 {
  var result = @zeros([total_levels_count]u16);
  var running_sum: u16 = 0;
  for (layers_data) |layer_data, index| {
  // layer params
    const M_local: u16 = layer_data.M_local; 
    const N_local: u16 = layer_data.N_local; 
    const R_M_local: u16 = layer_data.R_M_local; 
    const R_N_local: u16 = layer_data.R_N_local; 
    if (data == "A") {
      result[index] = running_sum;
      running_sum += M_local * N_local;
    } else if (data == "R") {
      result[index] = running_sum;
      running_sum += R_M_local * R_N_local;
    } else if (data == "P") {
      result[index] = running_sum;
      running_sum += R_N_local * R_M_local;
    } else if (data == "x") {
      result[index] = running_sum;
      running_sum += N_local;
    } else if (data == "b") {
      result[index] = running_sum;
      running_sum += M_local;
    } else if (data == "x_coarse") {
      result[index] = running_sum;
      running_sum += R_M_local;
    } else {
      @compileError("Invalid string for layeridx_to_offset_map");
    }
  }
  return result;
}
fn get_total_size_of(comptime data: comptime_string) u16 {
  var total_size_of_data: u16 = 0;
    for (layers_data) |layer_data| {
        // layer params
        const M_local: u16 = layer_data.M_local; 
        const N_local: u16 = layer_data.N_local; 
        const R_M_local: u16 = layer_data.R_M_local; 
        const R_N_local: u16 = layer_data.R_N_local; 
        if (data == "A") {
          total_size_of_data += M_local * N_local;
        } else if (data == "R") {
          total_size_of_data += R_M_local * R_N_local;
        } else if (data == "P") {
          total_size_of_data += R_N_local * R_M_local;
        } else if (data == "x") {
          total_size_of_data += N_local;
        } else if (data == "b") {
          total_size_of_data += M_local;
        } else if (data == "x_coarse") {
          total_size_of_data += R_M_local;
        } else {
          @compileError("Invalid string for get_total_size_of");
        }
    }
    return total_size_of_data;
}

fn get_size(layer_size_map: *const [total_levels_count] u16,  index: u16) u16 {
  @assert(index < total_levels_count);
  return (layer_size_map.*)[index];
}
fn get_offset(layer_offset_map: *const [total_levels_count] u16, index: u16) u16 {
  @assert(index < total_levels_count);
  return (layer_offset_map.*)[index];
}