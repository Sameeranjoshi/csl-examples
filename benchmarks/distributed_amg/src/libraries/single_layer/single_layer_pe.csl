 // params
param memcpy_params: comptime_struct;
param c2d_params: comptime_struct;
param common_params: comptime_struct;
param pe_id_x: u16;
param pe_id_y: u16;
param total_pe_cols: u16;
param total_levels_count: u16;
param layers_data: [total_levels_count]comptime_struct;
// [.M, .N, .M_local, .N_local, .R_M_local, .R_N_local, .layer_index]
param runtime_data: [total_levels_count, 7]u16;

// // // layer params
var M_i: u16; // Height of local matrix, or num rows per PE
var N_i: u16; // Width of local matrix, or num cols per PE
var M_local_i: u16; // Height of local matrix, or num rows per PE
var N_local_i: u16; // Width of local matrix, or num cols per PE
var R_M_local_i: u16; // Height of local matrix, or num rows per PE
var R_N_local_i: u16; // Width of local matrix, or num cols per PE
var layer_index_i: u16;

// var index: u16 = 0;
// const M_local1: u16 = layers_data[index].M_local; 

// common params
const layer_start_x: u16 = common_params.layer_start_x;
const layer_start_y: u16 = common_params.layer_start_y;
const layer_end_x: u16 = common_params.layer_end_x;
const layer_end_y: u16 = common_params.layer_end_y;
const layer_kernel_rows: u16 = common_params.layer_kernel_rows;
const layer_kernel_cols: u16 = common_params.layer_kernel_cols;
const STATE_MACHINE: local_task_id = common_params.layer_task_id[0];

// Task IDs
const STATE_INIT: u16 = 1;
const STATE_EXIT: u16 = 2;
const STATE_COMPUTE_JACOBI: u16 = 3;
const STATE_BCAST_JACOBI: u16 = 4;
const STATE_CHECK_JACOBI_ITERATION: u16 = 5;
const STATE_COMPUTE_RESIDUAL: u16 = 6;
const STATE_BCAST_RESIDUAL: u16 = 7;
const STATE_COMPUTE_RESTRICTION: u16 = 8;
const STATE_PROLONGATION: u16 = 9;
const STATE_BCAST_PROLONGATION: u16 = 10;

// bridge colors
const bcast_color  : color         = @get_color(4); // This is also activating color.
// state_machine tasks(8,9,10,11,12)
const state_exit_id: local_task_id = @get_local_task_id(13);
// tasks
const recv_b_tile_id: data_task_id = @get_data_task_id(bcast_color); //This should unblock
const exit_task_id: local_task_id = @get_local_task_id(14);
const bcast_b_tile_id: local_task_id = @get_local_task_id(15);
const done_task_id: local_task_id = @get_local_task_id(17);
// Queue IDs
const send_bcast_oq = @get_output_queue(1);
const send_bcast_iq = @get_input_queue(0);


const math_lib = @import_module("<math>");
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const mpi_x = @import_module("<collectives_2d/pe>", .{
    .dim_params = c2d_params.x,
    .queues = [2]u16{2,4},
    .dest_dsr_ids = [1]u16{1},
    .src0_dsr_ids = [1]u16{1},
    .src1_dsr_ids = [1]u16{1}
    });
const mpi_y = @import_module("<collectives_2d/pe>", .{
    .dim_params = c2d_params.y,
    .queues = [2]u16{3,5},
    .dest_dsr_ids = [1]u16{2},
    .src0_dsr_ids = [1]u16{2},
    .src1_dsr_ids = [1]u16{2}
    });
const simprint = @import_module("<simprint>", .{ .enable = true });

// Layers_data has shape for each level, M0, M1, M2, ... 
// meta data for each level.
// size map = [M0, M1, M2, ...]
// offset map = [0, M0, M0 + M1, M0 + M1 + M2, ...]
const layer_size_map_A = comptime layeridx_to_size_map("A");  
const layer_offset_map_A = comptime layeridx_to_offset_map("A");  
const layer_size_map_R = comptime layeridx_to_size_map("R");  
const layer_offset_map_R = comptime layeridx_to_offset_map("R");
const layer_size_map_P = comptime layeridx_to_size_map("P");  
const layer_offset_map_P = comptime layeridx_to_offset_map("P");
const layer_size_map_x = comptime layeridx_to_size_map("x");  
const layer_offset_map_x = comptime layeridx_to_offset_map("x");
const layer_size_map_b = comptime layeridx_to_size_map("b");  
const layer_offset_map_b = comptime layeridx_to_offset_map("b");

// total sizes 
const A_tiles_total_size: u16 = comptime get_total_size_of("A");
const R_tiles_total_size: u16 = comptime get_total_size_of("R");
const P_tiles_total_size: u16 = comptime get_total_size_of("P");
const x_tiles_total_size: u16 = comptime get_total_size_of("x");
const b_tiles_total_size: u16 = comptime get_total_size_of("b");
const x_coarse_total_size: u16 = comptime get_total_size_of("x_coarse");


// var dsd_A_tiles = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> A_tiles[i] });

//x, b, A, R will be partitioned using 2D Block decomposition.
// input
// init_data_blob(size, value, type)
var A_tile = @zeros([A_tiles_total_size]f32);
var R_tile = @zeros([R_tiles_total_size]f32);
var P_tile = @zeros([P_tiles_total_size]f32);  // transpose of R_tile
var x_tile = @zeros([x_tiles_total_size]f32);
var b_tile = @zeros([b_tiles_total_size]f32);
var x_coarse = @zeros([x_coarse_total_size]f32);  // P @ x_coarse( So x_coarse has to match 2nd dim of P.)
var omega = @zeros([1]f32);
var iterations = @constants([1]u32, 0); // default is 0 iteration.

var dsd_A_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> A_tile[i] }); // 1 col of A_tile
var dsd_A_diag = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> A_tile[i] });
var dsd_R_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> R_tile[i] }); // 1 col of R_tile
var dsd_P_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> P_tile[i] }); // 1 col of P_tile
var dsd_x_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> x_tile[i]});
var dsd_b_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> b_tile[i]});

// temporary variables on each PE.
// The product of Ax or Rx or any other matrix-vector product.
// var Ax = @zeros([M_local]f32);  //Ax
// var Rx = @zeros([R_M_local]f32);  // Rr
// var Px = @zeros([R_N_local]f32);  // Px = P @ x_coarse
// var residual_tile = @zeros([M_local]f32);
// var term_2 = @zeros([M_local]f32);
// var px_sum_tile = @zeros([N_local]f32);
// var D_inv = @zeros([M_local]f32); // vector of diagonals of A_tile
// var w_dinv_a_x = @zeros([M_local]f32);
// var i_into_x = @zeros([M_local]f32);
// var iter_count: i32 = 0;
// var dot = @zeros([1]f32);
var Ax = @zeros([1]f32);  //Ax
var Rx = @zeros([1]f32);  // Rr
var Px = @zeros([1]f32);  // Px = P @ x_coarse
var residual_tile = @zeros([1]f32);
var term_2 = @zeros([1]f32);
var px_sum_tile = @zeros([1]f32);
var D_inv = @zeros([1]f32); // vector of diagonals of A_tile
var w_dinv_a_x = @zeros([1]f32);
var i_into_x = @zeros([1]f32);
var iter_count: u32 = 0;
var dot = @zeros([1]f32);


var dsd_Ax =            @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> Ax[i]});
var dsd_Rx =            @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> Rx[i]});
var dsd_Px =            @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> Px[i]});
var dsd_residual_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> residual_tile[i]});
var dsd_D_inv =         @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> D_inv[i] });
var dsd_term_2 =        @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> term_2[i] });
var dsd_px_sum_tile =   @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> px_sum_tile[i] });
var dsd_w_dinv_a_x =    @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> w_dinv_a_x[i] });
var dsd_i_into_x =      @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> i_into_x[i] });

// output
var b_next = @zeros([1]f32);  // rightmost Column
var dsd_b_next = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> b_next[i] });


// Pointers and advertised outside
var ptr_x : [*]f32 = &x_tile;
var ptr_b : [*]f32 = &b_tile;
var ptr_A : [*]f32 = &A_tile;
var ptr_R : [*]f32 = &R_tile;
var ptr_P : [*]f32 = &P_tile;
var ptr_x_coarse : [*]f32 = &x_coarse;
var ptr_b_next : [*]f32 = &b_next;
var ptr_omega: [*]f32 = &omega;
var ptr_iter: [*]u32 = &iterations;


// temp variables
// Updated at runtime to store x and y IDs of PE reported by collectives library
var px: u16;
var py: u16;
var is_v_cycle_up: bool = false;
var v_cycle_iteration: i32 = 0;
var cur_state: u16 = 0;// State tracking variables
var next_state: u16 = 0;
var current_active_layer_index: u16 = 0;

const M_local_infinite:u16 = 0x7fff;

task bcast_b_tile() void {
  
  // var M_local = layers_data[current_active_layer_index].M_local; // M_local
  const out_dsd = @get_dsd(fabout_dsd, .{
                    .fabric_color = bcast_color, 
                    .extent = M_local_infinite,
                    .output_queue = send_bcast_oq,
                  });
  cur_state = STATE_EXIT;
  @fmovs(out_dsd, dsd_b_tile, .{ .async = true, .activate = STATE_MACHINE });
}

// Use to keep track of # of invocations of recv_x task
// when num_recv_x == N_per_PE, we are done receiving x elements
var num_recv_b_tile: u16 = 0;

task recv_b_tile(b_val: f32) void {
  const M_local = runtime_data[current_active_layer_index, 2]; // M_local
  // wavelet print
  simprint.fmt_with_coords("Received b_val = {f}", .{ b_val });
  b_tile[num_recv_b_tile] = b_val;

  num_recv_b_tile += 1;
  if (num_recv_b_tile == M_local) {
    simprint.fmt_with_coords("unblocked layer_index={d}", .{ @as(u32, current_active_layer_index) });
    cur_state = STATE_INIT;
    @unblock(STATE_MACHINE);
    @activate(STATE_MACHINE);
    
  }
}

// Exit task
task exit_task() void {
  simprint.fmt_with_coords("exit_task {d}", .{ @as(u32, current_active_layer_index) });
  sys_mod.unblock_cmd_stream();
}

task done_task() void {
  simprint.fmt_with_coords("done_task {d}", .{ @as(u32, current_active_layer_index) });
  // print D_inv after broadcast
  for (D_inv) |val, i| {
      simprint.fmt_with_coords("D_inv_after_broadcast[{d}] = {f}", .{ i, @as(f32, val) });
  }
  // Update state and unblock state machine
  cur_state = next_state;
  @unblock(STATE_MACHINE);
  @activate(STATE_MACHINE);
}

task state_exit() void {
  simprint.print_string("STATE_EXIT\n");
  for (b_next) |val, i| {
      simprint.fmt_with_coords("b_next[{d}] = {f}", .{ i, val });
  }
  sys_mod.unblock_cmd_stream();
}

// Main state machine task
task f_state() void {
  switch (cur_state) {
      STATE_INIT => state_init(),
      STATE_COMPUTE_JACOBI => state_compute_jacobi(),
      STATE_BCAST_JACOBI => state_bcast_jacobi(),
      STATE_CHECK_JACOBI_ITERATION => state_check_jacobi(),
      STATE_COMPUTE_RESIDUAL => state_compute_residual(),
      STATE_BCAST_RESIDUAL => state_bcast_residual(),
      STATE_COMPUTE_RESTRICTION => state_compute_restriction(),
      STATE_PROLONGATION => state_prolongation(),
      STATE_BCAST_PROLONGATION => state_bcast_prolongation(),
      STATE_EXIT => @activate(state_exit_id),
      else => {
          simprint.print_string("Error: unknown state\n");
          @assert(false);
          sys_mod.unblock_cmd_stream();
      }
  }
}


fn init_dsds(layer_index: u16) void {
// This function tries to generate below dsd for given input level index using runtime properties.
// var dsd_A_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> A_tile[i*@as(i16, N_local)] }); // 1 col of A_tile
// var dsd_A_diag = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> A_tile[i*N_local + i] });
// var dsd_R_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> R_tile[i*@as(i16, R_N_local)] }); // 1 col of R_tile
// var dsd_P_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_N_local} -> P_tile[i*@as(i16, R_M_local)] }); // 1 col of P_tile
// var dsd_x_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N_local} -> x_tile[i]});
// var dsd_b_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> b_tile[i]});

  // Reset completely else the next iteration starts from the first layers dsd equations and produces wrong results.
  dsd_A_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> A_tile[i] }); // 1 col of A_tile
  dsd_A_diag = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> A_tile[i] });
  dsd_R_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> R_tile[i] }); // 1 col of R_tile
  dsd_P_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> P_tile[i] }); // 1 col of P_tile
  dsd_x_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> x_tile[i]});
  dsd_b_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> b_tile[i]});


  // set base
  dsd_A_tile = @set_dsd_base_addr(dsd_A_tile, &A_tile);
  dsd_A_diag = @set_dsd_base_addr(dsd_A_diag, &A_tile);
  dsd_R_tile = @set_dsd_base_addr(dsd_R_tile, &R_tile);
  dsd_P_tile = @set_dsd_base_addr(dsd_P_tile, &P_tile);
  dsd_x_tile = @set_dsd_base_addr(dsd_x_tile, &x_tile);
  dsd_b_tile = @set_dsd_base_addr(dsd_b_tile, &b_tile);

  // increment to the current levels offset.
  const offset_A = @as(i16, get_offset(&layer_offset_map_A, layer_index));
  const offset_A_diag = @as(i16, get_offset(&layer_offset_map_A, layer_index));
  const offset_R = @as(i16, get_offset(&layer_offset_map_R, layer_index));
  const offset_P = @as(i16, get_offset(&layer_offset_map_P, layer_index));
  const offset_x = @as(i16, get_offset(&layer_offset_map_x, layer_index));
  const offset_b = @as(i16, get_offset(&layer_offset_map_b, layer_index));


  dsd_A_tile = @increment_dsd_offset(dsd_A_tile, offset_A, f32);
  dsd_A_diag = @increment_dsd_offset(dsd_A_diag, offset_A_diag, f32);
  dsd_R_tile = @increment_dsd_offset(dsd_R_tile, offset_R, f32);
  dsd_P_tile = @increment_dsd_offset(dsd_P_tile, offset_P, f32);
  dsd_x_tile = @increment_dsd_offset(dsd_x_tile, offset_x, f32);
  dsd_b_tile = @increment_dsd_offset(dsd_b_tile, offset_b, f32);

  // get shapes of the data.
  // [.M, .N, .M_local, .N_local, .R_M_local, .R_N_local, .layer_index]
  M_i = runtime_data[layer_index, 0];
  N_i = runtime_data[layer_index, 1]; 
  M_local_i = runtime_data[layer_index, 2];
  N_local_i = runtime_data[layer_index, 3];
  R_M_local_i = runtime_data[layer_index, 4];
  R_N_local_i = runtime_data[layer_index, 5];
  layer_index_i = runtime_data[layer_index, 6]; 

  // dsd_A_tile
  // print dsd_A_tile
  if (pe_id_x == 0 and pe_id_y == 0) {
    simprint.print_string("offset_A = ");
    simprint.print_u16_decimal(@as(u16, offset_A));
    simprint.print_string("M_i = ");
    simprint.print_u16_decimal(M_i);
    simprint.print_string("N_i = ");
    simprint.print_u16_decimal(N_i);
    simprint.print_string("M_local_i = ");
    simprint.print_u16_decimal(M_local_i);
    simprint.print_string("N_local_i = ");
    simprint.print_u16_decimal(N_local_i);
    simprint.print_string("R_M_local_i = ");
    simprint.print_u16_decimal(R_M_local_i);
    simprint.print_string("R_N_local_i = ");
    simprint.print_u16_decimal(R_N_local_i);
    simprint.print_string("dsd_A_tile after setting base and offset\n");
    @map(print_dsd, dsd_A_tile);
  }
  dsd_A_tile = @set_dsd_length(dsd_A_tile, (M_local_i));
  dsd_A_tile = @set_dsd_stride(dsd_A_tile, @as(i8, N_local_i)); // |i|{M_local} -> A_tiles[i*N_local]

  // dsd_A_diag
  // Trickier - diagonal can be a stride of N_local + 1
  dsd_A_diag = @set_dsd_length(dsd_A_diag, (M_local_i));
  dsd_A_diag = @set_dsd_stride(dsd_A_diag, @as(i8, N_local_i + 1)); // |i|{M_local} -> A_tiles[i*N_local + i]

  // dsd_R_tile
  dsd_R_tile = @set_dsd_length(dsd_R_tile, (R_M_local_i));
  dsd_R_tile = @set_dsd_stride(dsd_R_tile, @as(i8, R_N_local_i)); // |i|{R_M_local} -> R_tiles[i*R_N_local]

  // dsd_P_tile
  dsd_P_tile = @set_dsd_length(dsd_P_tile, (R_N_local_i));
  dsd_P_tile = @set_dsd_stride(dsd_P_tile, @as(i8, R_M_local_i)); // |i|{R_N_local} -> P_tiles[i*R_M_local]

  // dsd_x_tile
  dsd_x_tile = @set_dsd_length(dsd_x_tile, (N_local_i));
  dsd_x_tile = @set_dsd_stride(dsd_x_tile, @as(i8, 1)); // |i|{N_local} -> x_tiles[i]

  // dsd_b_tile
  dsd_b_tile = @set_dsd_length(dsd_b_tile, (M_local_i));
  dsd_b_tile = @set_dsd_stride(dsd_b_tile, @as(i8, 1)); // |i|{M_local} -> b_tiles[i]



  // temporaries

  // var dsd_Ax = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> Ax[i]});
  // var dsd_Rx = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> Rx[i]});
  // var dsd_Px = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_N_local} -> Px[i]});
  // var dsd_residual_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> residual_tile[i]});
  // var dsd_D_inv = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> D_inv[i] });
  // var dsd_term_2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> term_2[i] });
  // var dsd_px_sum_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N_local} -> px_sum_tile[i] });
  // var dsd_w_dinv_a_x = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> w_dinv_a_x[i] });
  // var dsd_i_into_x = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> i_into_x[i] });

  dsd_Ax = @set_dsd_base_addr(dsd_Ax, &Ax);
  dsd_Rx = @set_dsd_base_addr(dsd_Rx, &Rx);
  dsd_Px = @set_dsd_base_addr(dsd_Px, &Px);
  dsd_residual_tile = @set_dsd_base_addr(dsd_residual_tile, &residual_tile);
  dsd_D_inv = @set_dsd_base_addr(dsd_D_inv, &D_inv);
  dsd_term_2 = @set_dsd_base_addr(dsd_term_2, &term_2);
  dsd_px_sum_tile = @set_dsd_base_addr(dsd_px_sum_tile, &px_sum_tile);
  dsd_w_dinv_a_x = @set_dsd_base_addr(dsd_w_dinv_a_x, &w_dinv_a_x);
  dsd_i_into_x = @set_dsd_base_addr(dsd_i_into_x, &i_into_x);

  dsd_Ax = @set_dsd_length(dsd_Ax, (M_local_i));
  dsd_Rx = @set_dsd_length(dsd_Rx, (R_M_local_i));
  dsd_Px = @set_dsd_length(dsd_Px, (R_N_local_i));
  dsd_residual_tile = @set_dsd_length(dsd_residual_tile, (M_local_i));
  dsd_D_inv = @set_dsd_length(dsd_D_inv, (M_local_i));
  dsd_term_2 = @set_dsd_length(dsd_term_2, (M_local_i));
  dsd_px_sum_tile = @set_dsd_length(dsd_px_sum_tile, (N_local_i));
  dsd_w_dinv_a_x = @set_dsd_length(dsd_w_dinv_a_x, (M_local_i));
  dsd_i_into_x = @set_dsd_length(dsd_i_into_x, (M_local_i));


  // output
  // var b_next = @zeros([R_M_local]f32);  // rightmost Column
  // var dsd_b_next = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> b_next[i] });

  dsd_b_next = @set_dsd_base_addr(dsd_b_next, &b_next);
