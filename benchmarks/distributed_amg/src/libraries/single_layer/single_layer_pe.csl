fn print_dsd(value: f32) void {
  simprint.fmt_with_coords(" Value[] = {f}", .{value});
}

fn trigger_layer() void {
  init_dsds(current_active_layer_index);
}

// // Entrypoint into kernel
fn v_cycle_down() void {
  for (@range(u16, total_levels_count)) |level| {
    current_active_layer_index = level;
    simprint.fmt_with_coords("current_active_layer_index = {d}", .{current_active_layer_index});
    trigger_layer();
  }
  // cur_state = STATE_INIT;
  // @activate(STATE_MACHINE);
  // if (is_first_layer() and is_rectangle_first_column()) {
  //   bcast_b_tile();
  //   // bcast_b_tile_fabric();
  // }
}


//########################################################################################
// Dataflow and Routing.
//########################################################################################
comptime {
  @block(STATE_MACHINE);
  // Bind all state tasks
  @bind_local_task(f_state, STATE_MACHINE);
  @bind_local_task(state_exit, state_exit_id);
  @bind_local_task(exit_task, exit_task_id);
  @bind_local_task(bcast_b_tile, bcast_b_tile_id);
  @bind_local_task(done_task, done_task_id);
  // data task
  @bind_data_task(recv_b_tile, recv_b_tile_id);

  @export_symbol(ptr_A, "A");
  @export_symbol(ptr_x, "x");
  @export_symbol(ptr_b, "b");
  @export_symbol(ptr_R, "R");
  @export_symbol(ptr_P, "P");
  @export_symbol(ptr_x_coarse, "x_coarse");
  @export_symbol(ptr_b_next, "b_next");
  @export_symbol(ptr_omega, "omega");
  @export_symbol(ptr_iter, "iterations");
  @export_symbol(v_cycle_down);
  @export_symbol(layout_print); // prints layout of A

  
  configure_dataflow_bridge();

}

fn configure_dataflow_bridge() void {
  if (is_layer_first_column()) {
    @set_local_color_config(bcast_color, .{.routes = .{ .rx = .{RAMP}, .tx = .{EAST, RAMP}  }});
  } else if (is_layer_last_column()) {
    @set_local_color_config(bcast_color, .{.routes = .{ .rx = .{WEST}, .tx = .{RAMP}  }});
  } else {
    @set_local_color_config(bcast_color, .{.routes = .{ .rx = .{WEST}, .tx = .{EAST, RAMP}  }});
  }
}

//########################################################################################
// Can be a library instead.
//########################################################################################

fn initialize() void {
  init_params();
  if (px == py) {
      @map(inverse_callback, dsd_A_diag, dsd_D_inv);
  }
  cur_state = next_state;
  mpi_x.broadcast(py, @ptrcast([*]u32, &D_inv), M_local_i, STATE_MACHINE);
}

fn init_params() void {
  mpi_x.init();
  mpi_y.init();
  px = mpi_x.pe_id - @as(u16, layer_start_x);
  py = mpi_y.pe_id - @as(u16, layer_start_y);

  v_cycle_iteration += 1;
  is_v_cycle_up = false;
  iter_count = 0;  
}

// State machine tasks
fn state_init() void {
  simprint.fmt_with_coords("STATE_INIT, layer_index={d}", .{ @as(u32, current_active_layer_index) });
  next_state = STATE_COMPUTE_JACOBI;
  initialize();
}

fn state_compute_jacobi() void {
  simprint.print_string("STATE_COMPUTE_JACOBI\n");
  iter_count += 1;
  next_state = STATE_BCAST_JACOBI;
  compute_jacobi();
}

fn state_bcast_jacobi() void {
  next_state = STATE_CHECK_JACOBI_ITERATION;
  bcast_jacobi();
}

fn state_check_jacobi() void {
  if (iter_count < iterations[0]) {
      next_state = STATE_COMPUTE_JACOBI;
  } else {
      if (is_v_cycle_up) {
          next_state = STATE_EXIT;
      } else {
          next_state = STATE_COMPUTE_RESIDUAL;
      }
  }
  f_trigger_state_machine();
}

fn state_compute_residual() void {
  simprint.print_string("STATE_COMPUTE_RESIDUAL\n");
  next_state = STATE_BCAST_RESIDUAL;
  compute_residual();
}

fn state_bcast_residual() void {
  next_state = STATE_COMPUTE_RESTRICTION;
  bcast_residual();
}

fn state_compute_restriction() void {
  simprint.print_string("STATE_COMPUTE_RESTRICTION\n");
  current_active_layer_index += 1;
  if (current_active_layer_index <= total_levels_count - 1) {
    trigger_layer();
    next_state = STATE_INIT;
  } else {
    next_state = STATE_EXIT;
  }
  compute_restriction();

}

fn state_prolongation() void {
  simprint.print_string("STATE_PROLONGATION\n");
  next_state = STATE_BCAST_PROLONGATION;
  compute_prolongation();
}

fn state_bcast_prolongation() void {
  simprint.print_string("STATE_BCAST_PROLONGATION\n");
  next_state = STATE_CHECK_JACOBI_ITERATION;
  bcast_prolongation();
}

