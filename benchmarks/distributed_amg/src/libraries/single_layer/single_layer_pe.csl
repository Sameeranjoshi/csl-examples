param memcpy_params: comptime_struct;
param c2d_params: comptime_struct;
param common_params: comptime_struct;
param pe_id_x: u16;
param pe_id_y: u16;
param total_levels_count: u16;
param layers_data: [total_levels_count]comptime_struct;
// [.M, .N, .M_local, .N_local, .R_M_local, .R_N_local, .layer_index]
param runtime_data: [total_levels_count, 7]u16;

// common params
const layer_start_x: u16 = common_params.layer_start_x;
const layer_start_y: u16 = common_params.layer_start_y;
const layer_end_x: u16 = common_params.layer_end_x;
const layer_end_y: u16 = common_params.layer_end_y;
const layer_kernel_rows: u16 = common_params.layer_kernel_rows;
const layer_kernel_cols: u16 = common_params.layer_kernel_cols;
const STATE_MACHINE: local_task_id = common_params.layer_task_id[0];

// Task IDs
const STATE_INIT: u16 = 1;
const STATE_EXIT: u16 = 2;
const STATE_COMPUTE_JACOBI: u16 = 3;
const STATE_BCAST_JACOBI: u16 = 4;
const STATE_CHECK_JACOBI_ITERATION: u16 = 5;
const STATE_COMPUTE_RESIDUAL: u16 = 6;
const STATE_BCAST_RESIDUAL: u16 = 7;
const STATE_COMPUTE_RESTRICTION: u16 = 8;
const STATE_PROLONGATION: u16 = 9;
const STATE_BCAST_PROLONGATION: u16 = 10;
const STATE_BCAST_B_TILE_RIGHT: u16 = 11;
const STATE_NEXT_LAYER_CHECK: u16 = 12;

const state_exit_id: local_task_id = @get_local_task_id(14);
const no_op_id: local_task_id = @get_local_task_id(15);
// Queue IDs
const send_bcast_oq = @get_output_queue(1);
const send_bcast_iq = @get_input_queue(0);


// Libraries
const math_lib = @import_module("<math>");
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const mpi_x = @import_module("<collectives_2d/pe>", .{
    .dim_params = c2d_params.x,
    .queues = [2]u16{2,4},
    .dest_dsr_ids = [1]u16{1},
    .src0_dsr_ids = [1]u16{1},
    .src1_dsr_ids = [1]u16{1}
    });
const mpi_y = @import_module("<collectives_2d/pe>", .{
    .dim_params = c2d_params.y,
    .queues = [2]u16{3,5},
    .dest_dsr_ids = [1]u16{2},
    .src0_dsr_ids = [1]u16{2},
    .src1_dsr_ids = [1]u16{2}
    });
const simprint = @import_module("<simprint>", .{ .enable = true });

const broadcast_diagonal = @import_module("broadcast.csl", .{
    .color_1 = @get_color(19),
    .pe_id = pe_id_x,
    .root_id = pe_id_y, // diagonal
    .POS_DIR = EAST,
    .NEG_DIR = WEST,
    .start_index = 0, // should be 0, 3, 6
    .end_index = layer_kernel_cols - 1
});

// Layers_data has shape for each level, M0, M1, M2, ... 
const layer_size_map_A = comptime layeridx_to_size_map("A");  
const layer_offset_map_A = comptime layeridx_to_offset_map("A");  
const layer_size_map_R = comptime layeridx_to_size_map("R");  
const layer_offset_map_R = comptime layeridx_to_offset_map("R");
const layer_size_map_P = comptime layeridx_to_size_map("P");  
const layer_offset_map_P = comptime layeridx_to_offset_map("P");
const layer_size_map_x = comptime layeridx_to_size_map("x");  
const layer_offset_map_x = comptime layeridx_to_offset_map("x");
const layer_size_map_b = comptime layeridx_to_size_map("b");  
const layer_offset_map_b = comptime layeridx_to_offset_map("b");

// total sizes 
const A_tiles_total_size: u16 = comptime get_total_size_of("A");
const R_tiles_total_size: u16 = comptime get_total_size_of("R");
const P_tiles_total_size: u16 = comptime get_total_size_of("P");
const x_tiles_total_size: u16 = comptime get_total_size_of("x");
const b_tiles_total_size: u16 = comptime get_total_size_of("b");
const x_coarse_total_size: u16 = comptime get_total_size_of("x_coarse");


const dsd_struct = struct {
  base_address: [*]f32,
  stride: i8,
  extent: u16,
  offset: i16
};

///////////////////////////////////////////////
// x, b, A, R will be partitioned using 2D Block decomposition.
// Input
var A_tile = @zeros([A_tiles_total_size]f32);
var R_tile = @zeros([R_tiles_total_size]f32);
var P_tile = @zeros([P_tiles_total_size]f32);  // transpose of R_tile
var x_tile = @zeros([x_tiles_total_size]f32);
var b_tile = @zeros([b_tiles_total_size]f32);
var x_coarse = @zeros([x_coarse_total_size]f32);  // P @ x_coarse( So x_coarse has to match 2nd dim of P.)
var omega = @zeros([1]f32);
var iterations = @constants([1]u32, 0); // default is 0 iteration.

// DSDs
var dsd_A_tile: mem1d_dsd;
var dsd_A_diag: mem1d_dsd;
var dsd_R_tile: mem1d_dsd;
var dsd_P_tile: mem1d_dsd;
var dsd_x_tile: mem1d_dsd;
var dsd_b_tile: mem1d_dsd;

// Layouts for DSDs
var A_tile_struct_i: dsd_struct;
var A_diag_struct_i: dsd_struct;
var R_tile_struct_i: dsd_struct;
var P_tile_struct_i: dsd_struct;
var x_tile_struct_i: dsd_struct;
var b_tile_struct_i: dsd_struct;

// Pointers and advertised outside
var ptr_x : [*]f32 = &x_tile;
var ptr_b : [*]f32 = &b_tile;
var ptr_A : [*]f32 = &A_tile;
var ptr_R : [*]f32 = &R_tile;
var ptr_P : [*]f32 = &P_tile;
var ptr_x_coarse : [*]f32 = &x_coarse;
var ptr_omega: [*]f32 = &omega;
var ptr_iter: [*]u32 = &iterations;

///////////////////////////////////////////////
// Temporary variables
// Refers to the fine level data as it's the largest.
// Applying a DSD on such might not cause issue of overwriting into another data.
///////////////////////////////////////////////
const Ax_max_size: u16 = comptime get_max_size_of("Ax");
const Rx_max_size: u16 = comptime get_max_size_of("Rx");
const Px_max_size: u16 = comptime get_max_size_of("Px");
const residual_tile_max_size: u16 = comptime get_max_size_of("residual_tile");
const D_inv_max_size: u16 = comptime get_max_size_of("D_inv");
const term_2_max_size: u16 = comptime get_max_size_of("term_2");
const px_sum_tile_max_size: u16 = comptime get_max_size_of("px_sum_tile");
const w_dinv_a_x_max_size: u16 = comptime get_max_size_of("w_dinv_a_x");
const i_into_x_max_size: u16 = comptime get_max_size_of("i_into_x");

var Ax = @zeros([Ax_max_size]f32);  //Ax
var Rx = @zeros([Rx_max_size]f32);  // Rr
var Px = @zeros([Px_max_size]f32);  // Px = P @ x_coarse
var residual_tile = @zeros([residual_tile_max_size]f32);
var term_2 = @zeros([term_2_max_size]f32);
var px_sum_tile = @zeros([px_sum_tile_max_size]f32);
var D_inv = @zeros([D_inv_max_size]f32); // vector of diagonals of A_tile
var w_dinv_a_x = @zeros([w_dinv_a_x_max_size]f32);
var i_into_x = @zeros([i_into_x_max_size]f32);
var iter_count: u32 = 0;
var dot = @zeros([1]f32);

// DSDs
var dsd_Ax : mem1d_dsd; 
var dsd_Rx : mem1d_dsd; 
var dsd_Px : mem1d_dsd; 
var dsd_residual_tile : mem1d_dsd;
var dsd_D_inv : mem1d_dsd; 
var dsd_term_2 : mem1d_dsd;
var dsd_px_sum_tile : mem1d_dsd;
var dsd_w_dinv_a_x : mem1d_dsd;   
var dsd_i_into_x : mem1d_dsd;    

// Layout for DSDs
var Ax_struct_i: dsd_struct;
var Rx_struct_i: dsd_struct;
var Px_struct_i: dsd_struct;
var residual_tile_struct_i: dsd_struct;
var D_inv_struct_i: dsd_struct;
var term_2_struct_i: dsd_struct;
var px_sum_tile_struct_i: dsd_struct;
var w_dinv_a_x_struct_i: dsd_struct;
var i_into_x_struct_i: dsd_struct;

///////////////////////////////////////////////
// output
///////////////////////////////////////////////
// Pattern: data, dsd, struct, pointer
const b_next_max_size: u16 = comptime get_total_size_of("b_next");
var b_next = @zeros([b_next_max_size]f32);  // rightmost Column
var dsd_b_next : mem1d_dsd; // = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> b_next[i] });
var b_next_struct_i: dsd_struct;
var ptr_b_next : [*]f32 = &b_next;
///////////////////////////////////////////////

// global variables
var M_i: u16; // Height of local matrix, or num rows per PE
var N_i: u16; // Width of local matrix, or num cols per PE
var M_local_i: u16; // Height of local matrix, or num rows per PE
var N_local_i: u16; // Width of local matrix, or num cols per PE
var R_M_local_i: u16; // Height of local matrix, or num rows per PE
var R_N_local_i: u16; // Width of local matrix, or num cols per PE
var layer_index_i: u16;

// temp variables
var px: u16;
var py: u16;
var is_v_cycle_up: bool = false;
var v_cycle_iteration: i32 = 0;
var cur_state: u16 = 0;// State tracking variables
var next_state: u16 = 0;
var current_active_layer_index: u16 = 0;
const M_local_infinite:u16 = 0x7fff;
var buf = @zeros([1]f32);

///////////////////////////////////////////////

task state_exit() void {
  simprint.fmt_with_coords("STATE_EXIT layer_index={d}", .{current_active_layer_index});
  for (b_next) |val, i| {
      simprint.fmt_with_coords("b_next[{d}] = {f}", .{ i, val });
  }
  sys_mod.unblock_cmd_stream();
}

// Main state machine task
task f_state() void {
  switch (cur_state) {
      STATE_INIT => state_init(),
      STATE_BCAST_B_TILE_RIGHT => state_bcast_b_tile_right(),
      STATE_COMPUTE_JACOBI => state_compute_jacobi(),
      STATE_BCAST_JACOBI => state_bcast_jacobi(),
      STATE_CHECK_JACOBI_ITERATION => state_check_jacobi(),
      STATE_COMPUTE_RESIDUAL => state_compute_residual(),
      STATE_BCAST_RESIDUAL => state_bcast_residual(),
      STATE_COMPUTE_RESTRICTION => state_compute_restriction(),
      STATE_NEXT_LAYER_CHECK => state_next_layer_check(),
      STATE_PROLONGATION => state_prolongation(),
      STATE_BCAST_PROLONGATION => state_bcast_prolongation(),
      STATE_EXIT => @activate(state_exit_id),
      else => {
          simprint.print_string("Error: unknown state\n");
          @assert(false);
          sys_mod.unblock_cmd_stream();
      }
  }
}

fn get_runtime_dsd_i(dsd_struct_i: dsd_struct) mem1d_dsd {
  return @get_dsd(mem1d_dsd, .{ .base_address = dsd_struct_i.base_address,
                                .stride = dsd_struct_i.stride, 
                                .extent = dsd_struct_i.extent, 
                                .offset = dsd_struct_i.offset });
}

// Generate dsds at runtime and set some global structs, variables.
fn init_dsds_for_layer(layer_index: u16) void {
  // Get shapes of the data.
  // [.M, .N, .M_local, .N_local, .R_M_local, .R_N_local, .layer_index]
  M_i = runtime_data[layer_index, 0];
  N_i = runtime_data[layer_index, 1]; 
  M_local_i = runtime_data[layer_index, 2];
  N_local_i = runtime_data[layer_index, 3];
  R_M_local_i = runtime_data[layer_index, 4];
  R_N_local_i = runtime_data[layer_index, 5];
  layer_index_i = runtime_data[layer_index, 6]; 

  // var dsd_A_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> A_tile[i*@as(i16, N_local)] }); // 1 col of A_tile
  A_tile_struct_i = dsd_struct { .base_address = &A_tile, .stride = @as(i8, N_local_i), .extent = M_local_i, .offset = @as(i16, get_offset(&layer_offset_map_A, layer_index)) };
  // var dsd_A_diag = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> A_tile[i*N_local + i] });
  A_diag_struct_i = dsd_struct { .base_address = &A_tile, .stride = @as(i8, N_local_i + 1), .extent = M_local_i, .offset = @as(i16, get_offset(&layer_offset_map_A, layer_index)) };
  // var dsd_R_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> R_tile[i*@as(i16, R_N_local)] }); // 1 col of R_tile
  R_tile_struct_i = dsd_struct { .base_address = &R_tile, .stride = @as(i8, R_N_local_i), .extent = R_M_local_i, .offset = @as(i16, get_offset(&layer_offset_map_R, layer_index)) };
  // var dsd_P_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_N_local} -> P_tile[i*@as(i16, R_M_local)] }); // 1 col of P_tile
  P_tile_struct_i = dsd_struct { .base_address = &P_tile, .stride = @as(i8, R_M_local_i), .extent = R_N_local_i, .offset = @as(i16, get_offset(&layer_offset_map_P, layer_index)) };
  // var dsd_x_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N_local} -> x_tile[i]});
  x_tile_struct_i = dsd_struct { .base_address = &x_tile, .stride = @as(i8, 1), .extent = N_local_i, .offset = @as(i16, get_offset(&layer_offset_map_x, layer_index)) };
  // var dsd_b_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> b_tile[i]});
  b_tile_struct_i = dsd_struct { .base_address = &b_tile, .stride = @as(i8, 1), .extent = M_local_i, .offset = @as(i16, get_offset(&layer_offset_map_b, layer_index)) };

  dsd_A_tile = get_runtime_dsd_i(A_tile_struct_i);
  dsd_A_diag = get_runtime_dsd_i(A_diag_struct_i);
  dsd_R_tile = get_runtime_dsd_i(R_tile_struct_i);
  dsd_P_tile = get_runtime_dsd_i(P_tile_struct_i);
  dsd_x_tile = get_runtime_dsd_i(x_tile_struct_i);
  dsd_b_tile = get_runtime_dsd_i(b_tile_struct_i);

  // temporaries
  Ax_struct_i = dsd_struct { .base_address = &Ax, .stride = 1, .extent = M_local_i, .offset = 0 }; // .{ .tensor_access = |i|{M_local} -> Ax[i]}
  Rx_struct_i = dsd_struct { .base_address = &Rx, .stride = 1, .extent = R_M_local_i, .offset = 0 }; // .{ .tensor_access = |i|{R_M_local} -> Rx[i]}
  Px_struct_i = dsd_struct { .base_address = &Px, .stride = 1, .extent = R_N_local_i, .offset = 0 }; // .{ .tensor_access = |i|{R_N_local} -> Px[i]}
  residual_tile_struct_i = dsd_struct { .base_address = &residual_tile, .stride = 1, .extent = M_local_i, .offset = 0 }; // .{ .tensor_access = |i|{M_local} -> residual_tile[i]}
  D_inv_struct_i = dsd_struct { .base_address = &D_inv, .stride = 1, .extent = M_local_i, .offset = 0 }; // .{ .tensor_access = |i|{M_local} -> D_inv[i] }
  term_2_struct_i = dsd_struct { .base_address = &term_2, .stride = 1, .extent = M_local_i, .offset = 0 }; // .{ .tensor_access = |i|{M_local} -> term_2[i] }
  px_sum_tile_struct_i = dsd_struct { .base_address = &px_sum_tile, .stride = 1, .extent = N_local_i, .offset = 0 }; // .{ .tensor_access = |i|{N_local} -> px_sum_tile[i] }
  w_dinv_a_x_struct_i = dsd_struct { .base_address = &w_dinv_a_x, .stride = 1, .extent = M_local_i, .offset = 0 }; // .{ .tensor_access = |i|{M_local} -> w_dinv_a_x[i] }
  i_into_x_struct_i = dsd_struct { .base_address = &i_into_x, .stride = 1, .extent = M_local_i, .offset = 0 }; // .{ .tensor_access = |i|{M_local} -> i_into_x[i] }

  dsd_Ax = get_runtime_dsd_i(Ax_struct_i);
  dsd_Rx = get_runtime_dsd_i(Rx_struct_i);
  dsd_Px = get_runtime_dsd_i(Px_struct_i);
  dsd_residual_tile = get_runtime_dsd_i(residual_tile_struct_i);
  dsd_D_inv = get_runtime_dsd_i(D_inv_struct_i);
  dsd_term_2 = get_runtime_dsd_i(term_2_struct_i);
  dsd_px_sum_tile = get_runtime_dsd_i(px_sum_tile_struct_i);
  dsd_w_dinv_a_x = get_runtime_dsd_i(w_dinv_a_x_struct_i);
  dsd_i_into_x = get_runtime_dsd_i(i_into_x_struct_i);

  // output
  b_next_struct_i = dsd_struct { .base_address = &b_next, .stride = 1, .extent = R_M_local_i, .offset = 0 };
  dsd_b_next = get_runtime_dsd_i(b_next_struct_i);

  // if (pe_id_x == 0 and pe_id_y == 0) {
  //   simprint.print_string("A_tile\n");
  //   @map(print_dsd, dsd_A_tile);
  //   simprint.print_string("A_diag\n");
  //   @map(print_dsd, dsd_A_diag);
  //   simprint.print_string("R_tile\n");
  //   @map(print_dsd, dsd_R_tile);
  //   simprint.print_string("P_tile\n");
  //   @map(print_dsd, dsd_P_tile);
  //   simprint.print_string("x_tile\n");
  //   @map(print_dsd, dsd_x_tile);
  //   simprint.print_string("b_tile\n");
  //   @map(print_dsd, dsd_b_tile);
  // }

}
fn print_restriction_dsd(value: f32) void {
  simprint.fmt_with_coords("DSD_restriction_after[] = {f}", .{value});
}

fn print_dsd(value: f32) void {
  simprint.fmt_with_coords("DSD_residual_after[] = {f}", .{value});
}

// // Entrypoint into kernel
fn v_cycle_down() void {
  mpi_x.init();
  mpi_y.init();
  px = mpi_x.pe_id;
  py = mpi_y.pe_id;

  init_dsds_for_layer(current_active_layer_index);
  cur_state = STATE_BCAST_B_TILE_RIGHT;
  @activate(STATE_MACHINE);
}

fn print_data() void {
  if (pe_id_x == 0 and pe_id_y == 0) {
    // print A_tile
    simprint.print_string("A_tile\n");
    for (A_tile) |val, i| {
    simprint.fmt_with_coords("A_tile[{d}] = {f}", .{ i, val });
    }
    simprint.print_string("R_tile\n");
    for (R_tile) |val, i| {
      simprint.fmt_with_coords("R_tile[{d}] = {f}", .{ i, val });
    }
    simprint.print_string("x_tile\n");
    for (x_tile) |val, i| {
      simprint.fmt_with_coords("x_tile[{d}] = {f}", .{ i, val });
    }
    simprint.print_string("b_tile\n");
    for (b_tile) |val, i| {
      simprint.fmt_with_coords("b_tile[{d}] = {f}", .{ i, val });
    }

    // 
    simprint.print_string("A_tiles_total_size\n");
    simprint.fmt_with_coords("A_tiles_total_size = {d}", .{A_tiles_total_size});
    simprint.print_string("R_tiles_total_size\n");
    simprint.fmt_with_coords("R_tiles_total_size = {d}", .{R_tiles_total_size});
    simprint.print_string("x_tiles_total_size\n");
    simprint.fmt_with_coords("x_tiles_total_size = {d}", .{x_tiles_total_size});
    simprint.print_string("b_tiles_total_size\n");
    simprint.fmt_with_coords("b_tiles_total_size = {d}", .{b_tiles_total_size});

  }
}


//########################################################################################
// Dataflow and Routing.
//########################################################################################
//########################################################################################
comptime {
  // Bind all state tasks
  @bind_local_task(f_state, STATE_MACHINE);
  @bind_local_task(state_exit, state_exit_id);
  @bind_local_task(no_op, no_op_id);

  @export_symbol(ptr_A, "A");
  @export_symbol(ptr_x, "x");
  @export_symbol(ptr_b, "b");
  @export_symbol(ptr_R, "R");
  @export_symbol(ptr_P, "P");
  @export_symbol(ptr_x_coarse, "x_coarse");
  @export_symbol(ptr_b_next, "b_next");
  @export_symbol(ptr_omega, "omega");
  @export_symbol(ptr_iter, "iterations");
  @export_symbol(v_cycle_down);
  @export_symbol(print_data);


  broadcast_diagonal.configure_network();
}

//########################################################################################
// STATES
//########################################################################################

fn state_bcast_b_tile_right() void {
  next_state = STATE_INIT;
  bcast_b_tile_right();
}

// State machine tasks
fn state_init() void {
  simprint.fmt_with_coords("finished BCAST_B_TILE_RIGHT, layer_index={d}", .{ @as(u32, current_active_layer_index) });
  next_state = STATE_COMPUTE_JACOBI;
  initialize();
}

fn state_compute_jacobi() void {
  simprint.fmt_with_coords("Finished STATE_INIT, layer_index={d}", .{ @as(u32, current_active_layer_index) });
  iter_count += 1;
  next_state = STATE_BCAST_JACOBI;
  compute_jacobi();
}

fn state_bcast_jacobi() void {
  next_state = STATE_CHECK_JACOBI_ITERATION;
  bcast_jacobi();
}

fn state_check_jacobi() void {
  // print x_tile
  for (x_tile) |val, i| {
    simprint.fmt_with_coords("after smoothing x_tile[{d}] = {f}", .{ i, val });
  }
  if (iter_count < iterations[0]) {
      next_state = STATE_COMPUTE_JACOBI;
  } else {
      if (is_v_cycle_up) {
          next_state = STATE_EXIT;
      } else {
          next_state = STATE_COMPUTE_RESIDUAL;
      }
  }
  f_trigger_state_machine();
}

fn state_compute_residual() void {
  simprint.print_string("STATE_COMPUTE_RESIDUAL\n");
  next_state = STATE_BCAST_RESIDUAL;
  compute_residual();
}

fn state_bcast_residual() void {
  next_state = STATE_COMPUTE_RESTRICTION;
  bcast_residual();
}

fn state_compute_restriction() void {
  simprint.print_string("STATE_COMPUTE_RESTRICTION\n");
  @map(print_dsd, dsd_residual_tile);
  next_state = STATE_NEXT_LAYER_CHECK;
  compute_restriction();

}

fn state_next_layer_check() void {
  simprint.fmt_with_coords("STATE_NEXT_LAYER_CHECK, layer_index={d}", .{ @as(u32, current_active_layer_index) });
  @map(print_restriction_dsd, dsd_b_next);

  current_active_layer_index += 1;   
  if (current_active_layer_index <= total_levels_count - 1) {
    // bcast_left first then start the next layer.
    bcast_b_tile_left();
    

    // init_dsds_for_layer(current_active_layer_index);
    // next_state = STATE_INIT;
    next_state = STATE_EXIT;
  } else { // up cycle at some point.
    next_state = STATE_EXIT;
  }
  f_trigger_state_machine();
}

fn state_prolongation() void {
  simprint.print_string("STATE_PROLONGATION\n");
  next_state = STATE_BCAST_PROLONGATION;
  compute_prolongation();
}

fn state_bcast_prolongation() void {
  simprint.print_string("STATE_BCAST_PROLONGATION\n");
  next_state = STATE_CHECK_JACOBI_ITERATION;
  bcast_prolongation();
}

/////////////////////////////////////////////////////////
/// Functions
/////////////////////////////////////////////////////////

fn initialize() void {

  v_cycle_iteration += 1;
  is_v_cycle_up = false;
  iter_count = 0;
  cur_state = next_state;

  @map(inverse_callback, dsd_A_diag, dsd_D_inv);
  // var send_buf = @ptrcast([*]u32, &D_inv_struct_i.base_address[D_inv_struct_i.offset]);
  // mpi_x.broadcast(py, send_buf, D_inv_struct_i.extent, STATE_MACHINE);
  broadcast_diagonal.transfer_data(dsd_D_inv, D_inv_struct_i.extent, STATE_MACHINE);

}

fn bcast_b_tile_right() void {
  cur_state = next_state;

  const sizetosend = b_tile_struct_i.extent;
  var send_buf = @ptrcast([*]u32, &b_tile_struct_i.base_address[b_tile_struct_i.offset]);
  mpi_x.broadcast(0, send_buf, sizetosend, STATE_MACHINE);
}


fn bcast_b_tile_left() void {
  cur_state = next_state;

  var send_buf = @ptrcast([*]u32, &b_next[b_next_struct_i.offset]);
  // var recv_buf = @ptrcast([*]u32, &b_tile[b_tile_struct_i.offset]);

  mpi_x.broadcast(layer_kernel_cols-1, send_buf, b_next_struct_i.extent, no_op_id);

  // var recv_buf = @ptrcast([*]u32, &b_tile[b_tile_struct_i.offset]);

  // // works
  // if (pe_id_x == 0) { // leftmost columns
  //   mpi_x.broadcast(0, send_buf, b_tile_struct_i.extent, STATE_MACHINE);  // M_local_i size.
  // } else {
  //   mpi_x.broadcast(0, recv_buf, b_tile_struct_i.extent, STATE_MACHINE);
  // }
}

fn matvec(N_tile: u16, dsd_mv_tile: mem1d_dsd, dsd_matrix_tile: mem1d_dsd, vector_tile_data: [*]const f32) void {
  @fmovs(dsd_mv_tile, 0.0); // Initialize result to 0
  var matrix_dsd = dsd_matrix_tile; // Create a mutable copy of the DSD, but underlying data is the same.

  for (@range(u16, N_tile)) |j| {
    @fmacs(dsd_mv_tile, dsd_mv_tile, matrix_dsd, vector_tile_data[j]);
    // check bounds
    if (j < (N_tile - 1)) {
      matrix_dsd = @increment_dsd_offset(matrix_dsd, 1, f32);
    }
  }
}

// New formula implementation: Jacobi iteration logic (new formula)
// formula: x = (Identity-omega*D_inv*A_tile)*x_tile
// x_tile[i] = (1.0 - omega) * temp_tile[i] + omega * (b_tile[i] - rsum) / diag;
// The diagonal PEs add the term_1 so that we don't have to gather on diag PE.

fn jacobi_local() void {
  // dsd_A_tile = @set_dsd_base_addr(dsd_A_tile, &A_tile); // make sure you do this before
  // compute_mv_per_tile(N_local, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));  // Ax(vector) = Ax(matrix * vector)
  const x_tile_vector: [*]const f32 = @ptrcast([*]const f32, &x_tile_struct_i.base_address[x_tile_struct_i.offset]); // summedinto
  const vectorsize = x_tile_struct_i.extent;
  matvec(vectorsize, dsd_Ax, dsd_A_tile, x_tile_vector);  // Ax(vector) = Ax(matrix * vector)
  @fmuls(dsd_w_dinv_a_x, dsd_D_inv, dsd_Ax); // tmp = D_inv * Ax (vector * vector)
  @fmuls(dsd_w_dinv_a_x, omega[0], dsd_w_dinv_a_x); // tmp = w * D_inv * Ax (scalar * vector)

  if (px == py) { // good speedup.
    @fmovs(dsd_i_into_x, dsd_x_tile); // I*x = x
    // save some operations can be effective if PE grid large enough.
  } // otherwise, 0.0

  @fsubs(dsd_term_2, dsd_i_into_x, dsd_w_dinv_a_x); // tmp = I*x - omega * D_inv * Ax

  if (px == py) { // omega * D_inv * b
    @fmuls(dsd_w_dinv_a_x, dsd_D_inv, dsd_b_tile); // tmp = D_inv * b (vector * vector)
    @fmuls(dsd_w_dinv_a_x, omega[0], dsd_w_dinv_a_x); // tmp = omega * D_inv * b (scalar * vector)
    @fadds(dsd_term_2, dsd_w_dinv_a_x, dsd_term_2); // term_2 = omega * D_inv * b + term_2
  }
}

// Ax = A_local * x_local
fn residual_local() void {
  // dsd_A_tile = @set_dsd_base_addr(dsd_A_tile, &A_tile); // make sure you do this before
  // compute_mv_per_tile(N_local, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));  // Ax = A_tile * x_tile

  const x_tile_vector: [*]const f32 = @ptrcast([*]const f32, &x_tile_struct_i.base_address[x_tile_struct_i.offset]); // summedinto
  const vectorsize = x_tile_struct_i.extent;
  matvec(vectorsize, dsd_Ax, dsd_A_tile, x_tile_vector);  // Ax = A_tile * x_tile
}


fn inverse_callback(val: f32) f32 {
  return if (val != 0.0) math_lib.inv(val) else 0.0;
}


// State machine trigger function
fn f_trigger_state_machine() void {
  cur_state = next_state; // go to next state
  @activate(STATE_MACHINE);   
}

// Compute Jacobi iteration
fn compute_jacobi() void {
  cur_state = next_state;
  jacobi_local();  // updates term_2

  var send_buf = @ptrcast([*]f32, &term_2_struct_i.base_address[term_2_struct_i.offset]);
  var sizetosend = term_2_struct_i.extent;
  var recv_buf = @ptrcast([*]f32, &x_tile_struct_i.base_address[x_tile_struct_i.offset]); // summedinto
  mpi_x.reduce_fadds(py, send_buf, recv_buf,
                     sizetosend, STATE_MACHINE); // reduce across rows towards left into x_tile
}

fn bcast_jacobi() void {
  cur_state = next_state;

  var send_buf = @ptrcast([*]u32, &x_tile_struct_i.base_address[x_tile_struct_i.offset]);
  var sizetosend = x_tile_struct_i.extent;
  mpi_y.broadcast(px, send_buf, sizetosend, STATE_MACHINE);
}

// Compute residual
fn compute_residual() void {
  cur_state = next_state;

  residual_local(); // has answers in dsd_Ax
  var send_buf = @ptrcast([*]f32, &Ax_struct_i.base_address[Ax_struct_i.offset]);
  var sizetosend = Ax_struct_i.extent;
  var recv_buf = @ptrcast([*]f32, &residual_tile_struct_i.base_address[residual_tile_struct_i.offset]); // summedinto
  mpi_x.reduce_fadds(py, send_buf, recv_buf,
                     sizetosend, STATE_MACHINE); // output: residual_tile
}

// bcast(residual_tile) to all PEs.
fn bcast_residual() void {
  cur_state = next_state;
  @fsubs(dsd_residual_tile, dsd_b_tile, dsd_residual_tile);  // residual_tile = b - Ax
  var send_buf = @ptrcast([*]u32, &residual_tile_struct_i.base_address[residual_tile_struct_i.offset]);
  var sizetosend = residual_tile_struct_i.extent;
  mpi_y.broadcast(px, send_buf, sizetosend, STATE_MACHINE);  

  // mpi_y.broadcast(px, @ptrcast([*]u32, &residual_tile), M_local_i, STATE_MACHINE);
  // broadcast_diagonal.transfer_data(dsd_D_inv, D_inv_struct_i.extent, STATE_MACHINE);
}

// Compute restriction
fn compute_restriction() void {
  cur_state = next_state;

  const residual_tile_vector: [*]const f32 = @ptrcast([*]const f32, &residual_tile_struct_i.base_address[residual_tile_struct_i.offset]); // summedinto
  const vectorsize = residual_tile_struct_i.extent; // Note: R_M_local_i == M_local_i(during restriction)
  matvec(vectorsize, dsd_Rx, dsd_R_tile, residual_tile_vector);

  var send_buf = @ptrcast([*]f32, &Rx_struct_i.base_address[Rx_struct_i.offset]);
  var sizetosend = Rx_struct_i.extent;
  var recv_buf = @ptrcast([*]f32, &b_next_struct_i.base_address[b_next_struct_i.offset]); // summedinto
  mpi_x.reduce_fadds(layer_kernel_cols-1, send_buf, recv_buf,
                     sizetosend, STATE_MACHINE); // output: b_next
}

// Compute prolongation
fn compute_prolongation() void {
  dsd_P_tile = @set_dsd_base_addr(dsd_P_tile, &P_tile); // make sure you do this before
  // compute_mv_per_tile(R_M_local, dsd_Px, dsd_P_tile, @ptrcast([*]const f32, &x_coarse));
  matvec(R_M_local_i, dsd_Px, dsd_P_tile, @ptrcast([*]const f32, &x_coarse));
  cur_state = next_state;
  mpi_x.reduce_fadds(py, @ptrcast([*]f32, &Px), @ptrcast([*]f32, &px_sum_tile),
                     R_N_local_i, STATE_MACHINE); // reduce across rows towards left  
}

fn bcast_prolongation() void {
  if (px == py) {
    @fadds(dsd_x_tile, dsd_x_tile, dsd_px_sum_tile);  // x_tile = x_tile + Px
  }
  cur_state = next_state;
  mpi_y.broadcast(px, @ptrcast([*]u32, &x_tile), N_local_i, STATE_MACHINE);
}

task no_op() void {
  // simprint.print_string("no_op\n");
}

// Helpers

fn is_first_layer() bool {
  return current_active_layer_index == 0;
}

fn is_last_layer() bool {
  return current_active_layer_index == total_levels_count - 1;
}

fn is_layer_last_column() bool {
  return pe_id_x == layer_end_x - 1;
}

fn is_layer_first_column() bool {
  return pe_id_x == layer_start_x;
}

fn is_rectangle_first_column() bool {
  return is_layer_first_column();
}

//// blob and memcpy helper routines.
// create the layer size map and offset map.
fn layeridx_to_size_map(comptime data: comptime_string) [total_levels_count]u16 {
  var result = @zeros([total_levels_count]u16);
  for (layers_data) |layer_data, index| {
  // layer params
    const M_local: u16 = layer_data.M_local; 
    const N_local: u16 = layer_data.N_local; 
    const R_M_local: u16 = layer_data.R_M_local; 
    const R_N_local: u16 = layer_data.R_N_local; 
    if (data == "A") {
      result[index] = M_local * N_local;
    } else if (data == "R") {
      result[index] = R_M_local * R_N_local;
    } else if (data == "P") {
      result[index] = R_N_local * R_M_local;
    } else if (data == "x") {
      result[index] = N_local;
    } else if (data == "b") {
      result[index] = M_local;
    } else if (data == "x_coarse") {
      result[index] = R_M_local;
    } else {
      @compileError("Invalid string for layeridx_to_size_map");
    }
  }
  return result;
}
fn layeridx_to_offset_map(comptime data: comptime_string) [total_levels_count]u16 {
  var result = @zeros([total_levels_count]u16);
  var running_sum: u16 = 0;
  for (layers_data) |layer_data, index| {
  // layer params
    const M_local: u16 = layer_data.M_local; 
    const N_local: u16 = layer_data.N_local; 
    const R_M_local: u16 = layer_data.R_M_local; 
    const R_N_local: u16 = layer_data.R_N_local; 
    if (data == "A") {
      result[index] = running_sum;
      running_sum += M_local * N_local;
    } else if (data == "R") {
      result[index] = running_sum;
      running_sum += R_M_local * R_N_local;
    } else if (data == "P") {
      result[index] = running_sum;
      running_sum += R_N_local * R_M_local;
    } else if (data == "x") {
      result[index] = running_sum;
      running_sum += N_local;
    } else if (data == "b") {
      result[index] = running_sum;
      running_sum += M_local;
    } else if (data == "x_coarse") {
      result[index] = running_sum;
      running_sum += R_M_local;
    } else {
      @compileError("Invalid string for layeridx_to_offset_map");
    }
  }
  return result;
}
fn get_total_size_of(comptime data: comptime_string) u16 {
  var total_size_of_data: u16 = 0;
    for (layers_data) |layer_data| {
        // layer params
        const M_local: u16 = layer_data.M_local; 
        const N_local: u16 = layer_data.N_local; 
        const R_M_local: u16 = layer_data.R_M_local; 
        const R_N_local: u16 = layer_data.R_N_local; 
        if (data == "A") {
          total_size_of_data += M_local * N_local;
        } else if (data == "R") {
          total_size_of_data += R_M_local * R_N_local;
        } else if (data == "P") {
          total_size_of_data += R_N_local * R_M_local;
        } else if (data == "x") {
          total_size_of_data += N_local;
        } else if (data == "b") {
          total_size_of_data += M_local;
        } else if (data == "x_coarse") {
          total_size_of_data += R_M_local;
        } else if (data == "b_next") {
          total_size_of_data += R_M_local;
        } else {
          @compileError("Invalid string for get_total_size_of");
        }
    }
    return total_size_of_data;
}

fn get_max_size_of(comptime data: comptime_string) u16 {
    var total_size_of_data: u16 = 0;
    const layer_0_fine = layers_data[0];
    // layer params
    const M_local: u16 = layer_0_fine.M_local; 
    const N_local: u16 = layer_0_fine.N_local; 
    const R_M_local: u16 = layer_0_fine.R_M_local; 
    const R_N_local: u16 = layer_0_fine.R_N_local; 

    if (data == "Ax" or data == "residual_tile" or data == "D_inv" or data == "term_2" or data == "w_dinv_a_x" or data == "i_into_x") {
      total_size_of_data = M_local;
    } else if (data == "Rx") {
      total_size_of_data = R_M_local;
    } else if (data == "Px") {
      total_size_of_data = R_N_local;
    } else if (data == "px_sum_tile") {
      total_size_of_data = N_local;
    } else {
      @compileError("Invalid string for get_total_size_of");
    }
    return total_size_of_data;
}

fn get_size(layer_size_map: *const [total_levels_count] u16,  index: u16) u16 {
  @assert(index < total_levels_count);
  return (layer_size_map.*)[index];
}
fn get_offset(layer_offset_map: *const [total_levels_count] u16, index: u16) u16 {
  @assert(index < total_levels_count);
  return (layer_offset_map.*)[index];
}


