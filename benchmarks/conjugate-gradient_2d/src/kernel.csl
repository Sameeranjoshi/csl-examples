param memcpyParams: comptime_struct;
param BLOCK_SIZE: i16; // size of temporary buffers for communication
param STATE: local_task_id;
// Size of our local tile of `A`
param local_rows: i16; // Height of local matrix, or num rows per PE
param local_cols: i16; // Width of local matrix, or num cols per PE
const math_lib = @import_module("<math>");
const blas_lib = @import_module("blas.csl");
const timestamp = @import_module("<time>");
const layout_module = @import_module("<layout>");
const sys_mod = @import_module( "<memcpy/memcpy>", memcpyParams);
const simprint = @import_module("<simprint>");

// tsc_size_words = 3
// starting time of H2D/D2H
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
// ending time of H2D/D2H
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);

// time_buf_u16[0:5] = {tscStartBuffer, tscEndBuffer}
var time_buf_u16 = @zeros([timestamp.tsc_size_words*2]u16);
// reference clock inside allreduce module
var time_ref_u16 = @zeros([timestamp.tsc_size_words]u16);

// 48 kB of global memory contain A, x, b, y
var A: [local_rows*local_cols]f32; // A is stored in Col-major order
var x: [local_cols*1]f32;
var b: [local_rows*1]f32;
var w = @zeros([local_rows*1]f32); // w = A * p
var r = @zeros([local_rows*1]f32); // residual
var p = @zeros([local_rows]f32); // Krylov space, p=r

var n: i16 = 0;
var tol: f32 = @as(f32, 0);
var max_ite: i16 = 0;

var dot = @zeros([1]f32); // dummy variable for f_sync
var rho = @zeros([1]f32);
var rho_old = @zeros([1]f32);
var eta = @zeros([1]f32);
var beta: f32 = @as(f32,0);

var ptr_b: [*]f32 = &b;
var ptr_x: [*]f32 = &x;
var ptr_A: [*]f32 = &A;
var ptr_rho: [*]f32 = &rho;
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;
var ptr_time_ref: [*]u16 = &time_ref_u16;




var mem_b_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{local_rows} -> b[i] });
var mem_x_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{local_cols} -> x[i] });
var mem_r_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{local_rows} -> r[i] });
var mem_p_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{local_rows} -> p[i] }); // p=r
var mem_w_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{local_rows} -> w[i] });

const STATE_SYNC: i16 = 0;
const STATE_INIT: i16 = 1;
const STATE_SPMV_AX: i16 = 2;
const STATE_RESIDUAL: i16 = 3;
const STATE_CONV_CHECK: i16 = 4;
const STATE_UPDATE_P: i16 = 6;
const STATE_SPMV_AP: i16 = 7;
const STATE_ETA: i16 = 8;
const STATE_UPDATE_X_R_RHO: i16 = 9;
const STATE_EXIT: i16 = 10;
var k: i16 = 0;
var cur_state: i16 = 0;
var next_state: i16 = 0;


fn f_cg_init() void {
    simprint.print_string("In init\n");
    simprint.print_string("\n");
    // simprint.fmt_with_coords("local_rows: {d}", .{@as(u16, local_rows)});
    // simprint.fmt_with_coords("local_cols: {d}", .{@as(u16, local_cols)});
    simprint.print_string("\n");

    var my_pe_col_id = layout_module.get_x_coord();
    var my_pe_row_id = layout_module.get_y_coord();  

        for (@range(i16, local_rows)) |i| {   // Iterate over columns first
            for (@range(i16, local_cols)) |j| { // Iterate over rows second
                simprint.fmt_with_coords("A[{d}][{d}] = {f}", .{@as(u16,i), @as(u16,j), A[i*local_cols + j]});
            }
        }
        simprint.print_string("\n");

        for (b) |val, i| {
            simprint.fmt_with_coords("b[{d}] = {f}", .{ i, val });
        }
        simprint.print_string("\n");

        for (x) |val, i| {
            simprint.fmt_with_coords("x[{d}] = {f}", .{ i, val });
        }
        simprint.print_string("\n");

    // the user must unblock cmd color for every PE
   // must go back to state machine
    f_trigger_state_machine();
}

// // local GEMV col-major
// fn gemv(A: [*]f32, x: [*]f32, y:[*]f32) void {
// //   for (@range(i16, local_cols)) |j| {   // Iterate over columns first
// //     for (@range(i16, local_rows)) |i| { // Iterate over rows second
// //       y[i] += A[j*local_rows + i] * x[j]; // Access A in column-major order
// //     }
// //   }
// }

// w = A*x
fn f_spmv_Ax() void {
    simprint.print_string("In f_spmv_Ax\n");

    for (@range(i16, local_cols)) |j| {   // Iterate over columns first
        for (@range(i16, local_rows)) |i| { // Iterate over rows second
            w[i] += A[j*local_rows + i] * x[j]; // Access A in column-major order
        }
    }
    
    // simprint.fmt("type of A = {}", @type_of(A) );
    // gemv(&A, &x, &w);
    // the user must unblock cmd color for every PE
    f_trigger_state_machine();
}

// compute r = b - w and rho = |r|^2
// where w = A*x is computed by f_spmv_Ax
fn f_residual() void {  
    simprint.print_string("In f_residual\n");
    @fsubs(mem_r_dsd, mem_b_dsd, mem_w_dsd);

    // compute <r, r> locally
    n = local_rows;
    rho[0] = blas_lib.dot(n, &r, &r);
    f_trigger_state_machine();

}

// if k is 1
//   p = r0
// else
//   beta = rho/rho_old
//   p = r + beta*p
// end
fn f_update_p() void {
    simprint.print_string("In f_update_p\n");
    if (1 == k){
        // p = r
        @fmovs(mem_p_dsd, mem_r_dsd);
    }else{
        // beta_{k} = |r_{k-1}|^2/|r_{k-2}|^2
        beta = rho[0]/rho_old[0];
        // p_{k} = r_{k-1} + beta_{k} * p_{k-1}
        @fmacs(mem_p_dsd, mem_r_dsd, mem_p_dsd, beta);
        simprint.fmt_with_coords("beta = {f}", .{ beta });
    }  
    f_trigger_state_machine();
}


// w = A*p
fn f_spmv_Ap() void {
    simprint.print_string("In f_spmv_Ap\n");
    // simprint.print_string("In f_eta\n");
    // // print w and p
    // for (w) |val, i| {
    //     simprint.fmt_with_coords("w[{d}] = {f}", .{ i, val });
    // }
    // for (p) |val, i| {
    //     simprint.fmt_with_coords("p[{d}] = {f}", .{ i, val });
    // }
    // // print A
    // for (@range(i16, local_cols)) |j| {   // Iterate over columns first
    //     for (@range(i16, local_rows)) |i| { // Iterate over rows second
    //         simprint.fmt_with_coords("A[{d}][{d}] = {f}", .{@as(u16,i), @as(u16,j), A[i*local_cols + j]});
    //     }
    // }
    // simprint.print_string("\n");      
    for (@range(i16, local_cols)) |j| {   // Iterate over columns first
        for (@range(i16, local_rows)) |i| { // Iterate over rows second
            w[i] += A[j*local_rows + i] * p[j]; // Access A in column-major order
        }
    }
    // gemv(&A, &p, &w);
    // sys_mod.unblock_cmd_stream();
    f_trigger_state_machine();
}

// eta = np.dot(p,w)
fn f_eta() void {
    simprint.print_string("In f_eta\n");
    // compute <w, p> locally
    n = local_rows;
    eta[0] = blas_lib.dot(n, &w, &p);
    // reduce(<w,p>)
    // reduce_mod.allreduce(1, &eta, reduce_mod.TYPE_BINARY_OP.ADD);
    f_trigger_state_machine();
}

// update x, r and rho
// ---
// alpha = rho/eta
// x = x + alpha * p
// r = r - alpha * w where w = A*p
// rho_old = rho
// rho = np.dot(r,r)
// ---
//
// w must be computed by f_spmv_Ap()
// eta must be computed by f_eta()
//
fn f_update_x_r_rho() void {
    simprint.print_string("In f_update_x_r_rho\n");
    var alpha: f32 = rho[0]/eta[0];
    var alpha_minus: f32 = -alpha;

    // x_{k} = x_{k-1} + alpha_{k} * p_{k}
    // x = x + alpha * p
    @fmacs(mem_x_dsd, mem_x_dsd, mem_p_dsd, alpha);

    // r_{k} = r_{k-1} - alpha_{k} * A*p_{k}
    // r = r - alpha * w
    @fmacs(mem_r_dsd, mem_r_dsd, mem_w_dsd, alpha_minus);

    // update rho
        rho_old[0] = rho[0];
        simprint.print_string("In f_update_x_r_rho : \n");
        for (rho) |val, i| {
            simprint.fmt_with_coords("rho[{d}] = {f}", .{ i, val });
        }
        for (rho_old) |val, i| {
            simprint.fmt_with_coords("rho_old[{d}] = {f}", .{ i, val });
        }
    // rho = np.dot(r,r)
    // compute <r, r> locally
    n = local_rows;
    rho[0] = blas_lib.dot(n, &r, &r);

    // for (rho) |val, i| {
    //     simprint.fmt_with_coords("rho[{d}] = {f}", .{ i, val });
    // }
    // simprint.print_string("\n");
    // reduce(|r|^2)
    // reduce_mod.allreduce(1, &rho, reduce_mod.TYPE_BINARY_OP.ADD);
    f_trigger_state_machine();


}



fn f_enable_timer() void {
    timestamp.enable_tsc();
    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

fn f_tic() void {
    timestamp.get_timestamp(&tscStartBuffer);

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

fn f_toc() void {
    timestamp.get_timestamp(&tscEndBuffer);

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

fn f_memcpy_timestamps() void {

    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];

    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

fn f_reference_timestamps() void {
    time_ref_u16[0] = 100;
    time_ref_u16[1] = 100;
    time_ref_u16[2] = 100;
    
    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

fn f_sync() void {
    cur_state = STATE_SYNC;
    @activate(STATE);

}

fn f_cg(tol_val:f32, max_ite_val: i16) void {
    simprint.print_string("In f_cg\n");
    n = local_rows;
    tol = tol_val;
    max_ite = max_ite_val;
    cur_state = STATE_INIT;
    @activate(STATE);

}

fn f_trigger_state_machine() void {
    simprint.print_string("In f_trigger_state_machine\n");
    cur_state = next_state; // go to next state
    @activate(STATE);
}

task f_state() void {
    simprint.print_string("In f_state\n");
    if (STATE_SYNC == cur_state){
        // sync all PEs by internal allreduce module
        next_state = STATE_EXIT;
        // reduce_mod.allreduce(1, &dot, reduce_mod.TYPE_BINARY_OP.ADD);

    }else if (STATE_INIT == cur_state){
        next_state = STATE_SPMV_AX;
        f_cg_init();

    }else if (STATE_SPMV_AX == cur_state){
        next_state = STATE_RESIDUAL;
        k = 0;
        // w = A*x0
        f_spmv_Ax();

    }else if (STATE_RESIDUAL == cur_state){
        next_state = STATE_CONV_CHECK;
        // r0 = b - w = b - A*x0
        // rho = |r0|^2
        f_residual();

    }else if (STATE_CONV_CHECK == cur_state){
        // if |r_k|_2 < tol, then exit
        if ((rho[0] > tol*tol) and (k < max_ite)){
            next_state = STATE_UPDATE_P;
        }else{
            next_state = STATE_EXIT;
        }
        f_trigger_state_machine();

    }else if (STATE_UPDATE_P == cur_state){
        next_state = STATE_SPMV_AP;
        k = k + 1;
        // if k == 1
        //   p = z
        // else
        //   beta = rho/rho_old
        //   p = z + beta * p
        f_update_p();

    }else if (STATE_SPMV_AP == cur_state){
        next_state = STATE_ETA;
        // w = A*p
        f_spmv_Ap();

    }else if (STATE_ETA == cur_state){
        next_state = STATE_UPDATE_X_R_RHO;
        // eta = np.dot(p,w) = (p_{k}, A*p_{k})
        f_eta();

    }else if (STATE_UPDATE_X_R_RHO == cur_state){
        next_state = STATE_CONV_CHECK;
        // alpha = rho/eta
        // x = x + alpha * p
        // r = r - alpha * w  where w = A*p
        // rho_old = rho
        // rho = np.dot(r,r)
        f_update_x_r_rho();

    }else if (STATE_EXIT == cur_state){
        sys_mod.unblock_cmd_stream();
    }else{
        @assert(false); // Error: unknown state
        // assert() is ignored by HW, it could hang here
        // To avoid a stall, trigger callback (the caveat is the wrong result)
        sys_mod.unblock_cmd_stream();
    }
}

comptime {
    @bind_local_task( f_state, STATE);
}


comptime {
    @export_symbol(ptr_b, "b");
    @export_symbol(ptr_x, "x");
    @export_symbol(ptr_A, "A");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    @export_symbol(ptr_time_ref, "time_ref");
    @export_symbol(ptr_rho, "rho");
}

comptime{
    @export_symbol(f_enable_timer);
    @export_symbol(f_tic);
    @export_symbol(f_toc);
    @export_symbol(f_memcpy_timestamps);

    @export_symbol(f_cg);

    @export_symbol(f_reference_timestamps);
}
