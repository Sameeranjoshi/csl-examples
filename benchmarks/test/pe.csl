var invalid = @zeros([10]f32);
var dsd_invalid = @get_dsd(mem1d_dsd, .{.tensor_access = |i|{5} -> invalid[4 + i]});   // small
fn print_dsd(val: f32) void {
    simprint.fmt_with_coords("val = {f}", .{val});
}
