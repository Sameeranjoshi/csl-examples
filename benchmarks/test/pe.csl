param memcpy_params: comptime_struct;
param total_levels_count: u16;
param layers_data: [1]comptime_struct;
param runtime_array: [2, 4]u16;

// var N: u16;
const simprint = @import_module("<simprint>", .{ .enable = true });
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const bcast_color  : color         = @get_color(4); 
const send_bcast_oq = @get_output_queue(1);

fn foo(layer_index: u16) void {
   var li = layer_index;
   const N:u16 = runtime_array[li, 0];
   comptime var N_comp = N;
   const M:u16 = runtime_array[li, 1];
   const K:u16 = runtime_array[li, 2];
   const L:u16 = runtime_array[li, 3];
   simprint.fmt_with_coords("\n layer_index = {d}, N = {d}, M = {d}, K = {d}, L = {d}", .{li, N, M, K, L});

    // const M_comp = layers_data[li].M;
  const out_dsd = @get_dsd(fabout_dsd, .{
                    .fabric_color = bcast_color, 
                    .extent = N_comp,
                    .output_queue = send_bcast_oq,
                  });

}

fn user() void {
    foo(0);
    foo(1);
    sys_mod.unblock_cmd_stream();
}

comptime {
    @export_symbol(user);
}