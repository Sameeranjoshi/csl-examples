// Geometric Multigrid (GMG) V-cycle kernel with state machine
// Implements full V-cycle on device without host intervention
//-------------------------------------------------
// PARAMETERS TO THIS MODULE
//-------------------------------------------------

// parameters
param memcpyParams: comptime_struct;
param reduceParams: comptime_struct;
param stencilParams: comptime_struct;
param MAX_ZDIM: i16;
param BLOCK_SIZE: i16;
param LEVELS: i16;
param STATE: local_task_id;
const MAX_ITERATIONS: i16 = 100;  // Maximum iterations for storing rho history, this takes some space be mindful with allocations.

//-------------------------------------------------
// LIBRARIES and STATE MACHINE STATES
//-------------------------------------------------
const math_lib = @import_module("<math>");
const blas_lib = @import_module("blas.csl"); // modified reduced some code.
const sys_mod = @import_module( "<memcpy/memcpy>", memcpyParams);
// const timestamp = @import_module("<time>");
const timer = @import_module("timer_modified.csl", .{ .timerCount = 11 });
const reduce_mod = @import_module("./modified_csl_lib_hops/allreduce/pe.csl", @concat_structs(reduceParams, .{
     .f_callback = f_trigger_state_machine,
     .queues = [1]u16{2},
     .dest_dsr_ids = [1]u16{1},
     .src0_dsr_ids = [1]u16{1},
     .src1_dsr_ids = [1]u16{1},
     .MAX_PENCIL_DIM = MAX_ZDIM  // OPTIMIZATION: Pass MAX_ZDIM to size zero_buf dynamically, saves ~1KB for 256 problem
     }));
const stencil_mod = @import_module("./modified_csl_lib_hops/stencil_3d_7pts/pe.csl", @concat_structs(stencilParams, .{
     .f_callback = f_trigger_state_machine,
     .input_queues = [4]u16{4, 5, 6, 7},
     .output_queues = if (@is_arch("wse3")) [4]u16{4, 5, 6, 7} else [1]u16{3},
     .output_ut_id = 3,
     .BLOCK_SIZE = BLOCK_SIZE,
     .dest_dsr_ids = [2]u16{2,3},
     .src0_dsr_ids = [1]u16{2},
     .src1_dsr_ids = [2]u16{2,3},
     .timer=timer,
     }));
const layout_mod = @import_module("<layout>");
const simprint = @import_module("<simprint>", .{.enable = true});

// State definitions
const STATE_INIT: i16 = 0;
const STATE_DOWN_INIT: i16 = 1;
const STATE_DOWN_SMOOTH_APPLY: i16 = 2;
const STATE_DOWN_SMOOTH_UPDATE: i16 = 3;
const STATE_DOWN_SMOOTH_CHECK: i16 = 4;
const STATE_DOWN_RESIDUAL_APPLY: i16 = 5;
const STATE_DOWN_RESIDUAL_COMPUTE: i16 = 6;
const STATE_DOWN_RESTRICT_REDUCE: i16 = 7;
const STATE_DOWN_RESTRICT_DIV: i16 = 8;
const STATE_DOWN_LEVEL_CHECK: i16 = 9;
const STATE_COARSE_INIT: i16 = 10;
const STATE_COARSE_SMOOTH_APPLY: i16 = 11;
const STATE_COARSE_SMOOTH_UPDATE: i16 = 12;
const STATE_COARSE_SMOOTH_CHECK: i16 = 13;
const STATE_UP_INIT: i16 = 14;
const STATE_UP_EXPAND_Z: i16 = 15;
const STATE_UP_BCAST: i16 = 16;
const STATE_UP_INTERP_ADD: i16 = 17;
const STATE_UP_SMOOTH_APPLY: i16 = 18;
const STATE_UP_SMOOTH_UPDATE: i16 = 19;
const STATE_UP_SMOOTH_CHECK: i16 = 20;
const STATE_UP_LEVEL_CHECK: i16 = 21;
const STATE_EXIT: i16 = 22;
const STATE_SYNC: i16 = 23;
const STATE_CONV_CHECK: i16 = 24;  // Convergence check after V-cycle
const STATE_CALC_RHO: i16 = 25;  // Calculate rho = |r|^2
const STATE_RESIDUAL_AFTER_V_CYCLE_APPLY: i16 = 26;  // Apply operator after V-cycle to compute Au
const STATE_RESIDUAL_AFTER_V_CYCLE_COMPUTE: i16 = 27;  // Compute residual after V-cycle

// Timer identifiers
const TIMER_ID_SMOOTH: i16 = 0;
const TIMER_ID_RESIDUAL: i16 = 1;
const TIMER_ID_RESTRICT: i16 = 2;
const TIMER_ID_INTERP: i16 = 3;
const TIMER_ID_TOTAL: i16 = 4;
const TIMER_ID_SETUP_INIT: i16 = 5;
const TIMER_ID_RHO_CHECK: i16 = 6;
const TIMER_ID_H2D: i16 = 7;
const TIMER_ID_D2H: i16 = 8;
const TIMER_SPMV_TOTAL: i16=9;
const TIMER_SPMV_COMMUNICATION: i16=10; // Make sure the modules have the same number to avoid UB.

//-------------------------------------------------
// DATA on 48KB(variables, pointers, DSDs)
//-------------------------------------------------

// Compute total storage needed for GMG levels using geometric series formula
// Total = zdim + zdim/2 + zdim/4 + ... + zdim/2^(LEVELS-1)
// This function uses a comptime loop (like the identity matrix example)
fn compute_total_gmg_size() i16 {
    var total: i16 = 0;
    var level: i16 = 0;

    // geometric series: z + z/2 + z/4 + ... for LEVELS terms
    while (level < LEVELS) : (level += 1) {
        total += @as(i16, @as(u16, MAX_ZDIM) >> level);
    }

    return total;
}

// GMG data structures
var u = @zeros([MAX_ZDIM]f32);
var f = @zeros([MAX_ZDIM]f32);
var r = @zeros([MAX_ZDIM]f32);
var Au = @zeros([MAX_ZDIM]f32);
var residual_temp = @zeros([MAX_ZDIM]f32);
const TOTAL_GMG_SIZE: i16 = compute_total_gmg_size();
var save_u_smooth = @zeros([TOTAL_GMG_SIZE]f32);
var save_f_down = @zeros([TOTAL_GMG_SIZE]f32);

// Grid spacing arrays for each level (passed from host)
var hx_array = @zeros([LEVELS]f32);
var hy_array = @zeros([LEVELS]f32);
var hz_array = @zeros([LEVELS]f32);

// Jacobi coefficients for each level
var jacobi_coeff_array = @zeros([LEVELS]f32);

// Timing buffers - store accumulated elapsed timestamps for each operation at each level
// Operations: smooth (down + up separate), apply_op, restriction, interpolation
// For each operation we store elapsed timestamp words only (u16[tsc_size_words])
var timing_smooth = @zeros([LEVELS * timer.tsc_size_words]u16); // pre-/post-smoothing accumulated elapsed timing
var timing_apply_op = @zeros([LEVELS * timer.tsc_size_words]u16);    // operator application accumulated elapsed timing
var timing_residual = @zeros([LEVELS * timer.tsc_size_words]u16);    // residual accumulated elapsed timing
var timing_compute = @zeros([LEVELS * timer.tsc_size_words]u16);      // compute accumulated elapsed timing
var timing_communication = @zeros([LEVELS * timer.tsc_size_words]u16);      // communication accumulated elapsed timing
var timing_restrict = @zeros([LEVELS * timer.tsc_size_words]u16);    // restriction accumulated elapsed timing
var timing_interp = @zeros([LEVELS * timer.tsc_size_words]u16);      // interpolation accumulated elapsed timing
var timing_setup_init = @zeros([LEVELS * timer.tsc_size_words]u16);      // setup initialization accumulated elapsed timing
var timing_rho_check = @zeros([LEVELS * timer.tsc_size_words]u16);      // rho check accumulated elapsed timing
var timing_spmv_total = @zeros([LEVELS * timer.tsc_size_words]u16);      // spmv total accumulated elapsed timing
var timing_spmv_communication = @zeros([LEVELS * timer.tsc_size_words]u16);      // spmv communication accumulated elapsed timing
var timing_spmv_compute = @zeros([LEVELS * timer.tsc_size_words]u16);      // spmv compute accumulated elapsed timing

// Operation counters - track number of operations at each level
var counter_smooth = @zeros([LEVELS]u16);    // Number of up smoothing iterations per level
var counter_apply_op = @zeros([LEVELS]u16);     // Number of operator applications per level
var counter_residual = @zeros([LEVELS]u16);     // Number of residual operations per level
var counter_restrict = @zeros([LEVELS]u16);     // Number of restriction operations per level
var counter_interp = @zeros([LEVELS]u16);       // Number of interpolation operations per level
var counter_setup_init = @zeros([LEVELS]u16);   // Number of setup initialization operations per level
var counter_rho_check = @zeros([LEVELS]u16);   // Number of rho check operations per level
var counter_compute = @zeros([LEVELS]u16);   // Number of compute operations per level
var counter_communication = @zeros([LEVELS]u16);   // Number of communication operations per level

// Reference clock from allreduce module (for TSC synchronization)
// start, end
var time_total_start_end_u16 = @zeros([timer.tsc_size_words]u16);   // this is also elapsed time for entire V-cycle, 1 level
var time_ref_u16 = @zeros([timer.tsc_size_words]u16);
var time_h2d_u16 = @zeros([timer.tsc_size_words]u16);
var time_d2h_u16 = @zeros([timer.tsc_size_words]u16);
var tscStartBuffer = @zeros([timer.tsc_size_words]u16);
var tscEndBuffer = @zeros([timer.tsc_size_words]u16);
var dot = @zeros([1]f32); // dummy variable for f_sync

// GMG parameters
var hx_level: f32 = @as(f32, 1.0);
var hy_level: f32 = @as(f32, 1.0);
var hz_level: f32 = @as(f32, 1.0);
var stencil_coeff = @zeros([7]f32);

// State machine parameters
var n: i16 = 0;  // zDim
var num_levels: i16 = 0;
var pre_smooth_iter: i16 = 0;
var post_smooth_iter: i16 = 0;
var bottom_solver_iter: i16 = 0;
var max_iter: i16 = 0;  // Maximum number of V-cycle iterations
var tolerance: f32 = @as(f32, 0.0);  // Convergence tolerance
// var rho: f32 = @as(f32, 0.0);  // L2 norm squared of residual (like PCG's xi)
fn fill_rho() [1]f32 {
    var rho = @zeros([1]f32);
    rho[0] = @as(f32, 1000.0);
    return rho;
}
var rho = fill_rho();
var k: i16 = 0;  // Current iteration counter

// Array to store rho values after each iteration for host reading
var rho_history = @zeros([MAX_ITERATIONS]f32);
// Modified stencil/allreduce parameters
var factor: u16 = 1;
var hops: u16 = 1;
var restriction_window_width: u16 = 1;
var restriction_window_height: u16 = 1;
var active_pes_in_restriction_window_x: u16 = 2;
var active_pes_in_restriction_window_y: u16 = 2;
const rectangle = @get_rectangle();
const width: u16 = rectangle.width;
const height: u16 = rectangle.height;

var current_level_id: u16 = 0;
var is_active_pe: bool = true;

// State machine state variables
var current_level: i16 = 0;
var current_smooth_iter: i16 = 0;
var cur_state: i16 = 0;
var next_state: i16 = 0;

// DSDs
var mem_u_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> u[i] });
var mem_f_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> f[i] });
var mem_r_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> r[i] });
var mem_Au_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> Au[i] });
var mem_save_u_smooth_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> save_u_smooth[i] });
var mem_save_f_down_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> save_f_down[i] });
var mem_residual_temp_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> residual_temp[i] });
var mem_r_even_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> r[i] });
var mem_r_odd_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> r[i] });
var mem_f_coarse_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> f[i] });

// data pointers
var ptr_u: [*]f32 = &u;
var ptr_f: [*]f32 = &f;
var ptr_r: [*]f32 = &r;
var ptr_hx_array: [*]f32 = &hx_array;
var ptr_hy_array: [*]f32 = &hy_array;
var ptr_hz_array: [*]f32 = &hz_array;
var ptr_jacobi_coeff_array: [*]f32 = &jacobi_coeff_array;
// timing pointers
var ptr_timing_smooth: [*]u16 = &timing_smooth;
var ptr_timing_apply_op: [*]u16 = &timing_apply_op;
var ptr_timing_residual: [*]u16 = &timing_residual;
var ptr_timing_restrict: [*]u16 = &timing_restrict;
var ptr_timing_interp: [*]u16 = &timing_interp;
var ptr_timing_setup_init: [*]u16 = &timing_setup_init;
var ptr_timing_rho_check: [*]u16 = &timing_rho_check;
var ptr_time_h2d: [*]u16 = &time_h2d_u16;
var ptr_time_d2h: [*]u16 = &time_d2h_u16;
var ptr_time_ref: [*]u16 = &time_ref_u16;
var ptr_time_total_start_end: [*]u16 = &time_total_start_end_u16;
var ptr_timing_compute: [*]u16 = &timing_compute;
var ptr_timing_communication: [*]u16 = &timing_communication;
var ptr_timing_spmv_total: [*]u16 = &timing_spmv_total;
var ptr_timing_spmv_communication: [*]u16 = &timing_spmv_communication;
var ptr_timing_spmv_compute: [*]u16 = &timing_spmv_compute;

// counter pointers
var ptr_counter_smooth: [*]u16 = &counter_smooth;
var ptr_counter_apply_op: [*]u16 = &counter_apply_op;
var ptr_counter_residual: [*]u16 = &counter_residual;
var ptr_counter_restrict: [*]u16 = &counter_restrict;
var ptr_counter_interp: [*]u16 = &counter_interp;
var ptr_counter_setup_init: [*]u16 = &counter_setup_init;
var ptr_rho: [*]f32 = &rho;
var ptr_counter_rho_check: [*]u16 = &counter_rho_check;
var ptr_counter_compute: [*]u16 = &counter_compute;
var ptr_counter_communication: [*]u16 = &counter_communication;
var ptr_rho_history: [*]f32 = &rho_history;

//-------------------------------------------------
// HELPER FUNCTIONS
//-------------------------------------------------
// Helper functions
fn isActivePE(px: i16, py: i16, factor_val: u16) bool {
    return (px % @as(i16, factor_val)) == 0 and (py % @as(i16, factor_val)) == 0;
}

fn is_top_left_of_restriction_window(px: u16, py: u16, window_width: u16, window_height: u16) bool {
    const window_idx_x: u16 = px / window_width;
    const window_idx_y: u16 = py / window_height;
    const window_st_x: u16 = window_idx_x * window_width;
    const window_st_y: u16 = window_idx_y * window_height;
    return (px == window_st_x) and (py == window_st_y);
}

// ------------------------------------------------
// TIMER HELPER FUNCTIONS
// ------------------------------------------------

// Enable timing
fn f_enable_timer() void {
    timer.enable();
    sys_mod.unblock_cmd_stream();
}

// Copy reference clock from allreduce module
fn f_reference_timestamps() void {
    time_ref_u16[0] = reduce_mod.tscRefBuffer[0];
    time_ref_u16[1] = reduce_mod.tscRefBuffer[1];
    time_ref_u16[2] = reduce_mod.tscRefBuffer[2];
    sys_mod.unblock_cmd_stream();
}

fn f_tic_total() void {
    timer.start(TIMER_ID_TOTAL);
    
    // timestamp.get_timestamp(&tscStartBuffer);
    // sys_mod.unblock_cmd_stream();
}

fn f_toc_total() void {
    // timestamp.get_timestamp(&tscEndBuffer);

    // time_total_start_end_u16[0] = tscStartBuffer[0];
    // time_total_start_end_u16[1] = tscStartBuffer[1];
    // time_total_start_end_u16[2] = tscStartBuffer[2];
    // time_total_start_end_u16[3] = tscEndBuffer[0];
    // time_total_start_end_u16[4] = tscEndBuffer[1];
    // time_total_start_end_u16[5] = tscEndBuffer[2];
    timer.stop(TIMER_ID_TOTAL);
    timer.elapsed(TIMER_ID_TOTAL, @ptrcast(*[timer.tsc_size_words]u16, &time_total_start_end_u16));
    // sys_mod.unblock_cmd_stream();
}

fn f_tic_h2d() void {
    timer.start(TIMER_ID_H2D);
    sys_mod.unblock_cmd_stream();
}

fn f_toc_h2d() void {
    timer.stop(TIMER_ID_H2D);
    // timer.elapsed(TIMER_ID_H2D, @ptrcast(*[timer.timestamp_size]u16, &time_h2d_u16));
    timer.elapsed(TIMER_ID_H2D, @ptrcast(*[timer.tsc_size_words]u16, &time_h2d_u16));
    sys_mod.unblock_cmd_stream();
}

fn f_tic_d2h() void {
    timer.start(TIMER_ID_D2H);
    sys_mod.unblock_cmd_stream();
}

fn f_toc_d2h() void {
    timer.stop(TIMER_ID_D2H);
    // timer.elapsed(TIMER_ID_D2H, @ptrcast(*[timer.timestamp_size]u16, &time_d2h_u16));
    timer.elapsed(TIMER_ID_D2H, @ptrcast(*[timer.tsc_size_words]u16, &time_d2h_u16));
    sys_mod.unblock_cmd_stream();
}

