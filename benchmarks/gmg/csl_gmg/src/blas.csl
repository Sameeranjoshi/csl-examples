// Basic Linear Algebra Subprograms (BLAS) for GMG
// Implements dot product and other vector operations

// Dot product: result = sum(x[i] * y[i])
fn dot(n: i16, x: [*]f32, y: [*]f32) f32 {
    var result: f32 = @as(f32, 0.0);
    
    for (0..n) |i| {
        result += x[i] * y[i];
    }
    
    return result;
}

// Vector addition: z = x + y
fn add(n: i16, x: [*]f32, y: [*]f32, z: [*]f32) void {
    for (0..n) |i| {
        z[i] = x[i] + y[i];
    }
}

// Vector subtraction: z = x - y
fn sub(n: i16, x: [*]f32, y: [*]f32, z: [*]f32) void {
    for (0..n) |i| {
        z[i] = x[i] - y[i];
    }
}

// Scalar multiplication: y = alpha * x
fn scal(n: i16, alpha: f32, x: [*]f32, y: [*]f32) void {
    for (0..n) |i| {
        y[i] = alpha * x[i];
    }
}

// Vector copy: y = x
fn copy(n: i16, x: [*]f32, y: [*]f32) void {
    for (0..n) |i| {
        y[i] = x[i];
    }
}

// Vector norm: ||x||_2
fn norm(n: i16, x: [*]f32) f32 {
    var result: f32 = @as(f32, 0.0);
    
    for (0..n) |i| {
        result += x[i] * x[i];
    }
    
    return @sqrt(result);
}

// Export functions
comptime {
    @export_symbol(dot);
    @export_symbol(add);
    @export_symbol(sub);
    @export_symbol(scal);
    @export_symbol(copy);
    @export_symbol(norm);
}
