//     time_ref_u16[0] = reduce_mod.tscRefBuffer[0];
//     time_ref_u16[1] = reduce_mod.tscRefBuffer[1];
//     time_ref_u16[2] = reduce_mod.tscRefBuffer[2];
//     sys_mod.unblock_cmd_stream();
// }

fn f_trigger_state_machine() void {
    // Simple trigger for compatibility with modules
    sys_mod.unblock_cmd_stream();
}

// Export symbols
comptime {
    @export_symbol(ptr_u, "u");
    @export_symbol(ptr_f, "f");
    @export_symbol(ptr_r, "r");
    @export_symbol(ptr_Au, "Au");
    @export_symbol(ptr_stencil_coeff, "stencil_coeff");
    // @export_symbol(ptr_Au, "Au");
    // @export_symbol(ptr_u_smooth, "u_smooth");
    // @export_symbol(ptr_r_coarse, "r_coarse");
    // @export_symbol(ptr_u_coarse, "u_coarse");
    // @export_symbol(ptr_correction, "correction");
    // @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    // @export_symbol(ptr_time_ref, "time_ref");
    // @export_symbol(ptr_residual_norm, "residual_norm");
}

comptime {
    // @export_symbol(f_enable_timer);
    // @export_symbol(f_tic);
    // @export_symbol(f_toc);
    // @export_symbol(f_memcpy_timestamps);
    // @export_symbol(f_reference_timestamps);
    @export_symbol(f_gmg_init);
    @export_symbol(f_apply_operator);
    @export_symbol(f_residual);
    @export_symbol(f_trigger_state_machine);
    @export_symbol(f_jacobi_smooth);
    // @export_symbol(f_restrict);
