// Layout for Geometric Multigrid (GMG) kernel
// Defines the core rectangle and communication patterns

param width: i16;
param height: i16;
param MAX_ZDIM: i16;
param BLOCK_SIZE: i16;

// Core rectangle parameters
param C0_ID: i16;
param C1_ID: i16;
param C2_ID: i16;
param C3_ID: i16;
param C4_ID: i16;
param C5_ID: i16;
param C6_ID: i16;
param C7_ID: i16;
param C8_ID: i16;

// Import the main kernel
const kernel_gmg = @import_module("kernel_gmg.csl", .{
    .memcpyParams = .{
        .width = width,
        .height = height,
        .MAX_ZDIM = MAX_ZDIM,
        .BLOCK_SIZE = BLOCK_SIZE,
        .C0_ID = C0_ID,
        .C1_ID = C1_ID,
        .C2_ID = C2_ID,
        .C3_ID = C3_ID,
        .C4_ID = C4_ID,
        .C5_ID = C5_ID,
        .C6_ID = C6_ID,
        .C7_ID = C7_ID,
        .C8_ID = C8_ID,
    },
    .reduceParams = .{
        .width = width,
        .height = height,
        .MAX_ZDIM = MAX_ZDIM,
        .BLOCK_SIZE = BLOCK_SIZE,
        .C0_ID = C0_ID,
        .C1_ID = C1_ID,
        .C2_ID = C2_ID,
        .C3_ID = C3_ID,
        .C4_ID = C4_ID,
        .C5_ID = C5_ID,
        .C6_ID = C6_ID,
        .C7_ID = C7_ID,
        .C8_ID = C8_ID,
    },
    .stencilParams = .{
        .width = width,
        .height = height,
        .MAX_ZDIM = MAX_ZDIM,
        .BLOCK_SIZE = BLOCK_SIZE,
        .C0_ID = C0_ID,
        .C1_ID = C1_ID,
        .C2_ID = C2_ID,
        .C3_ID = C3_ID,
        .C4_ID = C4_ID,
        .C5_ID = C5_ID,
        .C6_ID = C6_ID,
        .C7_ID = C7_ID,
        .C8_ID = C8_ID,
    },
    .MAX_ZDIM = MAX_ZDIM,
    .BLOCK_SIZE = BLOCK_SIZE,
});

// Export the kernel functions
comptime {
    @export_symbol(kernel_gmg.f_enable_timer);
    @export_symbol(kernel_gmg.f_tic);
    @export_symbol(kernel_gmg.f_toc);
    @export_symbol(kernel_gmg.f_memcpy_timestamps);
    @export_symbol(kernel_gmg.f_reference_timestamps);
    @export_symbol(kernel_gmg.f_gmg_init);
    @export_symbol(kernel_gmg.f_apply_operator);
    @export_symbol(kernel_gmg.f_compute_residual);
    @export_symbol(kernel_gmg.f_jacobi_smooth);
    @export_symbol(kernel_gmg.f_restrict);
    @export_symbol(kernel_gmg.f_interpolate);
    @export_symbol(kernel_gmg.f_add_correction);
}


