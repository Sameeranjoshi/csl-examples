// Geometric Multigrid (GMG) V-cycle kernel with state machine
// Implements full V-cycle on device without host intervention
//-------------------------------------------------
// PARAMETERS TO THIS MODULE
//-------------------------------------------------

// parameters
param memcpyParams: comptime_struct;
param MAX_ZDIM: i16;
param BLOCK_SIZE: i16;
param LEVELS: i16;


//-------------------------------------------------
// LIBRARIES and STATE MACHINE STATES
//-------------------------------------------------

const sys_mod = @import_module( "<memcpy/memcpy>", memcpyParams);
// const timer = @import_module("timer_modified.csl", .{ .timerCount = 5 });
const timer = @import_module("<time>");
const simprint = @import_module("<simprint>", .{.enable = true});


//----------------------------------------------------//---------------------------------------------------
// DATA on 48KB(variables, pointers, DSDs)
//----------------------------------------------------//----------------------------------------------------

var timing_smooth = @zeros([timer.tsc_size_words]u16); // pre-/post-smoothing accumulated elapsed timing
var timing_residual = @zeros([timer.tsc_size_words]u16);    // residual accumulated elapsed timing
var timing_restrict = @zeros([timer.tsc_size_words]u16);    // restriction accumulated elapsed timing
var timing_interp = @zeros([timer.tsc_size_words]u16);      // interpolation accumulated elapsed timing
var timing_spmv_total = @zeros([timer.tsc_size_words]u16);      // spmv total accumulated elapsed timing
var timing_spmv_communication = @zeros([timer.tsc_size_words]u16);      // spmv communication accumulated elapsed timing
var timing_spmv_compute = @zeros([timer.tsc_size_words]u16);      // spmv compute accumulated elapsed timing
var time_total_start_end_u16 = @zeros([timer.tsc_size_words]u16);   // this is also elapsed time for entire V-cycle, 1 level

// Operation counters - track number of operations at each level
var counter_smooth = @zeros([LEVELS]u16);    // Number of up smoothing iterations per level
var counter_apply_op = @zeros([LEVELS]u16);     // Number of operator applications per level
var counter_residual = @zeros([LEVELS]u16);     // Number of residual operations per level
var counter_rho_check = @zeros([LEVELS]u16);   // Number of rho check operations per level
var counter_restrict = @zeros([LEVELS]u16);     // Number of restriction operations per level
var counter_interp = @zeros([LEVELS]u16);       // Number of interpolation operations per level
var counter_setup_init = @zeros([LEVELS]u16);   // Number of setup initialization operations per level

// timing pointers
var ptr_timing_smooth: [*]u16 = &timing_smooth;
var ptr_timing_residual: [*]u16 = &timing_residual;
var ptr_timing_restrict: [*]u16 = &timing_restrict;
var ptr_timing_interp: [*]u16 = &timing_interp;
var ptr_time_total_start_end: [*]u16 = &time_total_start_end_u16;
var ptr_timing_spmv_total: [*]u16 = &timing_spmv_total;
var ptr_timing_spmv_communication: [*]u16 = &timing_spmv_communication;
var ptr_timing_spmv_compute: [*]u16 = &timing_spmv_compute;

// counter pointers
var ptr_counter_smooth: [*]u16 = &counter_smooth;
var ptr_counter_apply_op: [*]u16 = &counter_apply_op;
var ptr_counter_residual: [*]u16 = &counter_residual;
var ptr_counter_restrict: [*]u16 = &counter_restrict;
var ptr_counter_interp: [*]u16 = &counter_interp;
var ptr_counter_setup_init: [*]u16 = &counter_setup_init;
var ptr_counter_rho_check: [*]u16 = &counter_rho_check;

comptime {
    // timing
    @export_symbol(ptr_timing_smooth, "timing_smooth");
    @export_symbol(ptr_timing_residual, "timing_residual");
    @export_symbol(ptr_timing_restrict, "timing_restrict");
    @export_symbol(ptr_timing_interp, "timing_interp");
    @export_symbol(ptr_time_total_start_end, "time_total_start_end");
    @export_symbol(ptr_timing_spmv_total, "timing_spmv_total");
    @export_symbol(ptr_timing_spmv_communication, "timing_spmv_communication");
    @export_symbol(ptr_timing_spmv_compute, "timing_spmv_compute");    


    // counters
    @export_symbol(ptr_counter_smooth, "counter_smooth");
    @export_symbol(ptr_counter_apply_op, "counter_apply_op");
    @export_symbol(ptr_counter_residual, "counter_residual");
    @export_symbol(ptr_counter_restrict, "counter_restrict");
    @export_symbol(ptr_counter_interp, "counter_interp");
    @export_symbol(ptr_counter_setup_init, "counter_setup_init");
    @export_symbol(ptr_counter_rho_check, "counter_rho_check");

}
