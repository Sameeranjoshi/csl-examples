// The goal of this code is to 
// There are 3 layers, each layer has 3 PEs.
// 36, 0, 0, 0, 0, 0, 0, 0, 0
// bcast now in layer 0.
// 36, 36, 36, 0, 0, 0, 0, 0, 0
// Dataflow across layer 0 and layer 1.
// 36, 36, 36, 36, 0, 0, 0, 0, 0
// bcast now in layer 1.
// 36, 36, 36, 36, 36, 36, 0, 0, 0
// Dataflow across layer 1 and layer 2.
// 36, 36, 36, 36, 36, 36, 36, 0, 0 
// bcast now in layer 2.
// 36, 36, 36, 36, 36, 36, 36, 36, 36

param pe_id: u16;
param Pw: u16;
param root_id: u16;
param memcpy_params: comptime_struct;
param size_of_layer: u16;

// value from {0,1,2}
const inside_layer_pe_id: u16 = pe_id % size_of_layer;
// if pe_id is 0,1,2 layer is 0
// if pe_id is 3,4,5 layer is 1
// if pe_id is 6,7,8 layer is 2
const layer_index: u16 = pe_id / size_of_layer;



fn is_first_layer() bool {
  return layer_index == 0;
}

fn is_last_layer() bool {
  return layer_index == size_of_layer - 1;
}

fn is_pe_first_in_layer() bool {
  return inside_layer_pe_id == 0;
}

fn is_pe_last_in_layer() bool {
  return inside_layer_pe_id == size_of_layer - 1;
}

fn is_pe_send_column() bool {
  return is_pe_last_in_layer();
}

fn is_pe_recv_column() bool {
  return is_pe_first_in_layer();
}

 
// const root_id: u16 = 5;
const broadcast_right1 = @import_module("broadcast.csl", .{
    .color_1 = @get_color(0),
    .pe_id = pe_id,
    .root_id = 0,
    .POS_DIR = EAST,
    .NEG_DIR = WEST,
    .start_index = 0, // should be 0, 3, 6
    .end_index = 2
});

const broadcast_right2 = @import_module("broadcast.csl", .{
    .color_1 = @get_color(1),
    .pe_id = pe_id,
    .root_id = 3,
    .POS_DIR = EAST,
    .NEG_DIR = WEST,
    .start_index = 3, // should be 3,4,5
    .end_index = 5
});

const broadcast_right3 = @import_module("broadcast.csl", .{
    .color_1 = @get_color(2),
    .pe_id = pe_id,
    .root_id = 6, 
    .POS_DIR = EAST,
    .NEG_DIR = WEST,
    .start_index = 6, // should be 6,7,8
    .end_index = 8
});

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const simprint = @import_module("<simprint>", .{ .enable = true });

// Data buffer for broadcast
const Nx = 1;
var x = @zeros([Nx]f32);
var x_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> x[i] });
var x_ptr: [*]f32 = &x;
var invalid_f32 = @zeros([1]f32);
var invalid_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> invalid_f32[i] });


param send_color: color = @get_color(3);
const activation_color: color = @get_color(4);
// const done_task_id: local_task_id = @get_local_task_id(4);
const exit_task_id: local_task_id = @get_local_task_id(5);
const compute_inside_layer_id: local_task_id = @get_local_task_id(6);
const send_right_task_id: local_task_id = @get_local_task_id(7);
const recv_left_task_id: data_task_id = @get_data_task_id(send_color);
const unblock_current_layer_id: local_task_id = @get_local_task_id(8);
const recv_activation_signal_id: data_task_id = @get_data_task_id(activation_color);
const send_color_oq = @get_output_queue(2);
const send_color_iq = @get_input_queue(2);
const activation_oq = @get_output_queue(3);
const activation_iq = @get_input_queue(3);



task send_right() void {
    if (is_pe_send_column() and !is_last_layer()) {
        const out_dsd = @get_dsd(fabout_dsd, .{
                    .fabric_color = send_color, 
                    .extent = Nx,
                    .output_queue = send_color_oq
                  });
        simprint.fmt_with_coords("send_right: x = {f}", .{x[0]});
        @fmovs(out_dsd, x_dsd, .{ .async = true });
    } else if (is_last_layer()) { // EXIT
        @activate(exit_task_id);
    }
}

// WTT
var num_recv_count: i16 = 0;
task recv_left(recv_data: f32) void {
    x[num_recv_count] = recv_data;
    // add 1 to the received data.
    x[num_recv_count] += 1.0;

    num_recv_count += 1;
    if (num_recv_count == Nx) {
      simprint.fmt_with_coords("recv_left layer_index={d} fully received", .{ @as(u32, layer_index) });
      @activate(unblock_current_layer_id);
    }
}

// This is just sending a signal and not real data.
task unblock_current_layer() void {
  const out_dsd = @get_dsd(fabout_dsd, .{
                    .fabric_color = activation_color, 
                    .extent = 1,  // no data only signal.
                    .output_queue = activation_oq
                  });
        simprint.fmt_with_coords("unblock_current_layer: layer_index={d}", .{ @as(u32, layer_index) });
        @fmovs(out_dsd, invalid_dsd, .{ .async = true }); 
}

// WTT
task recv_activation_signal(invalid_data: f32) void {
  @unblock(compute_inside_layer_id);
}

fn initialize() void {
    x[0] = @as(f32, 0.0);
    if (pe_id == 0) {
        x[0] = @as(f32, 1.0);  // propogate this to the end.
    }
    
    simprint.fmt_with_coords("x_initial = {f}", .{x[0]});
}

task compute_inside_layer() void {
    if (layer_index == 0) {
        broadcast_right1.transfer_data(x_ptr, Nx, send_right_task_id);
    } else if (layer_index == 1) {
        broadcast_right2.transfer_data(x_ptr, Nx, send_right_task_id);
    } else if (layer_index == 2) {
        broadcast_right3.transfer_data(x_ptr, Nx, send_right_task_id);
    }
}

// Initialize data
fn init_data() void {
    @activate(compute_inside_layer_id);
    initialize();

    if (is_first_layer()) {
        @unblock(compute_inside_layer_id);
    }
}

fn print_x() void {
  simprint.fmt_with_coords("x = {f}", .{x[0]});
  sys_mod.unblock_cmd_stream();
}

task exit_task() void {
    simprint.fmt_with_coords("x = {f}", .{x[0]});
    sys_mod.unblock_cmd_stream();
}
comptime {
    @block(compute_inside_layer_id);
    @bind_local_task(exit_task, exit_task_id);
    @bind_local_task(compute_inside_layer, compute_inside_layer_id);
    @bind_local_task(send_right, send_right_task_id);
    @bind_data_task(recv_left, recv_left_task_id);
    @bind_local_task(unblock_current_layer, unblock_current_layer_id);
    @bind_data_task(recv_activation_signal, recv_activation_signal_id);
    broadcast_right1.configure_network();
    broadcast_right2.configure_network();
    broadcast_right3.configure_network();
    @export_symbol(init_data);
    @export_symbol(print_x);

   configure_dataflow_bridge();
}

fn configure_dataflow_bridge() void {
    // interlayer dataflow.
    if (is_pe_send_column()) {
      @set_local_color_config(send_color, .{.routes = .{ .rx = .{RAMP}, .tx = .{EAST}  }});
    } else if (is_pe_recv_column()) {
      @set_local_color_config(send_color, .{.routes = .{ .rx = .{WEST}, .tx = .{RAMP}  }});
    }
    // activation color starts from first column of layer to last column of layer.
    if (is_pe_first_in_layer()) {
      @set_local_color_config(activation_color, .{.routes = .{ .rx = .{RAMP}, .tx = .{EAST, RAMP}  }});
    } else if (is_pe_last_in_layer()) {
      @set_local_color_config(activation_color, .{.routes = .{ .rx = .{WEST}, .tx = .{RAMP}  }});
    } else {
      @set_local_color_config(activation_color, .{.routes = .{ .rx = .{WEST}, .tx = .{EAST, RAMP}  }});
    }
}