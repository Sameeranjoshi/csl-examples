param pe_id: u16;
param Pw: u16;
param root_id: u16;
param memcpy_params: comptime_struct;
param c2d_params: comptime_struct;
param size_of_layer: u16;

// value from {0,1,2}
const inside_layer_pe_id: u16 = pe_id % size_of_layer;
// if pe_id is 0,1,2 layer is 0
// if pe_id is 3,4,5 layer is 1
// if pe_id is 6,7,8 layer is 2
const layer_index: u16 = inside_layer_pe_id / size_of_layer;



fn is_first_layer() bool {
  return layer_index == 0;
}

fn is_last_layer() bool {
  return layer_index == size_of_layer - 1;
}
fn is_pe_first_in_layer() bool {
  return inside_layer_pe_id == 0;
}

fn is_pe_last_in_layer() bool {
  return inside_layer_pe_id == size_of_layer - 1;
}

fn is_pe_send_column() bool {
  return is_pe_last_in_layer();
}

fn is_pe_recv_column() bool {
  return is_pe_first_in_layer();
}

// const root_id: u16 = 5;
const broadcast_right = @import_module("broadcast.csl", .{
    .color_1 = @get_color(4),
    .pe_id = pe_id,
    .root_id = root_id,
    .POS_DIR = EAST,
    .NEG_DIR = WEST,
    .start_index = 0,
    .end_index = Pw - 1
});

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const simprint = @import_module("<simprint>", .{ .enable = true });

// Data buffer for broadcast
const Nx = 1;
var x = @zeros([Nx]f32);
var x_ptr: [*]f32 = &x;

const exit_task_id: local_task_id = @get_local_task_id(3);

fn initialize() void {
    x[0] = @as(f32, pe_id); // {0,1,2,3,4,5,6,7,8 = Sum(0,1,2,3,4,5,6,7,8) = 36 }
    simprint.fmt_with_coords("x_initial = {f}", .{x[0]});
}

// Initialize data
fn init_data() void {
    initialize();
    broadcast_right.transfer_data(x_ptr, Nx, exit_task_id);
}

task exit_task() void {
    simprint.fmt_with_coords("x = {f}", .{x[0]});
    sys_mod.unblock_cmd_stream();
}
comptime {
    @bind_local_task(exit_task, exit_task_id);
    broadcast_right.configure_network();
    @export_symbol(init_data);
}