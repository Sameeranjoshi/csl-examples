
const Pw: u16 = 9;
const Ph: u16 = 1;
const memcpy_params = @import_module("<memcpy/get_params>", .{
  .width = Pw,
  .height = Ph,
});

// 0,1,2,3,4,5,6,7,8
// now mod of each by 3 
// 0,1,2,0,1,2,0,1,2
const layer_start_x: u16 = 0;
const layer_end_x: u16 = 2;
const size_of_layer: u16 = 3;

layout {
  @set_rectangle(Pw, Ph);

  for (@range(u16, Pw)) |Px| {
    for (@range(u16, Ph)) |Py| {     
      const memcpy_params = memcpy_params.get_params(Px);
      @set_tile_code(Px, Py, "code.csl", .{ 
        .pe_id = Px, 
        .root_id = Py, 
        .Pw = Pw, 
        .memcpy_params = memcpy_params,
        .size_of_layer = size_of_layer
        });
    }
  }

  @export_name("init_data", fn()void);
  @export_name("print_x", fn()void);
}
