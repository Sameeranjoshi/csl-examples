param memcpy_params: comptime_struct;
param total_levels_count: u16;
param layers_data: [total_levels_count]comptime_struct;
// Layers_data has shape for each level, M0, M1, M2, ... 
// Calculate the total size of the data blob for A.
const layer_size_map_A = layeridx_to_size_map_A();  // [M0, M1, M2, ...]
const layer_offset_map_A = layeridx_to_offset_map_A();  // [0, M0, M0 + M1, M0 + M1 + M2, ...]


fn get_size(layer_size_map: *const [total_levels_count] u16,  index: u16) u16 {
  @assert(index < total_levels_count);
  return (layer_size_map.*)[index];
}
fn get_offset(layer_offset_map: *const [total_levels_count] u16, index: u16) u16 {
  @assert(index < total_levels_count);
  return (layer_offset_map.*)[index];
}
// create the layer size map and offset map.
fn layeridx_to_size_map_A() [total_levels_count]u16 {
  var result = @zeros([total_levels_count]u16);
  for (layers_data) |layer_data, index| {
    result[index] = layer_data.M;
  }
  return result;
}
fn layeridx_to_offset_map_A() [total_levels_count]u16 {
  var result = @zeros([total_levels_count]u16);
  var running_sum: u16 = 0;
  for (layers_data) |layer_data, index| {
    result[index] = running_sum;
    running_sum += layer_data.M;
  }
  return result;
}
fn get_total_size_of_A_tile() u16 {
  var total_size_of_A_tile: u16 = 0;
    for (layers_data) |layer_data| {
        total_size_of_A_tile += layer_data.M;
    }
    return total_size_of_A_tile;
}
// 0, 1, 2, 3, ...
fn fill_data_in_A_tiles() [A_tiles_total_size]f32 {
  var data = @zeros([A_tiles_total_size]f32);
  for (@range(u16, A_tiles_total_size)) |i| {
    data[i] = @as(f32, i);
  }
  return data;
}

const A_tiles_total_size: u16 = get_total_size_of_A_tile(); // size
var A_tiles = fill_data_in_A_tiles();  // allocate memory for A_tiles

var N = 1;
var dsd_even_index = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N+1/2} -> A_tiles[2*i] });
// const odd_index = .{.base_address = &A_tiles, .extent = 1, .stride = 2, .offset = 1};

var dsd_odd_index = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N/2} -> A_tiles[2*i + 1] });
var ptr_A_tiles: [*]f32 = &A_tiles;



const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const simprint = @import_module("<simprint>", .{ .enable = true });

// print data as per index.
fn print_me(val: f32) void {
  simprint.fmt_with_coords("val = {f}", .{val});
  sys_mod.unblock_cmd_stream();
}
// level_index = What layer is this?
// layouttoapply = Apply this layout to the data.
// data = The address of the data to apply dsd on, like A, R, P, x, b, etc.
// data_name = Must be same as the data, A, R, P,...

fn get_level_dsd(level_index: u16, layouttoapply: mem1d_dsd, data: [*]f32, comptime data_name: comptime_string) mem1d_dsd {
  var offset_index: u16 = 0;
  var size_index: u16 = 0;
  if (data_name == "A") {
    offset_index = get_offset(&layer_offset_map_A, level_index);
    size_index = get_size(&layer_size_map_A, level_index);
  } else if (data_name == "R") {
    offset_index = get_offset(&layer_offset_map_R, level_index);
    size_index = get_size(&layer_size_map_R, level_index);
  } else if (data_name == "P") {
    offset_index = get_offset(&layer_offset_map_P, level_index);
    size_index = get_size(&layer_size_map_P, level_index);
  }

  simprint.fmt_with_coords("offset_index = {d}", .{offset_index});
  simprint.fmt_with_coords("size_index = {d}", .{size_index});
  // // First find the correct level and then apply the layout.
  // var sourceDSD = @set_dsd_base_addr(layouttoapply, data);
  var sourceDSD = @increment_dsd_offset(layouttoapply, @as(i16, offset_index), f32);
  // sourceDSD = @set_dsd_length(sourceDSD, (size_index + 1)/2);
  N = (size_index);
  return sourceDSD;
}

fn init_data_blob() void {
    for (@range(u16, total_levels_count)) |level_index| {
        // (level, layout, onwhatdata, "data name")
        var indexed_A_dsd = get_level_dsd(level_index, dsd_odd_index, &A_tiles, "A");
        @map(print_me, indexed_A_dsd);

        // change the value to level_index
        @fmovs(indexed_A_dsd, @as(f32, 555));
        // simprint.print_string("After fmovs\n");
        // @map(print_me, indexed_A_dsd);
    }
    sys_mod.unblock_cmd_stream();
}

fn print_data_blob() void {
  //1.
  simprint.fmt_with_coords("total_size_of_A_tile = {d}", .{A_tiles_total_size});

  //2.
  for (@range(u16, total_levels_count)) |i| {
    const size:u16 = get_size(&layer_size_map_A, i);
    const offset:u16 = get_offset(&layer_offset_map_A, i);
    simprint.fmt_with_coords("size = {d}", .{size});
    simprint.fmt_with_coords("offset = {d}", .{offset});
  }

  //3.
  for (A_tiles) |val, i| {
    simprint.fmt_with_coords("A_tiles[{d}] = {f}", .{ i, val });
  }

  sys_mod.unblock_cmd_stream();
}

fn before() void {
  for (A_tiles) |val, i| {
    simprint.fmt_with_coords("A_tiles[{d}] = {f}", .{ i, val });
  }
  sys_mod.unblock_cmd_stream();
}

comptime {
    // Symbols
    @export_symbol(init_data_blob);
    @export_symbol(print_data_blob);
    @export_symbol(before);
}
comptime {
  @export_symbol(ptr_A_tiles, "A_blob");
}
