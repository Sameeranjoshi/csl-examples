// Algorithm:
// 1. V-cycle down:
// The algorithm is as follows:
// 1. jacobi_smoother()
// x' = jacobi(x)
// 2. compute_residual()
// r = b - A*x'
// 3. restriction()
// b_next = R*r

// STATE MACHINE has below states:
// 1. Initialize:
// 2. Compute Jacobi:
// 3. Broadcast Jacobi:
// 4. Check Jacobi iteration:
// 5. Compute Residual:
// 6. Broadcast Residual:
// 7. Compute Restriction:

// Routing:
// Colors used: bridge_send_color, bcast_color
// There are N layers in AMG. Each layer is a subgrid of PEs.The first column
// of each layer is the recieving column.The last column of each layer is the 
// sending column across the layers.The routing across the layers is via bridge_send_color.
// This is a very static routing and might not be the best as this layout may not scale to 
// large number of PEs and might not be using the WSE at it's best.
// This layout can be beneficial if done pipelining.

// Layouts of data:
// Note: All the layouts are currently done ROW_MAJOR, even the data transfer from host, 
// this was choosen as it is easier to understand and implement.

// A is 2D block distribution.
// x is on top row and then bcasted to all columns.
// b is on left column and then bcasted to all rows.
// At this stage each PE has a tile of A, x, b. This is a typical matvec pattern
// seen in CSL tutorials and benchmarks. Each subgrid/layer does the computations
// and generates the final result in b_next to the rightmost column of the subgrid/layer.
// The last column sends the b_next to the next layer which is received in first column
//  of the next layer.The ALGORITHM steps repeat in next subgrid/layer and finally the 
// last column of rectangle is the output of down_cycle.

// Shapes: 
// A on each layer is a square matrix, R determines the shape of b_next.
// The R matrix coarsens the grid, so the size of A on next layer keeps getting smaller.
// I pass the shapes at each layer as a param to the kernel.

// Changes to libraries: 
// The only change is in mpi collectives library which was modified to understand the subgrid/layer.
// So for example the mpi_x.broadcast() will broadcast in the subgrid/layer and not the entire rectangle.
// The functionality was not changed just the params.csl understands the new min-max bounds.

// DSD and temp data:
// Todo: There are a lot of temporaries which might be simplified, I currently haven't thought about trimming them. 
// Most of the DSDs are linear across the total size of underlying data.

// Blocking and unblocking and PE usage:
// Intially when kernel launches the state machine is blocked, the first column broadcasts 
// the data to all PEs in the layer and once received the state machine is unblocked and activated.
// Currently the first layer is active and working on solving the algorithm, once the computations are done,
// the data is sent across the layers and once received on the next layer the bcast_b_tile triggers the state machine
// on the next layer. So when the first layer is active the second layer is inactive. 
// This is a serious drawback of the approach, as this WSE is stalled until a layer is activated.
// We are thinking about a analytical model which can predict us what might be a good layout to choose.
// Also a distributed approach might be better.

// Miscellaneous:
// typical matvec generated data on the left or right columnd, for the next iterations 
// of jacobi this data needs to be fed in on top rows, so this is typically a tranpose of across 
// PEs(data is generated on last column and I want it to be on first row).
// Approach1 = gather data on PE0.0 and then scatter across rows.
// I was afraid that this might need a lot of memory, I choose a different approach where in order 
// to perform a transpose I calculate on diagonals and then bcast across Y dimension.
// This is the pattern: 
// *   ↑   ↑
// ↓   *   ↑
// ↓   ↓   * 
// This might be causing a lot of communication I believe but couldn't think of anything else so just went with this.

// PE Layout: 
// The layout is autogenerated from a template, which tries to divide the total rectangle into subgrids/layers.
// Also each layer gets it's own data and it's bounds.

// params
param memcpy_params: comptime_struct;
param c2d_params: comptime_struct;
param layer_params: comptime_struct;
param pe_id_x: i16;
param pe_id_y: i16;
param total_pe_cols: i16;
param total_levels_count: i16;

const M_local: i16 = layer_params.M_local; // Height of local matrix, or num rows per PE
const N_local: i16 = layer_params.N_local; // Width of local matrix, or num cols per PE
const R_M_local: i16 = layer_params.R_M_local; // Height of local matrix, or num rows per PE
const R_N_local: i16 = layer_params.R_N_local; // Width of local matrix, or num cols per PE
const layer_start_x: i16 = layer_params.layer_start_x;
const layer_start_y: i16 = layer_params.layer_start_y;
const layer_end_x: i16 = layer_params.layer_end_x;
const layer_kernel_cols: i16 = layer_params.layer_kernel_cols;
const layer_index: i16 = layer_params.layer_index;

// Task IDs
const STATE_MACHINE: local_task_id = layer_params.layer_task_id[0];
const STATE_INIT: i16 = 1;
const STATE_COMPUTE_JACOBI: i16 = 2;
const STATE_BCAST_JACOBI: i16 = 3;
const STATE_CHECK_JACOBI_ITERATION: i16 = 4;
const STATE_COMPUTE_RESIDUAL: i16 = 5;
const STATE_BCAST_RESIDUAL: i16 = 6;
const STATE_COMPUTE_RESTRICTION: i16 = 7;
const STATE_SEND_DATA: i16 = 8;
const STATE_EXIT: i16 = 9;

// bridge colors
const bcast_color  : color         = @get_color(4); // This is also activating color.
const bridge_send_color  : color         = @get_color(5);
const state_exit_id: local_task_id = @get_local_task_id(13);

// tasks
const recv_left_bnext_id: data_task_id = @get_data_task_id(bridge_send_color);
const recv_b_tile_id: data_task_id = @get_data_task_id(bcast_color); //This should unblock
const send_right_bnext_id: local_task_id = @get_local_task_id(14);
const exit_task_id: local_task_id = @get_local_task_id(15);
const bcast_b_tile_id: local_task_id = @get_local_task_id(16);
const done_task_id: local_task_id = @get_local_task_id(17);
// Queue IDs
const bridge_send_color_oq = @get_output_queue(0);
const send_bcast_oq = @get_output_queue(1);
const send_bcast_iq = @get_input_queue(0);


const math_lib = @import_module("<math>");
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

const mpi_x = @import_module("../csl_source/csl-libs/collectives_2d/pe.csl", .{
    .dim_params = c2d_params.x,
    .queues = [2]u16{2,4},
    .dest_dsr_ids = [1]u16{1},
    .src0_dsr_ids = [1]u16{1},
    .src1_dsr_ids = [1]u16{1}
    });
const mpi_y = @import_module("../csl_source/csl-libs/collectives_2d/pe.csl", .{
    .dim_params = c2d_params.y,
    .queues = [2]u16{3,5},
    .dest_dsr_ids = [1]u16{2},
    .src0_dsr_ids = [1]u16{2},
    .src1_dsr_ids = [1]u16{2}
    });
const simprint = @import_module("<simprint>", .{ .enable = true });


//x, b, A, R will be partitioned using 2D Block decomposition.
// input
var A_tile = @zeros([M_local*N_local]f32);
var R_tile = @zeros([R_M_local*R_N_local]f32);
var x_tile = @zeros([N_local]f32);
var b_tile = @zeros([M_local]f32);
var omega = @zeros([1]f32);
var iterations = @constants([1]i32, 0); // default is 0 iteration.

// temporary variables on each PE.
// The product of Ax or Rx or any other matrix-vector product.
var Ax = @zeros([M_local]f32);  //Ax
var Rx = @zeros([R_M_local]f32);  // Rr
var residual_tile = @zeros([M_local]f32);
var term_2 = @zeros([M_local]f32);
var D_inv = @zeros([M_local]f32); // vector of diagonals of A_tile
var w_dinv_a_x = @zeros([M_local]f32);
var i_into_x = @zeros([M_local]f32);
var iter_count: i32 = 0;


// output
var b_next = @zeros([R_M_local]f32);  // rightmost Column
var dsd_b_next = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> b_next[i] });


// DSDs
var dsd_A_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> A_tile[i*@as(i16, N_local)] }); // 1 col of A_tile
var dsd_A_diag = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> A_tile[i*N_local + i] });
var dsd_R_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> R_tile[i*@as(i16, R_N_local)] }); // 1 col of R_tile
var dsd_x_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N_local} -> x_tile[i]});
var dsd_b_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> b_tile[i]});
var dsd_Ax = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> Ax[i]});
var dsd_Rx = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{R_M_local} -> Rx[i]});
var dsd_residual_tile = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> residual_tile[i]});
var dsd_D_inv = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> D_inv[i] });
var dsd_term_2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> term_2[i] });
var dsd_w_dinv_a_x = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> w_dinv_a_x[i] });
var dsd_i_into_x = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{M_local} -> i_into_x[i] });

var ptr_b_next : [*]f32 = &b_next;


// temp variables
// Updated at runtime to store x and y IDs of PE reported by collectives library
var px: u16;
var py: u16;
var is_v_cycle_up: bool = false;
var v_cycle_iteration: i32 = 0;
var cur_state: i16 = 0;// State tracking variables
var next_state: i16 = 0;


task send_right_bnext() void {
  if (layer_send_column() and !is_last_layer()) {
    simprint.fmt_with_coords("send_right_bnext layer_index={d} ", .{ @as(u32, layer_index) });
    const out_bridge_dsd = @get_dsd(fabout_dsd, .{
                      .fabric_color = bridge_send_color, 
                      .extent = R_M_local,
                      .output_queue = bridge_send_color_oq,
                    });
    @fmovs(out_bridge_dsd, dsd_b_next, .{ .async = true, .activate = exit_task_id });
  } else if (is_last_layer()) {
    @activate(exit_task_id);
  }
}

// WTT
var num_recv_bnext: i16 = 0;
task recv_left_bnext(wavelet_data: f32) void {
  b_tile[num_recv_bnext] = wavelet_data;
  num_recv_bnext += 1;
  // Reason to take R_N_local is that both subgrids have different R_M_local values, so sender sends
  // R_M_local whereas receiver expects R_M_local from layer 0, but instead uses local R_M_local from layer 1.
  // This causes the receiver to receive data in wavelet/color but the receiver assumes the data is received.
  // without being fully received, example sender sends 2 elements receiver should expect 2 but receiver has R_M_local=1, thinks
  // it received full data and proceeds to next step, which is wrong.
  // Fix: Use R_N_local instead of R_M_local as R_N_local = Fine grid size.
  // Send R_M_local receive R_N_local.
  if (num_recv_bnext == R_N_local) {  
    @activate(bcast_b_tile_id);
  }
}

task bcast_b_tile() void {
    const out_dsd = @get_dsd(fabout_dsd, .{
                      .fabric_color = bcast_color, 
                      .extent = M_local,
                      .output_queue = send_bcast_oq,
                    });
    @fmovs(out_dsd, dsd_b_tile, .{ .async = true, .activate = exit_task_id });
}

// Use to keep track of # of invocations of recv_x task
// when num_recv_x == N_per_PE, we are done receiving x elements
var num_recv_b_tile: i16 = 0;

task recv_b_tile(b_val: f32) void {
  b_tile[num_recv_b_tile] = b_val;
  num_recv_b_tile += 1;

  if (num_recv_b_tile == M_local) {
    cur_state = STATE_INIT;
    @unblock(STATE_MACHINE);
    @activate(STATE_MACHINE);
  }
}

// Exit task
task exit_task() void {
  simprint.fmt_with_coords("exit_task {d}", .{ @as(u32, layer_index) });
  sys_mod.unblock_cmd_stream();
}

task done_task() void {
    cur_state = next_state;
    @unblock(STATE_MACHINE);
    @activate(STATE_MACHINE);
}

task state_exit() void {
    simprint.print_string("STATE_EXIT\n");
    for (b_next) |val, i| {
        simprint.fmt_with_coords("b_next[{d}] = {f}", .{ i, val });
    }
    // sys_mod.unblock_cmd_stream();
}

// Main state machine task
task f_state() void {
    switch (cur_state) {
        STATE_INIT => state_init(),
        STATE_COMPUTE_JACOBI => state_compute_jacobi(),
        STATE_BCAST_JACOBI => state_bcast_jacobi(),
        STATE_CHECK_JACOBI_ITERATION => state_check_jacobi(),
        STATE_COMPUTE_RESIDUAL => state_compute_residual(),
        STATE_BCAST_RESIDUAL => state_bcast_residual(),
        STATE_COMPUTE_RESTRICTION => state_compute_restriction(),
        STATE_SEND_DATA => state_send_data(),
        STATE_EXIT => @activate(state_exit_id),
        else => {
            simprint.print_string("Error: unknown state\n");
            @assert(false);
            sys_mod.unblock_cmd_stream();
        }
    }
}

// Entrypoint into kernel
fn v_cycle_down() void {
  cur_state = STATE_INIT;
  @activate(STATE_MACHINE);
  if (is_first_layer() and is_rectangle_first_column()) {
    bcast_b_tile();
  }
}


//########################################################################################
// Dataflow and Routing.
//########################################################################################
comptime {
  @block(STATE_MACHINE);
  // Bind all state tasks
  @bind_local_task(f_state, STATE_MACHINE);
  @bind_local_task(state_exit, state_exit_id);

  @bind_local_task(send_right_bnext, send_right_bnext_id);
  @bind_local_task(exit_task, exit_task_id);
  @bind_local_task(bcast_b_tile, bcast_b_tile_id);
  @bind_local_task(done_task, done_task_id);
  // data task
  @bind_data_task(recv_left_bnext, recv_left_bnext_id);
  @bind_data_task(recv_b_tile, recv_b_tile_id);

  @export_symbol(ptr_b_next, "b_next");
  @export_symbol(v_cycle_down);

  configure_dataflow_bridge();

}

fn configure_dataflow_bridge() void {
    if (is_layer_first_column()) {
      @set_local_color_config(bcast_color, .{.routes = .{ .rx = .{RAMP}, .tx = .{EAST, RAMP}  }});
    } else if (is_layer_last_column()) {
      @set_local_color_config(bcast_color, .{.routes = .{ .rx = .{WEST}, .tx = .{RAMP}  }});
    } else {
      @set_local_color_config(bcast_color, .{.routes = .{ .rx = .{WEST}, .tx = .{EAST, RAMP}  }});
    }

    // interlayer
    if (layer_send_column()) {
      @set_local_color_config(bridge_send_color, .{.routes = .{ .rx = .{RAMP}, .tx = .{EAST}  }});
    } else if (layer_recv_column()) {
      @set_local_color_config(bridge_send_color, .{.routes = .{ .rx = .{WEST}, .tx = .{RAMP}  }});
    }
}

//########################################################################################
// State machine functions
//########################################################################################

fn state_init() void {
    simprint.fmt_with_coords("STATE_INIT, layer_index={d}", .{ @as(u32, layer_index) });
    next_state = STATE_COMPUTE_JACOBI;
    initialize();
}

fn state_compute_jacobi() void {
    simprint.print_string("STATE_COMPUTE_JACOBI\n");
    iter_count += 1;
    next_state = STATE_BCAST_JACOBI;
    compute_jacobi();
}

fn state_bcast_jacobi() void {
    next_state = STATE_CHECK_JACOBI_ITERATION;
    bcast_jacobi();
}

fn state_check_jacobi() void {
    if (iter_count < iterations[0]) {
        next_state = STATE_COMPUTE_JACOBI;
    } else {
        if (is_v_cycle_up) {
            next_state = STATE_EXIT;
        } else {
            next_state = STATE_COMPUTE_RESIDUAL;
        }
    }
    f_trigger_state_machine();
}

fn state_compute_residual() void {
    simprint.print_string("STATE_COMPUTE_RESIDUAL\n");
    next_state = STATE_BCAST_RESIDUAL;
    compute_residual();
}

fn state_bcast_residual() void {
    next_state = STATE_COMPUTE_RESTRICTION;
    bcast_residual();
}

fn state_compute_restriction() void {
    simprint.print_string("STATE_COMPUTE_RESTRICTION\n");
    next_state = STATE_SEND_DATA;
    compute_restriction();

}

fn state_send_data() void {
    simprint.print_string("STATE_SEND_DATA\n");
    @activate(send_right_bnext_id);
}

// State machine trigger function
fn f_trigger_state_machine() void {
    cur_state = next_state; // go to next state
    @activate(STATE_MACHINE);   
}

// Compute Jacobi iteration
fn compute_jacobi() void {
  jacobi_local();  // updates term_2
  // notice the py instead of 0.
  cur_state = next_state;
  mpi_x.reduce_fadds(py, @ptrcast([*]f32, &term_2), @ptrcast([*]f32, &x_tile),
                     M_local, STATE_MACHINE); // reduce across rows towards left
}

fn bcast_jacobi() void {
  cur_state = next_state;
  mpi_y.broadcast(px, @ptrcast([*]u32, &x_tile), N_local, STATE_MACHINE);
}

// Compute residual
fn compute_residual() void {
  residual_local(); // has answers in dsd_Ax
  cur_state = next_state;
  mpi_x.reduce_fadds(py, @ptrcast([*]f32, &Ax), @ptrcast([*]f32, &residual_tile),
                     M_local, STATE_MACHINE); // reduce across rows towards left
}

// bcast(residual_tile) to all PEs.
fn bcast_residual() void {
  if (px == py) {
    @fsubs(dsd_residual_tile, dsd_b_tile, dsd_residual_tile);  // r = b - Ax
  }
  cur_state = next_state;
  mpi_y.broadcast(px, @ptrcast([*]u32, &residual_tile), M_local, STATE_MACHINE);
}

// Compute restriction
fn compute_restriction() void {
  dsd_R_tile = @set_dsd_base_addr(dsd_R_tile, &R_tile); // make sure you do this before
  matvec(R_N_local, dsd_Rx, dsd_R_tile, @ptrcast([*]const f32, &residual_tile));
  cur_state = next_state;
  mpi_x.reduce_fadds(layer_kernel_cols-1, @ptrcast([*]f32, &Rx), @ptrcast([*]f32, &b_next),
                     R_M_local, STATE_MACHINE); // reduce across rows towards left
}
//########################################################################################
// Can be a library instead.
//########################################################################################

fn matvec(N_tile: i16, dsd_mv_tile: mem1d_dsd, dsd_matrix_tile: mem1d_dsd, vector_tile_data: [*]const f32) void {
  @fmovs(dsd_mv_tile, 0.0); // Initialize result to 0
  var matrix_dsd = dsd_matrix_tile; // Create a mutable copy of the DSD
  
  for (@range(i16, N_tile)) |j| {
    @fmacs(dsd_mv_tile, dsd_mv_tile, matrix_dsd, vector_tile_data[j]);
    matrix_dsd = @increment_dsd_offset(matrix_dsd, 1, f32);
  }
}

// New formula implementation: Jacobi iteration logic (new formula)
// formula: x = (Identity-omega*D_inv*A_tile)*x_tile
// x_tile[i] = (1.0 - omega) * temp_tile[i] + omega * (b_tile[i] - rsum) / diag;
// The diagonal PEs add the term_1 so that we don't have to gather on diag PE.
// Weighted Jacobi method: https://en.wikipedia.org/wiki/Jacobi_method
fn jacobi_local() void {
    dsd_A_tile = @set_dsd_base_addr(dsd_A_tile, &A_tile); // make sure you do this before
    matvec(N_local, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));  // Ax(vector) = Ax(matrix * vector)
    @fmuls(dsd_w_dinv_a_x, dsd_D_inv, dsd_Ax); // tmp = D_inv * Ax (vector * vector)
    @fmuls(dsd_w_dinv_a_x, omega[0], dsd_w_dinv_a_x); // tmp = w * D_inv * Ax (scalar * vector)

    if (px == py) { // good speedup.
      @fmovs(dsd_i_into_x, dsd_x_tile); // I*x = x
      // save some operatioons can be effective if PE grid large enough.
    } // otherwise, 0.0

    @fsubs(dsd_term_2, dsd_i_into_x, dsd_w_dinv_a_x); // tmp = I*x - omega * D_inv * Ax

    if (px == py) { // omega * D_inv * b
      @fmuls(dsd_w_dinv_a_x, dsd_D_inv, dsd_b_tile); // tmp = D_inv * b (vector * vector)
      @fmuls(dsd_w_dinv_a_x, omega[0], dsd_w_dinv_a_x); // tmp = omega * D_inv * b (scalar * vector)
      @fadds(dsd_term_2, dsd_w_dinv_a_x, dsd_term_2); // term_2 = omega * D_inv * b + term_2
    }
}

// Ax = A_local * x_local
fn residual_local() void {
  dsd_A_tile = @set_dsd_base_addr(dsd_A_tile, &A_tile); // make sure you do this before
  matvec(N_local, dsd_Ax, dsd_A_tile, @ptrcast([*]const f32, &x_tile));  // Ax = A_tile * x_tile
}

fn inverse_callback(val: f32) f32 {
  return if (val != 0.0) math_lib.inv(val) else 0.0;
}

// 1. sets the mpi parameters
// 2. calculates D_inv on diagonal PEs and broadcasts it to all the PEs in row.
fn initialize() void {
  init_params();
  if (px == py) {
      @map(inverse_callback, dsd_A_diag, dsd_D_inv);
  }
    // Don't update state here - wait for broadcast completion
  if (px == py) {
    // mpi_x.broadcast(root, send_buf, len, x_task_id);
    mpi_x.broadcast(py, @ptrcast([*]u32, &D_inv), M_local, done_task_id);
  } else {
    var recv_buf = @zeros([M_local]u32);
    mpi_x.broadcast(py, @ptrcast([*]u32, &recv_buf), M_local, done_task_id);
  }    
}

fn init_params() void {
  mpi_x.init();
  mpi_y.init();
  px = mpi_x.pe_id - @as(u16, layer_start_x);
  py = mpi_y.pe_id - @as(u16, layer_start_y);

  v_cycle_iteration += 1;
  is_v_cycle_up = false;
  iter_count = 0;  
}



// Helpers

// This tracks the subgrid/layer in AMG.
fn is_first_layer() bool {
  return layer_index == 0;
}
fn is_last_layer() bool {
  return layer_index == total_levels_count - 1;
}
fn is_layer_last_column() bool {
   return pe_id_x == layer_end_x - 1;
}
fn is_layer_first_column() bool {
  return pe_id_x == layer_start_x;
}
// This is the last column of the subgrid/layer.
fn layer_send_column() bool {
  return is_layer_last_column();
}
fn layer_recv_column() bool {
  return is_layer_first_column();
}
fn layer_middle_column() bool {
  return !is_layer_first_column() and !is_layer_last_column();
}


// A rectangle is the entire grid of PEs.
fn is_rectangle_last_column() bool {
  return pe_id_x == total_pe_cols - 1;
}
fn is_rectangle_first_column() bool {
  return pe_id_x == 0;
}
