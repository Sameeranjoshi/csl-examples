// Opcodes for potentially updating switches
const opcode = enum(u32) {
    NOP = 0,
    SWITCH_ADV = 1,
    SWITCH_RST = 2,
    TEARDOWN = 3
};

const MAX_CMDS = 8;

const ENTRYPOINT_BIT_POSN = 16;
const CMD0_OPCODE_BIT_POSN = 22;
const CMD0_CE_FILTER_BIT_POSN = 24;
const CMD1_OPCODE_BIT_POSN = 25;
const CMD1_CE_FILTER_BIT_POSN = 27;
const CMD2_OPCODE_BIT_POSN = 28;
const CMD2_CE_FILTER_BIT_POSN = 0;
const CMD3_OPCODE_BIT_POSN = 1;
const CMD3_CE_FILTER_BIT_POSN = 3;
const CMD4_OPCODE_BIT_POSN = 4;
const CMD4_CE_FILTER_BIT_POSN = 6;
const CMD5_OPCODE_BIT_POSN = 7;
const CMD5_CE_FILTER_BIT_POSN = 9;
const CMD6_OPCODE_BIT_POSN = 10;
const CMD6_CE_FILTER_BIT_POSN = 12;
const CMD7_OPCODE_BIT_POSN = 13;
const CMD7_CE_FILTER_BIT_POSN = 15;

const CMD_OPCODE_BIT_POSN = [8]u16 { CMD0_OPCODE_BIT_POSN,
                                     CMD1_OPCODE_BIT_POSN,
                                     CMD2_OPCODE_BIT_POSN,
                                     CMD3_OPCODE_BIT_POSN,
                                     CMD4_OPCODE_BIT_POSN,
                                     CMD5_OPCODE_BIT_POSN,
                                     CMD6_OPCODE_BIT_POSN,
                                     CMD7_OPCODE_BIT_POSN };

const CMD_CE_FILTER_BIT_POSN = [8]u16 { CMD0_CE_FILTER_BIT_POSN,
                                        CMD1_CE_FILTER_BIT_POSN,
                                        CMD2_CE_FILTER_BIT_POSN,
                                        CMD3_CE_FILTER_BIT_POSN,
                                        CMD4_CE_FILTER_BIT_POSN,
                                        CMD5_CE_FILTER_BIT_POSN,
                                        CMD6_CE_FILTER_BIT_POSN,
                                        CMD7_CE_FILTER_BIT_POSN };

// Description: Encode payload that activates a control task with no argument
fn encode_control_task_payload(entrypoint: control_task_id) u32 {
    return @as(u32, @get_int(entrypoint)) << ENTRYPOINT_BIT_POSN;
}

// Description: Encode payload that includes one switch command, plus control task entrypoint.
//              Control task will only activate if ce_ignore is false, and
//              control task may take single 16-bit argument data
fn encode_single_payload(cmd: opcode, ce_ignore: bool,
                         comptime entrypoint: anytype, data: u16) u32 {

    var result: u32 = 0;

    if (@is_same_type(@type_of(entrypoint), void)) {
        // If entrypoint is void, we use "null" entrypoint 31
        result |= 31 << ENTRYPOINT_BIT_POSN;
    } else if (@is_same_type(@type_of(entrypoint), control_task_id)) {
        result |= @as(u32, @get_int(entrypoint)) << ENTRYPOINT_BIT_POSN;
    } else {
        // Invalid! entrypoint must be either void or control_task_id
        @comptime_assert(false);
    }

    result |= @as(u32, cmd) << CMD_OPCODE_BIT_POSN[0];
    result |= @as(u32, ce_ignore) << CMD_CE_FILTER_BIT_POSN[0];

    result |= @as(u32, data);

    return result;
}

// Description: Encode payload with up to eight switch commands, plus control task entrypoint.
fn encode_payload(comptime N: u16, comptime cmds: [N]opcode, comptime ce_ignore: [N]bool,
                  ce_ignore_remaining: bool, comptime entrypoint: anytype) u32 {

    @comptime_assert(N <= MAX_CMDS);

    var result: u32 = 0;

    if (@is_same_type(@type_of(entrypoint), void)) {
        // If entrypoint is void, we use "null" entrypoint 31
        result |= 31 << ENTRYPOINT_BIT_POSN;
    } else if (@is_same_type(@type_of(entrypoint), control_task_id)) {
        result |= @as(u32, @get_int(entrypoint)) << ENTRYPOINT_BIT_POSN;
    } else {
        // Invalid! entrypoint must be either void or control_task_id
        @comptime_assert(false);
    }

    inline for (@range(u16, N)) |i| {
        result |= @as(u32, cmds[i]) << CMD_OPCODE_BIT_POSN[i];
        result |= @as(u32, ce_ignore[i]) << CMD_CE_FILTER_BIT_POSN[i];
    }

    if (ce_ignore_remaining) {
        inline for (@range(u16, N, MAX_CMDS, 1)) |i| {
            result |= @as(u32, 1) << CMD_CE_FILTER_BIT_POSN[i];
        }
    }
    return result;
}
