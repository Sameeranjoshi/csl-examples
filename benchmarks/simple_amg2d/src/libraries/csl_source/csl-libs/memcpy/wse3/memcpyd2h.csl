
// Resource Usage
// output queue 0: data from C21(internal D2H color)
// input queue x for streaming D2H_x
//
// copy mode: {data, ctrl} --> C21(fabout)
// streaming mode: streaming D2H_x (wtt) --> C21 (fabout)
//
// WARNING: if the user uses a microthread to send out the data.
// such microthread ID must be different from input queue ID of
// streaming D2H color.

// memcpyd2h to support 4 outputs:

// The color MEMCPYD2H_DATA is used to output data, it does not define a WTT task,
// so we bind f_send_data to MEMCPYD2H_DATA, to save one more entrypoint.
// The streaming does not use f_send_data because it has WTT tasks binding to user's
// D2H colors.
//
// To support D2H, we need routable MEMCPYD2H_DATA and entrypoint SEND_CTRL
//
// WARNING: memcpy does need to activate(SEND_DATA), now we use activate(MEMCPYD2H_DATA)
//
// WARNING: all memcpyd2h modules share input queue and output queue, so
// we must serialize all D2H ops

// a collective communication: send local data to mux from left to right
// via a system color MEMCPYD2H_DATA
//
// it is designed by switch.
// Example: suppose we have 4-by-1 PEs
//
// initial routing
//    -->   --->-->   -->-->  -->-->
//    ^
//    |
//
// after 1st control wavelet from PE0 to advance switch of PE1
//   (PE0 does not change switch because it keeps sending data)
//    -->     -->   -->-->  -->-->
//    ^       ^
//    |       |
// after 2nd control wavelet from PE1 to advance switch of 2 PEs
//    -->   -->-->     -->  -->-->
//    ^                ^
//    |                |
// after 3rd control wavelet from PE2 to advance switch of 2 PEs
//    -->   -->-->   -->-->   -->
//    ^                       ^
//    |                       |
// after 4th control wavelet from PE3 to advance switch of 2 PEs
//    -->   -->-->   -->-->   -->-->
//    ^
//    |
//
// Each PE sends out x, then triggers a switch advance command
// Only first PE can send out the data because the routing is {.rx = RAMP, .tx = EAST},
// other PEs cannot send data to the router because of {.rx = WEST, .tx = EAST}.
//
// First PE sends the control wavelet after the data is out.
// The control wavelet will advance the switch of 1st and 2nd PEs.
// 1st PE will have routing {.rx = WEST, .tx = EAST}, and
// 2nd PE will have routing {.rx = RAMP, .tx = EAST}
//
// Now 2nd PE can send the data to the router because rx = RAMP, and then
// it will send out the control wavelet to advance switch of 2nd and 3rd PEs.
//

// ------------ how to reconfigure a switch at runtime
//
// The following routing is pos0, P0 has a link from the west to receive a teardown
//
// west -->-->   --->-->   -->-->  -->-->  eaat
//         ^
//         |
//
// Observation 1: each PE has the same pos1={rx = RAMP}
//   once a PE is at pos1, it can send out data to its neighbor
//
// Observation 2: if 1st PE of ROI is Pk, then we need to add {rx = RAMP} in color config
//   register of Pk, we can use OR operation to setup color config reg
//
// Observation 3: 1st PE of ROI needs to send reset (0x99f 9249) signal to itself, in order
//   to switch back to pos0
// WARNING: 1st PE of ROI sends a TD to turn C23 back to teardown mode
//
// Observation 4: if 1st PE of ROI is k > 0, then Pk has {rx = NORTH, RAMP} for pos0
//   Although P0 has {rx = EAST, RAMP}, P0, P1, ... P{k-1} will not send any data and control
//   wavelets, so Pk is the 1st PE to send the data, we don't need to change the pos0 of P0
//
// Observation 5: if last PE of ROI is m, then P{m+1}, ... P{h-1} will not change the switch,
//   only forward the data, so Pm only sends cmd1=sw_advance to itself, does not change the
//   switch of P{m+1}
//

// local colors
param MEMCPYD2H_DATA: color;        // internal D2H color

// if the user only has one H2D color, then USER_MEMCPYD2H_DATA_[2|3|4]=32, so
// we don't generate routing for USER_MEMCPYD2H_DATA_[2|3|4]
// WARNING: USER_MEMCPYD2H_DATA_x is only used to configure the R --> R routing.
// It does not bind to a WTT.
param USER_MEMCPYD2H_DATA_1 = {}; // user's 1-th D2H
param USER_MEMCPYD2H_DATA_2 = {}; // user's 2-th D2H
param USER_MEMCPYD2H_DATA_3 = {}; // user's 3-th D2H
param USER_MEMCPYD2H_DATA_4 = {}; // user's 4-th D2H

param input_queue_id: i16; // reuse IQ0 from H2D
param output_queue_id: i16; // the caller has to reserve this output queue for memcpyD2H

// explicit DSR allocation
param dest_dsr_ids: [1]u16;
param src1_dsr_ids: [1]u16;

// local tasks
param SEND_CTRL: local_task_id;  // send switch advance

param chunk : i16;

// last PE which only advance its own switch
param first_pe: bool; // (0 == px);
param last_pe: bool;  // ((width-1) == px);
param width : i16 ;

// the callback should be COLOR_SYS_EXIT, which unblocks the command channel
param callback : local_task_id;

// D2H reuses IQ0 (input_queue_id) to receive data from one of D2H streaming color.
// The following figure shows IQ0 is shared by two D2H streaming colors.
//
// D2H data flow: reuse IQ0 from H2D
//        OQ2      R-->R   IQ0               OQ0
// D2H_1 ------>  router -------> WTT (D2H) ------>
//                  ^                         C21
//        OQ3       |
// D2H_2 ----------->
//
// The color field of IQ0 is C23 (internal H2D).
// IQ0 is blocked at comptime.
// All D2H streaming colors are backpressured in the beginning because
// there is no input queue binding to any of them.
//
// When D2H command arrives, it sets the color field of IQ0. At this point,
// IQ0 is ready to receive the data of corresponding D2H streaming color,
// other D2H streaming colors are still backpressured.
//
// teardown_d2h() blocks IQ0 when TD (teardown wavelet) of D2H arrives
// so IQ0 remains empty for the next operation.
//
// WARNING: IQ0 is bound to C23 at comptime, so we cannot bind any
// D2H streaming color to IQ0 here.
const iq_d2h_x = @get_input_queue(input_queue_id);
const task_id_d2h_x = @get_data_task_id(iq_d2h_x);

const oq_data = @get_output_queue(output_queue_id);

// define an entrypoint binding to MEMCPYD2H_DATA
const LOCAL_MEMCPYD2H_DATA: local_task_id = @get_local_task_id(@get_int(MEMCPYD2H_DATA));

const tile_config = @import_module("<tile_config>");

const switch_config = tile_config.switch_config;
const color_config = tile_config.color_config;
const memcpyd2h_addr = color_config.get_color_config_addr(MEMCPYD2H_DATA);
const memcpyh2d_cur_pos_addr = switch_config.get_switch_config_addr(MEMCPYD2H_DATA, switch_config.switch_status);

const fabric = @import_module("<layout>");
fn get_x_coord() u16 {
    return fabric.get_x_coord();
}
fn get_y_coord() u16 {
    return fabric.get_y_coord();
}

// runtime decides is_streaming
//    is_streaming == !(c >= 24)
// if the command is memcpyh2d(c=24,...), then it uses memcpy
// if the command is memcpyh2d(c=1,...), then it uses memcpy streaming
//
// memcpy streaming: 0 <= c < 24
// memcpy: c = 31
// return 0: memcpy
//        1: streaming
fn is_streaming_eval( user_color: u16) i16 {
    if (user_color < 24){
        return 1;
    }else{
        @assert(31 == user_color);
        return 0;
    }
}


////////////////////////////////////////////////////////////////////////////////
// Main memory (48KB)
////////////////////////////////////////////////////////////////////////////////

var data_buf = @zeros([chunk]u32);

var j : u16 = 0;

var pe_length : u16 = 0;

// (x_first, x_last, y_first, y_last) is the same as mux.csl, used to specify the ROI
// x_first = argmin{ j: px <= j < px+w }
// x_last  = argmax{ j: px <= j < px+w }
//
// y_first = argmin{ j: py <= j < py+h }
// y_last  = argmax{ j: py <= j < py+h }
//
var x_first : i16 = 0;
var x_last  : i16 = 0;
var y_first : i16 = 0;
var y_last  : i16 = 0;
// is_active = PE in [px, px+w) x [py, py+h)
var is_active: bool = false; // is_active = (_py <= y_last) and (_py >= y_first)
                             //         and (_px <= x_last) and (_px >= x_first)
// routing_active = PE in [px, end) x [py, py+h)
var routing_active: bool = false; // routing_active = (_py <= y_last) and (_py >= y_first)
                                  //    and (_px >= x_first)

var memcpyD2H_c: u16 = 0;
var memcpyD2H_is_half: u16 = 0;

var is_streaming: i16 = 1; // 0: memcpy
                           // 1: streaming

////////////////////////////////////////////////////////////////////////////////
// DSDs
// data-structure descriptors (DSDs), loaded into data-structure registers (DSRs)
//
// Queues 0,1: input depth 6 wavelets
// Queues 2,3: input depth 4 wavelets
// Queues 4-7: input depth 2 wavelets
//
// queues 0,1: output depth 2 wavelets
// queues 2,3: output depth 6 wavelets
// queues 4,5: output depth 2 wavelets
//
// Length of an operand:
// The length of all other types of DSRs is specified by the length field of its DSD. When
// the bits encoding the length are 0x7fff, the length is infinite.
//
// Length of the vector instruction is then determined in the following order:
// 1. If src0 has a non-zero length, that length is used
// 2. If src1 has a non-zero length, that length is used
// 3. If dst has a non-zero length, that length is used
// 4. if no operands have length (all operands are GPR), length = 1
////////////////////////////////////////////////////////////////////////////////

const dest_dsr = @get_dsr(dsr_dest, dest_dsr_ids[0]);
const src1_dsr = @get_dsr(dsr_src1, src1_dsr_ids[0]);

// binds DSD to m_dot in order to send out dot via async property
const dummy = @zeros([1]i16);
var mem_x_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{chunk} -> dummy[i] });

const fab_trans_x_wdsd = @get_dsd(fabout_dsd, .{
    .extent = chunk,
    .fabric_color = MEMCPYD2H_DATA,
    .output_queue = oq_data
});

// WARNING: control wavelet must be sent with the same microthread, via the same output buffer,
// otherwise, we may see only one data wavelet, then 2nd is the control wavelet, then
// the remaining data cannot be sent out because the routing is back to {.rx=WEST, .tx=EAST},
// there is no path from RAMP to the router.
const fab_trans_ctrl_wdsd = @get_dsd(fabout_dsd, .{
    .extent = 1,
    .control = true,
    .fabric_color = MEMCPYD2H_DATA,
    .output_queue = oq_data
});


// send {sw_adv, TD} back to back for last WTT wavelet
const fab_trans_ctrl_2_wdsd = @get_dsd(fabout_dsd, .{
    .extent = 2,
    .control = true,
    .fabric_color = MEMCPYD2H_DATA,
    .output_queue = oq_data
});



////////////////////////////////////////////////////////////////////////////////
// Tasks
// syntax
//     task_begin(name, entrypoint, color)
////////////////////////////////////////////////////////////////////////////////

//
// Behavior of memcpyD2H
// step 1: CMD fan sends D2H command to the core
// step 2: the core receives D2H command and reconfigures the switches
// step 3: core sends data for PE in ROI
// step 4: 1st PE of ROI sends a TD to turn C23 back to teardown mode
//

const switches = @import_module("<memcpy/memcpy_switches>");

// The following arrays define values for control wavelets, which update the
// switch position at the recipient PEs.
// All are comptime constants
//
// ctrl_1  is for last PE in ROI which only changes the its own switch
// ctrl_11 is for other PEs which changes switch of two consecutive PEs
var ctrl_11 = [1]u32 { switches.ctrl(switches.switch_cmd_11()) };
var ctrl_1  = [1]u32 { switches.ctrl(switches.switch_cmd_1()) };

// mem_ctrl_buf_dsd sets the base as ctrl_1 or ctrl_11 at runtime
var mem_ctrl_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> ctrl_11[i] });

// sw_td = {sw adv, TD}
var sw_td = @zeros([2]u32);

const mem_sw_td_buf_dsd  = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2} -> sw_td[i] });

// teardown from casm
// teardown_buf[0] = (1 << 31) | (0b111 << 22)
//
// teardown from csl
// from cslang/test-e2e/dynamic_filters/sender.csl
//  31=0x1f = no entrypoint
//
// teardown wavelet = 0x1df 0000
//const teardown_buf = [1]u32{(31 << 16) | 0b111 << 22};
// teardown wavelet = 0x9df 9249
const teardown_buf = [1]u32 { switches.ctrl(switches.teardown_cmd_1()) };

const mem_buf_td_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> teardown_buf[i] });

// Each PE has two parameters
// - pe_length
// - chunk
// to specify the tensor[pe_length][w][chunk]
//
// The switch has to send out the local data in round-robin sense according to the order of
// tensor[pe_length][w][chunk]
//
// Here is the pseudocode of f_memcpyd2h
// ---
// for (j = 0 ; j < pe_length ; j++){
//    send x[j*chunk: (j+1)*chunk)
//    send ctrl
// }
// ---
//
// However "send" is an asyn call with microthread, so we must transform the for-loop to
// the following data flow
//
//    memcpyd2h --> f_send_data --> f_send_ctrl
//                    ^                  |
//                    |                  |
//                    +------------------+
//
// f_memcpyd2h(){
//     j = 0
//     activate f_send_data
// }
//
// f_send_data(){
//     if (j < pe_length){
//         set mem_dsd to &x[j*chunk]
//         send x[j*chunk, (j+1)*chunk), callback = f_send_ctrl
//         j++
//     }
// }
//
// f_send_ctrl() {
//     send ctrl, callback = f_send_data
// }
//

// A PE is active if it is in ROI(= [px, px+w) x [ py, py+h))
// Only active PEs can call memcpyd2h_start() to send data/ctrl pair.
//
// TODO: replace px, w by x_first, x_last
//    remove py and h
fn memcpyd2h_start( d_A : u16, params_pe_length : u16,
    para_px: i16, para_py: i16, para_w: i16, para_h: i16, para_c: i16, para_is_half: u16 ) void {

    const _px = @as(i16, get_x_coord());

    memcpyD2H_c = @as(u16, para_c);
    memcpyD2H_is_half = para_is_half;

    is_streaming = is_streaming_eval(memcpyD2H_c);

    j = 0;

    pe_length = params_pe_length;

    x_first = para_px;
    x_last  = para_px + para_w-1;
    // 0 <= x_first <= x_last < width

    if ( _px == x_last){
        // last PE only changes switch of itself
        mem_ctrl_buf_dsd =  @set_dsd_base_addr(mem_ctrl_buf_dsd, ctrl_1);
        sw_td[0] = ctrl_1[0];
    }else{
        // other PE in [px, px+w) changes switch of of itself and its neighbor
        mem_ctrl_buf_dsd =  @set_dsd_base_addr(mem_ctrl_buf_dsd, ctrl_11);
        sw_td[0] = ctrl_11[0];
    }
    // sw_td = {sw_adv, TD}
    sw_td[1] = teardown_buf[0];

    // ------ memcpy or streaming
    if (0 == is_streaming){
        // TODO: we may add offset in the future in order to copy host tensor on A[offset]
        mem_x_buf_dsd = @set_dsd_base_addr(mem_x_buf_dsd, @get_tensor_ptr(d_A));
        //mem_x_buf_dsd = @increment_dsd_offset(mem_x_buf_dsd, offset, f32);
        mem_x_buf_dsd = @set_dsd_length(mem_x_buf_dsd, chunk );
        @activate( LOCAL_MEMCPYD2H_DATA );  // triggers f_send_data
    }else{
        // streaming: data is from user's D2H color which is R-->R
        // WTT reads one wavelet from user's D2H color, then sends it to system D2H color
        // WTT binds to IQ0.
        // prerequisite: IQ0 is blocked
        mem_x_buf_dsd = @set_dsd_base_addr(mem_x_buf_dsd, data_buf);
        mem_x_buf_dsd = @set_dsd_length(mem_x_buf_dsd, chunk);
        @unblock(task_id_d2h_x); // start to receive data from user's D2H color via IQ0
    }
}


// WTT receives data from user's D2H color which is R-->R
//
// To simplify the design, we only allow chunk=1
//
// prerequisite: the caller sets j = 0 and pe_length
//
// Assume pe_length > 0 (runtime checks this condition)
//
// The control flow is a little bit different from send_data() because the last (pe_length+1 call)
// send_data is called by send_ctrl, so we have condition j >= pe_length
// However WTT is only called pe_length times.
//
// for example: if pe_length = 1,
// calling sequence of memcpy: send_data --> send_ctrl --> send_data (send TD)
// calling seqeunce of streaming: f_user_memcpyd2h_data_x --> send_ctrl
//
task f_user_memcpyd2h_data_x( data : u32 ) void {

    // j = 0,1,2,..., pe_length-1

    // block WTT until the data and ctrl are sent out
    @block(task_id_d2h_x);

    // assume chunk = 1
    data_buf[0] = data;

    // pe_length > 0, so execute the follow line at least once
    // f_send_ctrl will unblock USER_MEMCPYD2H_DATA_x
    // dst DSD is for MEMCPYD2H_DATA, not user's color
    @load_to_dsr(dest_dsr, fab_trans_x_wdsd, .{.async=true, .activate=f_send_ctrl} );
    @load_to_dsr(src1_dsr, mem_x_buf_dsd);
    @mov32(dest_dsr, src1_dsr, .{.async=true} );
    j = j+1;
}


// only for memcpy, streaming uses f_user_memcpyd2h_data_x
// memcpy sequence: f_send_data() --> f_send_ctrl()
//                      ^                  |
//                      |------------------+
//
// - is_half is only used in memcpy (not memcmpy streaming).
// - is_half only affects data wavelets (fab_trans_x_wdsd), not control wavelets
// - is_half also affects the offset when advancing DSD
task f_send_data() void {

    if (j < pe_length){
        @load_to_dsr(dest_dsr, fab_trans_x_wdsd, .{.async=true, .activate=f_send_ctrl} );
        @load_to_dsr(src1_dsr, mem_x_buf_dsd);
        if (0 < memcpyD2H_is_half){
            @mov16(dest_dsr, src1_dsr, .{.async=true} );
            mem_x_buf_dsd = @increment_dsd_offset(mem_x_buf_dsd, chunk, f16);
        }else{
            @mov32(dest_dsr, src1_dsr, .{.async=true} );
            mem_x_buf_dsd = @increment_dsd_offset(mem_x_buf_dsd, chunk, f32);
        }
        j = j+1;
    }else{
        // memcpyD2H is done, return the control back to command decoder
        // - 1st PE of ROI sends TD to turn C23 (of PEs in routing ROI) back to teardown mode
        // - other PEs of ROI does nothing, just wait for TD from 1st PE
        // WARNING: DO NOT call sys.exit() because T29 will call it
        const _px = @as(i16, get_x_coord());
        //const _py = @as(i16, get_y_coord());
        if ( x_first == _px ){
            @load_to_dsr(dest_dsr, fab_trans_ctrl_wdsd, .{.async=true} );
            @load_to_dsr(src1_dsr, mem_buf_td_dsd);
            @mov32(dest_dsr, src1_dsr, .{.async=true} );
        }
    }
}


task f_send_ctrl() void{
    if (0 == is_streaming){
        // memcpy: only DSD operands are allowed for async operations
        @load_to_dsr(dest_dsr, fab_trans_ctrl_wdsd, .{.async=true, .activate=f_send_data } );
        @load_to_dsr(src1_dsr, mem_ctrl_buf_dsd);
        @mov32(dest_dsr, src1_dsr, .{.async=true} );
    }else{
        // streaming: unblock user's D2H color to receive next wavelet
        // j = 1,2,3,..., pe_length
        if (j < pe_length){
            // NOT last WTT: send sw_adv and unblock user's D2H color
            // WARNING: unblock(color) is no longer valid.
            // this workaround may fail the compilation for future architecture.
            @load_to_dsr(dest_dsr, fab_trans_ctrl_wdsd, .{.async=true, .unblock=task_id_d2h_x } );
            @load_to_dsr(src1_dsr, mem_ctrl_buf_dsd);
            @mov32(dest_dsr, src1_dsr, .{.async=true} );

        }else{
            // last WTT: keep user's D2H blocking (it is blocked by WTT)
            const _px = @as(i16, get_x_coord());
            //const _py = @as(i16, get_y_coord());
            if ( x_first == _px ){
                // 1st PE of ROI sends TD to turn C23 back to teardown mode
                // We need to send sw_adv and TD back to back
                @load_to_dsr(dest_dsr, fab_trans_ctrl_2_wdsd, .{.async=true} );
                @load_to_dsr(src1_dsr, mem_sw_td_buf_dsd);
                @mov32(dest_dsr, src1_dsr, .{.async=true} );
            }else{
                // only send sw_adv
                @load_to_dsr(dest_dsr, fab_trans_ctrl_wdsd, .{.async=true} );
                @load_to_dsr(src1_dsr, mem_ctrl_buf_dsd);
                @mov32(dest_dsr, src1_dsr, .{.async=true} );
            }
            // WARNING: DO NOT call sys.exit() because T29 will call it
        }
    }
}

comptime {
    @bind_local_task( f_send_ctrl, SEND_CTRL);
    @bind_local_task( f_send_data, LOCAL_MEMCPYD2H_DATA);
}




comptime {
    @comptime_assert(1 == chunk);

    // WTT task
    @bind_data_task( f_user_memcpyd2h_data_x, task_id_d2h_x);
}


comptime {

    // user can only send data via R --> R, so we can block this channel in the beginning.
    // once the switch of MEMCPYD2H_DATA is reconfigured, a microthread will read data
    // from USER_MEMCPYD2H_DATA, and forward it to MEMCPYD2H_DATA

//--- AUTO-6
    if (!@is_same_type(@type_of(USER_MEMCPYD2H_DATA_1), void)) {
        @set_local_color_config(USER_MEMCPYD2H_DATA_1, .{ .routes = .{ .rx = .{RAMP}, .tx = .{RAMP} } } );
    }
    if (!@is_same_type(@type_of(USER_MEMCPYD2H_DATA_2), void)) {
        @set_local_color_config(USER_MEMCPYD2H_DATA_2, .{ .routes = .{ .rx = .{RAMP}, .tx = .{RAMP} } } );
    }
    if (!@is_same_type(@type_of(USER_MEMCPYD2H_DATA_3), void)) {
        @set_local_color_config(USER_MEMCPYD2H_DATA_3, .{ .routes = .{ .rx = .{RAMP}, .tx = .{RAMP} } } );
    }
    if (!@is_same_type(@type_of(USER_MEMCPYD2H_DATA_4), void)) {
        @set_local_color_config(USER_MEMCPYD2H_DATA_4, .{ .routes = .{ .rx = .{RAMP}, .tx = .{RAMP} } } );
    }
}



//----------------- the following is the routing of MEMCPYD2H_DATA
//  independent of user's D2H colors

// case 1: PE in routing ROI, p.x >= px,  py <= p.y < py + h
// - reconfigure the switch
// - clear TIP
// - send data/ctrl pair, only unblock C22 when D2H is done.
// case 2: PE not in routing ROI, p.x < px or p.y is not in [py, py+h)
// - DO NOT clear TIP, C23 still in teardown mode
// - unblock C22 to proceed next command
//
fn d2h_configure(c: i16, px: i16, py: i16, w: i16, h: i16, d_A: u16, pe_length: u16, is_half: u16) void {

    const _px = @as(i16, get_x_coord());
    const _py = @as(i16, get_y_coord());

    var x_first:i16 = px;
    var x_last :i16 = px + w-1;
    // 0 <= x_first <= x_last < width
    var y_first: i16 = py;
    var y_last: i16  = py + h-1;
    // 0 <= y_first <= y_last < height

    // (1) setup switch according to config parameters
    // 1. pos0 (color config reg)
    // 2. pos1 (switch config reg)
    //    pos1 = {.rx = RAMP} for all PEs and never changed
    //
    // routing_active = PE in [px, end) x [py, py+h)
    routing_active = false;
    if ( (_px >= x_first) and (_py <= y_last) and (_py >= y_first)){
        routing_active = true;
    }
    // is_active = PE in [px, px+w) x [py, py+h)
    is_active = false;
    if ( (_px <= x_last) and routing_active){
        is_active = true;
    }

    if (routing_active){ // _px >= x_first
        // reset switch position to pos0
        // WARNING: if switch config register does not reset the switch position back to pos0,
        // it is possible that some PE is at pos1 after the switch is reconfigured and the sending
        // pattern is messed up, for example, the PE sends data first, then forwards the data from
        // the west.
        switch_config.clear_current_position(memcpyh2d_cur_pos_addr);

        if (x_first ==  _px){
            // 1st PE must has {rx = RAMP} to send out the data
            // .rx = .{ RAMP },.tx = .{ EAST },
            color_config.reset_routes(memcpyd2h_addr, .{.tx = EAST, .rx = RAMP});
        }else{
            //  x_first < _px
            // .rx = .{ WEST }, .tx = .{ EAST },
            color_config.reset_routes(memcpyd2h_addr, .{.tx = EAST, .rx = WEST});
        }

        // insert one instruction to resolve RAW hazard
        const dummy = switch_config.get_switch_config_addr(MEMCPYD2H_DATA, tile_config.target.switch_status);
        var r_switch_state = @get_config(dummy);

        // (2) clear teardown-in-progress bit
        // config_reg[c] ^= mask where mask = 1 << 14
        tile_config.teardown.exit(MEMCPYD2H_DATA);

        // case 1: PE is in ROI, send data/ctrl pair
        // case 2: PE is NOT in ROI, does nothing
        //   DO NOT unblock C22, T29 will unblock C22 and trigger user's callback
        if (is_active){
            memcpyd2h_start( d_A, pe_length, px, py, w, h, c, is_half ); // callback = f_sys_exit
        }
        // if a PE is not in ROI but still in routing ROI, it clears TIP to
        // allow the data/ctrl of active PEs pass through, but it does nothing.
        // 1st PE of ROI will sends TD to turn C23 back to teardown mode.
    }else{
        // NOT in the routing ROI
        // - keep C23 in teardown mode
        // - D2H only has TD covers [px, end)x[py, py+h),
        //   so other PEs must call sys_mod.exist() explicitly
        //  memcpy.csl import_module(memcpyd2h.csl) with
        //     .callback=SYS_EXIT
        //
        // WARNING: f_sys_exit() unblocks C22 and calls user's callback
        @activate(callback); // proceed next command
    }
}


//
// routing of MEMCPYD2H_DATA (send data to west, from leftmost)
//    -->   --->-->   -->-->
//    ^
//    |
//   sw_adv
//    -->      -->   -->-->
//    ^        ^
//    |        |
//   data     data
//            sw_adv
//    -->     --> -->     -->
//    ^                   ^
//    |                   |
//   sw_adv              data
//                      sw_adv
//    -->       -->    --> -->
//    ^         ^
//    |         |
//             data
//             sw_adv
//
// WARNING 1: cmd fan needs to send teardown to core, so we keep {rx = WEST}
//  for 1st PE
//
comptime {

    // WARNING: if only one PE per row, it needs always_pop, i.e. first PE is last PE
    // if not, it hangs
    // root cause: the teardown 0x9df 9249 from core cannot propagate to mux
    // because mux does not handle teardown for MEMCPYD2H (color 23), so if we use always_pop,
    // then 0x9df 9249 --> 0x91f 9249
    //
    // The other option is to add teardown support of MEMCPYD2H in mux.csl
    //
    // WARNING: cmd fan does not send TD, so remove WEST link from the C23
    const oneConfig = .{
        .routes= .{
            .rx = .{ RAMP },
            .tx = .{ EAST },
        },
        .switches=.{
            .pos1 = .{ .rx = RAMP },
            .ring_mode = true,
            .pop_mode = .{ .always_pop = true },
            //.pop_mode = .{ .pop_on_advance = true },
        },
        .teardown = true
    };

    // WARNING: cmd fan does not send TD, so remove WEST link from the C23
    const firstConfig = .{
        .routes= .{
            .rx = .{ RAMP },
            .tx = .{ EAST },
        },
        .switches=.{
            .pos1 = .{ .rx = RAMP },
            .ring_mode = true,
            //.pop_mode = .{ .always_pop = true },
            .pop_mode = .{ .pop_on_advance = true },
        },
        .teardown = true
    };
    const secondConfig = .{
        .routes= .{
            .rx = .{ WEST },
            .tx = .{ EAST },
        },
        .switches=.{
            .pos1 = .{ .rx = RAMP },
            .ring_mode = true,
            //.pop_mode = .{ .always_pop = true },
            .pop_mode = .{ .pop_on_advance = true },
        },
        .teardown = true
    };
    const lastConfig = .{
        .routes= .{
            .rx = .{ WEST },
            .tx = .{ EAST },
        },
        .switches=.{
            .pos1 = .{ .rx = RAMP },
            .ring_mode = true,
            .pop_mode = .{ .always_pop = true },
            //.pop_mode = .{ .pop_on_advance = true },
        },
        .teardown = true
    };

    if (1 == width){
        @set_local_color_config(MEMCPYD2H_DATA, oneConfig );
    }else{

        if ( first_pe ){
            // 1st PE receives teardown from cmd fan
            @set_local_color_config(MEMCPYD2H_DATA, firstConfig );
        }else if ( !last_pe ){
            // middle PE: 0 < px < (w-1)
            @set_local_color_config(MEMCPYD2H_DATA, secondConfig );
        }else{
            // last PE uses always_pop mode
            @set_local_color_config(MEMCPYD2H_DATA, lastConfig );
        }

    }
}

comptime {
    if (@is_arch("wse3")){
        @initialize_queue(oq_data, .{.color = MEMCPYD2H_DATA});
    }
}

// Only support wse3 because we reuse IQ0, so the task_id cannot
// bind to a streaming D2H color
comptime {
    @comptime_assert(@is_arch("wse3"));
}
