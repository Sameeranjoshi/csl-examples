
//
// special version of demux when N = 1 (height = 1 )
//
// The runtime only issues the H2D command when the H2D is not empty, so
// there is no need for filter
//
//
//  FABRIC_H2D_DATA  +----------+  GC_RXACT_DEMUX        +--------+  GC_TXACT_DEMUX    +---------+
// ------------->    | demux    | ---------------------> | demux  | -----------------> | CMD fan |
//                   | adaptor  |                        |        |                    |         |
//                   +----------+                        +--------+                    +---------+
//

// local colors
param RXACT: color; // receive data from demux adaptor
param TXACT: color; // send data to the core rectangle, only data wavelets

// local tasks
param STARTUP: local_task_id; // receive config parameters
param CONFIG: local_task_id;  // decode config parameters
param TXACT_NEXT_TENSOR: local_task_id;
param TXACT_NEXT_CHUNK: local_task_id;


// parameters
param _pe_id: i16; // 0 <= _pe_id < height
param height: i16; // number of receivers of this demux

const N = height;


const iq_rxact = @get_input_queue(0);
const task_id_rxact = if (@is_arch("wse3")) @get_data_task_id(iq_rxact) else @get_data_task_id(RXACT);

const oq_txact = @get_output_queue(0);

////////////////////////////////////////////////////////////////////////////////
// Main memory (48KB)
////////////////////////////////////////////////////////////////////////////////

// enable_receiver[N] = config_buf[0:N-1]
// pes_per_receiver = config_buf[N]
// pe_length = config_buf[N+1]
// num_receivers = config_buf[N+2]
// memcpy_optype = config_buf[N+3]
//
var config_buf = @zeros([N+4]i16);

// Counter init value for the next RXACT tensor. This value is equal to the
// PE's index in the order of receivers. If the PE does not receive any data
// then this value will be 0xffff.
var receiver_idx: i16 = -1; // 0xffff;

// Number of receivers for the next tensor, corresponds to filter limit
var num_receivers: i16 = 0;

var memcpy_optype: i16 = 0; // { MEMCPY_OP_DENSE = 0, MEMCPY_OP_ROW_BCAST = 1, MEMCPY_OP_COL_BCAST = 2, MEMCPY_OP_STRIDE = 3 }

// Number of PEs in demux minus 1, corresponds to initial filter limit
const num_demux: i16 = N-1;

// Location for saving number of PEs when meta FIFO is full
var num_pes_save: i16 = 0;

// Location for saving per-PE length when meta FIFO is full
var pe_len_save: i16 = 0;

// if the receiver is inactive, we still send out zero data, otherwise
// we will hang the output y because it is Cliff distribution
// the adaptor will send the same pes_per_receiver and pe_length for all
// receivers
// First of all, we will receive
//      receiver_idx = enable_receiver[i] = k >= 0: position of filtering
//                                         -1    : receiver is off
//
// if receiver_idx=-1, we reset num_pes_save =0, otherwise
// num_pes_save = pes_per_receiver
//
var pes_per_receiver: i16 = 0; // number of active PEs per receiver
var pe_length: i16 = 0;        // number of data wavelets per PE


// (num_send, idx_send) is used to send the data
// for i in range(num_receivers):
//   for j in range(pes_per_receiver):
//      send pe_length wavelets via microthread
//
// This is a workaround since the single-step cannot across the task boundary
// see demux_adaptor_casm.csl for the implementation of single-step
//
// num_send = num_receivers <= N <= dim(WSE) ~= 1000, i16 is enough
var num_send : i16 = @as(i16, 0);
var idx_send : i16 = @as(i16, 0);


////////////////////////////////////////////////////////////////////////////////
// DSDs
// data-structure descriptors (DSDs), loaded into data-structure registers (DSRs)
//
// Queues 0,1: input depth 6 wavelets
// Queues 2,3: input depth 4 wavelets
// Queues 4-7: input depth 2 wavelets
//
// queues 0,1: output depth 2 wavelets
// queues 2,3: output depth 6 wavelets
// queues 4,5: output depth 2 wavelets
////////////////////////////////////////////////////////////////////////////////

// Each receiver only filters (pe_length*pes_per_receiver) wavelets
// Assume there is no control wavelets in RXACT, so we remove control wavelets

var fab_recv_wdsd =  @get_dsd(fabin_dsd, .{
   .extent = 1,
   .fabric_color = RXACT,
   .input_queue = iq_rxact
});

var fab_trans_wdsd = @get_dsd(fabout_dsd, .{
    .extent = 1,
    .fabric_color = TXACT,
    .output_queue = oq_txact
});

// receive N+4 i16 config parameters
const mem_buf_config_np4_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N+4} -> config_buf[i] });
const fab_rx_config_wdsd = @get_dsd(fabin_dsd, .{
   .extent = N+4,
   .fabric_color = RXACT,
   .input_queue = iq_rxact
});


////////////////////////////////////////////////////////////////////////////////
// Tasks
// syntax
//     task_begin(name, entrypoint, color)
////////////////////////////////////////////////////////////////////////////////


// f_startp() recv config parameters from demux adaptor
//          |
//          V
// f_config() decode config parameters and call f_txact_next_tensor
//          |
//          V
// f_txact_next_tensor() set loop count and length of DSD
//          |
//          V
// f_txact_next_chunk() recv from adaptor and send to cmd fan
//          |
//          V
// f_startup() recv config parameter for next tensor
//

task f_startup() void {
    // receive config parameters N+4 i16
    @mov16(mem_buf_config_np4_dsd, fab_rx_config_wdsd, .{.async=true, .activate=f_config} );
}

//
// config_buf[N+4] is received, including
// - enable_receiver[N] = config_buf[0:N-1]
// - pes_per_receiver = config_buf[N]
// - pe_length = config_buf[N+1]
// - num_receivers = config_buf[N+2]
// - memcpy_optype = config_buf[N+3]
//
task f_config() void {
    // (1) enable_receiver[i] = k >= 0: position of filtering
    //                         -1    : receiver is off
    // handled by header_sentinel
    receiver_idx = config_buf[_pe_id];

    // (2) Use received values unless this PE does not act as a receiver for the
    // next tensor
    // handled by pes_sentinel
    pes_per_receiver = config_buf[N];
    if (-1 != receiver_idx){
       // Store received value into num_pes_save
       num_pes_save = pes_per_receiver;
    }else{
       // Store length 0 for this PE, since it is not active
       num_pes_save = 0;
    }

    // (3) number of wavelets per PE
    // handled by len_sentinel
    pe_length = config_buf[N+1];
    pe_len_save = pe_length;

    // (4) number of active receivers
    // handled by num_receivers_sentinel
    num_receivers = config_buf[N+2];

    // (5) memcpy op
    // only MEMCPY_OP_COL_BCAST needs to change demux
    memcpy_optype = config_buf[N+3];

    // (6) recv data from demux adaptor and send it to cmd fan
    @activate(TXACT_NEXT_TENSOR);
}


// pseudocode of single-step:
//    for j in range(pes_per_receiver):
//       send pe_length wavelets via microthread
//
task f_txact_next_tensor() void {

    @block( task_id_rxact ); // use microthread to receive data wavelets

    // receiver_idx must be 0
    // num_pes_save must be positive
    fab_recv_wdsd  = @set_dsd_length(fab_recv_wdsd, @as(u16, pe_length));
    fab_trans_wdsd = @set_dsd_length(fab_trans_wdsd, @as(u16, pe_length));
    num_send = @as(i16, num_pes_save);
    idx_send = 0;
    @activate(TXACT_NEXT_CHUNK);
}


task f_txact_next_chunk() void {
    if ( idx_send >= num_send ){
        //@block( task_id_rxact ); // necessary to receive config parameters (control wavelets) for next tensor

        // The tensor is sent out, receive config parameter of next tensor
        @activate(STARTUP);
    }else{
        @mov32(fab_trans_wdsd, fab_recv_wdsd, .{.async=true, .activate=f_txact_next_chunk } );
        idx_send = idx_send+1;
    }
}



comptime {

    @activate( STARTUP );

// WARNING: config parameters are received as control wavelets, so we must unblock RXACT
// To receive data, we need to block RXACT
    @block(task_id_rxact); // use microthread

    @bind_local_task( f_startup, STARTUP);
    @bind_local_task( f_config, CONFIG);
    @bind_local_task( f_txact_next_tensor, TXACT_NEXT_TENSOR );
    @bind_local_task( f_txact_next_chunk, TXACT_NEXT_CHUNK );

}


comptime {

    @comptime_assert(1 == N);

    @set_local_color_config(RXACT, .{ .routes = .{.rx = .{ WEST }, .tx = .{ RAMP} } } );

    @set_local_color_config(TXACT, .{ .routes = .{.rx = .{ RAMP }, .tx = .{ EAST} } } );
}

comptime {
    @initialize_queue(iq_rxact, .{.color = RXACT} );
}

comptime {
    if (@is_arch("wse3")){
        @initialize_queue(oq_txact, .{.color = TXACT});
    }
}
