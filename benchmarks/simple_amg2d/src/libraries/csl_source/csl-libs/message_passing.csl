param enable_asserts: bool = false; // Enables runtime checking of length and destination coords
param bank_id: u16 = 14; // Default is A (base=14), note that B (base=19) clashes with memcpy
param input_queue_id: u16;
param output_queue_id: u16;

// Internal module is parameterized by bank to set config registers, etc.
const internal = @import_module("<message_passing/internal>", .{ .bank_id = bank_id });

// These invariants can be used by consumers of the library
const mp_input_queue = @get_input_queue(input_queue_id);
const mp_output_queue = @get_output_queue(output_queue_id);
const mp_comm_color = @get_color(bank_id + 2);

// Use for declaring dummy DSD before setting address at runtime
var dummy_u32 = @zeros([1]u32);
var u32_ptr: [*]u32 = &dummy_u32;

// State variables for message passing library

// Track whether `init()` has been called for this module
var lib_initialized: bool = false;

// This is necessary for messages which are term_on_ctrl in which the user may
// make multiple calls to send_message before completion.
var msg_in_progress: bool = false;
var msg_in_progress_col_id: u16 = 0;
var msg_in_progress_row_id: u16 = 0;

// Description: set config registers to set up message passing
fn init() void {
    internal.init();
    if (comptime enable_asserts) {
        lib_initialized = true;
    }
}

// Description: Create msg header based on destination and msg length
//              31:20 Destination column ID
//              19:8  Destination row ID
//              7     Destination is to the North of source
//              6     Destination is to the South of source
//              5     Message terminated by control bit
//              4:0   Num wavelets to follow if bit 5 is zero; otherwise, user-defined
fn encode_header(dest_col: u16, dest_row: u16, length: u16) u32 {
    // length is limited to five bits
    if (comptime enable_asserts) {
        @assert(length < 32);
        @assert(dest_col < @get_rectangle().width);
        @assert(dest_row < @get_rectangle().height);
    }

    const dest_col_id: u32 = @as(u32, dest_col + @get_rectangle().offsets.width);
    const dest_row_id: u32 = @as(u32, dest_row + @get_rectangle().offsets.height);

    // bits 7:6 = 0b10 if destination to NORTH, 0b01 if destination to SOUTH, 0b00 otherwise
    const row_id: u32 = @as(u32, internal.tc.get_fabric_coord(internal.tc.fabric_coord.Y));
    const y_pos: u32 = if (row_id > dest_row_id) 2 else if (row_id < dest_row_id) 1 else 0;

    // length 0 means message terminated by control bit
    const ctrl_bit = @as(u32, length == 0);

    const header_wlt = (dest_col_id << 20) | (dest_row_id << 8)
                     | (y_pos << 6) | (ctrl_bit << 5) | @as(u32, length);

    return header_wlt;
}

// Description: Parse header for length. If ctrl bit is set, return 0 for length.
//              In that case, message will term on ctrl.
// Parameters:
// - header     (u32): Wavelet received from msg passing interpreted as header
// Return value (u16): Length of header, 0 if ctrl bit is set.
fn get_header_len(header: u32) u16 {
    const ctrl_bit: u32 = header & (1 << 5);
    const length: u32 = header & 0b11111;

    if (ctrl_bit != 0) {
        return 0;
    }
    return @as(u16, length);
}

fn is_16bit_ptr_type(comptime T: type) bool {
    return @is_same_type(T, [*]f16)
        or @is_same_type(T, [*]i16)
        or @is_same_type(T, [*]u16);
}

fn is_32bit_ptr_type(comptime T: type) bool {
    return @is_same_type(T, [*]f32)
        or @is_same_type(T, [*]i32)
        or @is_same_type(T, [*]u32);
}

// Description: Send message from buffer buf of length len to PE (dest_col, dest_row).
//              Activate or unblock callback upon completion of sending message.
// Parameters:
// - dest_col  (u16):             Column of receiving PE.
// - dest_row  (u16):             Row of receiving PE.
// - buf       ([*]type):         Buffer from which msg is sent. Buffer type must be 16 or 32-bit
//                                type, i.e., i16, u16, f16, i32, u32, or f32.
// - len       (u16):             Sent message length.
// - msg_done  (bool):            If true, this is the end of a message.
// - on_term   (comptime_struct): Struct of the form .{ .<ACTION> = <ID> }, where ACTION is an
//                                activate or unblock performed at the end of the microthreaded
//                                receive operation, and ID is a task or queue ID to be activated
//                                or unblocked. Type of arg is anytype so that {} can be used
//                                for no action.
fn send_partial_message(dest_col: u16, dest_row: u16, buf: anytype, len: u16,
                        msg_done: bool, comptime on_term: anytype) void {

    if (comptime enable_asserts) {
        @assert(lib_initialized);
        if (msg_in_progress) {
            // The message must match destination of message in progress
            @assert(dest_col == msg_in_progress_col_id and dest_row == msg_in_progress_row_id);
        }
    }

    const T = @type_of(buf);
    @comptime_assert(is_16bit_ptr_type(T) or is_32bit_ptr_type(T),
                     "message buf is not 16- or 32-bit type");

    // Setup initial fabout dsd with extent 1
    var out_dsd = @get_dsd(fabout_dsd, .{ .fabric_color = mp_comm_color, .extent = 1,
                      .output_queue = mp_output_queue
                  });

    // Only send out header if there's not already a message in progress
    if (!msg_in_progress) {
        // Set COL_ID and ROW_ID of new message to check consistency of next call
        msg_in_progress_col_id = dest_col;
        msg_in_progress_row_id = dest_row;

        // Send single-wavelet header synchronously
        // If more messages following this header are expected, then ctrl bit is set in header
        const msg_len = if (msg_done) len else 0;
        const mp_header = encode_header(dest_col, dest_row, msg_len);
        @mov32(out_dsd, mp_header);
    }

    // Reset msg_in_progress based on state when current message finishes
    msg_in_progress = !msg_done;

    // Setup mem1d_dsd pointing to buf
    var mem_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> dummy_u32[i] });
    mem_dsd = @set_dsd_length(mem_dsd, len);
    mem_dsd = @set_dsd_base_addr(mem_dsd, buf);

    const properties = if (@is_same_type(@type_of(on_term), void)) .{ .async = true }
                       else @concat_structs(.{ .async = true }, on_term);

    if (is_16bit_ptr_type(T)) {
        @mov16(out_dsd, mem_dsd, properties);
    } else if (is_32bit_ptr_type(T)) {
        @mov32(out_dsd, mem_dsd, properties);
    }
}

// Description: Send message from buffer buf of length len to PE (dest_col, dest_row),
//              with known fixed and complete length.
//              Activate or unblock callback upon completion of sending message.
// Parameters:
// - dest_col (u16):             Column of receiving PE.
// - dest_row (u16):             Row of receiving PE.
// - buf      ([*]type):         Buffer from which msg is sent. Buffer type must be 16 or 32-bit
//                               type, i.e., i16, u16, f16, i32, u32, or f32.
// - len      (u16):             Sent message length.
// - on_term  (comptime_struct): Struct of the form .{ .<ACTION> = <ID> }, where ACTION is an
//                               activate or unblock performed at the end of the microthreaded
//                               receive operation, and ID is a task or queue ID to be activated
//                               or unblocked.
fn send_message(dest_col: u16, dest_row: u16, buf: anytype, len: u16,
                comptime on_term: anytype) void {
    send_partial_message(dest_col, dest_row, buf, len, true, on_term);
}

// Description: Receive message into buffer buf, with number of elements received determined by
//              len param. If len is 0, first wavelet is read as a header wlt, which encodes len.
//              If ctrl bit is set in header, then message receive only terminates on ctrl.
// Parameters:
// - buf     ([*]type):         Buffer in which to receive message. Buffer type must be 16 or
//                              32-bit type, i.e., i16, u16, f16, i32, u32, or f32.
// - on_term (comptime_struct): Struct of the form .{ .<ACTION> = <ID> }, where ACTION is an
//                              activate or unblock performed at the end of the microthreaded
//                              receive operation, and ID is a task or queue ID to be activated
//                              or unblocked. Type of arg is anytype so that {} can be used
//                              for no action.
fn recv_message(buf: anytype, comptime on_term: anytype) void {

    if (comptime enable_asserts) {
        @assert(lib_initialized);
    }

    const T = @type_of(buf);
    @comptime_assert(is_16bit_ptr_type(T) or is_32bit_ptr_type(T),
                     "message buf is not 16- or 32-bit type");

    var in_dsd = @get_dsd(fabin_dsd, .{ .fabric_color = mp_comm_color, .extent = 1,
                     .input_queue = mp_input_queue
                 });
    @mov32(u32_ptr, in_dsd);

    const msg_len: u16 = get_header_len(u32_ptr[0]);

    var mem_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> dummy_u32[i] });
    mem_dsd = @set_dsd_base_addr(mem_dsd, buf);

    if (msg_len != 0) {
        mem_dsd = @set_dsd_length(mem_dsd, msg_len);
        in_dsd = @set_dsd_length(in_dsd, msg_len);

        const properties = if (@is_same_type(@type_of(on_term), void)) .{ .async = true }
                           else @concat_structs(.{ .async = true }, on_term);

        if (is_16bit_ptr_type(T)) {
            @mov16(mem_dsd, in_dsd, properties);
        } else if (is_32bit_ptr_type(T)) {
            @mov32(mem_dsd, in_dsd, properties);
        }

    } else {
        // Msg finished upon receipt of ctrl wavelet, so the DSDs are infinite length
        mem_dsd = @set_dsd_length(mem_dsd, 0x7fff);
        in_dsd = @set_dsd_length(in_dsd, 0x7fff);

        const properties = if (@is_same_type(@type_of(on_term), void))
                               .{ .async = true, .on_control = .{ .terminate = true }}
                           else
                               .{ .async = true, .on_control = on_term };

        if (is_16bit_ptr_type(T)) {
            @mov16(mem_dsd, in_dsd, properties);
        } else if (is_32bit_ptr_type(T)) {
            @mov32(mem_dsd, in_dsd, properties);
        }
    }
}

comptime {
    @comptime_assert(bank_id == 14 or bank_id == 19);
    @comptime_assert(@is_arch("wse3"));
    @initialize_queue(mp_output_queue, .{ .color = mp_comm_color });
    @initialize_queue(mp_input_queue, .{ .color = mp_comm_color });
}
