// Tile map for WSE3 (Schrödinger) architecture.
const types = @import_module("<target/types>");

const word_size = types.word_size;
const reg_type = types.reg;
const double_reg_type = types.double_reg;

const addresses = enum(reg_type) {
  TASK_PRIORITY        = 0x7e08 * word_size,
  CONTROL_TRANSFORM    = 0x7e0a * word_size,
  MISC_CFG             = 0x7e1f * word_size,
  EXCEPTION_MASK_ADDR  = 0x7e12 * word_size,
  TIMESTAMP_COUNTER    = 0x7b30 * word_size,
  PERF_COUNTER_CONTROL = 0x7b34 * word_size,
  INPUT_QUEUE_CONFIG   = 0x7bc0 * word_size,
  OUTPUT_QUEUE_CONFIG  = 0x7b80 * word_size,
  COLOR_CONFIG         = 0x7c00 * word_size,
  TEARDOWN_PENDING     = 0x7c42 * word_size,
  MISC_FABRIC_CFG      = 0x7c44 * word_size,
  FABRIC_COORD         = 0x7c45 * word_size,
  SWITCH_CONFIG        = 0x7c80 * word_size,
  PRNG_STATE           = 0x7dd0 * word_size,
  FILTER               = 0x7b40 * word_size,
  IQFLUSH_STATUS       = 0x7be1 * word_size,
  OQFLUSH_STATUS       = 0x7b92 * word_size
};

const fabric_coord_mask = 0x07ff;
const fabric_coord = enum(reg_type) {
  X = word_size,
  Y = 0
};

const filter_bank_1_size = 6;
const num_filters = filter_bank_1_size;
const filter_size = 8 * word_size;
const field = enum(reg_type) {
  CONFIG0 = 0 * word_size,
  CONFIG1 = 1 * word_size,
  DROP_COUNT = 2 * word_size,
  MAX_PASS = 4 * word_size,
  COUNTER = 6 * word_size,
  STATE = 7 * word_size
};

const prng_count = 4;
const prng_size = 2 * word_size;

const tsc_size_words = 3;

const main_thread_priority_offset: reg_type = 5;
const main_thread_priority_mask: reg_type = 0b11 << main_thread_priority_offset;
const main_thread_priority_level = enum(reg_type) {
  MEDIUM_LOW = 0b00,
  MEDIUM = 0b01,
  MEDIUM_HIGH = 0b10,
  HIGH = 0b11
};

const teardown_in_progress_offset: reg_type = 15;

// Routing

const fabric_io = enum(reg_type) {
  TX_WEST = 0x1,
  TX_EAST = 0x2,
  TX_SOUTH = 0x4,
  TX_NORTH = 0x8,
  TX_RAMP = 0x10,

  RX_WEST = 0x0,
  RX_EAST = 0x20,
  RX_SOUTH = 0x40,
  RX_NORTH = 0x60,
  RX_RAMP = 0x80,
  RX_DISABLE = 0xa0,
  RX_MASK = 0xe0,

  CLEAR_MASK = 0xff00
};

fn is_input_direction(comptime dir: fabric_io) bool {
  return dir == fabric_io.RX_WEST or
         dir == fabric_io.RX_EAST or
         dir == fabric_io.RX_SOUTH or
         dir == fabric_io.RX_NORTH or
         dir == fabric_io.RX_RAMP;
}

// Switching

const SWITCH_REGS_PER_COLOR = 4;

const pop_mode = enum(reg_type) {
  NO_POP = 0x0,
  ALWAYS_POP = 0x2000,
  POP_ON_ADVANCE = 0x4000,
  POP_ON_ADVANCE_OR_NOP = 0x6000,

  CLEAR_MASK = 0x9fff
};

const ring_mode = enum(reg_type) {
  NO_RING_MODE = 0x0,
  RING_MODE = 0x1000,

  CLEAR_MASK = 0xefff
};

const switch_status = enum(reg_type) {
  CLEAR_CURRENT_POS = 0xfff0,
  // pos1 has 8 bits:
  // bits 7:5 pos1 input select
  // bits 4:0 pos1 output <dir> enable
  CLEAR_POS1_2 = 0xff00,
  CLEAR_POS3 = 0x00ff,
  SELECT_INPUT_POS0_1_2 = 0x00e0,
  SELECT_OUTPUT_POS0_1_2 = 0x001f
};

const switch_select = enum(reg_type) {
  INPUT = 1,
  OUTPUT = 0
};

// WARNING: "comptime" is necessary, otherwise the compilation error is
//   function parameter type is not valid at runtime: 'type'.
// WARNING: if-else is necessary otherwise the compilation error shows
//   @comptime_assert is unreachable.
fn get_switch_setting_word_offset(comptime setting_type: type) u16 {
  if (@is_same_type(setting_type, pop_mode)){
    return 0;
  }else if (@is_same_type(setting_type, ring_mode)){
    return 0;
  }else{
    @comptime_assert(@is_same_type(setting_type, switch_status));
    return 3;
  }
}

// SDR has four switch config registers, 0x7c80 - 0x7cdf
// switch reg 0: 0x7c80
// switch reg 1: 0x7c81
// switch reg 2: 0x7c82
// fabric color status reg: 0x7c83
//
// switch reg 0 contains pos1 (bits 7:0)
// switch reg 1 contains pos2 (bits 7:0) and pos3 (bits 15:8)
// fabric color status reg contains current switch position,
//    input switch position at 3:2 and
//    output switch position at 1:0

// Values of the switch direction field
// The input select treats this number as an encoding number with 3 bits
// The output select treats this number as a bit position
const SWITCH_WEST: u16 = 0;
const SWITCH_EAST: u16 = 1;
const SWITCH_SOUTH: u16 = 2;
const SWITCH_NORTH: u16 = 3;
const SWITCH_RAMP: u16 = 4;
const SWITCH_INVALID: u16 = 5;

// Indices of the 3 switch positions within the mask
// bits 7:5 of reg0 is the pos1 input select
const INPUT_POS1: u16 = 5;
// bits 7:5 of reg1 is the pos2 input select
const INPUT_POS2: u16 = 5;
// bits 15:13 of reg1 is the pos3 input select
const INPUT_POS3: u16 = 13;
// bits 8:12 of reg1 is the pos3 output enables
const OUTPUT_POS3: u16 = 8;

// Index of the bit that contains the current switch position
// bits 3:2 input switch position
// bits 1:0 output switch position
const OUTPUT_SWITCH_CUR_POS: u16 = 0;
const INPUT_SWITCH_CUR_POS: u16 = 2;


// SDR has four switch registers.
// reg 0 contains position 1.
// reg 1 contains position 2.
// To invalidate pos1, pos2 and pos3, we need to touch
// two registers, so we have to put this function under
// target/<arch>.
fn set_invalid_for_all_switch_positions(addr_reg0: reg_type) void {

  const addr_reg1 = addr_reg0 + 1;

  // clear pos1 in reg0
  var r_switch_state = @get_config(addr_reg0);
  r_switch_state &= 0xff00;
  r_switch_state = r_switch_state | (SWITCH_INVALID << INPUT_POS1);
  @set_config(addr_reg0, r_switch_state);

  // clear pos2 and pos3 in reg1
  r_switch_state = (SWITCH_INVALID << INPUT_POS2) | (SWITCH_INVALID << INPUT_POS3);
  @set_config(addr_reg1, r_switch_state);
}



// 5 = INVALID, 4 = CE, 3 = N, 2 = S, 1 = E, 0 = W
// input select treats switch_direction_encoding(dir) as an encoded number.
// output enable treats switch_direction_encoding(dir) as a bit.
fn switch_direction_encoding(comptime dir: direction) u16 {
  if (dir == WEST) {
    return SWITCH_WEST;
  } else if (dir == EAST) {
    return SWITCH_EAST;
  } else if (dir == SOUTH) {
    return SWITCH_SOUTH;
  } else if (dir == NORTH) {
    return SWITCH_NORTH;
  } else if (dir == RAMP){
    return SWITCH_RAMP;
  } else {
    // SWITCH_INVALID is not allowed because output select does
    // not have a bit for INVALID.
    @comptime_assert(false);
  }
}


// Although SDR can configure both input switch and output switch at the same position,
// this API only configures either input or output.
// It also configures one direction only.
fn set_switch_pos1(switch_addr: reg_type, color_addr: reg_type, comptime dir: direction, comptime input: u16) void {

  var r_switch_state = @get_config(switch_addr + @as(reg_type, field.CONFIG0));
  // clear bits 7:5 pos1 input select
  // clear bits 4:0 pos1 output <dir> enable
  r_switch_state &= @get_int(switch_status.CLEAR_POS1_2);
  const dir_val: u16 = switch_direction_encoding(dir);
  if (0 < input){
     // dir_val is an encoding number
     r_switch_state |= (dir_val << INPUT_POS1);

     // propagate output switch from color config reg
     var r_color_state = @get_config(color_addr);
     r_color_state &= @get_int(switch_status.SELECT_OUTPUT_POS0_1_2);
     r_switch_state |= r_color_state;
  }else{
     // dir_val is a bit position
     r_switch_state |= (@as(u16, 1) << dir_val);

     // propagate input switch from color config reg
     var r_color_state = @get_config(color_addr);
     r_color_state &= @get_int(switch_status.SELECT_INPUT_POS0_1_2);
     r_switch_state |= r_color_state;
  }
  @set_config(switch_addr, r_switch_state);
}

fn set_rx_switch_pos1(switch_addr: reg_type, color_addr: reg_type, comptime dir: direction) void {
  set_switch_pos1(switch_addr, color_addr, dir, @as(u16, switch_select.INPUT));
}

fn set_tx_switch_pos1(switch_addr: reg_type, color_addr: reg_type, comptime dir: direction) void {
  set_switch_pos1(switch_addr, color_addr, dir, @as(u16, switch_select.OUTPUT));
}

fn set_rxtx_switch_pos1(switch_addr: reg_type, color_addr: reg_type, comptime dir_rx: direction, comptime dir_tx: direction) void {

  var r_switch_state = @get_config(switch_addr + @as(reg_type,field.CONFIG0));
  // clear bits 7:5 pos1 input select
  // clear bits 4:0 pos1 output <dir> enable
  r_switch_state &= @get_int(switch_status.CLEAR_POS1_2);

  const dir_rx_val: u16 = switch_direction_encoding(dir_rx);
  const dir_tx_val: u16 = switch_direction_encoding(dir_tx);
  // dir_rx_val is an encoding number
  r_switch_state |= (dir_rx_val << INPUT_POS1);
  // dir_tx_val is a bit position
  r_switch_state |= (@as(u16, 1) << dir_tx_val);

  @set_config(switch_addr, r_switch_state);
}

fn set_switch_pos2(switch_addr: reg_type, color_addr: reg_type, comptime dir: direction, comptime input: u16) void {
  var r_switch_state1 = @get_config(switch_addr + @as(reg_type, field.CONFIG0));

  var r_switch_state = @get_config(switch_addr + @as(reg_type, field.CONFIG1));
  // clear bits 7:5 pos2 input select
  // clear bits 4:0 pos2 output <dir> enable
  r_switch_state &= @get_int(switch_status.CLEAR_POS1_2);
  const dir_val: u16 = switch_direction_encoding(dir);
  if (0 < input){
     // dir_val is an encoding number
     r_switch_state |= (dir_val << INPUT_POS2);

     // propagate output switch from position 1
     r_switch_state1 &= @get_int(switch_status.SELECT_OUTPUT_POS0_1_2);
     r_switch_state |= r_switch_state1;
  }else{
     // dir_val is a bit position
     r_switch_state |= (@as(u16, 1) << dir_val);

     // propagate input switch from position 1
     r_switch_state1 &= @get_int(switch_status.SELECT_INPUT_POS0_1_2);
     r_switch_state |= r_switch_state1;
  }
  @set_config(switch_addr, r_switch_state);
}

fn set_rx_switch_pos2(switch_addr: reg_type, color_addr: reg_type, comptime dir: direction) void {
  set_switch_pos2(switch_addr, color_addr, dir, @as(u16, switch_select.INPUT));
}

fn set_tx_switch_pos2(switch_addr: reg_type, color_addr: reg_type, comptime dir: direction) void {
  set_switch_pos2(switch_addr, color_addr, dir, @as(u16, switch_select.OUTPUT));
}

fn set_rxtx_switch_pos2(switch_addr: reg_type, color_addr: reg_type, comptime dir_rx: direction, comptime dir_tx: direction) void {
  var r_switch_state = @get_config(switch_addr + @as(reg_type, field.CONFIG1));
  // clear bits 7:5 pos1 input select
  // clear bits 4:0 pos1 output <dir> enable
  r_switch_state &= @get_int(switch_status.CLEAR_POS1_2);

  const dir_rx_val: u16 = switch_direction_encoding(dir_rx);
  const dir_tx_val: u16 = switch_direction_encoding(dir_tx);
  // dir_rx_val is an encoding number
  r_switch_state |= (dir_rx_val << INPUT_POS2);
  // dir_tx_val is a bit position
  r_switch_state |= (@as(u16, 1) << dir_tx_val);

  @set_config(switch_addr, r_switch_state);
}

fn set_switch_pos3(switch_addr: reg_type, color_addr: reg_type, comptime dir: direction, comptime input: u16) void {

  var r_switch_state = @get_config(switch_addr + @as(reg_type, field.CONFIG1));
  // clear bits 15:13 pos3 input select
  // clear bits 12:8 pos3 output <dir> enable
  r_switch_state &= @get_int(switch_status.CLEAR_POS3);
  const dir_val: u16 = switch_direction_encoding(dir);
  if (0 < input){
     // dir_val is an encoding number
     r_switch_state |= (dir_val << INPUT_POS3);

     // propagate output switch from position 2
     var r_switch_pos2 = r_switch_state & @get_int(switch_status.SELECT_OUTPUT_POS0_1_2);
     r_switch_state |= r_switch_pos2;
  }else{
     // dir_val is a bit position
     r_switch_state |= (@as(u16, 1) << (dir_val + OUTPUT_POS3));

     // propagate input switch from position 2
     var r_switch_pos2 = r_switch_state & @get_int(switch_status.SELECT_INPUT_POS0_1_2);
     r_switch_state |= r_switch_pos2;
  }
  @set_config(switch_addr, r_switch_state);
}

fn set_rx_switch_pos3(switch_addr: reg_type, color_addr: reg_type, comptime dir: direction) void {
  set_switch_pos3(switch_addr, color_addr, dir, @as(u16, switch_select.INPUT));
}

fn set_tx_switch_pos3(switch_addr: reg_type, color_addr: reg_type, comptime dir: direction) void {
  set_switch_pos3(switch_addr, color_addr, dir, @as(u16, switch_select.OUTPUT));
}

fn set_rxtx_switch_pos3(switch_addr: reg_type, color_addr: reg_type, comptime dir_rx: direction, comptime dir_tx: direction) void {
  var r_switch_state = @get_config(switch_addr + @as(reg_type, field.CONFIG1));
  // clear bits 15:13 pos3 input select
  // clear bits 12:8 pos3 output <dir> enable
  r_switch_state &= @get_int(switch_status.CLEAR_POS3);

  const dir_rx_val: u16 = switch_direction_encoding(dir_rx);
  const dir_tx_val: u16 = switch_direction_encoding(dir_tx);
  // dir_rx_val is an encoding number
  r_switch_state |= (dir_rx_val << INPUT_POS3);
  // dir_tx_val is a bit position
  r_switch_state |= (@as(u16, 1) << (dir_tx_val + OUTPUT_POS3));

  @set_config(switch_addr, r_switch_state);
}

// The current switch position is in fabric color status register.
//
// SDR separates the input switch and the output switch.
// This API only specifies one parameter "init_pos" which is
// both input switch position and output switch position.
fn set_current_switch_position(addr: reg_type, init_pos: u16) void {

  var r_switch_state = @get_config(addr + @as(reg_type, field.CONFIG0));
  // clear bits 3:0
  r_switch_state &= @get_int(switch_status.CLEAR_CURRENT_POS);
  // reconfigure the current switch position, including input and output
  r_switch_state += (init_pos << INPUT_SWITCH_CUR_POS) + ((init_pos << OUTPUT_SWITCH_CUR_POS));
  @set_config(addr, r_switch_state);
}

// Input queue

const REGS_PER_INPUT_QUEUE = 2;

// Output queue

const REGS_PER_OUTPUT_QUEUE = 1;
