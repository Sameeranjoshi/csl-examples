param target : imported_module;

const addresses = target.addresses;
const reg_type = target.reg_type;
const word_size = target.word_size;

// Returns the word address of an input queue configuration that
// corresponds to input queue `qid`.
fn get_input_queue_config_addr(qid: u16) reg_type {
  const base_addr_input_queue_config = @get_int(addresses.INPUT_QUEUE_CONFIG) / word_size;
  return base_addr_input_queue_config + target.REGS_PER_INPUT_QUEUE * @get_int(qid);
}

// Only encode color field and filter_enable field.
// Other fields are kept as-is.
fn encode_input_queue( qid: u16, c: i16, filter_enable: bool) void {
  if (!@is_arch("wse3")) {
    @comptime_print("input queue not supported on this target");
    @comptime_assert(false);
  }
  // The encoding offset of the config reg 0 of input queue "qid"
  // The base word address is 0x7bc0 (byte addr 0xf780)
  // bit 4:0 is color
  // bit 11 is "filter enabled"

  const filter_enable_offset = 11;

  const addr = get_input_queue_config_addr(qid);
  var val: u16 = @get_config(addr);
  if (filter_enable){
    // set bit-11 to 1
    val = val | (1 << filter_enable_offset);
  }else{
    // set bit-11 to zero
    val = val & (~(@as(reg_type, 1 << filter_enable_offset)));
  }
  // set bit 4:0 to zero
  val = val & 0xffe0;
  // assign color to bit 4:0
  val = val + @as(u16, c);

  @set_config(addr, val);
}
