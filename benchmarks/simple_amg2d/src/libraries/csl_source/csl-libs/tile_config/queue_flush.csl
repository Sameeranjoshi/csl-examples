param target : imported_module;

const addresses = target.addresses;
const reg_type = target.reg_type;
const word_size = target.word_size;

const error_message = "queue flush not supported on this target";

// Reset the status of the queue flush status register that corresponds
// to `qid`. Depending on the type of `qid` this could be the input or
// output queue flush status register.
fn exit(comptime qid : anytype) void {
  @comptime_assert(@is_arch("wse3"), error_message);
  const id = @get_int(qid);
  const qid_ty = @type_of(qid);
  @comptime_assert(@is_same_type(qid_ty, input_queue) or
                   @is_same_type(qid_ty, output_queue),
                   "expected value of 'input_queue' or 'output_queue' type");
  const addr_enum = if (@is_same_type(qid_ty, input_queue))
                      addresses.IQFLUSH_STATUS
                    else
                      addresses.OQFLUSH_STATUS;
  const addr = @as(reg_type, addr_enum);
  const mask = 1 << id;
  @set_config(addr / word_size, mask);
}

// Return the value of the "input queue flush status" register.
fn iq_status() reg_type {
  @comptime_assert(@is_arch("wse3"), error_message);
  return @get_config(@as(reg_type, addresses.IQFLUSH_STATUS) / word_size);
}

// Return the value of the "output queue flush status" register.
fn oq_status() reg_type {
  @comptime_assert(@is_arch("wse3"), error_message);
  return @get_config(@as(reg_type, addresses.OQFLUSH_STATUS) / word_size);
}

// Given a value that represents the "queue flush status" register, which
// has 1 bit per queue indicating the ones that have been flushed, return
// `true` iff the queue id `q` has been flushed.
fn is_flushed(value: reg_type, comptime qid: anytype) bool {
  @comptime_assert(@is_arch("wse3"), error_message);
  const qid_ty = @type_of(qid);
  @comptime_assert(@is_same_type(qid_ty, input_queue) or
                   @is_same_type(qid_ty, output_queue),
                   "expected value of 'input_queue' or 'output_queue' type");
  const id = @get_int(qid);
  const mask = 1 << id;
  return (value & mask) != 0;
}
