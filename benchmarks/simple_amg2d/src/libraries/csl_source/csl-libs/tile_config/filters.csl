param target : imported_module;

const num_filters = target.num_filters;
const filter_bank_1_size = target.filter_bank_1_size;
const addresses = target.addresses;
const reg_type = target.reg_type;
const word_size = target.word_size;
const filter_size = target.filter_size;

fn __make_filters() [num_filters]reg_type {
  var f = @zeros([num_filters]reg_type);
  for (@range(reg_type, num_filters)) |i| {
    var base = if (i < filter_bank_1_size) addresses.FILTER else addresses.FILTER_BANK_2;
    var ind = if (i < filter_bank_1_size) i else i - filter_bank_1_size;
    f[i] = @as(reg_type, base) + ind * filter_size;
  }
  return f;
}

const filters = __make_filters();
const field = target.field;
const max_counter_width = (word_size * 8) - 1;

// Filter configuration functions.
//////////////////////////////////

fn set_config(filter_id: u16, config: field, value: reg_type) void {
  @set_config((filters[filter_id] + @as(reg_type, config)) / word_size, value);
}

fn get_config(filter_id: u16, config: field) u16 {
  return @get_config((filters[filter_id] + @as(reg_type, config)) / word_size);
}

// Set the drop_count of the wse3 counter filter given a 'limit' value
// that has the wse2 semantics. This method will read 'MAX_PASS' and
// therefore the user needs to make sure that `set_max_counter` is called
// prior to `set_active_limit`, if needed.
fn set_active_limit_wse3(filter_id: u16, limit: reg_type) void {
  @assert(limit < (1 << max_counter_width));
  const double_limit = limit * 2;
  const pass_count = get_config(filter_id, field.MAX_PASS) - 1;
  const drop_count = if (double_limit < pass_count) 0 else (double_limit - pass_count);
  set_config(filter_id, field.DROP_COUNT, drop_count);
}

// Set the active limit of a counter filter identified by `filter_id`
// to `limit`.
fn set_active_limit(filter_id: u16, limit: reg_type) void {
  if (@is_arch("wse3")) {
    set_active_limit_wse3(filter_id, limit);
  } else {
    set_config(filter_id, field.ACTIVE_LIMIT, limit);
  }
}

// Set the maximum counter value of a counter filter identified by `filter_id`
// to `max_counter`.
fn set_max_counter(filter_id: u16, max_counter: reg_type) void {
  if (@is_arch("wse3")) {
    @assert(max_counter < (1 << max_counter_width));
    set_config(filter_id, field.MAX_PASS, max_counter * 2 + 1);
  } else {
    set_config(filter_id, field.MAX_COUNTER, max_counter);
  }
}

// Set the initial counter depending on whether the provied 'counter'
// value is greater than 'pass_count' or not and set the state of
// the filter accordingly.
fn set_counter_wse3(filter_id: u16, counter: reg_type) void {
  @assert(counter < (1 << max_counter_width));
  const pass_count = get_config(filter_id, field.MAX_PASS);
  const double_counter = counter * 2;
  if (double_counter > pass_count) {
    const state_offset = 6;
    set_config(filter_id, field.STATE, 1 << state_offset);
    set_config(filter_id, field.COUNTER, double_counter - pass_count + 1);
  } else {
    set_config(filter_id, field.STATE, 0);
    set_config(filter_id, field.COUNTER, double_counter);
  }
}

// Set the counter value of a counter filter identified by `filter_id`
// to `counter`.
fn set_counter(filter_id: u16, counter: reg_type) void {
  if (@is_arch("wse3")) {
    set_counter_wse3(filter_id, counter);
  } else {
    set_config(filter_id, field.COUNTER, counter);
  }
}
