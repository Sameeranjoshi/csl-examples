param target : imported_module;

const addresses = target.addresses;
const reg_type = target.reg_type;
const word_size = target.word_size;

// "Control Wavelet Transform" functions.
/////////////////////////////////////////

fn set_mask(mask: reg_type) void {
  const addr = @as(reg_type, addresses.CONTROL_TRANSFORM) / word_size;
  @set_config(addr, mask);
}
