fn set_current_switch_position(c: anytype, init_pos: u16) void {
  const c_ty = @type_of(c);
  const addr = if (@is_same_type(c_ty, reg_type))
                 c
               else
                 get_switch_config_addr(c, switch_status);
  target.set_current_switch_position(addr, init_pos);
}
