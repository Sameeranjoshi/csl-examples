}

fn set_rxtx_switch_pos1(c: anytype, comptime dir_rx: direction, comptime dir_tx: direction) void {
  @comptime_assert(@is_arch("wse3"));
  const c_ty = @type_of(c);
  const switch_addr = if (@is_same_type(c_ty, reg_type))
                 c
               else
                 get_switch_config_addr(c, pop_mode);
  const color_addr = if (@is_same_type(c_ty, reg_type))
                 c
               else
                 get_color_config_addr(c);
