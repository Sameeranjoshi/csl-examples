param memcpyParams: comptime_struct;

param reduceParams: comptime_struct;

param stencilParams: comptime_struct;

param MAX_ZDIM: i16; // size of vector x

param BLOCK_SIZE: i16; // size of temporary buffers for communication

param STARTUP: local_task_id;

const math_lib = @import_module("<math>");
const simprint = @import_module("<simprint>", .{ .enable = true });
const timestamp = @import_module("<time>");

// memcpy module reserves
// - input/output queue 0 and 1
const sys_mod = @import_module( "<memcpy/memcpy>", memcpyParams);
const layout_mod = @import_module("<layout>");

// allreduce uses input queue/output queue 2
const reduce_mod = @import_module( "../modified_csl_lib/allreduce/pe.csl", @concat_structs(reduceParams, .{
     .f_callback = sys_mod.unblock_cmd_stream,
     .queues = [1]u16{2},
     .dest_dsr_ids = [1]u16{1},
     .src0_dsr_ids = [1]u16{1},
     .src1_dsr_ids = [1]u16{1}
     }));

// output queue cannot overlap input queues
const stencil_mod = @import_module( "../modified_csl_lib/stencil_3d_7pts/pe.csl", @concat_structs(stencilParams, .{
     .f_callback = sys_mod.unblock_cmd_stream,
     .input_queues = [4]u16{4, 5, 6, 7},
     .output_queues = if (@is_arch("wse3")) [4]u16{4, 5, 6, 7} else [1]u16{3},
     .output_ut_id = 3,
     .BLOCK_SIZE = BLOCK_SIZE,
     .dest_dsr_ids = [2]u16{2,3},
     .src0_dsr_ids = [1]u16{2},
     .src1_dsr_ids = [2]u16{2,3}
     }));


// tsc_size_words = 3
// starting time of H2D/D2H
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
// ending time of H2D/D2H
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);

var factor: u16 = 1;   // at least 1
var hops: u16 = 1;  // The least hops between active PEs
var restriction_window_width: u16 = 1;
var restriction_window_height: u16 = 1; // starting size of the window.
var active_pes_in_restriction_window_x: u16 = 2;
var active_pes_in_restriction_window_y: u16 = 2;
const rectangle = @get_rectangle();
const width: u16 = rectangle.width; // This should be passed as a parameter or retrieved from somewhere
const height: u16 = rectangle.height; // This should be passed as a parameter or retrieved from somewhere  
////////////////////////////////////////////////////////////////////////////////
// Main memory (48KB)
////////////////////////////////////////////////////////////////////////////////

var x = @zeros([MAX_ZDIM]f32);
var y = @zeros([MAX_ZDIM]f32);
var reduced_result = @zeros([MAX_ZDIM]f32);
var dot = @zeros([1]f32);

// stencil coefficients are organized as
// {c_west, c_east, c_south, c_north, c_bottom, c_top, c_center}
//
// The formula is
//    c_west * x[i-1][j][k] + c_east * x[i+1][j][k] +
//    c_south * x[i][j-1][k] + c_north * x[i][j+1][k] +
//    c_bottom * x[i][j][k-1] + c_top * x[i][j][k+1] +
//    c_center * x[i][j][k]
var stencil_coeff = @zeros([7]f32);

// time_buf_u16[0:5] = {tscStartBuffer, tscEndBuffer}
var time_buf_u16 = @zeros([timestamp.tsc_size_words*2]u16);

// reference clock inside allreduce module
var time_ref_u16 = @zeros([timestamp.tsc_size_words]u16);

var ptr_x: [*]f32 = &x;
var ptr_y: [*]f32 = &y;
var ptr_stencil_coeff: [*]f32 = &stencil_coeff;
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;
var ptr_time_ref: [*]u16 = &time_ref_u16;
var ptr_reduced_result: [*]f32 = &reduced_result;

////////////////////////////////////////////////////////////////////////////////
// Tasks
// syntax
//     task_begin(name, entrypoint, color)
////////////////////////////////////////////////////////////////////////////////

fn is_top_left_of_restriction_window(px: u16, py: u16, restriction_window_width: u16, restriction_window_height: u16) bool {
    return px == 0 and py == 0;
}

fn f_tic() void {
    timestamp.get_timestamp(&tscStartBuffer);

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

fn f_toc() void {
    timestamp.get_timestamp(&tscEndBuffer);

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

fn f_memcpy_timestamps() void {

    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];

    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

// level - done
// factor - done
// window size - done
// total pe hXW - not done
// hops across x and y - done
// total active PEs inside the window - done
fn f_init_spmv(level_id:u16) void {       
    // PE coordinates
    const pe_id_x: u16 = layout_mod.get_x_coord();
    const pe_id_y: u16 = layout_mod.get_y_coord();       
    // Get width and height from layout parameters (assuming they're available)
    // factor
    var const_2: f16 = 2.0;
    factor = @as(u16, math_lib.pow(const_2, @as(f16, level_id)));    // stride = 2^level_id
    // hops - keep as immediate neighbors for 7-point stencil
    hops = factor;
    // window(restriction window)
    restriction_window_width = @as(u16, math_lib.pow(const_2, @as(f16, factor + 1))); // window size = 2^(factor + 1)
    restriction_window_height = @as(u16, math_lib.pow(const_2, @as(f16, factor + 1)));    
    // total active inside window(always fixed)
    active_pes_in_restriction_window_x = 2;
    active_pes_in_restriction_window_y = 2;

    // Configure reduction module runtime params (use current layout width/height)
    // Todo: Remove this initialization later.  It is only for debugging.   
    // set reduced_result to 1.0 in only 1st layer.
    var row: i16 = 0;
    while(row < MAX_ZDIM) : (row +=1) {
        reduced_result[row] = @as(f32, 1.0);
    }

    // Set hop-based communication parameters in the stencil module
    stencil_mod.setHopBasedParams(hops, factor, width, height);
    reduce_mod.setReductionParams(width, height);

    sys_mod.unblock_cmd_stream();
}

// stencil coefficients are organized as
// {c_west, c_east, c_south, c_north, c_bottom, c_top, c_center}
fn f_spmv(n:i16) void {
    stencil_mod.spmv(n, &stencil_coeff, &x, &y);
}

// restriction pattern is top-left, changes per level and the restriction keeps the z dimension the same.
fn f_reduction_top_left_pattern(n:i16) void {
    // Semi-coarsening: Reduces only 2 dimensions and not the z dimension.
    // 1. Make sure the code is aware of the new window size at this level and total_active PEs inside the window.(f_init_spmv)
    // 2. Now inside the restriction window:
        // 2.1. Reduce rows across x dimension from right to left (east-to-west).
        // 2.2. Reduce column from bottom to top (south-to-north).
        // 2.3. The final answer is now stored in top-left PE (0,0).
    // result ends in top-left PE
    
    reduce_mod.reduce_row_col_top_left(n, &reduced_result, reduce_mod.TYPE_BINARY_OP.ADD);
    // The code triggers a callback when done.
    // sys_mod.unblock_cmd_stream();
}

// 2.4. Divide it by total number of active PEs in the window.
fn f_restriction() void {
    // PE coordinates
    const pe_id_x: u16 = layout_mod.get_x_coord();
    const pe_id_y: u16 = layout_mod.get_y_coord(); 
    if (is_top_left_of_restriction_window(pe_id_x, pe_id_y, width, height)) {
    // if (layout_mod.get_x_coord() == @as(u16, width - 1) and layout_mod.get_y_coord() == @as(u16, height - 1)) {
        var zindex: i16 = 0;
        // var total_active_PEs = @as(f32, active_pes_in_restriction_window_x * active_pes_in_restriction_window_y);
        var total_active_PEs = @as(f32, width * height);
        // Divide all Z dimensions
        while(zindex < MAX_ZDIM) : (zindex +=1) {
            reduced_result[zindex] = reduced_result[zindex] / total_active_PEs ;
        }
    }
    sys_mod.unblock_cmd_stream();
}

fn f_sync( n: i16 ) void {
   reduce_mod.allreduce(n, &dot, reduce_mod.TYPE_BINARY_OP.ADD);
}

fn f_reference_timestamps() void {

    time_ref_u16[0] = reduce_mod.tscRefBuffer[0];
    time_ref_u16[1] = reduce_mod.tscRefBuffer[1];
    time_ref_u16[2] = reduce_mod.tscRefBuffer[2];

    // the user must unblock cmd color for every PE
    sys_mod.unblock_cmd_stream();
}

task f_startup() void {
    timestamp.enable_tsc();
}


comptime {

    @activate(STARTUP);

    @bind_local_task(f_startup, STARTUP);
}

comptime {
    @export_symbol(ptr_x, "x");
    @export_symbol(ptr_y, "y");
    @export_symbol(ptr_stencil_coeff, "stencil_coeff");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    @export_symbol(ptr_time_ref, "time_ref");
    @export_symbol(ptr_reduced_result, "reduced_result");
}

comptime{
    @export_symbol(f_tic);
    @export_symbol(f_toc);
    @export_symbol(f_memcpy_timestamps);
    @export_symbol(f_init_spmv);
    @export_symbol(f_spmv);
    @export_symbol(f_sync);
    @export_symbol(f_reference_timestamps);
    @export_symbol(f_reduction_top_left_pattern);
    @export_symbol(f_restriction);
}
