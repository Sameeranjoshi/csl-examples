//   //   .fabric_color = x_color,
//   //   .extent = M_per_PE,
//   //   .input_queue = recv_west_iq
//   // });
  
//   @fmovs(x_dsd, wavelet_data);
//   @activate(compute_task_id);
// }


fn recv_y_fabric() void {
  simprint.fmt_with_coords("recv_y fabric {d}", .{ @as(u32, pe_id) });
 
  const in_dsd  = @get_dsd(fabin_dsd, .{
                    .fabric_color = recv_west_color, 
                    .extent = M_per_PE,
                    .input_queue = recv_west_iq
                  });
  
  @fmovs(x_dsd, in_dsd);
  // print x
  for (x) |val, i| {
    simprint.fmt_with_coords("x[{d}] = {f}", .{ i, val });
  }
}
// Task to send y values
fn send_y() void {
  simprint.fmt_with_coords("send_y {d}", .{ @as(u32, pe_id) });

  const out_dsd = @get_dsd(fabout_dsd, .{
                    .fabric_color = send_east_color, 
                    .extent = M_per_PE,
                    .output_queue = send_east_oq
                  });
  @fmovs(out_dsd, y_dsd, .{ .async = true });
}

// // recv
// // compute
// // send
// // activate another layer, repeat.

// Compute gemv
fn compute() void {
  simprint.fmt_with_coords("compute {d}", .{ @as(u32, pe_id) });
  // reset A_dsd to the start of A
  A_dsd = @set_dsd_base_addr(A_dsd, &A);
  // Compute local matrix multiplication
  for (@range(i16, N_per_PE)) |i| {
    @fmacs(y_dsd, y_dsd, A_dsd, x[i]);
    A_dsd = @increment_dsd_offset(A_dsd, 1, f32);
  }

  // // if (pe_id != @as(i16, kernel_x_dim)-1) {
  // //   @activate(send_y_id);
  // // } else {
  // //   @activate(exit_task_id);
  // // }
  // if (is_last_pe()) {
  //   @unblock(exit_task_id);
  // } else {
  //   @activate(send_y_id);
  // }
}

// Host-facing function to start computation
fn host_facing_function(layer: i16) void {
 const out_dsd = @get_dsd(fabout_dsd, .{
                    .fabric_color = send_east_color, 
                    .extent = M_per_PE,
                    .output_queue = send_east_oq
                  });
  const in_dsd  = @get_dsd(fabin_dsd, .{
                    .fabric_color = recv_west_color, 
                    .extent = M_per_PE,
                    .input_queue = recv_west_iq
                  });

  simprint.fmt_with_coords("host_facing_function {d}", .{ @as(u32, pe_id) });
  if (is_first_pe()) {
    compute();
    @fmovs(out_dsd, y_dsd, .{ .async = true, .activate = send_done});
  } else if (is_last_pe()) {
    @fmovs(x_dsd, in_dsd, .{ .async = true, .activate = recv_done});
    compute();
    // print y
    for (y) |val, i| {
      simprint.fmt_with_coords("y[{d}] = {f}", .{ i, val });
    }
    // exit_task();
  } else {
    @fmovs(x_dsd, in_dsd, .{ .async = true, .activate = recv_done });
    compute();
    @fmovs(out_dsd, y_dsd, .{ .async = true, .activate = send_done });
  }
}

task send_done() void {
  simprint.fmt_with_coords("send_done {d}", .{ @as(u32, pe_id) });
  sys_mod.unblock_cmd_stream();
}

task recv_done() void {
  simprint.fmt_with_coords("recv_done {d}", .{ @as(u32, pe_id) });
  sys_mod.unblock_cmd_stream();
}

// Exit task
fn exit_task() void {
  simprint.fmt_with_coords("exit_task {d}", .{ @as(u32, pe_id) });
  sys_mod.unblock_cmd_stream();
}

comptime {
  // @bind_local_task(exit_task, exit_task_id);
  // @bind_local_task(compute, compute_task_id);
  // @bind_local_task(send_y, send_y_id);
  // @bind_local_task(recv_y_fabric, recv_y_fabric_id);
  // @bind_data_task(recv_y, recv_y_id);

  @bind_local_task(send_done, send_done_id);
  @bind_local_task(recv_done, recv_done_id);

  @export_symbol(A_ptr, "A");
  @export_symbol(x_ptr, "x");
  @export_symbol(y_ptr, "y");
  @export_symbol(host_facing_function);
}
