//     @fadds(y_dsd, y_dsd, in_dsd, .{ .async = true, .activate = exit_task_id });
//   }
// }



// WTT
var num_recv_y: i16 = 0;
task recv_y(wavelet_data: f32) void {
  const recv_y_dsd = @get_dsd(fabin_dsd, .{
                        .fabric_color = x_color, 
                        .extent = M_per_PE,
                        .input_queue = recv_west_iq
                      });
  simprint.fmt_with_coords("recv_y {d}", .{ @as(u32, pe_id) });
  @fmovs(y_dsd, recv_y_dsd, .{ .async = true , .activate = recv_done_id }); // recv y from previous layer.
  // num_recv_y += 1;
  // if (num_recv_y == M_per_PE) {
  //   @activate(recv_done_id);  // copy y to x
  // }
}

task send_y() void {

// SEND AND RECV Y=Ax  output and trigger dataflow on this channel.
const send_y_dsd = @get_dsd(fabout_dsd, .{
                        .fabric_color = x_color, 
                        .extent = M_per_PE,
                        .output_queue = send_east_oq
                      });  
  simprint.fmt_with_coords("send_x {d}", .{ @as(u32, pe_id) });
  @fmovs(send_y_dsd, y_dsd, .{ .async = true, .activate = send_done});
}

task recv_done() void {
  simprint.fmt_with_coords("recv_done {d}", .{ @as(u32, pe_id) });
  // print y_dsd once received.
    for (y) |val, i| {
      simprint.fmt_with_coords("y[{d}] = {f}", .{ i, val });
    }
  // if (pe_id == kernel_x_dim-1) {
  //   @activate(exit_task_id);
  // } else {
    @activate(state_machine_id);

  // sys_mod.unblock_cmd_stream();
}

task send_done() void {
  simprint.fmt_with_coords("send_done {d}", .{ @as(u32, pe_id) });
  // sys_mod.unblock_cmd_stream();
  // @activate(exit_task_id);
  // current_active_layer = current_active_layer + 1;  // take next layer.
  // simprint.fmt_with_coords("current_active_layer {d}", .{ @as(u32, current_active_layer) });
  // host_facing_function(current_active_layer);
}
// // recv
// // compute
// // send
// // activate another layer.


// Compute gemv
task compute() void {
  simprint.fmt_with_coords("compute {d}", .{ @as(u32, pe_id) });
  // reset A_dsd to the start of A
  A_dsd = @set_dsd_base_addr(A_dsd, &A);
  
  // Initialize y to 0
  for (@range(i16, M_per_PE)) |i| {
    y[i] = 0.0;
  }
  
  // Compute local matrix multiplication
  for (@range(i16, N_per_PE)) |i| {
    @fmacs(y_dsd, y_dsd, A_dsd, x[i]);
    // Move A_dsd to next column of A
    A_dsd = @increment_dsd_offset(A_dsd, 1, f32);
  }  

  // unblock send to get more control.
  // @unblock(send_y_id);
}

// This is a local task, should be @activated only.
task state_machine() void {
  simprint.fmt_with_coords("state_machine {d}", .{ @as(u32, pe_id) });
  // After fmovs is done, activate exit_task to unblock cmd_stream
  @activate(compute_task_id);
  @activate(send_y_id);
  // if (pe_id == @as(i16, kernel_x_dim)-1) {
  //   @activate(exit_task_id);
  // } else {
  //   @activate(send_y_id);
  // }
  // if (pe_id == 0) {
  //   @activate(compute_task_id);
  //   @activate(send_y_id);
  // } else if (pe_id == @as(i16, kernel_x_dim)-1) {
  //   @activate(recv_y_id);
  // } else {
  //   @activate(recv_y_id);
  //   @activate(compute_task_id);
  //   @activate(send_y_id);
  // }
}

// The top row sends x values along x_color to launch recv_x
fn host_facing_function(current_active_layer: i16) void {
  simprint.fmt_with_coords("host_facing_function {d}", .{ @as(u32, pe_id) });
  if (pe_id == 0) {  // 0
    @activate(state_machine_id);
  }
}


task exit_task() void {
  simprint.fmt_with_coords("exit_task {d}", .{ @as(u32, pe_id) });
  sys_mod.unblock_cmd_stream();
}


comptime {
  // @block(send_y_id);
  // // When exit_task_id is activated, exit_task will execute
  @bind_local_task(exit_task, exit_task_id);
  @bind_local_task(send_done, send_done_id);
  @bind_local_task(recv_done, recv_done_id);
  @bind_local_task(send_y, send_y_id);
  @bind_local_task(compute, compute_task_id);
  @bind_local_task(state_machine, state_machine_id);

  // data task.
  @bind_data_task(recv_y, recv_y_id);

  // // recv_x is wavelet-triggered task (WTT)
  // // activated by receiving wavelets along color x_color,
  // // which corresponds to recv_x_task_id
  // @bind_data_task(recv_x, recv_x_task_id);

  // On WSE-3, we must explicitly initialize input and output queues
  if (@is_arch("wse3")) {
    @initialize_queue(send_east_oq, .{ .color = x_color });
    @initialize_queue(recv_west_iq, .{ .color = x_color });
  }

  @export_symbol(A_ptr, "A");
  @export_symbol(x_ptr, "x");
  @export_symbol(y_ptr, "y");
  @export_symbol(host_facing_function);
}
